      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">AppController</string>
          <string name="Source"><![CDATA[--[[
	AppController
	État de session du plugin et actions déclenchées par l'interface :
	cibles, surcharges de rôle, bibliothèque, zones d'exclusion, géométrie
	protégée, génération, preview, validation, annulation.

	L'interface n'a aucune logique métier : elle appelle ces méthodes et se
	met à jour sur l'événement onChanged.
]]

local HttpService = game:GetService("HttpService")

local Core = script.Parent.Parent.Core
local Analysis = script.Parent.Parent.Analysis

local Config = require(Core.Config)
local Logger = require(Core.Logger)
local Utilities = require(Core.Utilities)
local RandomGenerator = require(Core.RandomGenerator)
local SelectionAnalyzer = require(Analysis.SelectionAnalyzer)
local GeometryAnalyzer = require(Analysis.GeometryAnalyzer)
local AssetRegistry = require(Analysis.AssetRegistry)
local GenerationManager = require(script.Parent.GenerationManager)
local PreviewManager = require(script.Parent.PreviewManager)
local DebugVisualizer = require(script.Parent.DebugVisualizer)
local HistoryManager = require(script.Parent.HistoryManager)
local OutputBuilder = require(script.Parent.OutputBuilder)
local FloorPlacementEngine = require(script.Parent.Parent.Placement.FloorPlacementEngine)
local CollectionService = game:GetService("CollectionService")

local AppController = {}
AppController.__index = AppController

local function userError(message)
	error({ User = message }, 0)
end

local function describeError(err)
	if type(err) == "table" and err.User then
		return err.User, true
	end
	return "Unexpected error: " .. tostring(err), false
end

function AppController.new(plugin, settings)
	local self = setmetatable({}, AppController)
	self.Plugin = plugin
	self.Settings = settings
	self.TargetRoots = {}
	self.Overrides = setmetatable({}, { __mode = "k" })
	self.Analysis = nil
	self.Registry = AssetRegistry.new()
	self.LibraryRoots = {}
	self.LibrarySummary = nil
	self.ExclusionParts = {}
	self.ProtectedParts = {}
	self.Preview = PreviewManager.new()
	self.Debug = DebugVisualizer.new()
	self.LastPlan = nil
	self.Busy = false
	self.Status = { Text = "Select a zone and an asset library to begin.", Level = "Info", Progress = nil }
	self._listeners = {}
	self._connections = {}
	self._unsubscribeHistory = HistoryManager.onUndoRedo(function()
		self:_emit("history")
	end)
	self._unsubscribeLogger = Logger.addSink(function(level, message)
		if level == Logger.Level.Warning or level == Logger.Level.Error then
			self.Status = { Text = message, Level = level, Progress = nil }
			self:_emit("status")
		end
	end)
	return self
end

function AppController:onChanged(callback)
	table.insert(self._listeners, callback)
end

function AppController:_emit(kind)
	for _, cb in ipairs(self._listeners) do
		task.spawn(cb, kind, self)
	end
end

function AppController:setStatus(text, level, progress)
	self.Status = { Text = text, Level = level or "Info", Progress = progress }
	self:_emit("status")
end

-- Cibles ----------------------------------------------------------------------------

function AppController:_aliveList(list)
	local out = {}
	for _, inst in ipairs(list) do
		if Utilities.isAlive(inst) then
			table.insert(out, inst)
		end
	end
	return out
end

function AppController:targetParts()
	self.TargetRoots = self:_aliveList(self.TargetRoots)
	local parts = SelectionAnalyzer.resolveTargets(self.TargetRoots, self.LibraryRoots)
	return parts
end

function AppController:useSelectionAsTargets()
	local selection = SelectionAnalyzer.getSelection()
	local parts, warnings = SelectionAnalyzer.resolveTargets(selection, self.LibraryRoots)
	if #parts == 0 then
		self:setStatus(warnings[1] or "The selection contains no usable part.", "Warning")
		return false
	end
	self.TargetRoots = selection
	self:analyse()
	return true
end

function AppController:_analysisOptions()
	local S = self.Settings.Values
	local protected = table.clone(self:_aliveList(self.ProtectedParts))
	Utilities.appendAll(protected, SelectionAnalyzer.getTaggedParts(Config.Tags.PROTECTED))
	return {
		Overrides = self.Overrides,
		WallSides = S.WallSides,
		ObstacleParts = protected,
		Camera = workspace.CurrentCamera,
	}
end

function AppController:analyse()
	local parts = self:targetParts()
	if #parts == 0 then
		self.Analysis = nil
		self:setStatus("No target: select the geometry to decorate and press 'Use Current Selection'.", "Warning")
		self:_emit("analysis")
		return nil
	end
	local ok, result = pcall(GeometryAnalyzer.analyze, parts, self:_analysisOptions())
	if not ok then
		self:setStatus("Analysis failed: " .. tostring(result), "Error")
		return nil
	end
	self.Analysis = result
	self.Debug:drawAnalysis(result, self.Settings.Values)
	self:setStatus(string.format("Analysis: %d surfaces (%d floor, %d wall, %d ceiling, %d slope), %d corners.",
		#result.Surfaces, #result.Floors, #result.Walls, #result.Ceilings, #result.Slopes, #result.Corners),
		if #result.Surfaces > 0 then "Success" else "Warning")
	self:_emit("analysis")
	return result
end

function AppController:setOverride(part, role)
	role = GeometryAnalyzer.normalizeRole(role)
	if role == "Auto" then
		self.Overrides[part] = nil
	else
		self.Overrides[part] = role
	end
	self:analyse()
end

function AppController:getOverride(part)
	return self.Overrides[part] or "Auto"
end

-- Bibliothèque -------------------------------------------------------------------------

function AppController:useSelectionAsLibrary()
	local selection = SelectionAnalyzer.getSelection()
	local roots, warnings = SelectionAnalyzer.resolveLibraryRoots(selection)
	if #roots == 0 then
		self:setStatus(warnings[1] or "Select a Folder or Model containing assets.", "Warning")
		return false
	end
	self.LibraryRoots = roots
	return self:rescanLibrary()
end

function AppController:rescanLibrary()
	self.LibraryRoots = self:_aliveList(self.LibraryRoots)
	if #self.LibraryRoots == 0 then
		self:setStatus("No asset library selected.", "Warning")
		return false
	end
	if self.Busy then
		return false
	end
	self.Busy = true
	self:_emit("busy")
	local ok, summary = pcall(function()
		return self.Registry:scan(self.LibraryRoots, self.Settings.Values.AutoClassify, function(f, text)
			self:setStatus(text, "Info", f)
		end)
	end)
	self.Busy = false
	if not ok then
		self:setStatus("Library scan failed: " .. tostring(summary), "Error")
		self:_emit("library")
		return false
	end
	self.LibrarySummary = summary
	if summary.Count == 0 then
		self:setStatus(summary.Warnings[1] or "The library is empty.", "Warning")
	else
		self:setStatus(string.format("Library: %d assets in %d categories.", summary.Count, #summary.Categories), "Success")
	end
	self:_emit("library")
	return summary.Count > 0
end

-- Zones -----------------------------------------------------------------------------------

function AppController:useSelectionAsExclusions()
	local parts = SelectionAnalyzer.resolveZoneParts(SelectionAnalyzer.getSelection())
	if #parts == 0 then
		self:setStatus("Select one or more Parts to use as exclusion zones.", "Warning")
		return
	end
	self.ExclusionParts = parts
	self:setStatus(string.format("%d exclusion zone part(s) set.", #parts), "Success")
	self:_emit("zones")
end

function AppController:clearExclusions()
	self.ExclusionParts = {}
	self:_emit("zones")
end

function AppController:useSelectionAsProtected()
	local parts = SelectionAnalyzer.resolveZoneParts(SelectionAnalyzer.getSelection())
	if #parts == 0 then
		self:setStatus("Select one or more Parts to protect.", "Warning")
		return
	end
	self.ProtectedParts = parts
	self:setStatus(string.format("%d protected part(s) set.", #parts), "Success")
	self:_emit("zones")
end

function AppController:clearProtected()
	self.ProtectedParts = {}
	self:_emit("zones")
end

--[[
	Crée une vraie Part de zone d'exclusion au centre de chaque sol analysé
	(bande CenterClearStart..CenterClearEnd sur l'axe transversal). La Part est
	visible, redimensionnable, taguée ProceduralPlacementExclude, rangée dans un
	dossier séparé, et la création est annulable (Ctrl+Z).
]]
function AppController:createCenterExclusionZone()
	local analysis = self.Analysis or self:analyse()
	if not analysis or #analysis.Floors == 0 then
		self:setStatus("Analyse a zone with at least one floor first (Target > Use Current Selection).", "Warning")
		return {}
	end
	local S = self.Settings:snapshot()
	local Z = Config.ExclusionZone
	local created = {}
	local ok, err = HistoryManager.run("ProceduralComposer: Create Exclusion Zone", "Commit", function()
		local folder = workspace:FindFirstChild(Z.FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = Z.FOLDER_NAME
			folder.Parent = workspace
		end
		for _, floor in ipairs(analysis.Floors) do
			for _, r in ipairs(FloorPlacementEngine.centerZoneRects(floor, S)) do
				local zone = Instance.new("Part")
				zone.Name = Z.PART_NAME
				zone.Anchored = true
				zone.CanCollide = false
				zone.CanQuery = false
				zone.CanTouch = false
				zone.CastShadow = false
				zone.Transparency = Z.TRANSPARENCY
				zone.Color = Z.COLOR
				zone.Material = Enum.Material.ForceField
				zone.Size = Vector3.new(r.U1 - r.U0, Z.HEIGHT, r.V1 - r.V0)
				zone.CFrame = floor.Frame * CFrame.new((r.U0 + r.U1) * 0.5, Z.HEIGHT * 0.5, (r.V0 + r.V1) * 0.5)
				zone:SetAttribute("ProceduralExclusionZone", true)
				CollectionService:AddTag(zone, Config.Tags.EXCLUDE)
				zone.Parent = folder
				table.insert(created, zone)
			end
		end
	end)
	if not ok then
		self:setStatus("Could not create the zone: " .. tostring(err), "Error")
		return {}
	end
	if #created > 0 then
		pcall(function()
			game:GetService("Selection"):Set(created)
		end)
		self:setStatus(string.format("%d center exclusion zone(s) created (tag '%s'). Resize them freely; nothing will ever be placed inside.", #created, Config.Tags.EXCLUDE), "Success")
	else
		self:setStatus("The floor is too small for a center zone.", "Warning")
	end
	self:_emit("zones")
	return created
end

function AppController:taggedExclusionCount()
	return #SelectionAnalyzer.getTaggedParts(Config.Tags.EXCLUDE)
end

-- Seed ----------------------------------------------------------------------------------------

function AppController:randomizeSeed()
	self.Settings:set("Seed", RandomGenerator.randomSeed())
end

-- Génération ------------------------------------------------------------------------------------

function AppController:_sceneExclude()
	local list = {}
	local preview = self.Preview:getPreview()
	if preview then
		table.insert(list, preview)
	end
	if not self.Settings.Values.AvoidPreviousGenerations then
		local root = OutputBuilder.getRoot(false)
		if root then
			table.insert(list, root)
		end
	end
	Utilities.appendAll(list, self:_aliveList(self.LibraryRoots))
	Utilities.appendAll(list, self:_aliveList(self.ExclusionParts))
	Utilities.appendAll(list, self:_aliveList(self.ProtectedParts))
	if self.Analysis then
		Utilities.appendAll(list, self.Analysis.Parts)
	end
	return list
end

function AppController:generatePreview()
	if self.Busy then
		return
	end
	self.Busy = true
	self:_emit("busy")
	local startTime = os.clock()
	local ok, err = pcall(function()
		local parts = self:targetParts()
		if #parts == 0 then
			userError("No target geometry. Select the zone (Parts, Models, Folders) and press 'Use Current Selection'.")
		end
		self.Registry:validate()
		if self.Registry:count() == 0 then
			if #self:_aliveList(self.LibraryRoots) > 0 then
				self.Busy = false
				self:rescanLibrary()
				self.Busy = true
			end
			if self.Registry:count() == 0 then
				userError("No asset library. Select a Folder of assets and press 'Use Current Selection as Library'.")
			end
		end
		self.Registry:finalizeRoles(self.Settings.Values.AutoClassify)
		local S = self.Settings:snapshot()
		self:setStatus("Analysing geometry...", "Info", 0.02)
		local analysis = GeometryAnalyzer.analyze(parts, self:_analysisOptions())
		self.Analysis = analysis
		self:_emit("analysis")
		if #analysis.Surfaces == 0 then
			userError("No usable surface was found in the target. Force a role in the Target Surfaces list.")
		end
		local exclusions = self:_aliveList(self.ExclusionParts)
		Utilities.appendAll(exclusions, SelectionAnalyzer.getTaggedParts(Config.Tags.EXCLUDE))
		local protected = self:_aliveList(self.ProtectedParts)
		Utilities.appendAll(protected, SelectionAnalyzer.getTaggedParts(Config.Tags.PROTECTED))

		local plan = GenerationManager.plan({
			Settings = S,
			Analysis = analysis,
			Registry = self.Registry,
			ExclusionParts = exclusions,
			ProtectedParts = protected,
			SceneExclude = self:_sceneExclude(),
			OnProgress = function(f, text)
				self:setStatus(text, "Info", f)
			end,
		})
		self:setStatus(string.format("Building %d objects...", #plan.Items), "Info", 0.82)
		local buildStart = os.clock()
		local settingsJson = nil
		pcall(function()
			settingsJson = HttpService:JSONEncode(S)
		end)
		local shown, message, created, errors = self.Preview:showPlan(plan, {
			Seed = S.Seed,
			SettingsJson = settingsJson,
			AnchorClones = S.AnchorClones,
			StripScripts = S.StripScripts,
			OnProgress = function(f, text)
				self:setStatus(text, "Info", 0.82 + 0.18 * f)
			end,
		})
		if not shown then
			userError("Could not create the preview: " .. tostring(message))
		end
		local counters = plan.Diagnostics.Counters
		counters.InstantiationTime = os.clock() - buildStart
		counters.GenerationTime = os.clock() - startTime
		for _, e in ipairs(errors) do
			plan.Diagnostics:warn(e)
		end
		self.LastPlan = plan
		self.Debug:drawPlan(plan, analysis, S)
		self:setStatus(string.format("Preview ready: %d assets placed (seed %d). Accept, Regenerate or Cancel.", created, S.Seed), "Success")
		Logger.verbose(string.format("Generation done in %.2fs: %d items, %d rejected attempts.", counters.GenerationTime, created, counters.Rejected))
	end)
	self.Busy = false
	if not ok then
		local message, isUser = describeError(err)
		self:setStatus(message, if isUser then "Warning" else "Error")
		if not isUser then
			Logger.error(message)
		end
	end
	self:_emit("generated")
end

function AppController:regenerate()
	if self.Busy then
		return
	end
	if self.Settings.Values.NewSeedOnRegenerate then
		self:randomizeSeed()
	end
	self:generatePreview()
end

function AppController:accept()
	if self.Busy then
		return
	end
	local ok, result = self.Preview:accept()
	if ok then
		self.Debug:clear()
		self:setStatus("Generation accepted as " .. tostring(result) .. ". Ctrl+Z undoes it in one step.", "Success")
	else
		self:setStatus(tostring(result), "Warning")
	end
	self:_emit("accepted")
end

function AppController:cancel()
	if self.Busy then
		return
	end
	local ok, err = self.Preview:cancel()
	self.Debug:clear()
	if ok then
		self.LastPlan = nil
		self:setStatus("Preview cancelled and removed.", "Info")
	else
		self:setStatus(tostring(err), "Warning")
	end
	self:_emit("cancelled")
end

function AppController:clearGenerated()
	if self.Busy then
		return
	end
	local ok, result = self.Preview:clearGenerated()
	self.Debug:clear()
	if ok then
		self.LastPlan = nil
		self:setStatus(string.format("Cleared %d generated folder(s). Original walls restored. Ctrl+Z to undo.", result), "Success")
	else
		self:setStatus(tostring(result), "Warning")
	end
	self:_emit("cleared")
end

function AppController:redrawDebug()
	if self.LastPlan and self.Analysis then
		self.Debug:drawPlan(self.LastPlan, self.Analysis, self.Settings.Values)
	elseif self.Analysis then
		self.Debug:drawAnalysis(self.Analysis, self.Settings.Values)
	else
		self.Debug:clear()
	end
end

function AppController:clearDebug()
	self.Debug:clear()
end

function AppController:hasPreview()
	return self.Preview:hasPreview()
end

function AppController:generationCount()
	return #self.Preview:getGenerations()
end

function AppController:destroy()
	if self._unsubscribeHistory then
		self._unsubscribeHistory()
	end
	if self._unsubscribeLogger then
		self._unsubscribeLogger()
	end
	self.Debug:clear()
	self._listeners = {}
end

return AppController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">DebugVisualizer</string>
          <string name="Source"><![CDATA[--[[
	DebugVisualizer
	Visualisation de debug par HandleAdornments placés dans CoreGui :
	rien n'est ajouté à la place, rien n'entre dans l'historique d'annulation.

	Affiche (selon les réglages Debug*) :
	  - normales et contours des surfaces analysées ;
	  - boîtes englobantes des objets générés (architecture en orange) ;
	  - zones d'exclusion (rouge) et zone centrale protégée (jaune) ;
	  - points candidats (vert) et rejetés (rouge) ;
	  - points de snap (cyan) ;
	  - segmentation murale (magenta) et coins (orange).
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)

local DebugVisualizer = {}
DebugVisualizer.__index = DebugVisualizer

local D = Config.Debug
local MAX_BOXES = 1500

function DebugVisualizer.new()
	return setmetatable({ _folder = nil }, DebugVisualizer)
end

function DebugVisualizer:_getFolder()
	if self._folder and self._folder.Parent then
		return self._folder
	end
	local folder = Instance.new("Folder")
	folder.Name = D.FOLDER_NAME
	folder.Archivable = false
	local ok = pcall(function()
		folder.Parent = game:GetService("CoreGui")
	end)
	if not ok then
		folder.Parent = workspace.CurrentCamera
	end
	self._folder = folder
	return folder
end

function DebugVisualizer:clear()
	if self._folder then
		self._folder:Destroy()
		self._folder = nil
	end
end

local function adornee()
	return workspace.Terrain
end

function DebugVisualizer:box(cf, size, color, transparency)
	local b = Instance.new("BoxHandleAdornment")
	b.Adornee = adornee()
	b.CFrame = cf
	b.Size = size
	b.Color3 = color
	b.Transparency = transparency or D.BOX_TRANSPARENCY
	b.AlwaysOnTop = false
	b.ZIndex = 1
	b.Parent = self:_getFolder()
	return b
end

function DebugVisualizer:point(position, color, radius)
	local s = Instance.new("SphereHandleAdornment")
	s.Adornee = adornee()
	s.CFrame = CFrame.new(position)
	s.Radius = radius or D.POINT_RADIUS
	s.Color3 = color
	s.Transparency = 0.15
	s.AlwaysOnTop = true
	s.ZIndex = 2
	s.Parent = self:_getFolder()
	return s
end

function DebugVisualizer:line(a, b, color, thickness)
	local length = (b - a).Magnitude
	if length < 1e-4 then
		return nil
	end
	local l = Instance.new("LineHandleAdornment")
	l.Adornee = adornee()
	l.CFrame = CFrame.lookAt(a, b)
	l.Length = length
	l.Thickness = thickness or D.LINE_THICKNESS
	l.Color3 = color
	l.AlwaysOnTop = true
	l.ZIndex = 2
	l.Parent = self:_getFolder()
	return l
end

function DebugVisualizer:arrow(origin, direction, length, color)
	local tip = origin + direction * length
	self:line(origin, tip, color, D.LINE_THICKNESS)
	local cone = Instance.new("ConeHandleAdornment")
	cone.Adornee = adornee()
	cone.CFrame = CFrame.lookAt(tip, tip + direction)
	cone.Height = length * 0.18
	cone.Radius = length * 0.07
	cone.Color3 = color
	cone.AlwaysOnTop = true
	cone.ZIndex = 2
	cone.Parent = self:_getFolder()
end

-- Polygone 2D d'une surface dessiné légèrement au-dessus du plan.
function DebugVisualizer:polygon(surface, poly, color, lift)
	lift = lift or 0.08
	for i = 1, #poly do
		local p = poly[i]
		local q = poly[(i % #poly) + 1]
		local a = surface.Frame:PointToWorldSpace(Vector3.new(p.X, lift, p.Y))
		local b = surface.Frame:PointToWorldSpace(Vector3.new(q.X, lift, q.Y))
		self:line(a, b, color, D.LINE_THICKNESS)
	end
end

function DebugVisualizer:drawAnalysis(analysis, settings)
	self:clear()
	if not settings.DebugEnabled then
		return
	end
	if settings.DebugNormals then
		for _, s in ipairs(analysis.Surfaces) do
			local center = s.Frame:PointToWorldSpace(Vector3.new((s.UMin + s.UMax) * 0.5, 0.05, (s.VMin + s.VMax) * 0.5))
			self:arrow(center, s.Normal, D.NORMAL_LENGTH, D.Colors.Normal)
			self:polygon(s, {
				Vector2.new(s.UMin, s.VMin), Vector2.new(s.UMax, s.VMin),
				Vector2.new(s.UMax, s.VMax), Vector2.new(s.UMin, s.VMax),
			}, D.Colors.Surface, 0.05)
		end
		for _, c in ipairs(analysis.Corners) do
			self:point(c.Position, D.Colors.Corner, D.POINT_RADIUS * 2)
			self:line(c.Position, c.Position + Vector3.new(0, c.Height, 0), D.Colors.Corner)
			self:arrow(c.Position + Vector3.new(0, 0.1, 0), c.Bisector, D.NORMAL_LENGTH * 0.6, D.Colors.Corner)
		end
	end
end

function DebugVisualizer:drawPlan(plan, analysis, settings)
	self:drawAnalysis(analysis, settings)
	if not settings.DebugEnabled then
		return
	end
	local dbg = plan.Diagnostics.Debug
	if settings.DebugBounds then
		for i, item in ipairs(plan.Items) do
			if i > MAX_BOXES then
				break
			end
			local color = if item.Group == "Architecture" then D.Colors.Architecture else D.Colors.Bounds
			self:box(item.BoxCFrame, item.BoxSize, color, D.BOX_TRANSPARENCY)
		end
	end
	if settings.DebugZones then
		for _, z in ipairs(dbg.Zones) do
			local color = if z.Kind == "CenterClear" then D.Colors.CenterClear else D.Colors.Exclusion
			self:polygon(z.Surface, z.Polygon, color, 0.12)
		end
	end
	if settings.DebugCandidates then
		for _, p in ipairs(dbg.Candidates) do
			self:point(p, D.Colors.Candidate, D.POINT_RADIUS * 0.6)
		end
	end
	if settings.DebugRejected then
		for _, p in ipairs(dbg.Rejected) do
			self:point(p, D.Colors.Rejected, D.POINT_RADIUS * 0.6)
		end
	end
	if settings.DebugSnaps then
		for _, p in ipairs(dbg.Snaps) do
			self:point(p, D.Colors.Snap, D.POINT_RADIUS * 0.8)
		end
	end
	if settings.DebugSegments then
		for _, seg in ipairs(dbg.Segments) do
			self:line(seg[1], seg[2], D.Colors.Segment, D.LINE_THICKNESS + 1)
		end
	end
end

return DebugVisualizer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Diagnostics</string>
          <string name="Source"><![CDATA[--[[
	Diagnostics
	Compteurs d'une génération (affichés dans le panneau Diagnostics) et
	enregistreur de données de debug visuel (points candidats, rejets, snaps,
	segmentation murale, zones...). L'enregistrement de debug n'est actif que
	si le mode Debug est activé, pour ne rien coûter sinon.
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)

local Diagnostics = {}
Diagnostics.__index = Diagnostics

function Diagnostics.new(debugEnabled)
	local self = setmetatable({}, Diagnostics)
	self.Counters = {
		Surfaces = 0,
		Floors = 0,
		Walls = 0,
		Ceilings = 0,
		Corners = 0,
		Assets = 0,
		Placed = 0,
		Attempts = 0,
		Rejected = 0,
		OverlapsPrevented = 0,
		ExclusionRejected = 0,
		OutOfBounds = 0,
		SceneRejected = 0,
		TooLarge = 0,
		ModulesFitted = 0,
		GenerationTime = 0,
		PlanningTime = 0,
		InstantiationTime = 0,
	}
	self.PerPass = {}
	self.Warnings = {}
	self._warningSet = {}
	self.DebugEnabled = debugEnabled == true
	self.Debug = {
		Candidates = {},
		Rejected = {},
		Snaps = {},
		Segments = {},
		Zones = {},
		Corners = {},
		Bands = {},
	}
	return self
end

function Diagnostics:add(name, amount)
	self.Counters[name] = (self.Counters[name] or 0) + (amount or 1)
end

function Diagnostics:pass(name, amount)
	self.PerPass[name] = (self.PerPass[name] or 0) + (amount or 1)
end

function Diagnostics:warn(message)
	if not self._warningSet[message] then
		self._warningSet[message] = true
		table.insert(self.Warnings, message)
	end
end

-- Rejet d'un candidat : met à jour les compteurs par raison.
function Diagnostics:reject(reason, worldPosition)
	self.Counters.Rejected += 1
	if reason == "overlap" or reason == "protected" then
		self.Counters.OverlapsPrevented += 1
	elseif reason == "scene" then
		self.Counters.SceneRejected += 1
		self.Counters.OverlapsPrevented += 1
	elseif reason == "exclusion" then
		self.Counters.ExclusionRejected += 1
	elseif reason == "bounds" then
		self.Counters.OutOfBounds += 1
	end
	if self.DebugEnabled and worldPosition and #self.Debug.Rejected < Config.Debug.MAX_REJECTED then
		table.insert(self.Debug.Rejected, worldPosition)
	end
end

function Diagnostics:candidate(worldPosition)
	if self.DebugEnabled and #self.Debug.Candidates < Config.Debug.MAX_CANDIDATES then
		table.insert(self.Debug.Candidates, worldPosition)
	end
end

function Diagnostics:snap(worldPosition)
	if self.DebugEnabled then
		table.insert(self.Debug.Snaps, worldPosition)
	end
end

function Diagnostics:segment(a, b)
	if self.DebugEnabled then
		table.insert(self.Debug.Segments, { a, b })
	end
end

-- Zone 2D d'une surface (polygone) : convertie en points monde pour le debug.
function Diagnostics:zone(surface, polygon, kind)
	if self.DebugEnabled then
		table.insert(self.Debug.Zones, { Surface = surface, Polygon = polygon, Kind = kind })
	end
end

function Diagnostics:corner(corner)
	if self.DebugEnabled then
		table.insert(self.Debug.Corners, corner)
	end
end

function Diagnostics:summaryLines()
	local c = self.Counters
	return {
		{ "Surfaces", string.format("%d (floor %d, wall %d, ceiling %d)", c.Surfaces, c.Floors, c.Walls, c.Ceilings) },
		{ "Corners", tostring(c.Corners) },
		{ "Assets in library", tostring(c.Assets) },
		{ "Placed assets", tostring(c.Placed) },
		{ "Placement attempts", tostring(c.Attempts) },
		{ "Rejected attempts", tostring(c.Rejected) },
		{ "Overlaps prevented", tostring(c.OverlapsPrevented) },
		{ "Exclusion rejections", tostring(c.ExclusionRejected) },
		{ "Modules fitted", tostring(c.ModulesFitted) },
		{ "Generation time", string.format("%.2f s (plan %.2f s, build %.2f s)", c.GenerationTime, c.PlanningTime, c.InstantiationTime) },
	}
end

return Diagnostics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">GenerationManager</string>
          <string name="Source"><![CDATA[--[[
	GenerationManager
	Orchestration d'une génération complète, en pur calcul (aucune instance
	créée ici) :

	  1. collision : géométrie cible + géométrie protégée + scène ;
	  2. zones d'exclusion (sélection + tag ProceduralPlacementExclude) ;
	  3. passes dans l'ordre : architecture -> coins -> décor mural ->
	     sols / pentes -> plafonds (les gros éléments structurels d'abord, les
	     détails ensuite, tous dans le même monde de collision) ;
	  4. diagnostics.

	Chaque passe utilise un sous-flux aléatoire nommé : même seed + mêmes
	réglages + mêmes assets = même résultat.
]]

local Workspace = game:GetService("Workspace")

local Core = script.Parent.Parent.Core
local Placement = script.Parent.Parent.Placement

local Config = require(Core.Config)
local Utilities = require(Core.Utilities)
local RandomGenerator = require(Core.RandomGenerator)
local CollisionEngine = require(Placement.CollisionEngine)
local ExclusionZones = require(Placement.ExclusionZones)
local PlacementContext = require(Placement.PlacementContext)
local AssetSelector = require(Placement.AssetSelector)
local FloorPlacementEngine = require(Placement.FloorPlacementEngine)
local WallPlacementEngine = require(Placement.WallPlacementEngine)
local ArchitectureEngine = require(Placement.ArchitectureEngine)
local CornerEngine = require(Placement.CornerEngine)
local CeilingPlacementEngine = require(Placement.CeilingPlacementEngine)
local Diagnostics = require(script.Parent.Diagnostics)

local GenerationManager = {}

-- Quelles passes exécuter selon le mode et les réglages.
function GenerationManager.resolvePasses(settings)
	local mode = settings.PlacementMode
	local treatment = settings.WallTreatment
	local wallMode = settings.WallMode
	local passes = {
		Floors = mode == "Auto" or mode == "Floor" or mode == "Hybrid",
		WallProps = mode == "Auto" or mode == "Wall" or mode == "Hybrid",
		Architecture = false,
		Corners = settings.CornerDecoration and (mode == "Auto" or mode == "Wall" or mode == "Hybrid" or mode == "Architecture"),
		Ceilings = (mode == "Auto" or mode == "Hybrid") and settings.CeilingDecoration,
		FloorAlgorithm = if mode == "Auto" then "Hybrid" else settings.FloorAlgorithm,
		WallPropMode = "Hybrid",
		ArchitectureMode = "Modular",
		Treatment = treatment,
	}
	if mode == "Architecture" then
		passes.Architecture = true
		passes.ArchitectureMode = "Architectural"
		if treatment == "Keep" then
			passes.Treatment = "Rebuild"
		end
	elseif passes.WallProps then
		if treatment ~= "Keep" or wallMode == "Modular" or wallMode == "Architectural" then
			passes.Architecture = true
			if wallMode == "Architectural" or wallMode == "Modular" then
				passes.ArchitectureMode = wallMode
			else
				passes.ArchitectureMode = if treatment == "Rebuild" then "Architectural" else "Modular"
			end
			if treatment == "Keep" then
				passes.Treatment = "Cover"
			end
		end
		if wallMode == "Props" then
			passes.WallPropMode = "Props"
		elseif wallMode == "Relief" then
			passes.WallPropMode = "Relief"
		end
	end
	return passes
end

local function medianAssetSize(registry)
	local sizes = {}
	for _, a in ipairs(registry.Assets) do
		table.insert(sizes, a.CharacteristicSize)
	end
	table.sort(sizes)
	if #sizes == 0 then
		return 4
	end
	return sizes[math.ceil(#sizes / 2)]
end

--[[
	params = {
	  Settings, Analysis, Registry,
	  ExclusionParts, ProtectedParts,
	  SceneExclude : { Instance }  (exclus des requêtes de scène)
	  OnProgress(fraction, text)
	}
	Renvoie le plan : { Items, Diagnostics, HiddenWalls, Facades, Seed, Passes }
]]
function GenerationManager.plan(params)
	local S = params.Settings
	local analysis = params.Analysis
	local registry = params.Registry
	local startTime = os.clock()
	local diagnostics = Diagnostics.new(S.DebugEnabled)
	local progress = params.OnProgress or function() end

	local c = diagnostics.Counters
	c.Surfaces = #analysis.Surfaces
	c.Floors = #analysis.Floors + #analysis.Slopes
	c.Walls = #analysis.Walls
	c.Ceilings = #analysis.Ceilings
	c.Corners = #analysis.Corners
	c.Assets = registry:count()
	for _, w in ipairs(analysis.Warnings) do
		diagnostics:warn(w)
	end

	-- Collision.
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = params.SceneExclude or {}
	local collision = CollisionEngine.new({
		CellSize = medianAssetSize(registry) * Config.Collision.CELL_SIZE_FACTOR,
		Enabled = S.CollisionCheck,
		Precise = S.PreciseCollision,
		MinimumSpacing = S.MinimumSpacing,
		SceneQuery = S.CollideWithScene,
		OverlapParams = overlap,
		World = Workspace,
	})
	for _, part in ipairs(analysis.Parts) do
		collision:addProtectedPart(part)
	end
	for _, part in ipairs(params.ProtectedParts or {}) do
		if Utilities.isAlive(part) then
			collision:addProtectedPart(part)
		end
	end

	-- Zones d'exclusion.
	local zones = ExclusionZones.new(params.ExclusionParts or {})
	for _, s in ipairs(analysis.Surfaces) do
		for _, z in ipairs(zones:forSurface(s)) do
			diagnostics:zone(s, z.Polygon, "Exclusion")
		end
	end

	local yielder = Utilities.createYielder(Config.Performance.YIELD_BUDGET)
	local ctx = PlacementContext.new({
		Settings = S,
		Analysis = analysis,
		Registry = registry,
		Collision = collision,
		Zones = zones,
		Rng = RandomGenerator.new(S.Seed),
		Diagnostics = diagnostics,
		Yield = yielder,
		MaxAssets = math.min(S.MaxAssets, Config.Performance.HARD_MAX_ASSETS),
	})
	ctx.Selector = AssetSelector.new(ctx)
	ctx.HiddenWalls = {}

	local passes = GenerationManager.resolvePasses(S)
	local steps = 0
	local totalSteps = math.max(1, (if passes.Architecture then #analysis.Walls else 0)
		+ (if passes.Corners then 1 else 0)
		+ (if passes.WallProps then #analysis.Walls else 0)
		+ (if passes.Floors then #analysis.Floors + #analysis.Slopes else 0)
		+ (if passes.Ceilings then #analysis.Ceilings else 0))
	local function step(text)
		steps += 1
		progress(math.clamp(steps / totalSteps, 0, 1) * 0.8, text)
		yielder()
	end

	-- 1) Architecture.
	if passes.Architecture then
		for _, wall in ipairs(analysis.Walls) do
			ArchitectureEngine.run(ctx, wall, { Treatment = passes.Treatment, Mode = passes.ArchitectureMode })
			step("Architecture " .. wall.Id)
		end
	end
	-- 2) Coins.
	if passes.Corners and #analysis.Corners > 0 then
		CornerEngine.run(ctx, analysis.Corners)
		step("Corners")
	end
	-- 3) Décor mural (réduit sur les façades déjà décorées).
	if passes.WallProps then
		for _, wall in ipairs(analysis.Walls) do
			local factor = if ctx.Facades[wall] then 0.4 else 1
			local mode = if ctx.Facades[wall] then "Props" else passes.WallPropMode
			WallPlacementEngine.run(ctx, wall, mode, factor)
			step("Wall " .. wall.Id)
		end
	end
	-- 4) Sols et pentes.
	if passes.Floors then
		for _, floor in ipairs(analysis.Floors) do
			FloorPlacementEngine.run(ctx, floor, passes.FloorAlgorithm)
			step("Floor " .. floor.Id)
		end
		for _, slope in ipairs(analysis.Slopes) do
			FloorPlacementEngine.run(ctx, slope, "Scatter")
			step("Slope " .. slope.Id)
		end
	end
	-- 5) Plafonds.
	if passes.Ceilings then
		for _, ceiling in ipairs(analysis.Ceilings) do
			CeilingPlacementEngine.run(ctx, ceiling)
			step("Ceiling " .. ceiling.Id)
		end
	end

	if #ctx.Items >= ctx.MaxAssets then
		diagnostics:warn(string.format("Max assets (%d) reached: increase 'Max assets' for denser results.", ctx.MaxAssets))
	end
	if #ctx.Items == 0 then
		diagnostics:warn("Nothing could be placed. Check the Diagnostics counters (too large assets, exclusion zones, collisions) or lower the minimum spacing.")
	end
	c.PlanningTime = os.clock() - startTime
	return {
		Items = ctx.Items,
		Diagnostics = diagnostics,
		HiddenWalls = ctx.HiddenWalls,
		Facades = ctx.Facades,
		Seed = S.Seed,
		Passes = passes,
		Settings = S,
		Context = ctx,
	}
end

return GenerationManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">HistoryManager</string>
          <string name="Source"><![CDATA[--[[
	HistoryManager
	Encapsule ChangeHistoryService (API d'enregistrement TryBeginRecording /
	FinishRecording).

	Stratégie d'historique :
	  - Generate Preview : un enregistrement "Preview" (Commit).
	  - Regenerate       : si le dernier point d'annulation est notre preview,
	                       les changements y sont ajoutés (Append) : une seule
	                       entrée d'historique, quel que soit le nombre de variantes.
	  - Accept           : ajouté (Append) au point "Preview" ; un seul Ctrl+Z
	                       après Accept annule donc toute la génération.
	  - Cancel / Clear   : enregistrement séparé (Commit) ; Ctrl+Z les annule.
	  - Erreur pendant une génération : Cancel -> Studio annule tous les
	    changements partiels, la scène reste propre.
]]

local ChangeHistoryService = game:GetService("ChangeHistoryService")

local HistoryManager = {}

HistoryManager.PREVIEW = "ProceduralComposer: Generate Preview"
HistoryManager.ACCEPT = "ProceduralComposer: Accept Generation"
HistoryManager.CANCEL = "ProceduralComposer: Cancel Preview"
HistoryManager.CLEAR = "ProceduralComposer: Clear Generated"
HistoryManager.RESTORE = "ProceduralComposer: Restore Walls"

-- Démarre un enregistrement ; renvoie un identifiant (ou nil si impossible).
function HistoryManager.begin(name)
	local ok, id = pcall(ChangeHistoryService.TryBeginRecording, ChangeHistoryService, name, name)
	if ok and id then
		return id
	end
	return nil
end

-- mode : "Commit" | "Append" | "Cancel"
function HistoryManager.finish(id, mode)
	if not id then
		return false
	end
	local op = Enum.FinishRecordingOperation[mode] or Enum.FinishRecordingOperation.Commit
	local ok = pcall(ChangeHistoryService.FinishRecording, ChangeHistoryService, id, op)
	if not ok and mode == "Append" then
		ok = pcall(ChangeHistoryService.FinishRecording, ChangeHistoryService, id, Enum.FinishRecordingOperation.Commit)
	end
	return ok
end

-- Nom du dernier point d'annulation (ou nil).
function HistoryManager.lastWaypointName()
	local ok, canUndo, name = pcall(ChangeHistoryService.GetCanUndo, ChangeHistoryService)
	if ok and canUndo and type(name) == "string" then
		return name
	end
	return nil
end

function HistoryManager.lastIsPreview()
	return HistoryManager.lastWaypointName() == HistoryManager.PREVIEW
end

-- Exécute `fn` dans un enregistrement ; annule tout en cas d'erreur.
function HistoryManager.run(name, mode, fn)
	local id = HistoryManager.begin(name)
	if not id then
		return false, "Studio refused to start an undo recording (another plugin may be recording). Try again."
	end
	local ok, result = pcall(fn)
	if ok then
		HistoryManager.finish(id, mode)
		return true, result
	end
	HistoryManager.finish(id, "Cancel")
	return false, result
end

function HistoryManager.onUndoRedo(callback)
	local a = ChangeHistoryService.OnUndo:Connect(callback)
	local b = ChangeHistoryService.OnRedo:Connect(callback)
	return function()
		a:Disconnect()
		b:Disconnect()
	end
end

return HistoryManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">OutputBuilder</string>
          <string name="Source"><![CDATA[--[[
	OutputBuilder
	Transforme un plan en instances :

	  ProceduralAssetPlacement_Generated
	      Generation_001
	          Architecture / CornerDecor / WallDecor / FloorDecor / CeilingDecor
	              AssetName_001, AssetName_002...

	  - Toujours Clone() : les assets sources ne sont jamais modifiés.
	  - Mise à l'échelle : Model:ScaleTo (autour du pivot, cohérent avec le
	    repère de mesure) ; pour une Part isolée, taille + PivotOffset +
	    attachments + SpecialMesh.
	  - Étirement (modules étirables d'une seule Part) : taille et CFrame
	    calculés directement depuis la boîte planifiée.
	  - Attributs : GeneratedBy, Seed, SourceAsset, PlacementType,
	    TargetSurface, GenerationId...
	  - Les clones sont construits dans un dossier non parenté, puis le dossier
	    est parenté en une fois : rapide et un seul changement d'historique.
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local Utilities = require(Core.Utilities)

local OutputBuilder = {}

local OUT = Config.Output
local ATTR = Config.Attr

function OutputBuilder.getRoot(create)
	local root = workspace:FindFirstChild(OUT.ROOT_NAME)
	if root == nil and create then
		root = Instance.new("Folder")
		root.Name = OUT.ROOT_NAME
		root:SetAttribute(ATTR.GeneratedBy, OUT.GENERATED_BY)
		root.Parent = workspace
	end
	return root
end

function OutputBuilder.nextGenerationIndex(root)
	local maxIndex = 0
	if root then
		for _, child in ipairs(root:GetChildren()) do
			local idx = child:GetAttribute(ATTR.GenerationIndex)
			if type(idx) == "number" then
				maxIndex = math.max(maxIndex, idx)
			else
				local n = tonumber((string.match(child.Name, "^" .. OUT.GENERATION_PREFIX .. "(%d+)$")))
				if n then
					maxIndex = math.max(maxIndex, n)
				end
			end
		end
	end
	return maxIndex + 1
end

function OutputBuilder.generationName(index)
	return OUT.GENERATION_PREFIX .. Utilities.padNumber(index, OUT.GENERATION_DIGITS)
end

-- Dossier de génération (non parenté) + sous-dossiers.
function OutputBuilder.createGenerationFolder(name, meta)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder:SetAttribute(ATTR.GeneratedBy, OUT.GENERATED_BY)
	folder:SetAttribute(ATTR.GenerationId, meta.GenerationId)
	folder:SetAttribute(ATTR.Seed, meta.Seed)
	if meta.SettingsJson then
		folder:SetAttribute(ATTR.Settings, meta.SettingsJson)
	end
	local subfolders = {}
	for _, key in ipairs(OUT.SUBFOLDER_ORDER) do
		local sub = Instance.new("Folder")
		sub.Name = OUT.Subfolders[key]
		sub.Parent = folder
		subfolders[key] = sub
	end
	return folder, subfolders
end

-- Mise à l'échelle d'une Part isolée autour de son pivot.
local function scaleBasePart(part, s)
	local offset = part.PivotOffset
	part.Size = part.Size * s
	part.PivotOffset = CFrame.new(offset.Position * s) * offset.Rotation
	for _, d in ipairs(part:GetDescendants()) do
		if d:IsA("Attachment") then
			d.Position = d.Position * s
		elseif d:IsA("SpecialMesh") then
			if d.MeshType == Enum.MeshType.FileMesh then
				d.Scale = d.Scale * s
			end
			d.Offset = d.Offset * s
		end
	end
end

-- Étirement d'une Part : taille et CFrame issus de la boîte planifiée.
local function applyStretch(clone, asset, item)
	local part = if clone:IsA("BasePart") then clone else nil
	if not part then
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				part = d
				break
			end
		end
	end
	if not part then
		return false
	end
	-- Rotation de la Part dans le repère de référence (sans échelle) : doit être une permutation d'axes.
	local source = asset.StretchPart
	local rel = asset.RefFrame:ToObjectSpace(source.CFrame).Rotation
	local sizeRef = Vector3.new(
		math.abs(rel.XVector.X) * source.Size.X + math.abs(rel.YVector.X) * source.Size.Y + math.abs(rel.ZVector.X) * source.Size.Z,
		math.abs(rel.XVector.Y) * source.Size.X + math.abs(rel.YVector.Y) * source.Size.Y + math.abs(rel.ZVector.Y) * source.Size.Z,
		math.abs(rel.XVector.Z) * source.Size.X + math.abs(rel.YVector.Z) * source.Size.Y + math.abs(rel.ZVector.Z) * source.Size.Z
	)
	local aligned = math.max(math.abs(rel.XVector.X), math.abs(rel.XVector.Y), math.abs(rel.XVector.Z)) > 0.999
		and math.max(math.abs(rel.YVector.X), math.abs(rel.YVector.Y), math.abs(rel.YVector.Z)) > 0.999
	if not aligned or sizeRef.Magnitude < 1e-6 then
		return false
	end
	local target = item.BoxSize
	local k = Vector3.new(target.X / math.max(sizeRef.X, 1e-6), target.Y / math.max(sizeRef.Y, 1e-6), target.Z / math.max(sizeRef.Z, 1e-6))
	-- Facteur exprimé dans les axes propres de la Part.
	local function axisFactor(axisVector)
		local ax = math.abs(axisVector.X)
		local ay = math.abs(axisVector.Y)
		if ax >= ay and ax >= math.abs(axisVector.Z) then
			return k.X
		elseif ay >= math.abs(axisVector.Z) then
			return k.Y
		end
		return k.Z
	end
	part.Size = Vector3.new(
		source.Size.X * axisFactor(rel.XVector),
		source.Size.Y * axisFactor(rel.YVector),
		source.Size.Z * axisFactor(rel.ZVector)
	)
	part.CFrame = CFrame.new(item.BoxCFrame.Position) * item.RefCFrame.Rotation * rel
	return true
end

local function stripScripts(instance)
	for _, d in ipairs(instance:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		end
	end
end

local function anchorAll(instance)
	if instance:IsA("BasePart") then
		instance.Anchored = true
	end
	for _, d in ipairs(instance:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
end

--[[
	Instancie les objets du plan.
	options = { Seed, GenerationId, AnchorClones, StripScripts, OnProgress(f, text) }
	Renvoie (nombre créé, erreurs)
]]
function OutputBuilder.instantiate(items, subfolders, options)
	local counters = {}
	local created = 0
	local errors = {}
	local onProgress = options.OnProgress or function() end
	for index, item in ipairs(items) do
		local asset = item.Asset
		local ok, err = pcall(function()
			if not Utilities.isAlive(asset.Instance) then
				error("source asset no longer exists")
			end
			local clone = asset.Instance:Clone()
			if not clone then
				error("asset is not Archivable (Clone returned nil)")
			end
			if options.StripScripts then
				stripScripts(clone)
			end
			local s = item.Scale or 1
			local stretched = false
			if item.Stretch and math.abs((item.Stretch.Factor or 1) - 1) > 1e-9 and asset.StretchPart then
				if math.abs(s - 1) > 1e-9 then
					if clone:IsA("Model") then
						clone:ScaleTo(clone:GetScale() * s)
					elseif clone:IsA("BasePart") then
						scaleBasePart(clone, s)
					end
				end
				clone:PivotTo(item.Pivot)
				stretched = applyStretch(clone, asset, item)
			end
			if not stretched then
				if math.abs(s - 1) > 1e-9 then
					if clone:IsA("Model") then
						clone:ScaleTo(clone:GetScale() * s)
					elseif clone:IsA("BasePart") then
						scaleBasePart(clone, s)
					end
				end
				clone:PivotTo(item.Pivot)
			end
			if options.AnchorClones then
				anchorAll(clone)
			end
			local n = (counters[asset.Name] or 0) + 1
			counters[asset.Name] = n
			clone.Name = asset.Name .. "_" .. Utilities.padNumber(n, Config.Output.ITEM_DIGITS)
			clone:SetAttribute(ATTR.GeneratedBy, Config.Output.GENERATED_BY)
			clone:SetAttribute(ATTR.Seed, options.Seed)
			clone:SetAttribute(ATTR.SourceAsset, asset.FullName)
			clone:SetAttribute(ATTR.PlacementType, item.PlacementType)
			clone:SetAttribute(ATTR.TargetSurface, if item.Surface then (item.Surface.PartName .. " [" .. item.Surface.Role .. " " .. item.Surface.FaceName .. " " .. item.Surface.Id .. "]") else "Corner")
			clone:SetAttribute(ATTR.GenerationId, options.GenerationId)
			clone:SetAttribute(ATTR.SizeClass, asset.SizeClass)
			clone:SetAttribute(ATTR.Scale, s)
			clone:SetAttribute(ATTR.Layer, item.Layer or 0)
			local folder = subfolders[item.Folder] or subfolders.Floor
			clone.Parent = folder
			created += 1
		end)
		if not ok then
			table.insert(errors, string.format("%s: %s", asset.Name, tostring(err)))
		end
		if index % Config.Performance.INSTANTIATE_BATCH == 0 then
			onProgress(index / #items, string.format("Building %d/%d", index, #items))
			task.wait()
		end
	end
	-- Suppression des sous-dossiers vides pour une hiérarchie propre.
	for _, sub in pairs(subfolders) do
		if #sub:GetChildren() == 0 then
			sub:Destroy()
		end
	end
	return created, errors
end

-- Masque des murs d'origine de façon réversible (ObjectValue + transparence d'origine).
function OutputBuilder.hideWalls(folder, parts)
	if #parts == 0 then
		return
	end
	local store = Instance.new("Folder")
	store.Name = OUT.HIDDEN_WALLS_FOLDER
	for _, part in ipairs(parts) do
		if Utilities.isAlive(part) then
			local ref = Instance.new("ObjectValue")
			ref.Name = part.Name
			ref.Value = part
			ref:SetAttribute(ATTR.OriginalTransparency, part.Transparency)
			ref.Parent = store
			part.Transparency = 1
		end
	end
	store.Parent = folder
end

function OutputBuilder.restoreWalls(folder)
	local store = folder:FindFirstChild(OUT.HIDDEN_WALLS_FOLDER)
	if not store then
		return 0
	end
	local restored = 0
	for _, ref in ipairs(store:GetChildren()) do
		if ref:IsA("ObjectValue") and ref.Value and ref.Value:IsA("BasePart") then
			local original = ref:GetAttribute(ATTR.OriginalTransparency)
			if type(original) == "number" then
				ref.Value.Transparency = original
				restored += 1
			end
		end
	end
	return restored
end

return OutputBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">PreviewManager</string>
          <string name="Source"><![CDATA[--[[
	PreviewManager
	Cycle de vie du résultat dans la scène : Preview -> Regenerate -> Accept /
	Cancel, et Clear Generated.

	Sans état caché : la preview est retrouvée dans la scène par son attribut
	PCP_IsPreview, ce qui reste juste après un Ctrl+Z / Ctrl+Y.
	Toutes les modifications passent par HistoryManager (annulables).
]]

local HttpService = game:GetService("HttpService")

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local OutputBuilder = require(script.Parent.OutputBuilder)
local HistoryManager = require(script.Parent.HistoryManager)

local PreviewManager = {}
PreviewManager.__index = PreviewManager

local ATTR = Config.Attr

function PreviewManager.new()
	return setmetatable({}, PreviewManager)
end

function PreviewManager:getRoot()
	return OutputBuilder.getRoot(false)
end

function PreviewManager:getPreview()
	local root = self:getRoot()
	if not root then
		return nil
	end
	for _, child in ipairs(root:GetChildren()) do
		if child:GetAttribute(ATTR.IsPreview) == true then
			return child
		end
	end
	return nil
end

function PreviewManager:hasPreview()
	return self:getPreview() ~= nil
end

function PreviewManager:getGenerations()
	local list = {}
	local root = self:getRoot()
	if root then
		for _, child in ipairs(root:GetChildren()) do
			if child:IsA("Folder") and child:GetAttribute(ATTR.GeneratedBy) == Config.Output.GENERATED_BY and child:GetAttribute(ATTR.IsPreview) ~= true then
				table.insert(list, child)
			end
		end
	end
	return list
end

local function destroyPreviewFolder(folder)
	OutputBuilder.restoreWalls(folder)
	folder:Destroy()
end

--[[
	Affiche un plan comme preview (remplace la preview existante).
	meta = { Seed, SettingsJson, AnchorClones, StripScripts, OnProgress }
	Renvoie (ok, message, created)
]]
function PreviewManager:showPlan(plan, meta)
	local regenerate = self:hasPreview()
	local mode = if regenerate and HistoryManager.lastIsPreview() then "Append" else "Commit"
	local generationId = HttpService:GenerateGUID(false)
	local created, errors = 0, {}
	local ok, err = HistoryManager.run(HistoryManager.PREVIEW, mode, function()
		local existing = self:getPreview()
		if existing then
			destroyPreviewFolder(existing)
		end
		local root = OutputBuilder.getRoot(true)
		local folder, subfolders = OutputBuilder.createGenerationFolder(Config.Output.PREVIEW_NAME, {
			GenerationId = generationId,
			Seed = meta.Seed,
			SettingsJson = meta.SettingsJson,
		})
		folder:SetAttribute(ATTR.IsPreview, true)
		created, errors = OutputBuilder.instantiate(plan.Items, subfolders, {
			Seed = meta.Seed,
			GenerationId = generationId,
			AnchorClones = meta.AnchorClones,
			StripScripts = meta.StripScripts,
			OnProgress = meta.OnProgress,
		})
		OutputBuilder.hideWalls(folder, plan.HiddenWalls or {})
		folder.Parent = root
	end)
	if not ok then
		return false, tostring(err), 0, {}
	end
	return true, nil, created, errors
end

-- Valide la preview : elle devient Generation_NNN.
function PreviewManager:accept()
	local folder = self:getPreview()
	if not folder then
		return false, "There is no preview to accept."
	end
	local mode = if HistoryManager.lastIsPreview() then "Append" else "Commit"
	local name
	local ok, err = HistoryManager.run(HistoryManager.ACCEPT, mode, function()
		local root = self:getRoot()
		local index = OutputBuilder.nextGenerationIndex(root)
		name = OutputBuilder.generationName(index)
		folder.Name = name
		folder:SetAttribute(ATTR.IsPreview, nil)
		folder:SetAttribute(ATTR.GenerationIndex, index)
	end)
	if not ok then
		return false, tostring(err)
	end
	return true, name
end

function PreviewManager:cancel()
	local folder = self:getPreview()
	if not folder then
		return false, "There is no preview to cancel."
	end
	local ok, err = HistoryManager.run(HistoryManager.CANCEL, "Commit", function()
		destroyPreviewFolder(folder)
		local root = self:getRoot()
		if root and #root:GetChildren() == 0 then
			root:Destroy()
		end
	end)
	if not ok then
		return false, tostring(err)
	end
	return true
end

-- Supprime tout le contenu généré (preview + générations), murs restaurés.
function PreviewManager:clearGenerated()
	local root = self:getRoot()
	if not root then
		return false, "Nothing has been generated."
	end
	local count = 0
	local ok, err = HistoryManager.run(HistoryManager.CLEAR, "Commit", function()
		for _, child in ipairs(root:GetChildren()) do
			if child:IsA("Folder") then
				OutputBuilder.restoreWalls(child)
				count += 1
			end
		end
		root:Destroy()
	end)
	if not ok then
		return false, tostring(err)
	end
	return true, count
end

return PreviewManager
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="22">
      <Properties>
        <string name="Name">Placement</string>
      </Properties>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">ArchitectureEngine</string>
          <string name="Source"><![CDATA[--[[
	ArchitectureEngine
	Construit une façade architecturale DEVANT un mur de référence, sans jamais
	modifier ce mur :

	  COVER   : façade modulaire complète (rangées de modules) devant le mur.
	  REBUILD : structure complète : soubassement, piliers, travées de modules,
	            arches, corniche, détails dans les travées (et, si autorisé,
	            masquage réversible du mur d'origine).

	Étapes pour chaque mur :
	  1. Plage utile U : découpée aux coins ; si le mur voisin possède déjà une
	     façade, on s'arrête devant elle (joint "bout à bout" : ni trou, ni
	     chevauchement dans l'angle).
	  2. Segmentation autour des zones d'exclusion (porte, passage...).
	  3. Architectural : travées égales entre piliers (espacement PillarSpacing),
	     les modules courent de centre de pilier à centre de pilier (les joints
	     sont cachés par les piliers). Modular : un seul remplissage par segment.
	  4. Rangées empilées pour couvrir la hauteur (murs très hauts), chaque
	     rangée remplie EXACTEMENT par ModularFitter.
	  5. Piliers empilés par Snap_Bottom/Snap_Top si plus courts que le mur.
	  6. Soubassement et corniche continus (modules étirables acceptés).
	  7. Détails centrés dans les travées (symétriques).
	Couches de profondeur : chaque couche est avancée de n × SURFACE_EPSILON.
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local PlacementMath = require(script.Parent.PlacementMath)
local SnapEngine = require(script.Parent.SnapEngine)
local ModularFitter = require(script.Parent.ModularFitter)
local ExclusionZones = require(script.Parent.ExclusionZones)
local WallPlacementEngine = require(script.Parent.WallPlacementEngine)

local ArchitectureEngine = {}

local ARCH = Config.Architecture
local F = Config.Fitting
local A = Config.Assets
local TOL = Config.Precision.CONTACT_TOLERANCE

local function canonSize(asset, scale)
	local cmin, cmax = PlacementMath.wallCanonBounds(asset, scale, asset.WallYaw, nil)
	return cmax - cmin
end

local function moduleEntry(ctx, asset, dev)
	local S = ctx.Settings
	local conn = SnapEngine.horizontalConnectors(asset, 1, asset.WallYaw, nil)
	local allowScale = S.AllowModuleScaling and asset.Meta.AllowScale
	return {
		Key = asset.Key,
		Width = conn.Width,
		Weight = asset.Meta.Weight,
		Scalable = allowScale and dev > 0,
		MinFactor = asset.Meta.MinScale,
		MaxFactor = asset.Meta.MaxScale,
		Stretchable = asset.StretchPart ~= nil,
		MaxStretch = F.MAX_STRETCH,
		MinStretch = F.MIN_STRETCH,
		IsFiller = (asset.RoleScores.Filler or 0) >= A.ROLE_SCORE_THRESHOLD,
		Data = asset,
	}
end

-- Regroupe des assets par hauteur (rangées homogènes).
local function heightGroups(assets)
	local sorted = table.clone(assets)
	table.sort(sorted, function(a, b)
		local ha, hb = canonSize(a, 1).Y, canonSize(b, 1).Y
		if math.abs(ha - hb) > 1e-6 then
			return ha > hb
		end
		return a.Order < b.Order
	end)
	local groups = {}
	for _, a in ipairs(sorted) do
		local h = canonSize(a, 1).Y
		local g = groups[#groups]
		if g and h >= g.Height * (1 - F.HEIGHT_BUCKET_TOLERANCE) then
			table.insert(g.Assets, a)
		else
			table.insert(groups, { Height = h, Assets = { a } })
		end
	end
	return groups
end

-- Place les éléments d'un remplissage horizontal ; renvoie (hauteur de rangée, profondeur max, nb placés).
local function placeRow(ctx, wall, fit, segStart, vBottom, layer, meta)
	local eps = ctx.Epsilon
	local rowHeight, maxDepth, placed = 0, 0, 0
	for _, it in ipairs(fit.Items) do
		local asset = it.Module.Data
		local scale = it.Factor * (meta.BaseScale or 1)
		local stretch = nil
		if it.Stretch and math.abs(it.Stretch - 1) > 1e-9 then
			stretch = { Axis = PlacementMath.wallAlongAxis(asset.WallYaw), Factor = it.Stretch }
		end
		local conn = SnapEngine.horizontalConnectors(asset, scale, asset.WallYaw, stretch)
		local uStart = segStart + fit.StartOffset + it.Start
		local depth = (meta.DepthBase or 0) + layer * eps + asset.Meta.WallOffset
		local anchorY = meta.AnchorY or "Bottom"
		local pose = PlacementMath.wallPose(asset, scale, wall, uStart, vBottom, {
			AnchorXValue = conn.Start,
			AnchorY = anchorY,
			Depth = depth,
			Stretch = stretch,
		})
		local size = pose.CanonMax - pose.CanonMin
		local poly = PlacementMath.footprint(pose, wall)
		if ctx.Zones:blocks(wall, poly) then
			ctx.Diagnostics:reject("exclusion", pose.BoxCFrame.Position)
		else
			local item = ctx:tryCommit(pose, {
				Surface = wall,
				Role = "Architecture",
				Folder = "Architecture",
				PlacementType = meta.PlacementType,
				Group = "Architecture",
				AllowArchitectureOverlap = true,
				Layer = layer,
				IgnoreParts = meta.IgnoreParts,
				Pass = meta.Pass,
			})
			if item then
				placed += 1
				rowHeight = math.max(rowHeight, size.Y)
				maxDepth = math.max(maxDepth, depth + size.Z)
				ctx.Diagnostics:snap(SnapEngine.connectorWorld(wall, pose, conn.StartPoint))
				ctx.Diagnostics:snap(SnapEngine.connectorWorld(wall, pose, conn.EndPoint))
			end
		end
	end
	ctx.Diagnostics:add("ModulesFitted", placed)
	return rowHeight, maxDepth, placed
end

local function fitOptions(ctx, rng, endsFlush)
	local S = ctx.Settings
	return {
		AllowScale = S.AllowModuleScaling,
		MaxDeviation = S.MaxModuleScaleDeviation,
		AllowGaps = false,
		EndsFlush = endsFlush ~= false,
		Symmetric = S.Symmetry >= 0.5,
		Rng = rng,
		Variety = S.Variation,
		AllowFillers = true,
	}
end

-- Remplit un intervalle [u0, u1] par des rangées empilées de modules.
local function fillInterval(ctx, wall, u0, u1, groups, preferredFirst, rng, meta)
	local S = ctx.Settings
	local dev = if S.AllowModuleScaling then S.MaxModuleScaleDeviation else 0
	local length = u1 - u0
	local v = wall.VMin
	local remaining = wall.VMax - wall.VMin
	local maxDepth = 0
	local coveredHeight = 0
	local minGroupHeight = math.huge
	for _, g in ipairs(groups) do
		minGroupHeight = math.min(minGroupHeight, g.Height)
	end
	local rowIndex = 0
	local guard = 0
	while remaining > minGroupHeight * ARCH.MIN_ROW_FILL and guard < 64 do
		guard += 1
		rowIndex += 1
		local ordered = {}
		if rowIndex == 1 and preferredFirst then
			table.insert(ordered, preferredFirst)
		end
		for _, g in ipairs(groups) do
			if g ~= preferredFirst then
				table.insert(ordered, g)
			end
		end
		local done = false
		for _, g in ipairs(ordered) do
			if g.Height * (1 - dev) <= remaining + TOL then
				-- Le facteur d'échelle horizontal agrandit aussi la hauteur : il est
				-- borné pour que la rangée ne dépasse jamais le haut du mur.
				local modules = {}
				for _, a in ipairs(g.Assets) do
					if ctx:assetAvailable(a) then
						local entry = moduleEntry(ctx, a, dev)
						local h = canonSize(a, 1).Y
						local heightCap = (remaining + TOL * 0.5) / math.max(h, 1e-6)
						if heightCap >= 1 or (entry.Scalable and heightCap >= 1 - dev) then
							entry.MaxFactor = math.min(entry.MaxFactor or math.huge, heightCap)
							table.insert(modules, entry)
						end
					end
				end
				local fit = ModularFitter.fit(length, modules, fitOptions(ctx, rng:fork("row" .. rowIndex .. g.Height), true))
				if #fit.Items > 0 then
					-- Hauteur réelle de la rangée après mise à l'échelle.
					local rowH = 0
					for _, it in ipairs(fit.Items) do
						rowH = math.max(rowH, canonSize(it.Module.Data, it.Factor).Y)
					end
					if rowH <= remaining + TOL then
						local h, depth, placed = placeRow(ctx, wall, fit, u0, v, ARCH.LAYER_MODULE, meta)
						if placed > 0 then
							v += h
							remaining -= h
							coveredHeight += h
							maxDepth = math.max(maxDepth, depth)
							if fit.Method == "margin-large" then
								ctx.Diagnostics:warn(string.format("Wall %s: modules could not fill %.2f studs exactly (enable module scaling or add filler/stretchable modules).", wall.Id, fit.Residual))
							end
							done = true
							break
						end
					end
				end
			end
		end
		if not done then
			break
		end
		if not meta.MultiRow then
			break
		end
		ctx.Yield()
	end
	return coveredHeight, maxDepth
end

-- Pilier (éventuellement empilé) centré sur u.
local function placePillar(ctx, wall, pillar, u, targetHeight, moduleDepth, rng, ignore)
	local S = ctx.Settings
	local eps = ctx.Epsilon
	local dev = if S.AllowModuleScaling then S.MaxModuleScaleDeviation else 0
	local conn = SnapEngine.verticalConnectors(pillar, 1, pillar.WallYaw)
	local h = conn.Height
	if h <= 1e-3 then
		return 0
	end
	local count, scale
	if h >= targetHeight then
		scale = targetHeight / h
		count = 1
		local minScale = pillar.Meta.MinScale or (1 - dev * 2)
		if not pillar.Meta.AllowScale or scale < minScale then
			return 0
		end
	else
		count = math.max(1, math.floor(targetHeight / h + 0.5))
		scale = targetHeight / (count * h)
		if math.abs(scale - 1) > dev or not pillar.Meta.AllowScale then
			count = math.max(1, math.floor(targetHeight / h))
			scale = 1
		end
	end
	local size = canonSize(pillar, scale)
	local pillarDepth = size.Z
	local depth
	if pillarDepth > moduleDepth + ARCH.PILLAR_DEPTH_MARGIN then
		depth = ARCH.LAYER_PILLAR * eps
	else
		depth = moduleDepth + ARCH.LAYER_PILLAR * eps
	end
	depth += pillar.Meta.WallOffset
	local vconn = SnapEngine.verticalConnectors(pillar, scale, pillar.WallYaw)
	local positions = SnapEngine.stackPositions(vconn, wall.VMin, count)
	local placed = 0
	for i, vAnchor in ipairs(positions) do
		local pose = PlacementMath.wallPose(pillar, scale, wall, u, vAnchor, {
			AnchorX = "Center",
			AnchorYValue = vconn.Bottom,
			Depth = depth,
		})
		local poly = PlacementMath.footprint(pose, wall)
		if not ctx.Zones:blocks(wall, poly) then
			local item = ctx:tryCommit(pose, {
				Surface = wall,
				Role = "Architecture",
				Folder = "Architecture",
				PlacementType = "Pillar",
				Group = "Architecture",
				AllowArchitectureOverlap = true,
				Layer = ARCH.LAYER_PILLAR,
				IgnoreParts = ignore,
				Pass = "Pillar",
			})
			if item then
				placed += 1
				if i > 1 then
					ctx.Diagnostics:snap(pose.BoxCFrame.Position)
				end
			end
		end
	end
	return placed, depth + pillarDepth, size.X
end

-- Bordure continue (soubassement / corniche).
local function placeTrim(ctx, wall, u0, u1, assets, anchorY, depthBase, rng, ignore, placementType)
	local S = ctx.Settings
	local dev = if S.AllowModuleScaling then S.MaxModuleScaleDeviation else 0
	local height = wall.VMax - wall.VMin
	local modules = {}
	for _, a in ipairs(assets) do
		if canonSize(a, 1).Y <= height * 0.25 and ctx:assetAvailable(a) then
			table.insert(modules, moduleEntry(ctx, a, dev))
		end
	end
	if #modules == 0 then
		return 0
	end
	local fit = ModularFitter.fit(u1 - u0, modules, fitOptions(ctx, rng, true))
	if #fit.Items == 0 then
		return 0
	end
	local v = if anchorY == "Top" then wall.VMax else wall.VMin
	local _, depth = placeRow(ctx, wall, fit, u0, v, ARCH.LAYER_TRIM, {
		DepthBase = depthBase,
		AnchorY = anchorY,
		PlacementType = placementType,
		IgnoreParts = ignore,
		Pass = placementType,
	})
	return depth
end

--[[
	opts = { Treatment = "Cover" | "Rebuild", Mode = "Modular" | "Architectural" }
	Renvoie true si une façade a été construite.
]]
function ArchitectureEngine.run(ctx, wall, opts)
	local S = ctx.Settings
	local registry = ctx.Registry
	local rng = ctx.Rng:fork("arch:" .. wall.Id)
	local dev = if S.AllowModuleScaling then S.MaxModuleScaleDeviation else 0

	-- 1) Plage utile : arrêt devant la façade d'un mur voisin déjà construit.
	local u0, u1 = wall.UMin, wall.UMax
	for _, side in ipairs({ "Min", "Max" }) do
		local e = wall.Ends[side]
		if e.Type == "Corner" and ctx.Facades[e.Other] then
			local denom = wall.U:Dot(e.Other.Normal)
			if math.abs(denom) > 0.3 then
				local shift = ctx.Facades[e.Other].Depth / denom
				if side == "Min" then
					u0 = math.max(u0, wall.UMin + shift)
				else
					u1 = math.min(u1, wall.UMax + shift)
				end
			end
		end
	end
	local height = wall.VMax - wall.VMin
	if u1 - u0 < Config.Geometry.MIN_SURFACE_EXTENT or height < Config.Geometry.MIN_SURFACE_EXTENT then
		return false
	end

	local ignore = { [wall.Part] = true }
	if wall.SupportFloor then
		ignore[wall.SupportFloor.Part] = true
	end
	if wall.CeilingAbove then
		ignore[wall.CeilingAbove.Part] = true
	end

	-- 2) Assets disponibles.
	local function usable(role, maxHeightFactor)
		local list = {}
		for _, a in ipairs(registry:getByRole(role)) do
			local size = canonSize(a, 1)
			if size.Y <= height * (maxHeightFactor or (1 + dev)) and size.X > 1e-3 then
				table.insert(list, a)
			end
		end
		return list
	end
	local modulesAll = usable("WallModule")
	local arches = usable("Arch")
	local pillars = usable("Pillar", 1e9)
	local tops = usable("WallTop")
	local bases = usable("WallBase")
	local isArchitectural = opts.Mode == "Architectural"

	if #modulesAll == 0 and not (isArchitectural and #pillars > 0) and #tops == 0 and #bases == 0 then
		ctx.Diagnostics:warn(string.format("Wall %s: no WallModule / Pillar / WallTop / WallBase asset available for %s.", wall.Id, opts.Treatment))
		return false
	end
	-- Les arches ne servent pas de modules standards.
	local standard = {}
	for _, a in ipairs(modulesAll) do
		if not table.find(arches, a) or #modulesAll == #arches then
			table.insert(standard, a)
		end
	end
	local groups = heightGroups(standard)
	local archGroups = heightGroups(arches)

	-- 3) Segmentation autour des zones d'exclusion.
	local minWidth = math.huge
	for _, a in ipairs(standard) do
		minWidth = math.min(minWidth, SnapEngine.horizontalConnectors(a, 1, a.WallYaw).Width)
	end
	if minWidth == math.huge then
		minWidth = Config.Geometry.MIN_SURFACE_EXTENT
	end
	local blocked = ctx.Zones:blockedIntervalsU(wall, wall.VMin, wall.VMax)
	local segments = ExclusionZones.subtractIntervals(u0, u1, blocked, minWidth * (1 - dev))
	for _, seg in ipairs(segments) do
		ctx.Diagnostics:segment(wall.Frame:PointToWorldSpace(Vector3.new(seg[1], 0.05, wall.VMin)), wall.Frame:PointToWorldSpace(Vector3.new(seg[1], 0.05, wall.VMax)))
		ctx.Diagnostics:segment(wall.Frame:PointToWorldSpace(Vector3.new(seg[2], 0.05, wall.VMin)), wall.Frame:PointToWorldSpace(Vector3.new(seg[2], 0.05, wall.VMax)))
	end

	local moduleDepth = 0
	local facadeDepth = 0
	local coveredArea = 0
	local bays = {}
	local multiRow = true

	-- Largeur de pilier de référence (pour les travées).
	local pillarAsset = nil
	if isArchitectural and #pillars > 0 then
		pillarAsset = ctx.Selector:pick(pillars, { Role = "Pillar", Rng = rng, IgnoreFrequency = true })
	end

	for si, seg in ipairs(segments) do
		local segRng = rng:fork("seg" .. si)
		local s0, s1 = seg[1], seg[2]
		local segLength = s1 - s0
		if isArchitectural and pillarAsset then
			-- 4a) Travées égales entre piliers.
			local pw = canonSize(pillarAsset, 1).X
			if segLength < pw * 1.5 then
				continue
			end
			local n = math.max(1, math.floor((segLength - pw) / S.PillarSpacing + 0.5))
			local centers = {}
			local cStart = s0 + pw * 0.5
			local cEnd = s1 - pw * 0.5
			for i = 0, n do
				table.insert(centers, cStart + (cEnd - cStart) * (i / n))
			end
			-- Motif d'arches : travée centrale (symétrie) ou rythme régulier.
			local archBays = {}
			if #arches > 0 then
				if S.Symmetry >= 0.5 then
					if n % 2 == 1 then
						archBays[(n + 1) / 2] = true
					else
						archBays[n / 2] = true
						archBays[n / 2 + 1] = true
					end
				else
					local period = if S.VisualRhythm > 0.6 then 2 else 3
					local offset = segRng:int(0, period - 1)
					for b = 1, n do
						if (b + offset) % period == 0 and segRng:chance(math.max(ARCH.ARCH_BAY_RATIO, S.VisualRhythm)) then
							archBays[b] = true
						end
					end
				end
			end
			for b = 1, n do
				local bu0 = if b == 1 then s0 else centers[b]
				local bu1 = if b == n then s1 else centers[b + 1]
				-- Même graine pour des travées symétriques -> séquences identiques.
				local patternIndex = math.min(b, n + 1 - b)
				local bayRng = rng:fork("bay" .. patternIndex .. (if archBays[b] then "a" else "m") .. si)
				local preferred = nil
				local bayGroups = groups
				if archBays[b] and #archGroups > 0 then
					preferred = archGroups[1]
					bayGroups = table.clone(groups)
					table.insert(bayGroups, 1, archGroups[1])
				end
				if #bayGroups > 0 then
					local h, depth = fillInterval(ctx, wall, bu0, bu1, bayGroups, preferred, bayRng, {
						PlacementType = if archBays[b] then "Arch" else "WallModule",
						IgnoreParts = ignore,
						Pass = "Modules",
						MultiRow = multiRow,
					})
					moduleDepth = math.max(moduleDepth, depth)
					coveredArea += h * (bu1 - bu0)
				end
				table.insert(bays, { U0 = bu0, U1 = bu1, Center = (centers[b] + centers[b + 1]) * 0.5, Arch = archBays[b] == true, Index = b, Count = n })
			end
			-- Piliers (aux extrémités : sauf coin décoré par CornerEngine).
			for i, c in ipairs(centers) do
				local isEnd = i == 1 or i == #centers
				local skip = false
				if isEnd and S.CornerDecoration then
					local side = if i == 1 then "Min" else "Max"
					local atSegmentEnd = (i == 1 and math.abs(s0 - u0) < 1e-6) or (i == #centers and math.abs(s1 - u1) < 1e-6)
					if atSegmentEnd and wall.Ends[side].Type == "Corner" and #registry:getByRole("Corner") > 0 then
						skip = true
					end
				end
				if not skip then
					local p = pillarAsset
					if not ctx:assetAvailable(p) then
						p = ctx.Selector:pick(pillars, { Role = "Pillar", Rng = segRng, IgnoreFrequency = true })
					end
					if p then
						local _, depth = placePillar(ctx, wall, p, c, height, moduleDepth, segRng, ignore)
						if depth then
							facadeDepth = math.max(facadeDepth, depth)
						end
					end
				end
			end
		elseif #groups > 0 then
			-- 4b) Mur modulaire : remplissage continu du segment.
			local h, depth = fillInterval(ctx, wall, s0, s1, groups, nil, segRng, {
				PlacementType = "WallModule",
				IgnoreParts = ignore,
				Pass = "Modules",
				MultiRow = multiRow,
			})
			moduleDepth = math.max(moduleDepth, depth)
			coveredArea += h * segLength
			-- Travées virtuelles pour les détails : une par module de la première rangée.
			local count = math.max(1, math.floor(segLength / math.max(S.PillarSpacing, 1) + 0.5))
			for b = 1, count do
				local a = s0 + segLength * (b - 1) / count
				local z = s0 + segLength * b / count
				table.insert(bays, { U0 = a, U1 = z, Center = (a + z) * 0.5, Arch = false, Index = b, Count = count })
			end
		end
		ctx.Yield()
	end
	facadeDepth = math.max(facadeDepth, moduleDepth)

	-- 5) Soubassement et corniche (en avant des modules).
	for si, seg in ipairs(segments) do
		if S.BaseDecoration and #bases > 0 then
			local d = placeTrim(ctx, wall, seg[1], seg[2], bases, "Bottom", moduleDepth, rng:fork("base" .. si), ignore, "WallBase")
			facadeDepth = math.max(facadeDepth, d)
		end
		if S.TopDecoration and #tops > 0 then
			local d = placeTrim(ctx, wall, seg[1], seg[2], tops, "Top", moduleDepth, rng:fork("top" .. si), ignore, "WallTop")
			facadeDepth = math.max(facadeDepth, d)
		end
	end

	if facadeDepth <= 0 then
		return false
	end
	ctx.Facades[wall] = {
		Depth = facadeDepth,
		ModuleDepth = moduleDepth,
		U0 = u0,
		U1 = u1,
		Bays = bays,
	}

	-- 6) Détails dans les travées : rythme régulier (toutes les travées, une sur
	--    deux ou une sur trois selon WallDensity), motif symétrique, un ou deux
	--    assets cohérents pour toute la façade.
	local detailPalette = ctx.Selector:palette(wall, { "Relief", "Wall" }, rng:fork("details"))
	if #detailPalette > 0 and S.WallDensity > 0.05 and #bays > 0 then
		local detailRng = rng:fork("detailPick")
		local period = if S.WallDensity >= 0.66 then 1 elseif S.WallDensity >= 0.33 then 2 else 3
		local phase = if period > 1 then detailRng:int(0, period - 1) else 0
		local minBayWidth = math.huge
		for _, bay in ipairs(bays) do
			minBayWidth = math.min(minBayWidth, bay.U1 - bay.U0)
		end
		local function pickDetail(exclude)
			return ctx.Selector:pick(detailPalette, {
				Role = "Relief",
				Rng = detailRng,
				Surface = wall,
				Exclude = exclude,
				Filter = function(a)
					local size = canonSize(a, 1)
					return size.X <= minBayWidth * 0.7 and size.Y <= height * 0.6
				end,
			})
		end
		local primary = pickDetail(nil)
		local secondary = nil
		if primary and S.Variation >= 0.5 then
			secondary = pickDetail({ [primary] = true })
		end
		for _, bay in ipairs(bays) do
			if not bay.Arch and primary then
				local pattern = math.min(bay.Index, bay.Count + 1 - bay.Index)
				if (pattern - 1 + phase) % period == 0 then
					local asset = if secondary and pattern % 2 == 0 then secondary else primary
					if ctx:assetAvailable(asset) then
						local scale = PlacementMath.resolveScale(asset, S, rng:fork("detailScale" .. pattern))
						WallPlacementEngine.placeAt(ctx, wall, asset, scale, bay.Center, wall.VMin + height * ARCH.DETAIL_HEIGHT, "Center", {
							Layer = ARCH.LAYER_DETAIL,
							Folder = "Architecture",
							PlacementType = "Detail",
							Pass = "Details",
						})
					end
				end
			end
		end
	end

	-- 7) Masquage réversible du mur d'origine (Rebuild + option explicite).
	local wallArea = (wall.UMax - wall.UMin) * height
	if opts.Treatment == "Rebuild" and S.HideOriginalWalls and wallArea > 0 then
		if coveredArea / wallArea >= 0.85 then
			ctx.HiddenWalls = ctx.HiddenWalls or {}
			if not table.find(ctx.HiddenWalls, wall.Part) then
				table.insert(ctx.HiddenWalls, wall.Part)
			end
		else
			ctx.Diagnostics:warn(string.format("Wall %s kept visible: the generated facade covers only %d%% of it.", wall.Id, math.floor(coveredArea / wallArea * 100)))
		end
	end
	return true
end


return ArchitectureEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">AssetSelector</string>
          <string name="Source"><![CDATA[--[[
	AssetSelector
	Choix des assets, pensé comme un level designer :
	  - palette par surface : on n'utilise qu'une partie cohérente de la
	    bibliothèque sur une même zone (fraction pilotée par Variation), en
	    conservant au moins un asset par classe de taille disponible ;
	  - tirage pondéré : Weight × score de rôle × fréquence de la classe de
	    taille × pénalité de répétition récente ;
	  - respect de UniqueAsset / RepeatLimit ;
	  - filtre de taille : un asset plus grand que l'espace disponible n'est
	    jamais proposé (surface minuscule, asset gigantesque).
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local Utilities = require(Core.Utilities)

local AssetSelector = {}
AssetSelector.__index = AssetSelector

local COMP = Config.Composition

function AssetSelector.new(ctx)
	local self = setmetatable({}, AssetSelector)
	self.Ctx = ctx
	self._palettes = {}
	return self
end

function AssetSelector:sizeFrequency(sizeClass)
	local s = self.Ctx.Settings
	if sizeClass == "Small" then
		return s.SmallAssetFrequency
	elseif sizeClass == "Medium" then
		return s.MediumAssetFrequency
	elseif sizeClass == "Large" then
		return s.LargeAssetFrequency
	elseif sizeClass == "Hero" then
		return s.LargeAssetFrequency * 0.8
	end
	return 1
end

--[[
	Palette d'une surface pour un rôle (mise en cache, déterministe).
	roles : un rôle ou une liste de rôles (union).
]]
function AssetSelector:palette(surface, roles, rng)
	if type(roles) == "string" then
		roles = { roles }
	end
	local cacheKey = (surface and surface.Id or "global") .. ":" .. table.concat(roles, "+")
	local cached = self._palettes[cacheKey]
	if cached then
		return cached
	end
	local registry = self.Ctx.Registry
	local seen = {}
	local all = {}
	for _, role in ipairs(roles) do
		for _, a in ipairs(registry:getByRole(role)) do
			if not seen[a] then
				seen[a] = true
				table.insert(all, a)
			end
		end
	end
	table.sort(all, function(a, b)
		return a.Order < b.Order
	end)
	local n = #all
	if n == 0 then
		self._palettes[cacheKey] = all
		return all
	end
	local variation = self.Ctx.Settings.Variation
	local fraction = Utilities.lerp(COMP.PALETTE_MIN_FRACTION, 1, variation)
	local target = math.max(math.min(COMP.PALETTE_MIN_COUNT, n), math.ceil(n * fraction))
	if target >= n then
		self._palettes[cacheKey] = all
		return all
	end
	-- Un représentant par classe de taille, puis complément pondéré.
	local chosen = {}
	local chosenSet = {}
	local function weightOf(a)
		local best = 0
		for _, role in ipairs(roles) do
			best = math.max(best, a.RoleScores[role] or 0)
		end
		return math.max(1e-3, a.Meta.Weight * best)
	end
	for _, sizeClass in ipairs(Config.Assets.SIZE_CLASS_ORDER) do
		local group, weights = {}, {}
		for _, a in ipairs(all) do
			if a.SizeClass == sizeClass then
				table.insert(group, a)
				table.insert(weights, weightOf(a))
			end
		end
		if #group > 0 and #chosen < target then
			local i = rng:weightedIndex(weights)
			if i then
				table.insert(chosen, group[i])
				chosenSet[group[i]] = true
			end
		end
	end
	while #chosen < target do
		local pool, weights = {}, {}
		for _, a in ipairs(all) do
			if not chosenSet[a] then
				table.insert(pool, a)
				table.insert(weights, weightOf(a))
			end
		end
		local i = rng:weightedIndex(weights)
		if not i then
			break
		end
		table.insert(chosen, pool[i])
		chosenSet[pool[i]] = true
	end
	table.sort(chosen, function(a, b)
		return a.Order < b.Order
	end)
	self._palettes[cacheKey] = chosen
	return chosen
end

--[[
	Tirage d'un asset dans une liste.
	opts = {
	  Role, SizeClasses = {Small = true, ...}?, Surface, Rng,
	  MaxRadius, MaxWidth, MaxHeight, MaxDepth, Filter = function(asset) -> bool,
	  IgnoreFrequency : bool, Exclude = {[asset] = true}
	}
]]
function AssetSelector:pick(list, opts)
	local ctx = self.Ctx
	local rng = opts.Rng
	local variation = ctx.Settings.Variation
	local gamma = Utilities.lerp(1.3, 0.6, variation)
	local recent = if opts.Surface then ctx:surfaceState(opts.Surface).Recent else {}
	local last = recent[#recent]
	local candidates, weights = {}, {}
	for _, a in ipairs(list) do
		local ok = ctx:assetAvailable(a)
		if ok and opts.Exclude and opts.Exclude[a] then
			ok = false
		end
		if ok and opts.SizeClasses and not opts.SizeClasses[a.SizeClass] then
			ok = false
		end
		local minScale = a.Meta.MinScale or 1
		if not a.Meta.AllowScale then
			minScale = 1
		end
		minScale = math.min(minScale, 1)
		if ok and opts.MaxRadius and a.FootprintRadius * minScale > opts.MaxRadius then
			ok = false
		end
		if ok and opts.MaxWidth and math.min(a.Size.X, a.Size.Z) * minScale > opts.MaxWidth then
			ok = false
		end
		if ok and opts.MaxHeight and a.Size.Y * minScale > opts.MaxHeight then
			ok = false
		end
		if ok and opts.Filter and not opts.Filter(a) then
			ok = false
		end
		if ok then
			local roleScore = if opts.Role then (a.RoleScores[opts.Role] or 0) else 1
			local w = (math.max(a.Meta.Weight, 1e-3) ^ gamma) * (roleScore ^ 1.5)
			if not opts.IgnoreFrequency then
				w *= self:sizeFrequency(a.SizeClass)
			end
			if a == last then
				w *= COMP.REPEAT_LAST_FACTOR
			elseif table.find(recent, a) then
				w *= COMP.REPEAT_RECENT_FACTOR
			end
			if w > 0 then
				table.insert(candidates, a)
				table.insert(weights, w)
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	local i = rng:weightedIndex(weights)
	return if i then candidates[i] else nil
end

return AssetSelector
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">CandidateScoring</string>
          <string name="Source"><![CDATA[--[[
	CandidateScoring
	Plutôt que de choisir une position au hasard, chaque placement génère
	plusieurs candidats valides puis leur attribue un score composite :

	  + cohésion de groupe (distance idéale aux membres du même groupe)
	  - encombrement (trop proche d'éléments non groupés)
	  - deux grands éléments trop proches (hiérarchie visuelle)
	  - répétition du même asset à proximité
	  ± affinité aux bords / aux murs (selon la passe et l'algorithme)
	  - proximité de l'axe central (préservation du centre, couloirs)
	  + équilibre gauche/droite de la masse visuelle (modulé par Symmetry)
	  + rythme visuel le long de la grande dimension
	  - zones "respirantes" du champ de bruit (EmptySpaceRatio)
	  + points de composition (tiers) pour les éléments héros
	  + bruit (Randomness)

	Le moteur choisit ensuite parmi les meilleurs candidats (pas toujours le
	premier, pour éviter un résultat mécanique).
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local RandomGenerator = require(Core.RandomGenerator)

local CandidateScoring = {}

local SC = Config.Scoring
local W = SC.Weights
local COMP = Config.Composition

local LARGE = { Large = true, Hero = true }

local function clamp01(x)
	return math.clamp(x, 0, 1)
end

--[[
	env = {
	  State, Domain, Asset, Radius, Profile, ClusterId, Rng, Settings, NoiseSeed
	}
	Profile = {
	  EdgeAffinity (-1..1), WallAffinity (0..1), Thirds (0..1),
	  ClusterCenter (Vector2?), ClusterRadius, CenterAvoid (0..1),
	  RhythmWeight (0..1), EmptyWeight (0..1), BalanceWeight (0..1),
	  AvoidClusters (bool)
	}
	Renvoie le score (plus grand = meilleur).
]]
function CandidateScoring.floor(env, pos)
	local settings = env.Settings
	local profile = env.Profile
	local domain = env.Domain
	local asset = env.Asset
	local r = env.Radius
	local score = 0

	-- Voisinage.
	local searchRadius = r * SC.NEIGHBOR_RADIUS_FACTOR + 2 * settings.SpacingScale
	local neighbors = env.State.Index:query(pos, searchRadius)
	local isLarge = LARGE[asset.SizeClass] == true
	local crowd, cohesion, largePenalty, repeatPenalty = 0, 0, 0, 0
	local cohesionCount = 0
	for _, n in ipairs(neighbors) do
		local d = (n.Pos - pos).Magnitude - n.Radius - r
		if env.ClusterId and n.ClusterId == env.ClusterId then
			local ideal = r * SC.CLUSTER_GAP_FACTOR * (1.5 - settings.ClusterStrength) + settings.MinimumSpacing
			local dev = math.abs(d - ideal) / math.max(r * 2, 0.5)
			cohesion += math.exp(-dev * dev * 2)
			cohesionCount += 1
		else
			local desired = (r + n.Radius) * SC.DESIRED_GAP_FACTOR * settings.SpacingScale + settings.MinimumSpacing
			if d < desired then
				crowd += (1 - clamp01(d / desired)) ^ 2
			end
		end
		if isLarge and LARGE[n.SizeClass] then
			local need = (r + n.Radius) * SC.LARGE_SEPARATION_FACTOR * settings.SpacingScale
			if d < need then
				largePenalty += 1 - clamp01(d / need)
			end
		end
		if n.Asset == asset then
			local repeatRadius = r * SC.REPEAT_RADIUS_FACTOR
			if d < repeatRadius then
				repeatPenalty += 1 - clamp01(d / repeatRadius)
			end
		end
	end
	score -= W.Crowding * math.min(crowd, 3)
	if cohesionCount > 0 then
		score += W.ClusterCohesion * (cohesion / cohesionCount)
	end
	score -= W.LargeSeparation * math.min(largePenalty, 2)
	score -= W.Repetition * math.min(repeatPenalty, 2) * (1.2 - settings.Variation)

	-- Distance au centre du groupe visé.
	if profile.ClusterCenter and profile.ClusterRadius then
		local d = (pos - profile.ClusterCenter).Magnitude
		score -= W.ClusterCohesion * clamp01(d / math.max(profile.ClusterRadius * 2, 1)) * 0.5
	end

	-- Bords et murs.
	if profile.EdgeAffinity and profile.EdgeAffinity ~= 0 and domain.edgeDistance then
		local dEdge = domain:edgeDistance(pos)
		local closeness = 1 - clamp01(dEdge / math.max(domain.EdgeDepth, 0.5))
		score += W.Edge * profile.EdgeAffinity * (closeness * 2 - 1)
	end
	if profile.WallAffinity and profile.WallAffinity > 0 and domain.wallDistance then
		local dWall = domain:wallDistance(pos)
		if dWall < math.huge then
			score += W.Wall * profile.WallAffinity * (1 - clamp01(dWall / math.max(domain.EdgeDepth * 2, 1)))
		end
	end

	-- Préservation douce du centre.
	if profile.CenterAvoid and profile.CenterAvoid > 0 and domain.crossNormalized then
		local c = math.abs(domain:crossNormalized(pos))
		score -= W.Center * profile.CenterAvoid * (1 - c) ^ 2
	end

	-- Équilibre gauche/droite.
	if profile.BalanceWeight and profile.BalanceWeight > 0 and domain.crossNormalized then
		local side = domain:crossNormalized(pos)
		local mp, mn = env.State.MassPositive, env.State.MassNegative
		local total = mp + mn
		if total > 0 then
			local imbalance = (mp - mn) / total
			-- Côté le plus léger favorisé.
			local prefer = if side >= 0 then -imbalance else imbalance
			score += W.Balance * profile.BalanceWeight * prefer
		end
	end

	-- Rythme le long de la grande dimension.
	if profile.RhythmWeight and profile.RhythmWeight > 0 and domain.rhythm then
		score += W.Rhythm * profile.RhythmWeight * settings.VisualRhythm * (domain:rhythm(pos) * 2 - 1)
	end

	-- Champ de densité : zones respirantes cohérentes.
	if profile.EmptyWeight and profile.EmptyWeight > 0 and settings.EmptySpaceRatio > 0 then
		local scale = math.max(COMP.NOISE_SCALE * settings.SpacingScale, domain.NoiseScale or 0)
		local n = RandomGenerator.fractalNoise2D(env.NoiseSeed, pos.X / scale, pos.Y / scale)
		local threshold = settings.EmptySpaceRatio
		if n < threshold then
			score -= W.Empty * profile.EmptyWeight * (1 - n / math.max(threshold, 1e-3))
		else
			score += W.Empty * profile.EmptyWeight * 0.25 * ((n - threshold) / math.max(1 - threshold, 1e-3))
		end
	end

	-- Points de composition (règle des tiers).
	if profile.Thirds and profile.Thirds > 0 and domain.Thirds then
		local best = math.huge
		for _, p in ipairs(domain.Thirds) do
			best = math.min(best, (p - pos).Magnitude)
		end
		local ref = math.max(domain.MinExtent * 0.25, 1)
		score += W.Thirds * profile.Thirds * (1 - clamp01(best / ref))
	end

	-- Éloignement des autres groupes (centres de groupes).
	if profile.AvoidClusters then
		local minD = math.huge
		for _, c in ipairs(env.State.Clusters) do
			minD = math.min(minD, (c.Center - pos).Magnitude - c.Radius)
		end
		if minD < math.huge then
			local breathing = (profile.ClusterRadius or r * 3) * COMP.CLUSTER_BREATHING * (0.6 + settings.EmptySpaceRatio)
			score -= W.ClusterSeparation * (1 - clamp01(minD / math.max(breathing, 1)))
		end
	end

	-- Bruit.
	score += W.Noise * settings.Randomness * (env.Rng:next() - 0.5) * 2

	return score
end

--[[
	Choisit l'ordre de test des candidats triés par score :
	le premier est tiré parmi les N meilleurs (N dépend de Randomness),
	les suivants restent dans l'ordre du score.
]]
function CandidateScoring.orderCandidates(scored, settings, rng)
	table.sort(scored, function(a, b)
		if a.Score ~= b.Score then
			return a.Score > b.Score
		end
		return a.Index < b.Index
	end)
	local topN = math.clamp(math.floor(COMP.MIN_TOP_CHOICES + (COMP.MAX_TOP_CHOICES - COMP.MIN_TOP_CHOICES) * settings.Randomness + 0.5), 1, math.max(1, #scored))
	if topN > 1 then
		local weights = {}
		for i = 1, topN do
			weights[i] = 1 / i
		end
		local pick = rng:weightedIndex(weights) or 1
		if pick ~= 1 then
			local chosen = table.remove(scored, pick)
			table.insert(scored, 1, chosen)
		end
	end
	return scored
end

return CandidateScoring
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">CeilingPlacementEngine</string>
          <string name="Source"><![CDATA[--[[
	CeilingPlacementEngine
	Éléments suspendus : lampes, câbles, chaînes, stalactites, tuyaux...

	La normale d'un plafond pointe vers le bas : la direction de pose est
	inversée automatiquement. L'asset reste "debout" (son haut vers le
	plafond) et sa face supérieure touche le plafond à SURFACE_EPSILON près ;
	CeilingFlip = true retourne l'asset (sa base contre le plafond).

	Répartition : rangées parallèles à la grande dimension, séquences
	rythmiques le long de chaque rangée, symétrie optionnelle. La hauteur de
	chute est limitée par la hauteur de la pièce.
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local MathUtil = require(Core.MathUtil)
local PlacementMath = require(script.Parent.PlacementMath)
local CompositionPlanner = require(script.Parent.CompositionPlanner)

local CeilingPlacementEngine = {}

local COMP = Config.Composition
local ARCH = Config.Architecture
local TOL = Config.Precision.CONTACT_TOLERANCE

-- Hauteur libre sous le plafond (distance au sol le plus haut situé dessous).
local function roomHeight(ctx, ceiling)
	local best = math.huge
	local c = ceiling.Frame.Position
	for _, f in ipairs(ctx.Analysis.Floors) do
		local l = f.Frame:PointToObjectSpace(c)
		if l.X >= f.UMin and l.X <= f.UMax and l.Z >= f.VMin and l.Z <= f.VMax and l.Y > 0 then
			best = math.min(best, l.Y)
		end
	end
	return best
end

function CeilingPlacementEngine.run(ctx, ceiling)
	local S = ctx.Settings
	if not S.CeilingDecoration or S.CeilingDensity <= 0.01 then
		return
	end
	local rng = ctx.Rng:fork("ceiling:" .. ceiling.Id)
	local palette = ctx.Selector:palette(ceiling, { "Ceiling" }, rng:fork("palette"))
	if #palette == 0 then
		return
	end
	local eps = ctx.Epsilon
	local room = roomHeight(ctx, ceiling)
	local maxDrop = if room < math.huge then room * COMP.CEILING_MAX_DROP_RATIO else math.huge
	local margin = S.EdgeMargin
	local u0, u1 = ceiling.UMin + margin, ceiling.UMax - margin
	local v0, v1 = ceiling.VMin + margin, ceiling.VMax - margin
	if u1 - u0 < 1 or v1 - v0 < 1 then
		return
	end
	local fitting = {}
	for _, a in ipairs(palette) do
		if a.Size.Y <= maxDrop and a.Size.X <= u1 - u0 and a.Size.Z <= v1 - v0 then
			table.insert(fitting, a)
		else
			ctx.Diagnostics:add("TooLarge")
		end
	end
	if #fitting == 0 then
		return
	end
	local radii = {}
	for _, a in ipairs(fitting) do
		table.insert(radii, a.FootprintRadius)
	end
	table.sort(radii)
	local typical = radii[math.ceil(#radii / 2)]
	local spacing = typical * 2 * S.SpacingScale / math.max(S.CeilingDensity, 0.1)
	local rowCount = math.max(1, math.floor((v1 - v0) / math.max(spacing, 1) + 0.5))
	local rowCount2 = math.min(rowCount, 8)
	for r = 1, rowCount2 do
		local v = v0 + (v1 - v0) * (r - 0.5) / rowCount2
		local rowRng = rng:fork("row" .. math.min(r, rowCount2 + 1 - r))
		local beats = CompositionPlanner.beats(u1 - u0, rowRng, S, {
			BaseSpacing = typical * 2,
			Density = S.CeilingDensity,
			Symmetric = S.Symmetry >= 0.5,
			EndMargin = typical,
		})
		for _, beat in ipairs(beats) do
			if ctx:remaining() <= 0 then
				return
			end
			if beat.Kind ~= "Gap" then
				local asset = ctx.Selector:pick(fitting, { Role = "Ceiling", Rng = rowRng, Surface = ceiling })
				if asset then
					local scale = PlacementMath.resolveScale(asset, S, rowRng)
					local yaw = 0
					if asset.Meta.AllowRotation then
						if S.RotationMode == "Random360" then
							yaw = rowRng:range(0, math.pi * 2)
						elseif S.RotationMode == "Random90" then
							yaw = rowRng:int(0, 3) * math.pi * 0.5
						elseif S.RotationMode == "Random180" then
							yaw = rowRng:int(0, 1) * math.pi
						end
					end
					local u = u0 + beat.T
					local pose = PlacementMath.ceilingPose(asset, scale, ceiling, u, v, {
						Yaw = yaw,
						Flip = asset.Meta.CeilingFlip,
						Depth = ARCH.LAYER_MODULE * eps + S.SurfaceOffset,
					})
					local poly, _, hMax = PlacementMath.footprint(pose, ceiling)
					local inside = MathUtil.polygonInsideRect(poly, u0, v0, u1, v1, TOL)
					if not inside or hMax > maxDrop then
						ctx.Diagnostics:reject("bounds", pose.BoxCFrame.Position)
					elseif ctx.Zones:blocks(ceiling, poly) then
						ctx.Diagnostics:reject("exclusion", pose.BoxCFrame.Position)
					else
						ctx:tryCommit(pose, {
							Surface = ceiling,
							Role = "Ceiling",
							Folder = "Ceiling",
							PlacementType = "Ceiling",
							Group = "Decor",
							Layer = ARCH.LAYER_MODULE,
							IgnoreParts = { [ceiling.Part] = true },
							Pos2D = Vector2.new(u, v),
							Radius = asset.FootprintRadius * scale,
							Pass = "Ceiling",
						})
					end
				end
			end
		end
		ctx.Yield()
	end
end

return CeilingPlacementEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">CollisionEngine</string>
          <string name="Source"><![CDATA[--[[
	CollisionEngine
	Détection de collision performante entre la génération en cours, la
	géométrie cible et la géométrie protégée.

	  - Hash spatial 3D (grille uniforme) : une requête ne teste que les objets
	    des cellules touchées, jamais tous les objets de la scène.
	  - Phase large : OBB complète de l'asset (test SAT 15 axes).
	  - Phase fine (optionnelle) : sous-boîtes par part (ou grille d'occupation
	    pour les assets de centaines de parts) -> deux arbres peuvent entremêler
	    leurs feuillages sans que leurs parts se traversent.
	  - Contact exact autorisé (tolérance), espacement minimal optionnel.
	  - Géométrie de la scène : workspace:GetPartBoundsInBox + OverlapParams,
	    appelé seulement si les tests internes passent.
	  - Lancer de rayon sur la géométrie planifiée (pas encore instanciée),
	    utilisé pour poser des détails sur une façade générée.
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local MathUtil = require(Core.MathUtil)
local PlacementMath = require(script.Parent.PlacementMath)

local CollisionEngine = {}
CollisionEngine.__index = CollisionEngine

local C = Config.Collision
local OFFSET = 65536
local KY = 131072
local KZ = 131072 * 131072

--[[
	opts = {
	  CellSize, Enabled, Precise, MinimumSpacing, Tolerance,
	  SceneQuery : bool, OverlapParams : OverlapParams?, World : WorldRoot?,
	}
]]
function CollisionEngine.new(opts)
	local self = setmetatable({}, CollisionEngine)
	self.CellSize = math.clamp(opts.CellSize or 8, C.MIN_CELL_SIZE, C.MAX_CELL_SIZE)
	self.Enabled = opts.Enabled ~= false
	self.Precise = opts.Precise ~= false
	self.MinimumSpacing = opts.MinimumSpacing or 0
	self.Tolerance = opts.Tolerance or Config.Precision.CONTACT_TOLERANCE
	self.SceneQuery = opts.SceneQuery == true
	self.OverlapParams = opts.OverlapParams
	self.World = opts.World
	self._cells = {}
	self._records = {}
	self._stamp = 0
	self.Stats = { Tests = 0, Overlaps = 0, SceneHits = 0, ProtectedHits = 0 }
	return self
end

function CollisionEngine:_cellRange(lo, hi)
	local s = self.CellSize
	return math.floor(lo.X / s), math.floor(lo.Y / s), math.floor(lo.Z / s),
		math.floor(hi.X / s), math.floor(hi.Y / s), math.floor(hi.Z / s)
end

local function key(x, y, z)
	return (x + OFFSET) + (y + OFFSET) * KY + (z + OFFSET) * KZ
end

function CollisionEngine:_insert(record)
	local lo, hi = MathUtil.obbAABB(record.BoxCFrame, record.BoxSize)
	record.AABBMin, record.AABBMax = lo, hi
	local x0, y0, z0, x1, y1, z1 = self:_cellRange(lo, hi)
	local count = (x1 - x0 + 1) * (y1 - y0 + 1) * (z1 - z0 + 1)
	if count > C.MAX_QUERY_CELLS then
		-- Objet gigantesque : stocké dans une liste globale testée à chaque requête.
		self._large = self._large or {}
		table.insert(self._large, record)
	else
		for z = z0, z1 do
			for y = y0, y1 do
				for x = x0, x1 do
					local k = key(x, y, z)
					local cell = self._cells[k]
					if not cell then
						cell = {}
						self._cells[k] = cell
					end
					cell[#cell + 1] = record
				end
			end
		end
	end
	table.insert(self._records, record)
	return record
end

-- Ajoute un objet planifié. record = { BoxCFrame, BoxSize, Pose?, Group, CanOverlap, MinSpacing, Id }
function CollisionEngine:addPlaced(record)
	record.Kind = "Placed"
	return self:_insert(record)
end

-- Ajoute une Part protégée (cible, géométrie protégée).
function CollisionEngine:addProtectedPart(part)
	return self:_insert({
		Kind = "Protected",
		Part = part,
		BoxCFrame = part.CFrame,
		BoxSize = part.Size,
	})
end

function CollisionEngine:_gather(lo, hi)
	self._stamp += 1
	local stamp = self._stamp
	local out = {}
	local x0, y0, z0, x1, y1, z1 = self:_cellRange(lo, hi)
	local count = (x1 - x0 + 1) * (y1 - y0 + 1) * (z1 - z0 + 1)
	if count > C.MAX_QUERY_CELLS then
		for _, r in ipairs(self._records) do
			out[#out + 1] = r
		end
		return out
	end
	for z = z0, z1 do
		for y = y0, y1 do
			for x = x0, x1 do
				local cell = self._cells[key(x, y, z)]
				if cell then
					for _, r in ipairs(cell) do
						if r._stamp ~= stamp then
							r._stamp = stamp
							out[#out + 1] = r
						end
					end
				end
			end
		end
	end
	if self._large then
		for _, r in ipairs(self._large) do
			if r._stamp ~= stamp then
				r._stamp = stamp
				out[#out + 1] = r
			end
		end
	end
	return out
end

local function aabbOverlap(aLo, aHi, bLo, bHi, margin)
	return aLo.X - margin <= bHi.X and aHi.X + margin >= bLo.X
		and aLo.Y - margin <= bHi.Y and aHi.Y + margin >= bLo.Y
		and aLo.Z - margin <= bHi.Z and aHi.Z + margin >= bLo.Z
end

function CollisionEngine:_subBoxesCollide(shapeBoxes, otherBoxes, gap)
	local tol = self.Tolerance
	for _, a in ipairs(shapeBoxes) do
		for _, b in ipairs(otherBoxes) do
			if MathUtil.obbIntersects(a.CFrame, a.Size, b.CFrame, b.Size, tol, gap) then
				return true
			end
		end
	end
	return false
end

local function boxesOf(entry)
	if entry.Pose then
		return PlacementMath.worldSubBoxes(entry.Pose)
	end
	return { { CFrame = entry.BoxCFrame, Size = entry.BoxSize } }
end

--[[
	Teste une forme candidate.
	shape = {
	  BoxCFrame, BoxSize, Pose?, Group ("Decor" | "Architecture"),
	  CanOverlap, MinSpacing, IgnoreParts = {[BasePart] = true},
	  AllowArchitectureOverlap : bool,
	}
	Renvoie (collision : bool, raison : string?, autre : record?)
]]
function CollisionEngine:test(shape)
	self.Stats.Tests += 1
	if not self.Enabled then
		return false
	end
	local tol = self.Tolerance
	local spacing = math.max(self.MinimumSpacing, shape.MinSpacing or 0)
	local lo, hi = MathUtil.obbAABB(shape.BoxCFrame, shape.BoxSize)
	shape.AABBMin, shape.AABBMax = lo, hi
	local margin = spacing + tol
	local candidates = self:_gather(lo - Vector3.new(margin, margin, margin), hi + Vector3.new(margin, margin, margin))
	local ignore = shape.IgnoreParts
	local shapeBoxes = nil
	local isDecor = shape.Group ~= "Architecture"

	for _, r in ipairs(candidates) do
		local skip = false
		local gap = 0
		if r.Kind == "Protected" then
			if ignore and ignore[r.Part] then
				skip = true
			end
		else
			local otherDecor = r.Group ~= "Architecture"
			if not isDecor and not otherDecor and shape.AllowArchitectureOverlap then
				skip = true
			elseif isDecor and otherDecor and (shape.CanOverlap or r.CanOverlap) then
				skip = true
			elseif isDecor and otherDecor then
				gap = math.max(spacing, r.MinSpacing or 0)
			end
		end
		if not skip and aabbOverlap(lo, hi, r.AABBMin, r.AABBMax, gap - tol) then
			if MathUtil.obbIntersects(shape.BoxCFrame, shape.BoxSize, r.BoxCFrame, r.BoxSize, tol, gap) then
				local collide = true
				if self.Precise then
					shapeBoxes = shapeBoxes or boxesOf(shape)
					local otherBoxes = boxesOf(r)
					if #shapeBoxes > 1 or #otherBoxes > 1 then
						collide = self:_subBoxesCollide(shapeBoxes, otherBoxes, gap)
					end
				end
				if collide then
					self.Stats.Overlaps += 1
					if r.Kind == "Protected" then
						self.Stats.ProtectedHits += 1
						return true, "protected", r
					end
					return true, "overlap", r
				end
			end
		end
	end

	if self.SceneQuery and self.World and self.OverlapParams then
		if self:sceneCollides(shape) then
			self.Stats.SceneHits += 1
			return true, "scene", nil
		end
	end
	return false
end

-- Requête sur la géométrie existante de la scène (hors cibles, hors génération courante).
function CollisionEngine:sceneCollides(shape)
	local tol = self.Tolerance
	local boxes
	if self.Precise then
		boxes = boxesOf(shape)
	else
		boxes = { { CFrame = shape.BoxCFrame, Size = shape.BoxSize } }
	end
	local ignore = shape.IgnoreParts
	for _, b in ipairs(boxes) do
		local size = b.Size - Vector3.new(tol, tol, tol) * 2
		if size.X > 0 and size.Y > 0 and size.Z > 0 then
			local ok, parts = pcall(self.World.GetPartBoundsInBox, self.World, b.CFrame, size, self.OverlapParams)
			if ok and parts then
				for _, p in ipairs(parts) do
					local relevant = true
					if ignore and ignore[p] then
						relevant = false
					elseif C.IGNORE_INVISIBLE_SCENE_PARTS and p.Transparency >= 0.999 and not p.CanCollide then
						relevant = false
					end
					if relevant then
						return true
					end
				end
			end
		end
	end
	return false
end

--[[
	Rayon contre la géométrie planifiée. filter(record) -> bool.
	Renvoie (distance, record) ou nil.
]]
function CollisionEngine:raycastPlanned(origin, direction, maxDistance, filter)
	local dir = MathUtil.safeUnit(direction, nil)
	if dir.Magnitude < 0.5 then
		return nil
	end
	local step = self.CellSize * C.RAY_STEP_FACTOR
	local best, bestRecord = math.huge, nil
	self._stamp += 1
	local stamp = self._stamp
	local t = 0
	local visited = {}
	while t <= maxDistance + step do
		local p = origin + dir * math.min(t, maxDistance)
		local s = self.CellSize
		local k = key(math.floor(p.X / s), math.floor(p.Y / s), math.floor(p.Z / s))
		if not visited[k] then
			visited[k] = true
			local cell = self._cells[k]
			if cell then
				for _, r in ipairs(cell) do
					if r._stamp ~= stamp then
						r._stamp = stamp
						if r.Kind == "Placed" and (not filter or filter(r)) then
							for _, b in ipairs(boxesOf(r)) do
								local d = MathUtil.rayOBB(origin, dir, b.CFrame, b.Size, maxDistance)
								if d and d < best then
									best, bestRecord = d, r
								end
							end
						end
					end
				end
			end
		end
		if best <= t then
			break
		end
		t += step
	end
	if self._large then
		for _, r in ipairs(self._large) do
			if r.Kind == "Placed" and (not filter or filter(r)) then
				for _, b in ipairs(boxesOf(r)) do
					local d = MathUtil.rayOBB(origin, dir, b.CFrame, b.Size, maxDistance)
					if d and d < best then
						best, bestRecord = d, r
					end
				end
			end
		end
	end
	if bestRecord then
		return best, bestRecord
	end
	return nil
end

function CollisionEngine:getRecords()
	return self._records
end

return CollisionEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">CompositionPlanner</string>
          <string name="Source"><![CDATA[--[[
	CompositionPlanner
	Outils de composition visuelle partagés par les moteurs :

	  - beats() : séquence rythmique 1D (bords de sol, murs, plafonds) du type
	      [gros élément][2 petits proches][respiration][moyen][petit groupe][vide]
	    au lieu de "asset - asset - asset" à distance constante. Un gros
	    élément n'est jamais suivi d'un autre gros élément, un vide jamais
	    d'un autre vide. La séquence est ensuite redistribuée pour occuper
	    exactement la longueur disponible (pas de grand trou en fin de mur),
	    et peut être rendue symétrique (palindrome).
	  - rhythm() : champ rythmique le long de la grande dimension.
	  - floorBudget() : nombre de points focaux, de groupes et couverture
	    visée, calculés à partir de l'aire et de la taille réelle des assets.
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local Utilities = require(Core.Utilities)

local CompositionPlanner = {}

local COMP = Config.Composition
local SC = Config.Scoring

--[[
	opts = {
	  BaseSpacing : espacement typique d'un beat (studs)
	  Density     : densité (0..1), défaut Settings.Density
	  Symmetric   : bool
	  Allowed     : { Large = bool, Medium = bool, SmallGroup = bool }
	  EndMargin   : marge aux extrémités
	}
]]
function CompositionPlanner.beats(length, rng, settings, opts)
	opts = opts or {}
	local beats = {}
	local endMargin = opts.EndMargin or 0
	local available = length - 2 * endMargin
	if available <= 0 then
		return beats
	end
	local density = opts.Density or settings.Density
	local spacing = math.max(0.5, (opts.BaseSpacing or 4) * settings.SpacingScale / Utilities.lerp(0.35, 1.6, density))
	local allowed = opts.Allowed or { Large = true, Medium = true, SmallGroup = true }
	local randomness = settings.Randomness
	local rhythmAmp = settings.VisualRhythm * 0.6
	local waves = Utilities.lerp(COMP.RHYTHM_MIN_WAVES, COMP.RHYTHM_MAX_WAVES, rng:next())
	local phase = rng:range(0, math.pi * 2)

	local symmetric = opts.Symmetric
	local runLength = if symmetric then available * 0.5 else available

	local t = 0
	local previous = "Gap"
	local sequence = {}
	local guard = 0
	while t < runLength and guard < COMP.BEAT_MAX do
		guard += 1
		local pLarge = if allowed.Large and previous ~= "Large" then settings.LargeAssetFrequency else 0
		local pMedium = if allowed.Medium then settings.MediumAssetFrequency else 0
		local pSmall = if allowed.SmallGroup then settings.SmallAssetFrequency else 0
		local pGap = if previous == "Gap" then 0 else settings.EmptySpaceRatio * 1.5
		if previous == "Large" then
			pGap *= 2
		end
		local weights = { pLarge, pMedium, pSmall, pGap }
		local index = rng:weightedIndex(weights)
		if not index then
			index = 4
			if previous == "Gap" then
				break
			end
		end
		local kind = ({ "Large", "Medium", "SmallGroup", "Gap" })[index]
		local width
		if kind == "Large" then
			width = spacing * 1.6
		elseif kind == "Medium" then
			width = spacing
		elseif kind == "SmallGroup" then
			width = spacing * 0.9
		else
			width = spacing * Utilities.lerp(0.6, 2.0, rng:next()) * (0.5 + settings.EmptySpaceRatio)
		end
		local rhythm = 1 + rhythmAmp * math.sin(phase + 2 * math.pi * waves * (t / math.max(runLength, 1e-3)))
		width *= rhythm * (1 + (rng:next() - 0.5) * 0.7 * randomness)
		width = math.max(width, 0.25)
		table.insert(sequence, { Kind = kind, Width = width })
		t += width
		previous = kind
	end
	if #sequence == 0 then
		return beats
	end
	-- Redistribution exacte sur la longueur disponible (ou la demi-longueur).
	local total = 0
	for _, b in ipairs(sequence) do
		total += b.Width
	end
	local k = runLength / total
	local cursor = endMargin
	for _, b in ipairs(sequence) do
		local w = b.Width * k
		table.insert(beats, { T = cursor + w * 0.5, Kind = b.Kind, Width = w })
		cursor += w
	end
	if symmetric then
		local mirrored = {}
		for i = #beats, 1, -1 do
			local b = beats[i]
			table.insert(mirrored, { T = length - b.T, Kind = b.Kind, Width = b.Width, Mirror = true })
		end
		for _, b in ipairs(mirrored) do
			table.insert(beats, b)
		end
	end
	return beats
end

-- Champ rythmique dans [0, 1] le long d'un axe.
function CompositionPlanner.rhythmField(rng)
	local waves = Utilities.lerp(COMP.RHYTHM_MIN_WAVES, COMP.RHYTHM_MAX_WAVES, rng:next())
	local phase = rng:range(0, math.pi * 2)
	return function(t, length)
		return 0.5 + 0.5 * math.sin(phase + 2 * math.pi * waves * (t / math.max(length, 1e-3)))
	end
end

-- Rayon d'empreinte typique (médiane) d'une liste d'assets filtrée par classes de taille.
function CompositionPlanner.typicalRadius(assets, sizeClasses)
	local radii = {}
	for _, a in ipairs(assets) do
		if not sizeClasses or sizeClasses[a.SizeClass] then
			table.insert(radii, a.FootprintRadius)
		end
	end
	if #radii == 0 then
		return nil
	end
	table.sort(radii)
	return radii[math.ceil(#radii / 2)]
end

--[[
	Budget d'un sol.
	Renvoie { Heroes, Clusters, CoverageTarget, TypicalRadius, HeroRadius, SmallRadius }
]]
function CompositionPlanner.floorBudget(settings, area, palette, algorithm)
	local typical = CompositionPlanner.typicalRadius(palette, nil) or 2
	local heroR = CompositionPlanner.typicalRadius(palette, { Hero = true, Large = true })
	local smallR = CompositionPlanner.typicalRadius(palette, { Small = true }) or typical * 0.5
	local mediumR = CompositionPlanner.typicalRadius(palette, { Medium = true }) or typical

	local heroZone = ((heroR or typical) * SC.HERO_SPACING_RADII) ^ 2
	local clusterZone = (mediumR * SC.CLUSTER_SPACING_RADII) ^ 2 * settings.SpacingScale

	local density = settings.Density
	local heroes = 0
	if heroR and settings.LargeAssetFrequency > 0.05 then
		heroes = math.floor(area / heroZone * settings.LargeAssetFrequency * (0.5 + density) + 0.5)
		if heroes == 0 and area >= (heroR * 3) ^ 2 and settings.LargeAssetFrequency >= 0.25 then
			heroes = 1
		end
	end
	local clusters = math.floor(area / clusterZone * density * (0.4 + 0.6 * settings.ClusterStrength) * (1 - 0.5 * settings.EmptySpaceRatio) + 0.5)
	if algorithm == "HeroComposition" then
		heroes = math.max(if heroR then 1 else 0, math.floor(area / heroZone * 1.2 + 0.5))
		clusters = 0
	elseif algorithm == "Scatter" or algorithm == "Grid" or algorithm == "Border" then
		clusters = 0
	end
	-- Remplissage : un petit élément par cellule de dispersion (budget en nombre,
	-- pas en surface : des centaines de cailloux ne remplacent pas une composition).
	local scatterRadius = if algorithm == "Scatter" then typical else smallR
	local cell = math.max(COMP.SCATTER_CELL_MIN, scatterRadius * COMP.SCATTER_CELL_RADII) * settings.SpacingScale
	local fillers = math.floor(area / (cell * cell) * density * (1 - settings.EmptySpaceRatio) * settings.SmallAssetFrequency * 1.4 + 0.5)
	if algorithm == "HeroComposition" or algorithm == "Grid" or algorithm == "Border" then
		fillers = 0
	end
	-- Éléments de classe "Hero" : au plus un par grande zone (au moins un si la place le permet).
	local heroClassR = CompositionPlanner.typicalRadius(palette, { Hero = true })
	local heroClassCap = 0
	if heroClassR then
		heroClassCap = math.max(1, math.floor(area / ((heroClassR * SC.HERO_CLASS_ZONE_RADII) ^ 2) + 0.5))
		if algorithm == "HeroComposition" then
			heroClassCap = math.max(heroClassCap, heroes)
		end
	end
	-- Plafond de sécurité de couverture.
	local coverage = COMP.MAX_FLOOR_COVERAGE * (0.5 + density) * (1 - 0.3 * settings.EmptySpaceRatio)
	return {
		Heroes = heroes,
		Clusters = clusters,
		Fillers = fillers,
		HeroClassCap = heroClassCap,
		CoverageTarget = coverage,
		TypicalRadius = typical,
		HeroRadius = heroR or typical,
		MediumRadius = mediumR,
		SmallRadius = smallR,
	}
end

-- Nombre de membres d'un groupe.
function CompositionPlanner.clusterSize(settings, rng)
	local s = settings.ClusterStrength * (0.5 + 0.5 * settings.Density)
	local base = Utilities.lerp(COMP.MIN_CLUSTER_MEMBERS, COMP.MAX_CLUSTER_MEMBERS, s)
	return math.max(COMP.MIN_CLUSTER_MEMBERS, math.floor(base + rng:range(-1, 1) * settings.Randomness + 0.5))
end

return CompositionPlanner
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">CornerEngine</string>
          <string name="Source"><![CDATA[--[[
	CornerEngine
	Traitement des coins intérieurs détectés entre deux murs (GeometryAnalyzer).

	Un asset de coin (PlacementType = Corner, ou pilier / élément vertical en
	mode auto) est posé au sol dans l'angle et touche EXACTEMENT les deux murs :
	la position est obtenue en résolvant un système 2×2 sur les fonctions de
	support de sa boîte contre les deux plans (valable pour tout angle entre
	les murs, pas seulement 90°).

	Si les murs ont une façade générée, la pièce de coin appartient à
	l'architecture (elle recouvre le joint entre les deux façades) ; sinon elle
	est posée devant les murs comme une décoration.
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local MathUtil = require(Core.MathUtil)
local PlacementMath = require(script.Parent.PlacementMath)
local SnapEngine = require(script.Parent.SnapEngine)

local CornerEngine = {}

local ARCH = Config.Architecture

-- Rotation d'un asset dont l'avant (-Z) regarde `front` (horizontal).
local function rotationFacing(front)
	local look = MathUtil.safeUnit(Vector3.new(front.X, 0, front.Z), Vector3.new(0, 0, -1))
	local right = look:Cross(MathUtil.UP)
	return CFrame.fromMatrix(Vector3.new(), right, MathUtil.UP, -look)
end

--[[
	Position (horizontale) du point d'ancrage pour que la boîte touche les deux plans.
	offsets[i] = distance souhaitée entre le plan du mur i et la boîte.
]]
local function solveCornerPosition(corner, rotation, bmin, bmax, anchorLocal, offsetA, offsetB)
	local nA = Vector3.new(corner.NormalA.X, 0, corner.NormalA.Z)
	local nB = Vector3.new(corner.NormalB.X, 0, corner.NormalB.Z)
	if nA.Magnitude < 0.5 or nB.Magnitude < 0.5 then
		return nil
	end
	nA, nB = nA.Unit, nB.Unit
	-- Support : min des projections des coins de la boîte (relatifs à l'ancre) sur chaque normale.
	local sA, sB = math.huge, math.huge
	for _, x in ipairs({ bmin.X, bmax.X }) do
		for _, y in ipairs({ bmin.Y, bmax.Y }) do
			for _, z in ipairs({ bmin.Z, bmax.Z }) do
				local w = rotation:VectorToWorldSpace(Vector3.new(x, y, z) - anchorLocal)
				sA = math.min(sA, w:Dot(nA))
				sB = math.min(sB, w:Dot(nB))
			end
		end
	end
	local aA = offsetA - sA
	local aB = offsetB - sB
	-- [nA.x nA.z; nB.x nB.z] * [px; pz] = [aA; aB]
	local det = nA.X * nB.Z - nA.Z * nB.X
	if math.abs(det) < 1e-4 then
		return nil
	end
	local px = (aA * nB.Z - nA.Z * aB) / det
	local pz = (nA.X * aB - aA * nB.X) / det
	return corner.Position + Vector3.new(px, 0, pz)
end

function CornerEngine.run(ctx, corners)
	local S = ctx.Settings
	if not S.CornerDecoration then
		return
	end
	local palette = ctx.Registry:getByRole("Corner")
	if #palette == 0 then
		return
	end
	local eps = ctx.Epsilon
	local dev = if S.AllowModuleScaling then S.MaxModuleScaleDeviation else 0
	for index, corner in ipairs(corners) do
		if ctx:remaining() <= 0 then
			return
		end
		ctx.Diagnostics:corner(corner)
		local rng = ctx.Rng:fork("corner:" .. corner.WallA.Id .. ":" .. corner.WallB.Id .. ":" .. index)
		local facadeA = ctx.Facades[corner.WallA]
		local facadeB = ctx.Facades[corner.WallB]
		local architectural = facadeA ~= nil or facadeB ~= nil
		local lenA = corner.WallA.UMax - corner.WallA.UMin
		local lenB = corner.WallB.UMax - corner.WallB.UMin
		local maxFootprint = math.min(lenA, lenB) * 0.45
		local tried = {}
		for _ = 1, Config.Scoring.MAX_ASSET_RETRIES do
			local asset = ctx.Selector:pick(palette, {
				Role = "Corner",
				Rng = rng,
				IgnoreFrequency = true,
				Exclude = tried,
				Filter = function(a)
					return math.max(a.Size.X, a.Size.Z) <= maxFootprint
				end,
			})
			if not asset then
				break
			end
			tried[asset] = true
			local scale = PlacementMath.resolveScale(asset, S, rng)
			local count = 1
			-- En architecture, un pilier de coin couvre la hauteur du mur (empilé si besoin).
			local isPillar = (asset.RoleScores.Pillar or 0) >= Config.Assets.ROLE_SCORE_THRESHOLD
			local vconn = SnapEngine.verticalConnectors(asset, 1, 0)
			if architectural and isPillar and vconn.Height > 1e-3 then
				if vconn.Height >= corner.Height then
					local s = corner.Height / vconn.Height
					if asset.Meta.AllowScale and s >= (asset.Meta.MinScale or 1 - 2 * dev) then
						scale = s
					end
				else
					count = math.max(1, math.floor(corner.Height / vconn.Height + 0.5))
					local s = corner.Height / (count * vconn.Height)
					if math.abs(s - 1) <= dev and asset.Meta.AllowScale then
						scale = s
					else
						count = math.max(1, math.floor(corner.Height / vconn.Height))
						scale = 1
					end
				end
			end
			if asset.Size.Y * scale * count > corner.Height + Config.Precision.CONTACT_TOLERANCE and isPillar and architectural then
				continue
			end
			-- Orientation : alignée sur le mur A pour les piliers, sinon face à la bissectrice.
			local front = if isPillar then corner.NormalA else corner.Bisector
			local rotation = rotationFacing(front)
			local bmin, bmax = PlacementMath.localBounds(asset, scale, nil)
			local anchorLocal = Vector3.new((bmin.X + bmax.X) * 0.5, bmin.Y, (bmin.Z + bmax.Z) * 0.5)
			local offsetA, offsetB
			if architectural then
				offsetA = ARCH.LAYER_PILLAR * eps
				offsetB = ARCH.LAYER_PILLAR * eps
			else
				offsetA = eps + (if facadeA then facadeA.Depth else 0)
				offsetB = eps + (if facadeB then facadeB.Depth else 0)
			end
			local target = solveCornerPosition(corner, rotation, bmin, bmax, anchorLocal, offsetA, offsetB)
			if target then
				local ignore = { [corner.WallA.Part] = true, [corner.WallB.Part] = true }
				if corner.WallA.SupportFloor then
					ignore[corner.WallA.SupportFloor.Part] = true
				end
				if corner.WallB.SupportFloor then
					ignore[corner.WallB.SupportFloor.Part] = true
				end
				local placedAny = false
				local vconnScaled = SnapEngine.verticalConnectors(asset, scale, 0)
				for i = 0, count - 1 do
					local lift = i * vconnScaled.Height
					local pose = PlacementMath.freePose(asset, scale, rotation, anchorLocal, target + MathUtil.UP * lift, nil)
					local item = ctx:tryCommit(pose, {
						Surface = nil,
						Role = "Corner",
						Folder = "Corner",
						PlacementType = "Corner",
						Group = if architectural then "Architecture" else "Decor",
						AllowArchitectureOverlap = architectural,
						Layer = ARCH.LAYER_PILLAR,
						IgnoreParts = ignore,
						Pass = "Corner",
					})
					if item then
						placedAny = true
						ctx.Diagnostics:snap(target + MathUtil.UP * lift)
					elseif i == 0 then
						break
					end
				end
				if placedAny then
					break
				end
			end
		end
		ctx.Yield()
	end
end

CornerEngine._solve = solveCornerPosition

return CornerEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">ExclusionZones</string>
          <string name="Source"><![CDATA[--[[
	ExclusionZones
	Zones interdites projetées sur chaque surface :
	  - Parts sélectionnées comme zones d'exclusion ;
	  - Parts taguées "ProceduralPlacementExclude" (CollectionService) ;
	  - zone centrale protégée (Keep Center Clear) et chemin (Path Width) des sols.

	Une zone 3D est projetée sur le plan d'une surface si elle se trouve dans
	l'espace libre devant elle (profondeur de sonde configurable). On obtient un
	polygone convexe 2D : test de chevauchement par SAT, très rapide.
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local MathUtil = require(Core.MathUtil)

local ExclusionZones = {}
ExclusionZones.__index = ExclusionZones

local G = Config.Geometry

function ExclusionZones.new(zoneParts)
	local self = setmetatable({}, ExclusionZones)
	self.Parts = zoneParts or {}
	self._perSurface = {}
	return self
end

-- Projette toutes les zones sur une surface (résultat mis en cache).
function ExclusionZones:forSurface(surface)
	local cached = self._perSurface[surface]
	if cached then
		return cached
	end
	local list = {}
	local frame = surface.Frame
	local depth = G.EXCLUSION_PROBE_DEPTH
	local back = G.EXCLUSION_PROBE_BACK
	local regionCf = frame * CFrame.new((surface.UMin + surface.UMax) * 0.5, (depth - back) * 0.5, (surface.VMin + surface.VMax) * 0.5)
	local regionSize = Vector3.new(surface.SizeU + 2 * back, depth + back, surface.SizeV + 2 * back)
	for _, part in ipairs(self.Parts) do
		if part.Parent ~= nil and MathUtil.obbIntersects(regionCf, regionSize, part.CFrame, part.Size, 0, 0) then
			local poly, hMin, hMax = MathUtil.projectOBBToSurface(frame, part.CFrame, part.Size)
			if #poly >= 3 then
				table.insert(list, { Polygon = poly, Part = part, HMin = hMin, HMax = hMax, Kind = "Exclusion" })
			end
		end
	end
	self._perSurface[surface] = list
	return list
end

-- Ajoute une zone 2D spécifique à une surface (zone centrale, chemin...).
function ExclusionZones:addSurfaceZone(surface, polygon, kind)
	local list = self:forSurface(surface)
	table.insert(list, { Polygon = polygon, Kind = kind or "Custom", HMin = -math.huge, HMax = math.huge })
end

-- L'empreinte chevauche-t-elle une zone ? (hauteur optionnelle pour les murs)
function ExclusionZones:blocks(surface, footprint, hMin, hMax)
	for _, zone in ipairs(self:forSurface(surface)) do
		local verticalOverlap = true
		if hMin and hMax and zone.HMin and zone.HMax then
			-- Une zone entièrement "derrière" la surface ne bloque rien.
			verticalOverlap = zone.HMax > 0 or zone.HMax == math.huge
		end
		if verticalOverlap and MathUtil.polygonsIntersect(footprint, zone.Polygon, Config.Precision.CONTACT_TOLERANCE) then
			return true, zone
		end
	end
	return false
end

--[[
	Intervalles U bloqués pour une bande verticale [v0, v1] d'un mur :
	utilisé pour segmenter les murs modulaires autour des zones d'exclusion.
]]
function ExclusionZones:blockedIntervalsU(surface, v0, v1)
	local intervals = {}
	for _, zone in ipairs(self:forSurface(surface)) do
		local minU, minV, maxU, maxV = MathUtil.polygonBounds(zone.Polygon)
		if maxV > v0 and minV < v1 then
			table.insert(intervals, { minU, maxU })
		end
	end
	table.sort(intervals, function(a, b)
		return a[1] < b[1]
	end)
	-- Fusion des intervalles qui se chevauchent.
	local merged = {}
	for _, iv in ipairs(intervals) do
		local last = merged[#merged]
		if last and iv[1] <= last[2] then
			last[2] = math.max(last[2], iv[2])
		else
			table.insert(merged, { iv[1], iv[2] })
		end
	end
	return merged
end

-- Soustrait des intervalles bloqués d'un intervalle [a, b] ; renvoie les segments libres.
function ExclusionZones.subtractIntervals(a, b, blocked, minLength)
	local segments = {}
	local cursor = a
	for _, iv in ipairs(blocked) do
		if iv[2] > cursor and iv[1] < b then
			if iv[1] - cursor >= (minLength or 0) then
				table.insert(segments, { cursor, math.min(iv[1], b) })
			end
			cursor = math.max(cursor, iv[2])
		end
	end
	if b - cursor >= (minLength or 0) then
		table.insert(segments, { cursor, b })
	end
	return segments
end

function ExclusionZones:all(surface)
	return self:forSurface(surface)
end

return ExclusionZones
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">FloorPlacementEngine</string>
          <string name="Source"><![CDATA[--[[
	FloorPlacementEngine
	Décoration des sols (et pentes) par composition :

	  Hero Composition : quelques gros éléments sur les points de composition ;
	  Cluster          : groupes (leader moyen/grand + satellites) séparés par
	                     des zones respirantes ;
	  Edge Decoration  : séquences rythmiques le long des murs / bords, les
	                     assets sont "snappés" dos au mur (contact exact) ;
	  Border           : suite continue d'assets bord à bord le long des bords ;
	  Grid             : placement régulier (trous cohérents via champ de bruit) ;
	  Scatter          : dispersion pondérée par le score ;
	  Hybrid           : choix automatique selon la forme de la zone.

	Toutes les coordonnées sont celles du repère local de la surface.
]]

local Workspace = game:GetService("Workspace")

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local MathUtil = require(Core.MathUtil)
local Utilities = require(Core.Utilities)
local PlacementMath = require(script.Parent.PlacementMath)
local CandidateScoring = require(script.Parent.CandidateScoring)
local CompositionPlanner = require(script.Parent.CompositionPlanner)
local ModularFitter = require(script.Parent.ModularFitter)
local RandomGenerator = require(Core.RandomGenerator)

local FloorPlacementEngine = {}

local COMP = Config.Composition
local SC = Config.Scoring
local G = Config.Geometry
local TOL = Config.Precision.CONTACT_TOLERANCE

local LARGE_CLASSES = { Large = true, Hero = true }
local MEDIUM_CLASSES = { Medium = true }
local SMALL_CLASSES = { Small = true }

-- Domaine ----------------------------------------------------------------------------

local Domain = {}
Domain.__index = Domain

local function segmentDistance(p, line)
	local d = MathUtil.pointSegmentDistance(p, line.P0, line.P1)
	return d
end

function Domain:edgeDistance(p)
	local best = math.min(p.X - self.U0, self.U1 - p.X, p.Y - self.V0, self.V1 - p.Y)
	best = math.max(best, 0)
	for _, line in ipairs(self.WallLines) do
		best = math.min(best, segmentDistance(p, line))
	end
	return best
end

function Domain:wallDistance(p)
	local best = math.huge
	for _, line in ipairs(self.WallLines) do
		best = math.min(best, segmentDistance(p, line))
	end
	return best
end

function Domain:nearestEdge(p)
	local best, bestLine = math.huge, nil
	for _, line in ipairs(self.EdgeLines) do
		local d = segmentDistance(p, line)
		if d < best then
			best, bestLine = d, line
		end
	end
	return bestLine, best
end

function Domain:crossCoord(p)
	return if self.CrossAxis == "U" then p.X else p.Y
end

function Domain:alongCoord(p)
	return if self.CrossAxis == "U" then p.Y else p.X
end

function Domain:crossNormalized(p)
	local half = (self.CrossMax - self.CrossMin) * 0.5
	if half <= 1e-6 then
		return 0
	end
	return math.clamp((self:crossCoord(p) - (self.CrossMin + self.CrossMax) * 0.5) / half, -1, 1)
end

function Domain:rhythm(p)
	local a0 = if self.CrossAxis == "U" then self.V0 else self.U0
	local length = if self.CrossAxis == "U" then self.V1 - self.V0 else self.U1 - self.U0
	return self.RhythmFn(self:alongCoord(p) - a0, length)
end

function Domain:randomPoint(rng)
	return Vector2.new(rng:range(self.U0, self.U1), rng:range(self.V0, self.V1))
end

-- Construit le domaine de placement d'une surface de sol.
local function buildDomain(ctx, surface, rng)
	local S = ctx.Settings
	local margin = S.EdgeMargin
	local d = setmetatable({}, Domain)
	d.Surface = surface
	d.U0, d.U1 = surface.UMin + margin, surface.UMax - margin
	d.V0, d.V1 = surface.VMin + margin, surface.VMax - margin
	if d.U1 - d.U0 < G.MIN_SURFACE_EXTENT or d.V1 - d.V0 < G.MIN_SURFACE_EXTENT then
		return nil
	end
	d.SizeU = d.U1 - d.U0
	d.SizeV = d.V1 - d.V0
	d.Center = Vector2.new((d.U0 + d.U1) * 0.5, (d.V0 + d.V1) * 0.5)
	d.MinExtent = math.min(d.SizeU, d.SizeV)
	d.MaxExtent = math.max(d.SizeU, d.SizeV)
	d.LengthAxis = if d.SizeU >= d.SizeV then "U" else "V"
	d.EdgeDepth = math.clamp(math.max(S.EdgeDepth, COMP.MIN_EDGE_DEPTH), 0.5, math.max(0.5, d.MinExtent * 0.5))
	d.Obstacles = surface.Obstacles

	-- Lignes de murs (décalées de la profondeur de façade si une architecture a été générée).
	d.WallLines = {}
	for _, w in ipairs(surface.Walls) do
		local offset = ctx:facadeDepth(w.Surface)
		table.insert(d.WallLines, {
			P0 = w.P0 + w.Normal * offset,
			P1 = w.P1 + w.Normal * offset,
			Normal = w.Normal,
			Length = w.Length,
			Kind = "Wall",
			Wall = w.Surface,
		})
	end
	table.sort(d.WallLines, function(a, b)
		return a.Wall.Index < b.Wall.Index
	end)

	-- Bords du rectangle non couverts par un mur.
	local rectEdges = {
		{ P0 = Vector2.new(d.U0, d.V0), P1 = Vector2.new(d.U1, d.V0), Normal = Vector2.new(0, 1) },
		{ P0 = Vector2.new(d.U1, d.V1), P1 = Vector2.new(d.U0, d.V1), Normal = Vector2.new(0, -1) },
		{ P0 = Vector2.new(d.U0, d.V1), P1 = Vector2.new(d.U0, d.V0), Normal = Vector2.new(1, 0) },
		{ P0 = Vector2.new(d.U1, d.V0), P1 = Vector2.new(d.U1, d.V1), Normal = Vector2.new(-1, 0) },
	}
	d.EdgeLines = table.clone(d.WallLines)
	for _, e in ipairs(rectEdges) do
		e.Length = (e.P1 - e.P0).Magnitude
		e.Kind = "Edge"
		local covered = false
		for _, w in ipairs(d.WallLines) do
			if w.Normal:Dot(e.Normal) > 0.9 then
				local mid = (e.P0 + e.P1) * 0.5
				local dist = MathUtil.pointSegmentDistance(mid, w.P0, w.P1)
				if dist <= math.max(d.EdgeDepth * 0.5, G.WALL_FLOOR_PLAN_TOLERANCE + 1) + ctx:facadeDepth(w.Wall) then
					covered = true
					break
				end
			end
		end
		e.Covered = covered
		if not covered then
			table.insert(d.EdgeLines, e)
		end
	end

	-- Axe transversal (pour Keep Center Clear, l'équilibre et le rythme).
	local mode = S.CenterClearAxis
	local shortAxis = if d.LengthAxis == "U" then "V" else "U"
	local cross = shortAxis
	if mode == "Length" then
		cross = d.LengthAxis
	elseif mode == "Auto" and #d.WallLines > 0 then
		local su, sv = 0, 0
		for _, w in ipairs(d.WallLines) do
			su += math.abs(w.Normal.X) * w.Length
			sv += math.abs(w.Normal.Y) * w.Length
		end
		cross = if su >= sv then "U" else "V"
	end
	d.CrossAxis = cross
	local cmin = if cross == "U" then d.U0 else d.V0
	local cmax = if cross == "U" then d.U1 else d.V1
	for _, w in ipairs(d.WallLines) do
		local nc = if cross == "U" then w.Normal.X else w.Normal.Y
		if math.abs(nc) > 0.9 then
			local c = if cross == "U" then (w.P0.X + w.P1.X) * 0.5 else (w.P0.Y + w.P1.Y) * 0.5
			if nc > 0 and c > cmin and c < cmax then
				cmin = c
			elseif nc < 0 and c < cmax and c > cmin then
				cmax = c
			end
		end
	end
	d.CrossMin, d.CrossMax = cmin, cmax

	-- Points de composition (tiers) dans la zone décorable.
	d.Thirds = {}
	for _, fu in ipairs({ 1 / 3, 2 / 3 }) do
		for _, fv in ipairs({ 1 / 3, 2 / 3 }) do
			table.insert(d.Thirds, Vector2.new(d.U0 + d.SizeU * fu, d.V0 + d.SizeV * fv))
		end
	end
	d.RhythmFn = CompositionPlanner.rhythmField(rng)
	d.NoiseScale = d.MinExtent * 0.35
	return d
end

-- Polygones (repère de la surface) de la zone centrale protégée et du chemin.
-- force = true : calcule la zone centrale même si KeepCenterClear est désactivé.
local function computeClearZones(domain, S, force)
	local zones = {}
	local function band(c0, c1)
		if c1 - c0 <= 1e-3 then
			return
		end
		if domain.CrossAxis == "U" then
			table.insert(zones, MathUtil.rectPolygon(c0, domain.V0 - 1, c1, domain.V1 + 1))
		else
			table.insert(zones, MathUtil.rectPolygon(domain.U0 - 1, c0, domain.U1 + 1, c1))
		end
	end
	local span = domain.CrossMax - domain.CrossMin
	if (S.KeepCenterClear or force) and span > 0 then
		local c0 = domain.CrossMin + span * S.CenterClearStart
		local c1 = domain.CrossMin + span * S.CenterClearEnd
		if S.CenterClearAxis == "Both" then
			local a0 = if domain.CrossAxis == "U" then domain.V0 else domain.U0
			local a1 = if domain.CrossAxis == "U" then domain.V1 else domain.U1
			local la = a1 - a0
			local l0 = a0 + la * S.CenterClearStart
			local l1 = a0 + la * S.CenterClearEnd
			if domain.CrossAxis == "U" then
				table.insert(zones, MathUtil.rectPolygon(c0, l0, c1, l1))
			else
				table.insert(zones, MathUtil.rectPolygon(l0, c0, l1, c1))
			end
		else
			band(c0, c1)
		end
	end
	if S.PathWidth > 0 and span > 0 and not force then
		local mid = (domain.CrossMin + domain.CrossMax) * 0.5
		band(mid - S.PathWidth * 0.5, mid + S.PathWidth * 0.5)
	end
	return zones
end

-- Zones "Keep Center Clear" et "Path Width" enregistrées comme zones interdites.
local function registerClearZones(ctx, domain)
	local zones = computeClearZones(domain, ctx.Settings, false)
	for _, poly in ipairs(zones) do
		ctx.Zones:addSurfaceZone(domain.Surface, poly, "CenterClear")
		ctx.Diagnostics:zone(domain.Surface, poly, "CenterClear")
	end
	domain.ClearZones = zones
	return #zones > 0
end

-- Outils de pose ----------------------------------------------------------------------

local function surfaceVector(surface, v2)
	return surface.U * v2.X + surface.V * v2.Y
end

local function footprintCenter(surface, pose)
	local l = surface.Frame:PointToObjectSpace(pose.BoxCFrame.Position)
	return Vector2.new(l.X, l.Z)
end

-- Colle l'empreinte contre une ligne (mur ou bord) à la distance `gap`.
local function snapToLine(surface, pose, line, gap)
	local poly = PlacementMath.footprint(pose, surface)
	local dmin = math.huge
	for _, v in ipairs(poly) do
		dmin = math.min(dmin, (v - line.P0):Dot(line.Normal))
	end
	if dmin == math.huge then
		return
	end
	local shift = (gap or 0) - dmin
	if math.abs(shift) > 1e-9 then
		PlacementMath.translatePose(pose, surfaceVector(surface, line.Normal * shift))
		pose.SubBoxes = nil
	end
end

-- Hôte non analytique (MeshPart, Union...) : sonde la surface réelle par raycast.
local function probeMeshGround(surface, pose, poly)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { surface.Part }
	local n = surface.Normal
	local probe = G.RAYCAST_PROBE_HEIGHT
	local heights = {}
	local points = table.clone(poly)
	table.insert(points, MathUtil.polygonCentroid(poly))
	for _, p in ipairs(points) do
		local origin = surface.Frame:PointToWorldSpace(Vector3.new(p.X, probe, p.Y))
		local result = Workspace:Raycast(origin, -n * (probe + surface.Thickness + G.RAYCAST_MAX_SINK), params)
		if not result then
			return false
		end
		table.insert(heights, probe - (origin - result.Position).Magnitude)
	end
	local lo, hi = math.huge, -math.huge
	for _, h in ipairs(heights) do
		lo = math.min(lo, h)
		hi = math.max(hi, h)
	end
	if hi - lo > G.RAYCAST_MAX_SINK then
		return false
	end
	if math.abs(lo) > 1e-6 then
		PlacementMath.translatePose(pose, n * lo)
		pose.SubBoxes = nil
	end
	return true
end

local function checkFootprint(ctx, domain, pose, asset)
	local surface = domain.Surface
	local poly, hMin, hMax = PlacementMath.footprint(pose, surface)
	if not MathUtil.polygonInsideRect(poly, domain.U0, domain.V0, domain.U1, domain.V1, TOL) then
		return false, "bounds"
	end
	local S = ctx.Settings
	local wallTol = if S.AllowWallContact and asset.Meta.CanTouchWall then TOL else -(S.MinimumSpacing + TOL)
	for _, ob in ipairs(domain.Obstacles) do
		if ob.HMin < hMax - TOL and ob.HMax > math.max(hMin, 0) + TOL then
			if MathUtil.polygonsIntersect(poly, ob.Polygon, wallTol) then
				return false, "bounds"
			end
		end
	end
	if ctx.Zones:blocks(surface, poly) then
		return false, "exclusion"
	end
	if not surface.IsAnalytic then
		if not probeMeshGround(surface, pose, poly) then
			return false, "bounds"
		end
	end
	return true, nil, poly
end

-- Orientation selon le mode de rotation.
local function computeYaw(ctx, domain, p, asset, rng, hintNormal, modeOverride)
	if not asset.Meta.AllowRotation then
		return 0
	end
	local S = ctx.Settings
	local mode = modeOverride or S.RotationMode
	local jitter = math.rad(COMP.MAX_ROTATION_JITTER_DEG) * S.Randomness * rng:gaussian() * 0.5
	if mode == "Fixed" or mode == "AlignToSurface" then
		return 0
	elseif mode == "Random90" then
		return rng:int(0, 3) * math.pi * 0.5
	elseif mode == "Random180" then
		return rng:int(0, 1) * math.pi
	elseif mode == "Random360" then
		return rng:range(0, math.pi * 2)
	elseif mode == "AlignToWall" then
		local n = hintNormal
		if not n then
			local line = domain:nearestEdge(p)
			n = if line then line.Normal else Vector2.new(0, 1)
		end
		return MathUtil.yawFacing(n.X, n.Y) + jitter
	elseif mode == "FaceCenter" or mode == "FaceAway" then
		local target
		if domain.MaxExtent / math.max(domain.MinExtent, 1e-3) > 1.8 then
			-- Zone allongée : on regarde la ligne centrale.
			local mid = (domain.CrossMin + domain.CrossMax) * 0.5
			target = if domain.CrossAxis == "U" then Vector2.new(mid, p.Y) else Vector2.new(p.X, mid)
		else
			target = domain.Center
		end
		local dir = target - p
		if mode == "FaceAway" then
			dir = -dir
		end
		return MathUtil.yawFacing(dir.X, dir.Y) + jitter
	elseif mode == "FollowPath" then
		local dir = if domain.LengthAxis == "U" then Vector2.new(1, 0) else Vector2.new(0, 1)
		if asset.Meta.AllowMirror and rng:chance(0.5) then
			dir = -dir
		end
		return MathUtil.yawFacing(dir.X, dir.Y) + jitter * 0.5
	end
	return 0
end

local function mirrorPoint(domain, p)
	local mid = (domain.CrossMin + domain.CrossMax) * 0.5
	if domain.CrossAxis == "U" then
		return Vector2.new(2 * mid - p.X, p.Y)
	end
	return Vector2.new(p.X, 2 * mid - p.Y)
end

local function mirrorYaw(domain, yaw)
	local fu, fv = -math.sin(yaw), -math.cos(yaw)
	if domain.CrossAxis == "U" then
		fu = -fu
	else
		fv = -fv
	end
	return MathUtil.yawFacing(fu, fv)
end

-- Placement unitaire ----------------------------------------------------------------------

local function commit(ctx, domain, pose, asset, request, pos2D, polyArea)
	local surface = domain.Surface
	local item = ctx:tryCommit(pose, {
		Surface = surface,
		Role = "Floor",
		Folder = "Floor",
		PlacementType = if LARGE_CLASSES[asset.SizeClass] then "LargeStructure" else "Floor",
		Group = "Decor",
		Layer = 0,
		IgnoreParts = domain.IgnoreParts,
		Pos2D = pos2D,
		Radius = asset.FootprintRadius * pose.Scale,
		ClusterId = request.ClusterId,
		CrossCoord = domain:crossNormalized(pos2D),
		Pass = request.Pass,
	})
	if item then
		domain.Coverage += polyArea or (pose.BoxSize.X * pose.BoxSize.Z)
		if asset.SizeClass == "Hero" then
			domain.HeroCount += 1
		end
	end
	return item
end

local function tryMirror(ctx, domain, item, request, yaw, rng)
	local S = ctx.Settings
	if request.NoMirror or S.Symmetry <= 0 then
		return
	end
	if not request.ForceMirror and not rng:chance(S.Symmetry) then
		return
	end
	local surface = domain.Surface
	local asset = item.Asset
	local p = footprintCenter(surface, item.Pose)
	local mp = mirrorPoint(domain, p)
	if (mp - p).Magnitude < asset.FootprintRadius * item.Scale * 2 then
		return
	end
	local myaw = mirrorYaw(domain, yaw)
	-- On repositionne l'ancre pour que le centre de l'empreinte tombe sur le point miroir.
	local pose = PlacementMath.floorPose(asset, item.Scale, surface, mp.X, mp.Y, {
		Yaw = myaw,
		AlignToSurface = domain.AlignToSurface,
		Offset = asset.Meta.FloorOffset + S.SurfaceOffset,
		Epsilon = ctx.Epsilon,
	})
	local center = footprintCenter(surface, pose)
	local delta = mp - center
	if delta.Magnitude > 1e-6 then
		PlacementMath.translatePose(pose, surfaceVector(surface, delta))
		pose.SubBoxes = nil
	end
	local ok, _, poly = checkFootprint(ctx, domain, pose, asset)
	if ok and ctx:assetAvailable(asset) then
		commit(ctx, domain, pose, asset, { Pass = "Mirror", ClusterId = item.ClusterId }, mp, MathUtil.polygonArea(poly))
	end
end

--[[
	request = {
	  Palette, Asset?, SizeClasses?, Sampler(rng, asset, radius) -> (Vector2?, hintNormal?, snapLine?, gap?),
	  Profile, ClusterId?, Pass, Candidates?, RotationMode?, NoMirror?, Scale?
	}
]]
local function placeOne(ctx, domain, request, rng)
	local S = ctx.Settings
	local surface = domain.Surface
	local selector = ctx.Selector
	local tried = {}
	for _ = 1, SC.MAX_ASSET_RETRIES do
		if ctx:remaining() <= 0 then
			return nil
		end
		local classes = request.SizeClasses
		if domain.HeroCount >= domain.HeroCap then
			-- Hiérarchie : les éléments "Hero" restent rares sur une même surface.
			local filtered = {}
			for k, v in pairs(classes or { Small = true, Medium = true, Large = true, Hero = true }) do
				if k ~= "Hero" then
					filtered[k] = v
				end
			end
			classes = filtered
		end
		local asset = request.Asset or selector:pick(request.Palette, {
			Role = "Floor",
			SizeClasses = classes,
			Surface = surface,
			Rng = rng,
			MaxWidth = domain.MinExtent,
			Exclude = tried,
			IgnoreFrequency = request.IgnoreFrequency,
		})
		if not asset then
			return nil
		end
		local scale = request.Scale or PlacementMath.resolveScale(asset, S, rng)
		local footprintW = math.min(asset.Size.X, asset.Size.Z) * scale
		if footprintW > domain.MinExtent or math.max(asset.Size.X, asset.Size.Z) * scale > domain.MaxExtent then
			ctx.Diagnostics:add("TooLarge")
			tried[asset] = true
			if request.Asset then
				return nil
			end
		else
			local radius = asset.FootprintRadius * scale
			local env = {
				State = ctx:surfaceState(surface),
				Domain = domain,
				Asset = asset,
				Radius = radius,
				Profile = request.Profile or {},
				ClusterId = request.ClusterId,
				Rng = rng,
				Settings = S,
				NoiseSeed = domain.NoiseSeed,
			}
			local scored = {}
			local count = request.Candidates or S.CandidatesPerPlacement
			for k = 1, count do
				local p, hint, line, gap = request.Sampler(rng, asset, radius)
				if p then
					local yaw = computeYaw(ctx, domain, p, asset, rng, hint, request.RotationMode)
					local pose = PlacementMath.floorPose(asset, scale, surface, p.X, p.Y, {
						Yaw = yaw,
						AlignToSurface = domain.AlignToSurface,
						Offset = asset.Meta.FloorOffset + S.SurfaceOffset,
						Epsilon = ctx.Epsilon,
					})
					if line then
						snapToLine(surface, pose, line, gap or 0)
					end
					local ok, reason, poly = checkFootprint(ctx, domain, pose, asset)
					local center = footprintCenter(surface, pose)
					if ok then
						local score = CandidateScoring.floor(env, center)
						table.insert(scored, { Pose = pose, Pos = center, Score = score, Index = k, Yaw = yaw, Area = MathUtil.polygonArea(poly) })
						ctx.Diagnostics:candidate(pose.BoxCFrame.Position)
					else
						ctx.Diagnostics:reject(reason, pose.BoxCFrame.Position)
					end
				end
			end
			if #scored > 0 then
				CandidateScoring.orderCandidates(scored, S, rng)
				for i = 1, math.min(#scored, SC.MAX_COLLISION_TESTS) do
					local c = scored[i]
					local item = commit(ctx, domain, c.Pose, asset, request, c.Pos, c.Area)
					if item then
						tryMirror(ctx, domain, item, request, c.Yaw, rng)
						return item
					end
				end
			end
			tried[asset] = true
			if request.Asset then
				return nil
			end
		end
	end
	return nil
end

-- Échantillonneurs -------------------------------------------------------------------------

local function uniformSampler(domain)
	return function(rng)
		return domain:randomPoint(rng)
	end
end

local function thirdsSampler(domain)
	return function(rng)
		if rng:chance(0.6) then
			local p = domain.Thirds[rng:int(1, #domain.Thirds)]
			local j = domain.MinExtent * 0.12
			return p + Vector2.new(rng:gaussian() * j, rng:gaussian() * j)
		end
		return domain:randomPoint(rng)
	end
end

local function ringSampler(center, rMin, rMax)
	return function(rng)
		local a = rng:range(0, math.pi * 2)
		local r = rng:range(rMin, rMax)
		return center + Vector2.new(math.cos(a) * r, math.sin(a) * r)
	end
end

local function pickLine(lines, rng)
	local weights = {}
	for i, l in ipairs(lines) do
		weights[i] = l.Length
	end
	local i = rng:weightedIndex(weights)
	return if i then lines[i] else nil
end

local function edgeBandSampler(domain, lines)
	return function(rng, _, radius)
		local line = pickLine(lines, rng)
		if not line then
			return domain:randomPoint(rng)
		end
		local t = rng:next()
		local depth = (rng:next() ^ 1.5) * domain.EdgeDepth
		local p = line.P0:Lerp(line.P1, t) + line.Normal * (depth + radius)
		if depth < domain.EdgeDepth * 0.15 then
			return p, line.Normal, line, 0
		end
		return p, line.Normal
	end
end

-- Passes ------------------------------------------------------------------------------------

local function nextClusterId(domain)
	domain.ClusterCount += 1
	return domain.Surface.Id .. ":C" .. tostring(domain.ClusterCount)
end

local function addCluster(ctx, domain, center, radius, id)
	local state = ctx:surfaceState(domain.Surface)
	table.insert(state.Clusters, { Center = center, Radius = radius, Id = id })
	return id
end

local function satellites(ctx, domain, leader, clusterId, count, palette, rng, pass)
	if count <= 0 then
		return
	end
	-- Sous-palette cohérente : 1 à 2 petits assets + éventuellement un moyen.
	local smalls, mediums = {}, {}
	for _, a in ipairs(palette) do
		if a.SizeClass == "Small" then
			table.insert(smalls, a)
		elseif a.SizeClass == "Medium" then
			table.insert(mediums, a)
		end
	end
	local sub = {}
	rng:shuffle(smalls)
	for i = 1, math.min(#smalls, if ctx.Settings.Variation > 0.6 then 3 else 2) do
		table.insert(sub, smalls[i])
	end
	if #mediums > 0 and (#sub == 0 or rng:chance(ctx.Settings.MediumAssetFrequency * 0.6)) then
		table.insert(sub, mediums[rng:int(1, #mediums)])
	end
	if #sub == 0 then
		return
	end
	local surface = domain.Surface
	local leaderPos = footprintCenter(surface, leader.Pose)
	local leaderR = leader.Asset.FootprintRadius * leader.Scale
	local S = ctx.Settings
	for _ = 1, count do
		if domain.Coverage >= domain.CoverageLimit or ctx:remaining() <= 0 then
			return
		end
		local spread = Utilities.lerp(5, 1.2, S.ClusterStrength)
		placeOne(ctx, domain, {
			Palette = sub,
			IgnoreFrequency = true,
			Sampler = function(r, _, radius)
				local rMin = leaderR + radius + S.MinimumSpacing
				return ringSampler(leaderPos, rMin, rMin + radius * spread)(r)
			end,
			Profile = {
				ClusterCenter = leaderPos,
				ClusterRadius = leaderR * 2,
				EmptyWeight = 0.15,
				EdgeAffinity = 0,
				CenterAvoid = domain.CenterAvoid,
			},
			ClusterId = clusterId,
			Pass = pass or "Cluster",
			NoMirror = true,
		}, rng)
	end
end

local function heroPass(ctx, domain, budget, palette, rng, edgeAffinity)
	local S = ctx.Settings
	for _ = 1, budget.Heroes do
		if ctx:remaining() <= 0 then
			return
		end
		local clusterId = nextClusterId(domain)
		local item = placeOne(ctx, domain, {
			Palette = palette,
			SizeClasses = LARGE_CLASSES,
			IgnoreFrequency = true,
			Sampler = thirdsSampler(domain),
			Profile = {
				Thirds = 0.9,
				EdgeAffinity = edgeAffinity,
				BalanceWeight = 0.8,
				EmptyWeight = 0.4,
				AvoidClusters = true,
				ClusterRadius = budget.HeroRadius * 3,
				CenterAvoid = domain.CenterAvoid,
			},
			ClusterId = clusterId,
			Pass = "Hero",
		}, rng)
		if item then
			local pos = footprintCenter(domain.Surface, item.Pose)
			local r = item.Asset.FootprintRadius * item.Scale
			local id = addCluster(ctx, domain, pos, r * 2.5, clusterId)
			if S.ClusterStrength >= 0.25 then
				satellites(ctx, domain, item, id, CompositionPlanner.clusterSize(S, rng) - 1, palette, rng, "HeroCluster")
			end
		end
	end
end

local function clusterPass(ctx, domain, budget, palette, rng, edgeAffinity, centerSampler)
	local S = ctx.Settings
	local state = ctx:surfaceState(domain.Surface)
	for _ = 1, budget.Clusters do
		if domain.Coverage >= domain.CoverageLimit or ctx:remaining() <= 0 then
			return
		end
		-- Centre du groupe : meilleur point parmi plusieurs, loin des autres groupes.
		local probeAsset = { SizeClass = "Medium", Meta = {}, Importance = 1 }
		local env = {
			State = state,
			Domain = domain,
			Asset = probeAsset,
			Radius = budget.MediumRadius,
			Profile = {
				AvoidClusters = true,
				ClusterRadius = budget.MediumRadius * 3,
				EmptyWeight = 1,
				EdgeAffinity = edgeAffinity,
				BalanceWeight = 0.6,
				RhythmWeight = 0.5,
				CenterAvoid = domain.CenterAvoid,
			},
			Rng = rng,
			Settings = S,
			NoiseSeed = domain.NoiseSeed,
		}
		local bestP, bestScore = nil, -math.huge
		for _ = 1, S.CandidatesPerPlacement do
			local p = centerSampler(rng, probeAsset, budget.MediumRadius)
			if p then
				local s = CandidateScoring.floor(env, p)
				if s > bestScore then
					bestP, bestScore = p, s
				end
			end
		end
		if bestP then
			local classes = { Medium = true }
			if S.LargeAssetFrequency >= 0.4 and rng:chance(S.LargeAssetFrequency * 0.5) then
				classes.Large = true
			end
			local center = bestP
			local clusterId = nextClusterId(domain)
			local leader = placeOne(ctx, domain, {
				Palette = palette,
				SizeClasses = classes,
				IgnoreFrequency = true,
				Sampler = function(r)
					local j = budget.MediumRadius * 0.6
					return center + Vector2.new(r:gaussian() * j, r:gaussian() * j)
				end,
				Profile = { EmptyWeight = 0.2, AvoidClusters = true, ClusterRadius = budget.MediumRadius * 2, CenterAvoid = domain.CenterAvoid },
				ClusterId = clusterId,
				Pass = "Cluster",
			}, rng)
			if leader then
				local pos = footprintCenter(domain.Surface, leader.Pose)
				local id = addCluster(ctx, domain, pos, leader.Asset.FootprintRadius * leader.Scale * 2.5, clusterId)
				satellites(ctx, domain, leader, id, CompositionPlanner.clusterSize(S, rng), palette, rng, "Cluster")
			end
		end
		ctx.Yield()
	end
end

-- Ligne opposée et parallèle (murs face à face) : décorée en miroir si Symmetry est élevé.
local function findOppositeLines(domain, lines)
	local mirrored = {}
	for i, a in ipairs(lines) do
		if not mirrored[a] then
			for j = i + 1, #lines do
				local b = lines[j]
				local crossComponent = if domain.CrossAxis == "U" then math.abs(a.Normal.X) else math.abs(a.Normal.Y)
				if not mirrored[b] and a.Normal:Dot(b.Normal) < -0.9 and crossComponent > 0.9 then
					mirrored[b] = a
					break
				end
			end
		end
	end
	return mirrored
end

local function edgePass(ctx, domain, budget, palette, rng, lines, coverageShare)
	local S = ctx.Settings
	local limit = domain.CoverageLimit * coverageShare
	local symmetric = S.Symmetry >= 0.5
	local mirrored = if symmetric then findOppositeLines(domain, lines) else {}
	local hasOpposite = {}
	for b, a in pairs(mirrored) do
		hasOpposite[a] = true
		hasOpposite[b] = true
	end
	local spacing = math.max(budget.MediumRadius * 2.4, COMP.EDGE_BEAT_MIN_SPACING)
	for li, line in ipairs(lines) do
		if domain.Coverage >= limit or ctx:remaining() <= 0 then
			return
		end
		-- La ligne opposée reçoit les copies miroir de celle-ci.
		if not mirrored[line] then
			local dir = (line.P1 - line.P0).Unit
			local lineRng = rng:fork("edge" .. tostring(li))
			local beats = CompositionPlanner.beats(line.Length, lineRng, S, {
				BaseSpacing = spacing,
				Symmetric = S.Symmetry >= 0.6,
				EndMargin = math.min(budget.TypicalRadius * 0.5, line.Length * 0.1),
			})
			for bi, beat in ipairs(beats) do
				if domain.Coverage >= limit or ctx:remaining() <= 0 then
					break
				end
				if beat.Kind ~= "Gap" then
					local classes = if beat.Kind == "Large" then LARGE_CLASSES elseif beat.Kind == "Medium" then MEDIUM_CLASSES else SMALL_CLASSES
					local count = if beat.Kind == "SmallGroup" then lineRng:int(2, 3) else 1
					local clusterId = if count > 1 then (domain.Surface.Id .. ":E" .. li .. ":" .. bi) else nil
					for j = 1, count do
						local contact = beat.Kind == "Large" or j == 1
						placeOne(ctx, domain, {
							Palette = palette,
							SizeClasses = classes,
							Sampler = function(r, _, radius)
								local t = math.clamp(beat.T + (r:next() - 0.5) * beat.Width * 0.8, 0, line.Length)
								local depth = if contact then 0 else (r:next() ^ 2) * domain.EdgeDepth * 0.6
								local p = line.P0 + dir * t + line.Normal * (depth + radius)
								if contact or depth < 0.05 then
									return p, line.Normal, line, S.MinimumSpacing * 0.25
								end
								return p, line.Normal
							end,
							Profile = {
								EdgeAffinity = 0.6,
								RhythmWeight = 0.3,
								EmptyWeight = 0.3,
								CenterAvoid = domain.CenterAvoid,
							},
							ClusterId = clusterId,
							Pass = "Edge",
							NoMirror = not hasOpposite[line],
							ForceMirror = hasOpposite[line],
						}, lineRng)
					end
				end
			end
			ctx.Yield()
		end
	end
end

local function borderPass(ctx, domain, palette, rng, lines)
	local S = ctx.Settings
	local surface = domain.Surface
	for li, line in ipairs(lines) do
		if ctx:remaining() <= 0 then
			return
		end
		local lineRng = rng:fork("border" .. tostring(li))
		local candidates = {}
		for _, a in ipairs(palette) do
			if a.SizeClass ~= "Hero" and math.max(a.Size.X, a.Size.Z) <= line.Length and a.Size.Z <= domain.EdgeDepth * 2 then
				table.insert(candidates, a)
			end
		end
		table.sort(candidates, function(a, b)
			local ta = if a.Shape == "Trim" then 0 else 1
			local tb = if b.Shape == "Trim" then 0 else 1
			if ta ~= tb then
				return ta < tb
			end
			return a.Order < b.Order
		end)
		local modules = {}
		for i = 1, math.min(#candidates, 6) do
			local a = candidates[i]
			table.insert(modules, {
				Key = a.Key,
				Width = a.Size.X,
				Weight = a.Meta.Weight,
				Scalable = a.Meta.AllowScale,
				MinFactor = a.Meta.MinScale,
				MaxFactor = a.Meta.MaxScale,
				Data = a,
			})
		end
		local endMargin = 0
		local fit = ModularFitter.fit(line.Length - 2 * endMargin, modules, {
			AllowScale = true,
			MaxDeviation = 0.1,
			AllowGaps = S.EmptySpaceRatio > 0.05,
			MaxGapFraction = S.EmptySpaceRatio * 1.5 + 0.05,
			EndsFlush = false,
			Symmetric = S.Symmetry >= 0.5,
			Rng = lineRng,
			Variety = S.Variation,
		})
		local dir = (line.P1 - line.P0).Unit
		local yaw = MathUtil.yawFacing(line.Normal.X, line.Normal.Y)
		for _, it in ipairs(fit.Items) do
			local a = it.Module.Data
			if ctx:assetAvailable(a) and ctx:remaining() > 0 then
				local t = endMargin + fit.StartOffset + it.Start + it.Width * 0.5
				local p = line.P0 + dir * t + line.Normal * (a.Size.Z * it.Factor * 0.5)
				local pose = PlacementMath.floorPose(a, it.Factor, surface, p.X, p.Y, {
					Yaw = yaw,
					AlignToSurface = domain.AlignToSurface,
					Offset = a.Meta.FloorOffset + S.SurfaceOffset,
					Epsilon = ctx.Epsilon,
				})
				snapToLine(surface, pose, line, 0)
				-- Recentrage exact le long de la ligne (l'ancre de pose peut être un attachment).
				local center = footprintCenter(surface, pose)
				local along = (center - line.P0):Dot(dir)
				local fix = t - along
				if math.abs(fix) > 1e-9 then
					PlacementMath.translatePose(pose, surfaceVector(surface, dir * fix))
					pose.SubBoxes = nil
				end
				local ok, reason, poly = checkFootprint(ctx, domain, pose, a)
				if ok then
					commit(ctx, domain, pose, a, { Pass = "Border" }, footprintCenter(surface, pose), MathUtil.polygonArea(poly))
					ctx.Diagnostics:snap(pose.BoxCFrame.Position)
				else
					ctx.Diagnostics:reject(reason, pose.BoxCFrame.Position)
				end
			end
		end
		ctx.Diagnostics:add("ModulesFitted", #fit.Items)
		ctx.Yield()
	end
end

local function gridPass(ctx, domain, budget, palette, rng)
	local S = ctx.Settings
	local cell = math.max(budget.TypicalRadius * 2 * S.SpacingScale * (1 + S.EmptySpaceRatio), 1)
	local nu = math.max(1, math.floor(domain.SizeU / cell))
	local nv = math.max(1, math.floor(domain.SizeV / cell))
	local cu = domain.SizeU / nu
	local cv = domain.SizeV / nv
	for i = 1, nu do
		for j = 1, nv do
			if ctx:remaining() <= 0 then
				return
			end
			local center = Vector2.new(domain.U0 + (i - 0.5) * cu, domain.V0 + (j - 0.5) * cv)
			local n = RandomGenerator.noise2D(domain.NoiseSeed, center.X / (cell * 3), center.Y / (cell * 3))
			local keep = n >= S.EmptySpaceRatio * 0.9 and rng:next() < 0.35 + 0.65 * S.Density
			if keep then
				placeOne(ctx, domain, {
					Palette = palette,
					Candidates = 3,
					Sampler = function(r)
						local jit = S.Randomness * 0.3
						return center + Vector2.new((r:next() - 0.5) * cu * jit, (r:next() - 0.5) * cv * jit)
					end,
					Profile = {},
					Pass = "Grid",
					NoMirror = true,
				}, rng)
			end
		end
		ctx.Yield()
	end
end

local function scatterPass(ctx, domain, budget, palette, rng, sizeClasses, sampler, edgeAffinity, countFactor)
	local S = ctx.Settings
	local state = ctx:surfaceState(domain.Surface)
	local failures = 0
	local guard = 0
	local placed = 0
	local target = math.floor(budget.Fillers * (countFactor or 1) + 0.5)
	while placed < target and domain.Coverage < domain.CoverageLimit and failures < COMP.MAX_CONSECUTIVE_FAILURES and ctx:remaining() > 0 do
		guard += 1
		if guard > Config.Performance.HARD_MAX_ASSETS then
			break
		end
		local useCluster = #state.Clusters > 0 and rng:chance(S.ClusterStrength * 0.75)
		local s = sampler
		local clusterId = nil
		if useCluster then
			local c = state.Clusters[rng:int(1, #state.Clusters)]
			clusterId = c.Id
			s = function(r, _, radius)
				return ringSampler(c.Center, c.Radius * 0.6 + radius, c.Radius * 1.8 + radius * 2)(r)
			end
		end
		local item = placeOne(ctx, domain, {
			Palette = palette,
			SizeClasses = sizeClasses,
			Sampler = s,
			Profile = {
				EmptyWeight = 1,
				RhythmWeight = 0.6,
				BalanceWeight = 0.4,
				EdgeAffinity = edgeAffinity,
				CenterAvoid = domain.CenterAvoid,
			},
			ClusterId = clusterId,
			Pass = "Scatter",
		}, rng)
		if item then
			failures = 0
			placed += 1
		else
			failures += 1
		end
		ctx.Yield()
	end
end

-- Point focal unique pour une surface minuscule.
local function focalPass(ctx, domain, palette, rng)
	local center = domain.Center
	placeOne(ctx, domain, {
		Palette = palette,
		IgnoreFrequency = true,
		Sampler = function(r)
			local j = domain.MinExtent * 0.1
			return center + Vector2.new((r:next() - 0.5) * j, (r:next() - 0.5) * j)
		end,
		Profile = {},
		Pass = "Focal",
		NoMirror = true,
	}, rng)
end

-- Point d'entrée ----------------------------------------------------------------------------

function FloorPlacementEngine.run(ctx, surface, algorithmOverride)
	local S = ctx.Settings
	local rng = ctx.Rng:fork("floor:" .. surface.Id)
	local domain = buildDomain(ctx, surface, rng)
	if not domain then
		ctx.Diagnostics:warn(string.format("Floor %s is too small after margins.", surface.Id))
		return
	end
	domain.IgnoreParts = { [surface.Part] = true }
	domain.AlignToSurface = S.AlignToSlopes
	domain.NoiseSeed = rng:nextUInt32()
	domain.ClusterCount = 0
	domain.Coverage = 0

	local palette = ctx.Selector:palette(surface, { "Floor", "LargeStructure" }, rng:fork("palette"))
	if #palette == 0 then
		ctx.Diagnostics:warn("No floor asset available in the library (check PlacementType attributes).")
		return
	end
	-- Assets trop grands pour cette surface : signalés (jamais posés).
	local oversize = 0
	for _, a in ipairs(palette) do
		local minScale = if a.Meta.AllowScale then math.min(1, a.Meta.MinScale or 1) else 1
		if math.min(a.Size.X, a.Size.Z) * minScale > domain.MinExtent then
			oversize += 1
		end
	end
	if oversize > 0 then
		ctx.Diagnostics:add("TooLarge", oversize)
		ctx.Diagnostics:warn(string.format("%d asset(s) are larger than floor %s and were skipped.", oversize, surface.Id))
	end
	local hasClear = registerClearZones(ctx, domain)
	local area = domain.SizeU * domain.SizeV
	if hasClear then
		for _, poly in ipairs(domain.ClearZones) do
			area -= MathUtil.polygonArea(poly)
		end
		area = math.max(area, 0)
	end
	local algorithm = algorithmOverride or S.FloorAlgorithm
	if surface.Role == "Slope" then
		algorithm = "Scatter"
	end
	local budget = CompositionPlanner.floorBudget(S, area, palette, algorithm)
	domain.CoverageLimit = area * budget.CoverageTarget
	domain.HeroCount = 0
	domain.HeroCap = budget.HeroClassCap
	local aspect = domain.MaxExtent / math.max(domain.MinExtent, 1e-3)
	local corridor = aspect >= COMP.CORRIDOR_ASPECT
	domain.CenterAvoid = if corridor then 0.6 elseif S.KeepCenterClear then 0.3 else 0
	local hasWalls = #domain.WallLines > 0
	local typicalArea = (budget.TypicalRadius * 2) ^ 2

	if area < math.max(COMP.TINY_AREA, typicalArea * 3) then
		focalPass(ctx, domain, palette, rng)
		return
	end

	local wallLines = if #domain.WallLines > 0 then domain.WallLines else domain.EdgeLines
	if algorithm == "HeroComposition" then
		heroPass(ctx, domain, budget, palette, rng, if hasWalls then 0.2 else 0)
	elseif algorithm == "Cluster" then
		heroPass(ctx, domain, budget, palette, rng, 0)
		clusterPass(ctx, domain, budget, palette, rng, 0, uniformSampler(domain))
		scatterPass(ctx, domain, budget, palette, rng, SMALL_CLASSES, uniformSampler(domain), 0)
	elseif algorithm == "EdgeDecoration" then
		edgePass(ctx, domain, budget, palette, rng, domain.EdgeLines, 0.8)
		scatterPass(ctx, domain, budget, palette, rng, nil, edgeBandSampler(domain, domain.EdgeLines), 0.8, 0.6)
	elseif algorithm == "Scatter" then
		scatterPass(ctx, domain, budget, palette, rng, nil, uniformSampler(domain), 0)
	elseif algorithm == "Grid" then
		gridPass(ctx, domain, budget, palette, rng)
	elseif algorithm == "Border" then
		borderPass(ctx, domain, palette, rng, domain.EdgeLines)
	else
		-- Hybrid : décision automatique selon la forme de la zone.
		if corridor then
			edgePass(ctx, domain, budget, palette, rng, wallLines, 0.75)
			scatterPass(ctx, domain, budget, palette, rng, SMALL_CLASSES, edgeBandSampler(domain, wallLines), 0.5, 0.6)
		elseif hasWalls then
			heroPass(ctx, domain, budget, palette, rng, 0.35)
			edgePass(ctx, domain, budget, palette, rng, domain.WallLines, 0.55)
			clusterPass(ctx, domain, budget, palette, rng, 0.2, uniformSampler(domain))
			scatterPass(ctx, domain, budget, palette, rng, SMALL_CLASSES, uniformSampler(domain), 0.25, 0.8)
		else
			heroPass(ctx, domain, budget, palette, rng, 0)
			clusterPass(ctx, domain, budget, palette, rng, 0, uniformSampler(domain))
			scatterPass(ctx, domain, budget, palette, rng, SMALL_CLASSES, uniformSampler(domain), 0)
		end
	end
end

FloorPlacementEngine._buildDomain = buildDomain

--[[
	Rectangles de zone centrale d'un sol (repère de la surface), hors génération :
	utilisé par "Create Center Exclusion Zone" pour matérialiser la zone en Part.
	Renvoie une liste de { U0, V0, U1, V1 } bornés à la surface.
]]
function FloorPlacementEngine.centerZoneRects(surface, settings)
	local fakeCtx = {
		Settings = settings,
		facadeDepth = function()
			return 0
		end,
	}
	local domain = buildDomain(fakeCtx, surface, RandomGenerator.new(0))
	if not domain then
		return {}
	end
	local rects = {}
	for _, poly in ipairs(computeClearZones(domain, settings, true)) do
		local u0, v0, u1, v1 = MathUtil.polygonBounds(poly)
		u0, u1 = math.max(u0, surface.UMin), math.min(u1, surface.UMax)
		v0, v1 = math.max(v0, surface.VMin), math.min(v1, surface.VMax)
		if u1 - u0 > 0.1 and v1 - v0 > 0.1 then
			table.insert(rects, { U0 = u0, V0 = v0, U1 = u1, V1 = v1 })
		end
	end
	return rects
end

return FloorPlacementEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">ModularFitter</string>
          <string name="Source"><![CDATA[--[[
	ModularFitter
	Remplit exactement une longueur avec des modules, sans trou et sans
	chevauchement (murs modulaires, bordures, soubassements, corniches,
	rangées verticales...).

	Méthode :
	  1. Programmation dynamique (sac à dos non borné) sur les largeurs
	     quantifiées : pour chaque longueur atteignable, la combinaison de coût
	     minimal (moins de modules, poids élevés, bruit déterministe pour la
	     variété selon la seed).
	  2. Choix de la combinaison la plus proche de la longueur cible dans la
	     tolérance de déformation autorisée, puis mise à l'échelle uniforme très
	     légère pour tomber EXACTEMENT sur la longueur (ex. 211.507 studs avec
	     des modules de 14 : 15 modules à 1.0072).
	  3. Sinon : absorption du reste par les modules étirables, puis par des
	     espacements répartis (si autorisés), puis par un module de remplissage
	     (jamais une pièce ridicule de 0.2 stud), et en dernier recours une
	     petite marge centrée.
	  4. Ordonnancement : répartition régulière des types (A B A C A B A),
	     ou palindrome si la symétrie est demandée.

	Module = { Key, Width, Weight, Scalable, MinFactor, MaxFactor,
	           Stretchable, MinStretch, MaxStretch, IsFiller, Data }
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)

local ModularFitter = {}

local F = Config.Fitting

local function emptyResult(length, method)
	return { Items = {}, Covered = 0, Residual = length, Method = method or "empty", StartOffset = 0, Length = length }
end

local function moduleFactorRange(m, dev)
	local lo = 1 - dev
	local hi = 1 + dev
	if not m.Scalable then
		return 1, 1
	end
	if m.MinFactor then
		lo = math.max(lo, m.MinFactor)
	end
	if m.MaxFactor then
		hi = math.min(hi, m.MaxFactor)
	end
	if lo > hi then
		return 1, 1
	end
	return lo, hi
end

-- Ordonnancement régulier (smooth weighted round robin) avec départage déterministe.
local function interleave(counts, order, rng)
	local total = 0
	for _, c in pairs(counts) do
		total += c
	end
	local current = {}
	for _, k in ipairs(order) do
		current[k] = 0
	end
	local remaining = table.clone(counts)
	local seq = {}
	for _ = 1, total do
		local best, bestVal = nil, -math.huge
		for _, k in ipairs(order) do
			if remaining[k] > 0 then
				current[k] += counts[k]
				local jitter = if rng then rng:next() * 1e-3 else 0
				if current[k] + jitter > bestVal then
					best, bestVal = k, current[k] + jitter
				end
			end
		end
		if not best then
			break
		end
		current[best] -= total
		remaining[best] -= 1
		table.insert(seq, best)
	end
	return seq
end

local function arrange(counts, modules, symmetric, rng)
	local order = {}
	for i = 1, #modules do
		if (counts[i] or 0) > 0 then
			table.insert(order, i)
		end
	end
	table.sort(order, function(a, b)
		if counts[a] ~= counts[b] then
			return counts[a] > counts[b]
		end
		return a < b
	end)
	-- Les fillers vont au centre (symétrique) ou en fin de séquence.
	local fillerCounts, mainCounts = {}, {}
	local mainOrder = {}
	for _, i in ipairs(order) do
		if modules[i].IsFiller then
			fillerCounts[i] = counts[i]
		else
			mainCounts[i] = counts[i]
			table.insert(mainOrder, i)
		end
	end
	local fillers = {}
	for _, i in ipairs(order) do
		for _ = 1, (fillerCounts[i] or 0) do
			table.insert(fillers, i)
		end
	end
	if symmetric then
		local halfCounts = {}
		local middle = {}
		for _, i in ipairs(mainOrder) do
			halfCounts[i] = math.floor(mainCounts[i] / 2)
			if mainCounts[i] % 2 == 1 then
				table.insert(middle, i)
			end
		end
		local half = interleave(halfCounts, mainOrder, nil)
		local seq = table.clone(half)
		local center = {}
		for _, i in ipairs(middle) do
			table.insert(center, i)
		end
		for _, i in ipairs(fillers) do
			table.insert(center, math.ceil((#center + 1) / 2), i)
		end
		for _, i in ipairs(center) do
			table.insert(seq, i)
		end
		for k = #half, 1, -1 do
			table.insert(seq, half[k])
		end
		return seq
	end
	local seq = interleave(mainCounts, mainOrder, rng)
	for _, i in ipairs(fillers) do
		table.insert(seq, i)
	end
	return seq
end

local function buildItems(seq, modules, factors, stretches, gaps, startOffset)
	local items = {}
	local cursor = startOffset
	for k, i in ipairs(seq) do
		local m = modules[i]
		local w = m.Width * (factors[k] or 1) * (stretches[k] or 1)
		table.insert(items, {
			Module = m,
			Index = i,
			Start = cursor,
			Width = w,
			Factor = factors[k] or 1,
			Stretch = stretches[k] or 1,
		})
		cursor += w + (gaps[k] or 0)
	end
	return items, cursor
end

--[[
	options = {
	  MaxDeviation, AllowScale, AllowGaps, MaxGapFraction, EndsFlush,
	  Symmetric, Rng, Variety (0..1), AllowFillers
	}
]]
function ModularFitter.fit(length, modules, options)
	options = options or {}
	local valid = {}
	for _, m in ipairs(modules) do
		if m.Width and m.Width > 1e-3 then
			table.insert(valid, m)
		end
	end
	modules = valid
	if length <= F.LENGTH_TOLERANCE or #modules == 0 then
		return emptyResult(math.max(length, 0))
	end
	local dev = if options.AllowScale then (options.MaxDeviation or F.DEFAULT_MAX_SCALE_DEVIATION) else 0
	local rng = options.Rng
	local variety = options.Variety or 0.5

	-- Longueur plus petite que tous les modules : un seul module mis à l'échelle / étiré.
	local minWidth = math.huge
	for _, m in ipairs(modules) do
		minWidth = math.min(minWidth, m.Width)
	end
	if length < minWidth * (1 - dev) - F.LENGTH_TOLERANCE then
		local best, bestErr = nil, math.huge
		for i, m in ipairs(modules) do
			if m.Stretchable then
				local k = length / m.Width
				if k >= (m.MinStretch or F.MIN_STRETCH) and k <= (m.MaxStretch or F.MAX_STRETCH) then
					local err = math.abs(math.log(k))
					if err < bestErr then
						best, bestErr = { i, 1, k }, err
					end
				end
			end
		end
		if best then
			local items = buildItems({ best[1] }, modules, { best[2] }, { best[3] }, {}, 0)
			return { Items = items, Covered = length, Residual = 0, Method = "single-stretch", StartOffset = 0, Length = length }
		end
		return emptyResult(length, "too-short")
	end

	-- 1) Programmation dynamique.
	local q = math.max(F.QUANTUM, length / F.MAX_UNITS)
	local T = length / q
	local wq, cost = {}, {}
	local maxWq = 0
	local maxWeight = 0
	for _, m in ipairs(modules) do
		maxWeight = math.max(maxWeight, m.Weight or 1)
	end
	for i, m in ipairs(modules) do
		wq[i] = math.max(1, math.floor(m.Width / q + 0.5))
		maxWq = math.max(maxWq, wq[i])
		local wNorm = if maxWeight > 0 then (m.Weight or 1) / maxWeight else 1
		local noise = if rng then rng:next() * F.NOISE_COST * variety else 0
		cost[i] = F.MODULE_COST * (1 + (1 - wNorm)) + (if m.IsFiller then F.FILLER_COST else 0) + noise
	end
	local tMax = math.floor(T * (1 + dev)) + maxWq
	local best = table.create(tMax + 1, math.huge)
	local choice = table.create(tMax + 1, 0)
	best[1] = 0 -- index t+1 (t = 0)
	for t = 1, tMax do
		local bt, bc = math.huge, 0
		for i = 1, #modules do
			local prev = t - wq[i]
			if prev >= 0 then
				local c = best[prev + 1] + cost[i]
				if c < bt then
					bt, bc = c, i
				end
			end
		end
		best[t + 1] = bt
		choice[t + 1] = bc
	end

	local function reconstruct(t)
		local counts = {}
		local n = 0
		while t > 0 do
			local i = choice[t + 1]
			if i == 0 then
				return nil
			end
			counts[i] = (counts[i] or 0) + 1
			n += 1
			t -= wq[i]
		end
		return counts, n
	end

	local function realWidths(counts)
		local scalable, fixed = 0, 0
		for i, c in pairs(counts) do
			local lo, hi = moduleFactorRange(modules[i], dev)
			if hi - lo > 1e-9 then
				scalable += modules[i].Width * c
			else
				fixed += modules[i].Width * c
			end
		end
		return scalable, fixed
	end

	-- 2) Route "mise à l'échelle exacte".
	if dev > 0 then
		local bestT, bestScore, bestF = nil, math.huge, 1
		local tLo = math.max(1, math.floor(T / (1 + dev)))
		local tHi = math.min(tMax, math.ceil(T / math.max(1 - dev, 1e-3)))
		for t = tLo, tHi do
			if best[t + 1] < math.huge then
				local counts = reconstruct(t)
				if counts then
					local scalable, fixed = realWidths(counts)
					if scalable > 1e-6 then
						local f = (length - fixed) / scalable
						-- Tous les modules doivent accepter ce facteur.
						local okAll = f > 0
						for i in pairs(counts) do
							local lo, hi = moduleFactorRange(modules[i], dev)
							if hi - lo > 1e-9 and (f < lo - 1e-9 or f > hi + 1e-9) then
								okAll = false
								break
							end
						end
						if okAll then
							local score = F.DEFORMATION_COST * math.abs(math.log(f)) + best[t + 1] * 0.15
							if score < bestScore then
								bestT, bestScore, bestF = t, score, f
							end
						end
					elseif math.abs(fixed - length) <= F.LENGTH_TOLERANCE then
						local score = best[t + 1] * 0.15
						if score < bestScore then
							bestT, bestScore, bestF = t, score, 1
						end
					end
				end
			end
		end
		if bestT then
			local counts = reconstruct(bestT)
			local seq = arrange(counts, modules, options.Symmetric, rng)
			local factors = {}
			for k, i in ipairs(seq) do
				local lo, hi = moduleFactorRange(modules[i], dev)
				factors[k] = if hi - lo > 1e-9 then bestF else 1
			end
			local items, finish = buildItems(seq, modules, factors, {}, {}, 0)
			return {
				Items = items,
				Covered = finish,
				Residual = length - finish,
				Method = "exact-scale",
				StartOffset = 0,
				Length = length,
				Factor = bestF,
			}
		end
	end

	-- 3) Route "sous-remplissage" : plus grande combinaison <= longueur.
	local tBelow = nil
	for t = math.min(tMax, math.floor(T + 1e-9)), 1, -1 do
		if best[t + 1] < math.huge then
			local counts = reconstruct(t)
			if counts then
				local s = 0
				for i, c in pairs(counts) do
					s += modules[i].Width * c
				end
				if s <= length + F.LENGTH_TOLERANCE then
					tBelow = t
					break
				end
			end
		end
	end
	if not tBelow then
		return emptyResult(length, "no-combination")
	end
	local counts = reconstruct(tBelow)
	local seq = arrange(counts, modules, options.Symmetric, rng)
	local natural = 0
	for _, i in ipairs(seq) do
		natural += modules[i].Width
	end
	local residual = length - natural
	local factors, stretches, gaps = {}, {}, {}
	for k = 1, #seq do
		factors[k] = 1
		stretches[k] = 1
	end
	local method = "exact"

	-- 3a) Étirement des modules étirables.
	if residual > F.LENGTH_TOLERANCE then
		local capacity = 0
		for _, i in ipairs(seq) do
			local m = modules[i]
			if m.Stretchable then
				capacity += m.Width * ((m.MaxStretch or F.MAX_STRETCH) - 1)
			end
		end
		if capacity > 1e-6 then
			local ratio = math.min(1, residual / capacity)
			local used = 0
			for k, i in ipairs(seq) do
				local m = modules[i]
				if m.Stretchable then
					local extra = m.Width * ((m.MaxStretch or F.MAX_STRETCH) - 1) * ratio
					stretches[k] = 1 + extra / m.Width
					used += extra
				end
			end
			residual -= used
			method = "stretch"
		end
	end

	-- 3b) Module de remplissage (jamais plus petit que MIN_FILLER_WIDTH).
	if residual > F.END_MARGIN_TOLERANCE and residual >= F.MIN_FILLER_WIDTH and options.AllowFillers ~= false then
		local fillerIndex, fillerStretch, fillerFactor, fillerErr = nil, 1, 1, math.huge
		for i, m in ipairs(modules) do
			local lo, hi = moduleFactorRange(m, dev)
			local f = residual / m.Width
			local stretchOk = m.Stretchable and f >= (m.MinStretch or F.MIN_STRETCH) and f <= (m.MaxStretch or F.MAX_STRETCH)
			local scaleOk = f >= lo - 1e-9 and f <= hi + 1e-9
			if stretchOk or scaleOk then
				local err = math.abs(math.log(f)) + (if m.IsFiller then 0 else 0.25)
				if err < fillerErr then
					fillerIndex, fillerErr = i, err
					if scaleOk then
						fillerFactor, fillerStretch = f, 1
					else
						fillerFactor, fillerStretch = 1, f
					end
				end
			end
		end
		if fillerIndex then
			local pos = if options.Symmetric then math.ceil((#seq + 1) / 2) else #seq + 1
			table.insert(seq, pos, fillerIndex)
			table.insert(factors, pos, fillerFactor)
			table.insert(stretches, pos, fillerStretch)
			residual = 0
			method = "filler"
		end
	end

	-- 3c) Espacements répartis.
	local startOffset = 0
	if residual > F.LENGTH_TOLERANCE and options.AllowGaps then
		local slots = if options.EndsFlush then #seq - 1 else #seq + 1
		if slots >= 1 then
			local gap = residual / slots
			local avgWidth = natural / math.max(1, #seq)
			if gap <= avgWidth * (options.MaxGapFraction or F.MAX_GAP_FRACTION) then
				if options.EndsFlush then
					for k = 1, #seq - 1 do
						gaps[k] = gap
					end
				else
					startOffset = gap
					for k = 1, #seq do
						gaps[k] = gap
					end
					gaps[#seq] = 0
				end
				residual = if options.EndsFlush then 0 else gap
				method = "gaps"
			end
		end
	end

	-- 3d) Dernier recours : marge centrée.
	if residual > F.LENGTH_TOLERANCE and method ~= "gaps" then
		startOffset = residual * 0.5
		method = if residual <= F.END_MARGIN_TOLERANCE then "margin" else "margin-large"
	end

	local items, finish = buildItems(seq, modules, factors, stretches, gaps, startOffset)
	return {
		Items = items,
		Covered = finish - startOffset,
		Residual = length - (finish - startOffset),
		Method = method,
		StartOffset = startOffset,
		Length = length,
	}
end

return ModularFitter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">PlacementContext</string>
          <string name="Source"><![CDATA[--[[
	PlacementContext
	État partagé d'une génération : plan des objets à créer, moteur de
	collision, zones d'exclusion, index de voisinage 2D par surface,
	compteurs d'usage des assets, façades construites, diagnostics.

	Tous les moteurs (sol, murs, architecture, coins, plafond) passent par
	`tryCommit` pour valider un placement : budget, collision, puis
	enregistrement. La planification est 100 % en données ; les clones ne sont
	créés qu'à la fin par OutputBuilder.
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local PlacementMath = require(script.Parent.PlacementMath)

local PlacementContext = {}
PlacementContext.__index = PlacementContext

-- Index de voisinage 2D (grille) --------------------------------------------------

local NeighborIndex = {}
NeighborIndex.__index = NeighborIndex

function NeighborIndex.new(cellSize)
	return setmetatable({ CellSize = cellSize, Cells = {}, Entries = {} }, NeighborIndex)
end

local function cellKey(x, y)
	return x * 1000003 + y
end

function NeighborIndex:insert(entry)
	local s = self.CellSize
	local x0 = math.floor((entry.Pos.X - entry.Radius) / s)
	local x1 = math.floor((entry.Pos.X + entry.Radius) / s)
	local y0 = math.floor((entry.Pos.Y - entry.Radius) / s)
	local y1 = math.floor((entry.Pos.Y + entry.Radius) / s)
	for x = x0, x1 do
		for y = y0, y1 do
			local k = cellKey(x, y)
			local cell = self.Cells[k]
			if not cell then
				cell = {}
				self.Cells[k] = cell
			end
			cell[#cell + 1] = entry
		end
	end
	table.insert(self.Entries, entry)
end

-- Entrées dont le centre est à moins de `radius` (+ leur rayon) du point.
function NeighborIndex:query(pos, radius)
	local s = self.CellSize
	local out = {}
	local seen = {}
	local x0 = math.floor((pos.X - radius) / s)
	local x1 = math.floor((pos.X + radius) / s)
	local y0 = math.floor((pos.Y - radius) / s)
	local y1 = math.floor((pos.Y + radius) / s)
	if (x1 - x0 + 1) * (y1 - y0 + 1) > 4096 then
		for _, e in ipairs(self.Entries) do
			if (e.Pos - pos).Magnitude - e.Radius <= radius then
				out[#out + 1] = e
			end
		end
		return out
	end
	for x = x0, x1 do
		for y = y0, y1 do
			local cell = self.Cells[cellKey(x, y)]
			if cell then
				for _, e in ipairs(cell) do
					if not seen[e] then
						seen[e] = true
						if (e.Pos - pos).Magnitude - e.Radius <= radius then
							out[#out + 1] = e
						end
					end
				end
			end
		end
	end
	return out
end

PlacementContext.NeighborIndex = NeighborIndex

-- Contexte -------------------------------------------------------------------------

--[[
	params = {
	  Settings, Analysis, Registry, Collision, Zones, Rng, Diagnostics,
	  Yield, MaxAssets, SceneIgnoreParts
	}
]]
function PlacementContext.new(params)
	local self = setmetatable({}, PlacementContext)
	self.Settings = params.Settings
	self.Analysis = params.Analysis
	self.Registry = params.Registry
	self.Collision = params.Collision
	self.Zones = params.Zones
	self.Rng = params.Rng
	self.Diagnostics = params.Diagnostics
	self.Yield = params.Yield or function() end
	self.MaxAssets = params.MaxAssets or 600
	self.Items = {}
	self.Surfaces = {}
	self.Facades = {}
	self.AssetCounts = {}
	self.Epsilon = params.Settings.SurfaceEpsilon
	self._nextId = 0
	return self
end

function PlacementContext:remaining()
	return self.MaxAssets - #self.Items
end

function PlacementContext:surfaceState(surface)
	local state = self.Surfaces[surface]
	if not state then
		state = {
			Index = NeighborIndex.new(Config.Collision.NEIGHBOR_CELL_SIZE),
			Items = {},
			Recent = {},
			MassPositive = 0,
			MassNegative = 0,
			Clusters = {},
		}
		self.Surfaces[surface] = state
	end
	return state
end

function PlacementContext:assetCount(asset)
	return self.AssetCounts[asset] or 0
end

-- L'asset peut-il encore être utilisé (UniqueAsset / RepeatLimit) ?
function PlacementContext:assetAvailable(asset)
	local n = self:assetCount(asset)
	if asset.Meta.UniqueAsset and n >= 1 then
		return false
	end
	if asset.Meta.RepeatLimit and n >= asset.Meta.RepeatLimit then
		return false
	end
	return true
end

function PlacementContext:facadeDepth(surface)
	local f = self.Facades[surface]
	return if f then f.Depth else 0
end

--[[
	Valide et enregistre un placement.
	meta = {
	  Surface, Role, Folder, PlacementType, Group ("Decor" | "Architecture"),
	  Layer, IgnoreParts, SkipCollision, AllowArchitectureOverlap,
	  Pos2D, Radius, ClusterId, CrossCoord, Mass
	}
	Renvoie (item, nil) ou (nil, raison).
]]
function PlacementContext:tryCommit(pose, meta)
	if #self.Items >= self.MaxAssets then
		return nil, "budget"
	end
	local asset = pose.Asset
	self.Diagnostics:add("Attempts")
	local shape = {
		BoxCFrame = pose.BoxCFrame,
		BoxSize = pose.BoxSize,
		Pose = pose,
		Group = meta.Group or "Decor",
		CanOverlap = asset.Meta.CanOverlapDecoration,
		MinSpacing = if meta.Group == "Architecture" then 0 else (asset.Meta.MinSpacing or 0),
		IgnoreParts = meta.IgnoreParts,
		AllowArchitectureOverlap = meta.AllowArchitectureOverlap,
	}
	if not meta.SkipCollision then
		local hit, reason = self.Collision:test(shape)
		if hit then
			self.Diagnostics:reject(reason, pose.BoxCFrame.Position)
			return nil, reason
		end
	end
	self._nextId += 1
	local item = {
		Id = self._nextId,
		Asset = asset,
		Pose = pose,
		Scale = pose.Scale,
		Stretch = pose.Stretch,
		RefCFrame = pose.RefCFrame,
		Pivot = PlacementMath.pivotFor(asset, pose),
		BoxCFrame = pose.BoxCFrame,
		BoxSize = pose.BoxSize,
		Surface = meta.Surface,
		Role = meta.Role,
		Folder = meta.Folder or meta.Role,
		PlacementType = meta.PlacementType or meta.Role,
		Group = shape.Group,
		Layer = meta.Layer or 0,
		SizeClass = asset.SizeClass,
		ClusterId = meta.ClusterId,
		Pass = meta.Pass,
		IgnoreParts = meta.IgnoreParts,
	}
	self.Collision:addPlaced({
		BoxCFrame = pose.BoxCFrame,
		BoxSize = pose.BoxSize,
		Pose = pose,
		Group = shape.Group,
		CanOverlap = shape.CanOverlap,
		MinSpacing = shape.MinSpacing,
		Id = item.Id,
		Item = item,
		Surface = meta.Surface,
	})
	table.insert(self.Items, item)
	self.AssetCounts[asset] = (self.AssetCounts[asset] or 0) + 1
	if meta.Surface then
		local state = self:surfaceState(meta.Surface)
		table.insert(state.Items, item)
		if meta.Pos2D then
			local mass = meta.Mass or (asset.Importance or 1) * pose.Scale
			state.Index:insert({
				Pos = meta.Pos2D,
				Radius = meta.Radius or asset.FootprintRadius * pose.Scale,
				SizeClass = asset.SizeClass,
				Asset = asset,
				ClusterId = meta.ClusterId,
				Mass = mass,
				Item = item,
			})
			if meta.CrossCoord then
				if meta.CrossCoord >= 0 then
					state.MassPositive += mass
				else
					state.MassNegative += mass
				end
			end
		end
		table.insert(state.Recent, asset)
		if #state.Recent > Config.Composition.RECENT_HISTORY then
			table.remove(state.Recent, 1)
		end
	end
	self.Diagnostics:add("Placed")
	if meta.Pass then
		self.Diagnostics:pass(meta.Pass)
	end
	return item, nil
end

return PlacementContext
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">PlacementMath</string>
          <string name="Source"><![CDATA[--[[
	PlacementMath
	Calcul exact de la pose d'un asset sur une surface, à partir de sa boîte
	réelle mesurée (jamais du pivot) :

	  - Sol   : la face la plus basse réelle de l'asset arrive exactement sur la
	            surface (les assets plats sont avancés de SURFACE_EPSILON pour
	            éviter le z-fighting). Sur une pente, un asset vertical est
	            légèrement enfoncé pour qu'aucun coin ne flotte.
	  - Mur   : la face arrière arrive contre le mur + profondeur contrôlée
	            (couche * SURFACE_EPSILON + WallOffset).
	  - Plafond : la face supérieure touche le plafond (direction de pose inversée).

	Repère canonique mural : x -> U (le long du mur), y -> V (haut), z -> -N
	(vers le mur). L'avant de l'asset (-Z) regarde donc l'espace libre.

	Une "pose" = { RefCFrame, BoxCFrame, BoxSize, Scale, Stretch, Rotation,
	               CanonMin, CanonMax }.
]]

local Core = script.Parent.Parent.Core
local MathUtil = require(Core.MathUtil)
local Utilities = require(Core.Utilities)

local PlacementMath = {}

local ZERO = Vector3.new(0, 0, 0)
local TILT_THRESHOLD_DEG = 0.5

-- Boîte locale (repère asset) après échelle uniforme et étirement éventuel.
-- stretch = { Axis = "X" | "Z", Factor = k } : étirement autour de l'origine du repère.
function PlacementMath.localBounds(asset, scale, stretch)
	local bmin = asset.BoundsMin * scale
	local bmax = asset.BoundsMax * scale
	if stretch and stretch.Factor and math.abs(stretch.Factor - 1) > 1e-9 then
		local k = stretch.Factor
		if stretch.Axis == "Z" then
			bmin = Vector3.new(bmin.X, bmin.Y, bmin.Z * k)
			bmax = Vector3.new(bmax.X, bmax.Y, bmax.Z * k)
		else
			bmin = Vector3.new(bmin.X * k, bmin.Y, bmin.Z)
			bmax = Vector3.new(bmax.X * k, bmax.Y, bmax.Z)
		end
	end
	return bmin, bmax
end

-- Axe local de l'asset qui suit le mur pour un lacet mural donné.
function PlacementMath.wallAlongAxis(wallYaw)
	local c = math.abs(math.cos(wallYaw))
	return if c >= 0.5 then "X" else "Z"
end

local function makePose(asset, scale, stretch, rotation, anchorLocalWorldOffset, target, bmin, bmax)
	local refCFrame = CFrame.new(target - anchorLocalWorldOffset) * rotation
	local center = (bmin + bmax) * 0.5
	return {
		Asset = asset,
		RefCFrame = refCFrame,
		BoxCFrame = refCFrame * CFrame.new(center),
		BoxSize = bmax - bmin,
		Scale = scale,
		Stretch = stretch,
		Rotation = rotation,
		LocalMin = bmin,
		LocalMax = bmax,
	}
end

local function translatePose(pose, delta)
	pose.RefCFrame = pose.RefCFrame + delta
	pose.BoxCFrame = pose.BoxCFrame + delta
end

--[[
	Pose au sol.
	opts = {
	  Yaw            : rotation autour du haut (radians)
	  AlignToSurface : incliner selon la surface (sinon vertical)
	  Offset         : décalage le long du haut (FloorOffset + SurfaceOffset)
	  Epsilon        : SURFACE_EPSILON (appliqué aux assets plats)
	  Stretch
	}
]]
function PlacementMath.floorPose(asset, scale, surface, u, v, opts)
	opts = opts or {}
	local bmin, bmax = PlacementMath.localBounds(asset, scale, opts.Stretch)
	local frame = surface.Frame
	local surfacePoint = frame:PointToWorldSpace(Vector3.new(u, 0, v))
	local tilted = surface.Tilt >= TILT_THRESHOLD_DEG
	local aligned = opts.AlignToSurface or not tilted
	local baseRot = if aligned then frame.Rotation else MathUtil.uprightRotation(surface.U)
	local rotation = baseRot * CFrame.Angles(0, opts.Yaw or 0, 0)

	local anchor
	local base = asset.Attachments.PlacementBase
	if base then
		local p = base.Position * scale
		anchor = Vector3.new(p.X, p.Y, p.Z)
	else
		anchor = Vector3.new((bmin.X + bmax.X) * 0.5, bmin.Y, (bmin.Z + bmax.Z) * 0.5)
	end
	local pose = makePose(asset, scale, opts.Stretch, rotation, rotation:VectorToWorldSpace(anchor), surfacePoint, bmin, bmax)

	-- Asset vertical sur une pente : on l'enfonce jusqu'à ce qu'aucun coin inférieur ne flotte.
	if not aligned then
		local n = surface.Normal
		local maxD = -math.huge
		for _, x in ipairs({ bmin.X, bmax.X }) do
			for _, z in ipairs({ bmin.Z, bmax.Z }) do
				local c = pose.RefCFrame:PointToWorldSpace(Vector3.new(x, bmin.Y, z))
				maxD = math.max(maxD, (c - surfacePoint):Dot(n))
			end
		end
		local upDotN = MathUtil.UP:Dot(n)
		if maxD > 0 and upDotN > 1e-3 then
			translatePose(pose, -MathUtil.UP * (maxD / upDotN))
		end
	end

	local offset = opts.Offset or 0
	if asset.IsFlat then
		offset += opts.Epsilon or 0
	end
	if math.abs(offset) > 0 then
		translatePose(pose, rotation.YVector * offset)
	end
	pose.SurfacePoint = surfacePoint
	return pose
end

--[[
	Pose murale.
	opts = {
	  AnchorX : "Center" | "Start" | "End"   (position u = centre / bord gauche / bord droit)
	  AnchorY : "Center" | "Bottom" | "Top"  (position v)
	  AnchorXValue : abscisse canonique explicite (snap par attachments)
	  AnchorYValue : ordonnée canonique explicite (empilement vertical)
	  Depth   : distance entre le plan du mur et l'arrière de l'asset
	  WallYaw : lacet mural (défaut : asset.WallYaw)
	  Stretch
	}
]]
function PlacementMath.wallPose(asset, scale, surface, u, v, opts)
	opts = opts or {}
	local wallYaw = if opts.WallYaw ~= nil then opts.WallYaw else asset.WallYaw or 0
	local n, uAxis, vAxis = surface.Normal, surface.U, surface.V
	local rotWall = CFrame.fromMatrix(ZERO, uAxis, vAxis, -n)
	local rotY = CFrame.Angles(0, wallYaw, 0)
	local rotation = rotWall * rotY
	local bmin, bmax = PlacementMath.localBounds(asset, scale, opts.Stretch)
	local cmin, cmax = MathUtil.rotatedBounds(bmin, bmax, rotY)

	local ax
	if opts.AnchorXValue ~= nil then
		ax = opts.AnchorXValue
	elseif opts.AnchorX == "Start" then
		ax = cmin.X
	elseif opts.AnchorX == "End" then
		ax = cmax.X
	else
		ax = (cmin.X + cmax.X) * 0.5
	end
	local ay
	if opts.AnchorYValue ~= nil then
		ay = opts.AnchorYValue
	elseif opts.AnchorY == "Bottom" then
		ay = cmin.Y
	elseif opts.AnchorY == "Top" then
		ay = cmax.Y
	else
		ay = (cmin.Y + cmax.Y) * 0.5
	end
	local az = cmax.Z
	local back = asset.Attachments.PlacementBack
	if back then
		az = rotY:VectorToWorldSpace(back.Position * scale).Z
	end
	local anchor = Vector3.new(ax, ay, az)
	local surfacePoint = surface.Frame:PointToWorldSpace(Vector3.new(u, 0, v))
	local target = surfacePoint + n * (opts.Depth or 0)
	local pose = makePose(asset, scale, opts.Stretch, rotation, rotWall:VectorToWorldSpace(anchor), target, bmin, bmax)
	pose.CanonMin = cmin
	pose.CanonMax = cmax
	pose.WallYaw = wallYaw
	pose.SurfacePoint = surfacePoint
	return pose
end

-- Bornes canoniques murales d'un asset (sans calculer de pose).
function PlacementMath.wallCanonBounds(asset, scale, wallYaw, stretch)
	local bmin, bmax = PlacementMath.localBounds(asset, scale, stretch)
	return MathUtil.rotatedBounds(bmin, bmax, CFrame.Angles(0, wallYaw or asset.WallYaw or 0, 0))
end

--[[
	Pose au plafond : l'asset reste "debout" (haut = haut du monde) et sa face
	supérieure touche le plafond. opts.Flip retourne l'asset (sa base contre le plafond).
]]
function PlacementMath.ceilingPose(asset, scale, surface, u, v, opts)
	opts = opts or {}
	local n = surface.Normal
	local up = -n
	local baseRot
	if opts.Flip then
		baseRot = CFrame.fromMatrix(ZERO, surface.U, n)
	else
		baseRot = CFrame.fromMatrix(ZERO, surface.U, up)
	end
	local rotation = baseRot * CFrame.Angles(0, opts.Yaw or 0, 0)
	local bmin, bmax = PlacementMath.localBounds(asset, scale, opts.Stretch)
	local anchorY = if opts.Flip then bmin.Y else bmax.Y
	local anchor = Vector3.new((bmin.X + bmax.X) * 0.5, anchorY, (bmin.Z + bmax.Z) * 0.5)
	local surfacePoint = surface.Frame:PointToWorldSpace(Vector3.new(u, 0, v))
	local target = surfacePoint + n * (opts.Depth or 0)
	local pose = makePose(asset, scale, opts.Stretch, rotation, rotation:VectorToWorldSpace(anchor), target, bmin, bmax)
	pose.SurfacePoint = surfacePoint
	return pose
end

-- Pose libre : l'asset est posé à partir d'une rotation monde et d'un point d'ancrage local.
function PlacementMath.freePose(asset, scale, rotation, anchorLocal, target, stretch)
	local bmin, bmax = PlacementMath.localBounds(asset, scale, stretch)
	return makePose(asset, scale, stretch, rotation, rotation:VectorToWorldSpace(anchorLocal), target, bmin, bmax)
end

PlacementMath.translatePose = translatePose

-- Pivot final à appliquer au clone (après ScaleTo).
function PlacementMath.pivotFor(asset, pose)
	return pose.RefCFrame * asset.PivotFromRef
end

-- Sous-boîtes de collision en coordonnées monde.
function PlacementMath.worldSubBoxes(pose)
	if pose.SubBoxes then
		return pose.SubBoxes
	end
	local asset = pose.Asset
	local list = {}
	if pose.Stretch and math.abs((pose.Stretch.Factor or 1) - 1) > 1e-9 then
		list[1] = { CFrame = pose.BoxCFrame, Size = pose.BoxSize }
	else
		local s = pose.Scale
		for _, b in ipairs(asset.SubBoxes) do
			local cf = b.CFrame
			list[#list + 1] = {
				CFrame = pose.RefCFrame * (CFrame.new(cf.Position * s) * cf.Rotation),
				Size = b.Size * s,
			}
		end
	end
	pose.SubBoxes = list
	return list
end

-- Empreinte 2D (polygone convexe) d'une pose dans le repère d'une surface.
function PlacementMath.footprint(pose, surface)
	local poly, hMin, hMax = MathUtil.projectOBBToSurface(surface.Frame, pose.BoxCFrame, pose.BoxSize)
	return poly, hMin, hMax
end

-- Échelle finale d'un asset selon les réglages et ses métadonnées.
function PlacementMath.resolveScale(asset, settings, rng)
	local meta = asset.Meta
	if not meta.AllowScale then
		return 1
	end
	local scale = 1
	local mode = settings.ScaleMode
	if mode == "Fixed" then
		scale = settings.FixedScale
	elseif mode == "RandomRange" then
		local lo = meta.MinScale or settings.MinScale
		local hi = meta.MaxScale or settings.MaxScale
		if hi < lo then
			lo, hi = hi, lo
		end
		scale = rng:range(lo, hi)
	end
	if meta.MinScale then
		scale = math.max(scale, meta.MinScale)
	end
	if meta.MaxScale then
		scale = math.min(scale, meta.MaxScale)
	end
	return Utilities.clamp(scale, 0.05, 20)
end

return PlacementMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">SnapEngine</string>
          <string name="Source"><![CDATA[--[[
	SnapEngine
	Assemblage bord à bord sans trou ni chevauchement.

	Connecteurs d'un asset (dans le repère canonique mural, après lacet,
	échelle et étirement) :
	  - si l'asset possède les Attachments Snap_Left ET Snap_Right, ils sont
	    prioritaires : la largeur utile est la distance entre eux et le
	    connecteur de début d'un module coïncide EXACTEMENT avec le connecteur
	    de fin du précédent. Le nom gauche/droite n'a pas d'importance : le
	    connecteur d'abscisse la plus faible est le début (robuste quel que soit
	    le sens dans lequel l'asset a été modélisé) ;
	  - sinon, les faces de la boîte réelle sont utilisées.
	Même principe verticalement avec Snap_Bottom / Snap_Top (empilement).

	Les positions d'une rangée sont calculées par somme cumulée depuis
	l'origine du segment (pas de déplacement incrémental d'un CFrame à
	l'autre) : aucune erreur flottante ne s'accumule le long d'un mur.
]]

local PlacementMath = require(script.Parent.PlacementMath)

local SnapEngine = {}

local MIN_CONNECTOR_SPAN = 1e-3

local function canonicalPoint(localCFrame, scale, wallYaw, stretch)
	local p = localCFrame.Position * scale
	if stretch and stretch.Factor then
		if stretch.Axis == "Z" then
			p = Vector3.new(p.X, p.Y, p.Z * stretch.Factor)
		else
			p = Vector3.new(p.X * stretch.Factor, p.Y, p.Z)
		end
	end
	return CFrame.Angles(0, wallYaw, 0):VectorToWorldSpace(p)
end

--[[
	Connecteurs horizontaux.
	Renvoie { Start, End, Width, UsesAttachments, StartPoint, EndPoint, CanonMin, CanonMax }
]]
function SnapEngine.horizontalConnectors(asset, scale, wallYaw, stretch)
	wallYaw = if wallYaw ~= nil then wallYaw else asset.WallYaw or 0
	local cmin, cmax = PlacementMath.wallCanonBounds(asset, scale, wallYaw, stretch)
	local left = asset.Attachments.SnapLeft
	local right = asset.Attachments.SnapRight
	if left and right then
		local a = canonicalPoint(left, scale, wallYaw, stretch)
		local b = canonicalPoint(right, scale, wallYaw, stretch)
		if a.X > b.X then
			a, b = b, a
		end
		if b.X - a.X > MIN_CONNECTOR_SPAN then
			return {
				Start = a.X,
				End = b.X,
				Width = b.X - a.X,
				UsesAttachments = true,
				StartPoint = a,
				EndPoint = b,
				CanonMin = cmin,
				CanonMax = cmax,
			}
		end
	end
	return {
		Start = cmin.X,
		End = cmax.X,
		Width = cmax.X - cmin.X,
		UsesAttachments = false,
		StartPoint = Vector3.new(cmin.X, (cmin.Y + cmax.Y) * 0.5, cmax.Z),
		EndPoint = Vector3.new(cmax.X, (cmin.Y + cmax.Y) * 0.5, cmax.Z),
		CanonMin = cmin,
		CanonMax = cmax,
	}
end

-- Connecteurs verticaux : { Bottom, Top, Height, UsesAttachments, CanonMin, CanonMax }
function SnapEngine.verticalConnectors(asset, scale, wallYaw)
	wallYaw = if wallYaw ~= nil then wallYaw else asset.WallYaw or 0
	local cmin, cmax = PlacementMath.wallCanonBounds(asset, scale, wallYaw, nil)
	local bottom = asset.Attachments.SnapBottom
	local top = asset.Attachments.SnapTop
	if bottom and top then
		local a = canonicalPoint(bottom, scale, wallYaw, nil)
		local b = canonicalPoint(top, scale, wallYaw, nil)
		if a.Y > b.Y then
			a, b = b, a
		end
		if b.Y - a.Y > MIN_CONNECTOR_SPAN then
			return { Bottom = a.Y, Top = b.Y, Height = b.Y - a.Y, UsesAttachments = true, CanonMin = cmin, CanonMax = cmax }
		end
	end
	return { Bottom = cmin.Y, Top = cmax.Y, Height = cmax.Y - cmin.Y, UsesAttachments = false, CanonMin = cmin, CanonMax = cmax }
end

--[[
	Rangée : positions de départ (le long de U) de chaque élément.
	widths[i] = largeur utile, gaps[i] = espace après l'élément i (optionnel).
]]
function SnapEngine.layoutRow(startU, widths, gaps)
	local positions = table.create(#widths)
	local acc = 0
	for i, w in ipairs(widths) do
		positions[i] = startU + acc
		acc += w + ((gaps and gaps[i]) or 0)
	end
	return positions, startU + acc
end

--[[
	Empilement vertical : ordonnée (v) à donner à AnchorYValue = connecteur bas
	de chaque segment, pour que le segment i+1 repose exactement sur le segment i.
	baseV = hauteur du sol (bas de la boîte du premier segment).
]]
function SnapEngine.stackPositions(connectors, baseV, count)
	local positions = table.create(count)
	local first = baseV + (connectors.Bottom - connectors.CanonMin.Y)
	for i = 0, count - 1 do
		positions[i + 1] = first + i * connectors.Height
	end
	return positions
end

--[[
	Alignement 3D exact de deux attachments : renvoie le RefCFrame de l'asset B
	tel que son attachment `attachB` (CFrame local au repère de référence, échelle 1)
	coïncide avec le point monde `targetWorld`, pour une rotation monde donnée.
]]
function SnapEngine.alignToPoint(rotation, attachB, scale, targetWorld)
	local offset = rotation:VectorToWorldSpace(attachB.Position * scale)
	return CFrame.new(targetWorld - offset) * rotation
end

-- Point monde d'un attachment d'un asset posé.
function SnapEngine.worldAttachmentPoint(refCFrame, attach, scale)
	return refCFrame:PointToWorldSpace(attach.Position * scale)
end

-- Position monde d'un connecteur canonique pour une pose murale.
function SnapEngine.connectorWorld(surface, pose, canonicalPointValue)
	local rotWall = CFrame.fromMatrix(Vector3.new(), surface.U, surface.V, -surface.Normal)
	local refPos = pose.RefCFrame.Position
	return refPos + rotWall:VectorToWorldSpace(canonicalPointValue)
end


return SnapEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">WallPlacementEngine</string>
          <string name="Source"><![CDATA[--[[
	WallPlacementEngine
	Décorations ponctuelles sur les murs (Wall Props) et reliefs (Wall Relief).

	  - Répartition horizontale par séquence rythmique (CompositionPlanner.beats),
	    symétrique autour du centre du mur si Symmetry est élevé.
	  - Hauteur : PreferredHeight (fraction si <= 1, sinon studs au-dessus du
	    pied du mur), sinon selon la forme : reliefs à mi-hauteur, props à
	    hauteur d'homme, éléments élancés suspendus depuis le haut. Les murs très
	    hauts reçoivent une rangée supérieure de reliefs.
	  - L'arrière de l'asset est posé contre le mur à SURFACE_EPSILON près. Si une
	    façade a été générée devant ce mur, sa profondeur réelle au point de pose
	    est mesurée par lancer de rayons sur la géométrie planifiée : le détail
	    se pose sur la façade, sans la traverser.
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local PlacementMath = require(script.Parent.PlacementMath)
local CompositionPlanner = require(script.Parent.CompositionPlanner)

local WallPlacementEngine = {}

local COMP = Config.Composition
local ARCH = Config.Architecture
local TOL = Config.Precision.CONTACT_TOLERANCE

local LARGE_CLASSES = { Large = true, Hero = true }
local MEDIUM_CLASSES = { Medium = true }
local SMALL_CLASSES = { Small = true }

-- Profondeur de la façade générée devant le mur, mesurée sur l'empreinte arrière de l'asset.
function WallPlacementEngine.facadeDepthAt(ctx, wall, u0, u1, v0, v1)
	if not ctx.Facades[wall] then
		return 0
	end
	local start = ARCH.DETAIL_RAY_START
	local best = 0
	local samples = {
		{ (u0 + u1) * 0.5, (v0 + v1) * 0.5 },
		{ u0, v0 }, { u1, v0 }, { u0, v1 }, { u1, v1 },
		{ (u0 + u1) * 0.5, v0 }, { (u0 + u1) * 0.5, v1 },
	}
	for _, s in ipairs(samples) do
		local origin = wall.Frame:PointToWorldSpace(Vector3.new(s[1], start, s[2]))
		local dist = ctx.Collision:raycastPlanned(origin, -wall.Normal, start + 1, function(record)
			return record.Group == "Architecture" and record.Surface == wall
		end)
		if dist then
			best = math.max(best, start - dist)
		end
	end
	return best
end

-- Hauteur cible (coordonnée v) d'un asset sur un mur.
local function targetHeight(wall, asset, scale, rowFraction)
	local vMin, vMax = wall.VMin, wall.VMax
	local h = vMax - vMin
	local cmin, cmax = PlacementMath.wallCanonBounds(asset, scale, asset.WallYaw, nil)
	local assetH = cmax.Y - cmin.Y
	local pref = asset.Meta.PreferredHeight
	if pref then
		local v = if pref <= 1 then vMin + h * pref else vMin + pref
		return v, "Center"
	end
	if rowFraction then
		return vMin + h * rowFraction, "Center"
	end
	-- Élément élancé : suspendu depuis le haut du mur.
	if asset.Shape == "Relief" and assetH > (cmax.X - cmin.X) * 1.4 then
		return vMax - COMP.WALL_HANGING_TOP_MARGIN, "Top"
	end
	if asset.Shape == "Relief" or asset.Shape == "Panel" then
		return vMin + h * COMP.WALL_RELIEF_DEFAULT_HEIGHT, "Center"
	end
	-- Props : hauteur relative, plafonnée à une hauteur "humaine" sur les grands murs.
	local maxAbs = assetH * 2.5 + 4
	return vMin + math.min(h * COMP.WALL_PROP_DEFAULT_HEIGHT, maxAbs), "Center"
end

-- Tente de poser un asset au point (u, v) d'un mur ; renvoie l'item ou nil.
function WallPlacementEngine.placeAt(ctx, wall, asset, scale, u, v, anchorY, opts)
	opts = opts or {}
	local S = ctx.Settings
	local eps = ctx.Epsilon
	local cmin, cmax = PlacementMath.wallCanonBounds(asset, scale, asset.WallYaw, nil)
	local w = cmax.X - cmin.X
	local h = cmax.Y - cmin.Y
	-- Rectangle de l'asset dans le repère du mur.
	local vBottom
	if anchorY == "Top" then
		vBottom = v - h
	elseif anchorY == "Bottom" then
		vBottom = v
	else
		vBottom = v - h * 0.5
	end
	-- Recadrage vertical dans la plage utile.
	if vBottom < wall.VMin then
		vBottom = wall.VMin
	end
	if vBottom + h > wall.VMax then
		vBottom = wall.VMax - h
	end
	if vBottom < wall.VMin - TOL then
		ctx.Diagnostics:reject("bounds", nil)
		return nil
	end
	local u0, u1 = u - w * 0.5, u + w * 0.5
	local margin = COMP.WALL_EDGE_MARGIN
	if u0 < wall.UMin + margin - TOL or u1 > wall.UMax - margin + TOL then
		ctx.Diagnostics:reject("bounds", nil)
		return nil
	end
	local facade = WallPlacementEngine.facadeDepthAt(ctx, wall, u0, u1, vBottom, vBottom + h)
	local layer = opts.Layer or ARCH.LAYER_PROP
	local depth = facade + layer * eps + asset.Meta.WallOffset + S.SurfaceOffset
	local pose = PlacementMath.wallPose(asset, scale, wall, u, vBottom, {
		AnchorX = "Center",
		AnchorY = "Bottom",
		Depth = depth,
	})
	local poly = PlacementMath.footprint(pose, wall)
	if ctx.Zones:blocks(wall, poly) then
		ctx.Diagnostics:reject("exclusion", pose.BoxCFrame.Position)
		return nil
	end
	local item, reason = ctx:tryCommit(pose, {
		Surface = wall,
		Role = "Wall",
		Folder = opts.Folder or "Wall",
		PlacementType = opts.PlacementType or (if asset.Shape == "Relief" then "Relief" else "Wall"),
		Group = opts.Group or "Decor",
		Layer = layer,
		IgnoreParts = { [wall.Part] = true },
		Pos2D = Vector2.new(u, vBottom + h * 0.5),
		Radius = w * 0.5,
		Pass = opts.Pass or "WallProps",
	})
	if item then
		ctx.Diagnostics:candidate(pose.BoxCFrame.Position)
	end
	return item, reason
end

--[[
	mode : "Props" | "Relief" | "Hybrid"
	densityFactor : multiplicateur de WallDensity (façades déjà décorées...)
]]
function WallPlacementEngine.run(ctx, wall, mode, densityFactor)
	local S = ctx.Settings
	local rng = ctx.Rng:fork("wall:" .. wall.Id)
	local length = wall.UMax - wall.UMin
	local height = wall.VMax - wall.VMin
	if length < Config.Geometry.MIN_SURFACE_EXTENT or height < Config.Geometry.MIN_SURFACE_EXTENT then
		return
	end
	local roles
	if mode == "Relief" then
		roles = { "Relief" }
	elseif mode == "Props" then
		roles = { "Wall" }
	else
		roles = { "Wall", "Relief" }
	end
	local palette = ctx.Selector:palette(wall, roles, rng:fork("palette"))
	if #palette == 0 then
		ctx.Diagnostics:warn("No wall asset available (PlacementType = Wall / Relief, or flat assets for auto mode).")
		return
	end
	-- Filtre : l'asset doit tenir sur le mur.
	local fitting = {}
	for _, a in ipairs(palette) do
		local cmin, cmax = PlacementMath.wallCanonBounds(a, 1, a.WallYaw, nil)
		local minScale = if a.Meta.AllowScale then math.min(1, a.Meta.MinScale or 1) else 1
		if (cmax.X - cmin.X) * minScale <= length - 2 * COMP.WALL_EDGE_MARGIN and (cmax.Y - cmin.Y) * minScale <= height then
			table.insert(fitting, a)
		else
			ctx.Diagnostics:add("TooLarge")
		end
	end
	if #fitting == 0 then
		return
	end
	local widths = {}
	for _, a in ipairs(fitting) do
		local cmin, cmax = PlacementMath.wallCanonBounds(a, 1, a.WallYaw, nil)
		table.insert(widths, cmax.X - cmin.X)
	end
	table.sort(widths)
	local typicalWidth = widths[math.ceil(#widths / 2)]

	local density = math.clamp(S.WallDensity * (densityFactor or 1), 0, 1)
	if density <= 0.01 then
		return
	end
	-- Rangées : principale + rangée haute sur les murs très hauts.
	local rows = { { Fraction = nil, Name = "Main" } }
	local medianHeight = 0
	for _, a in ipairs(fitting) do
		medianHeight += a.Size.Y
	end
	medianHeight /= #fitting
	if height > medianHeight * 4 and density > 0.3 then
		table.insert(rows, { Fraction = 0.78, Name = "Upper", ReliefOnly = true })
	end

	for ri, row in ipairs(rows) do
		local rowRng = rng:fork("row" .. ri)
		local beats = CompositionPlanner.beats(length, rowRng, S, {
			BaseSpacing = typicalWidth * (if mode == "Relief" then 1.6 else 2.2),
			Density = density,
			Symmetric = S.Symmetry >= 0.5,
			EndMargin = COMP.WALL_EDGE_MARGIN + typicalWidth * 0.3,
		})
		-- Asset imposé par position miroir pour une vraie symétrie.
		local mirrorAssets = {}
		for bi, beat in ipairs(beats) do
			if ctx:remaining() <= 0 then
				return
			end
			if beat.Kind ~= "Gap" then
				local classes = if beat.Kind == "Large" then LARGE_CLASSES elseif beat.Kind == "Medium" then MEDIUM_CLASSES else SMALL_CLASSES
				local asset
				local key = string.format("%.3f", math.abs(beat.T - length * 0.5))
				if beat.Mirror and mirrorAssets[key] then
					asset = mirrorAssets[key]
					if not ctx:assetAvailable(asset) then
						asset = nil
					end
				end
				if not asset then
					asset = ctx.Selector:pick(fitting, {
						Role = if mode == "Relief" then "Relief" else "Wall",
						SizeClasses = classes,
						Surface = wall,
						Rng = rowRng,
						Filter = function(a)
							if row.ReliefOnly and a.Shape ~= "Relief" then
								return false
							end
							return true
						end,
					}) or ctx.Selector:pick(fitting, {
						Role = if mode == "Relief" then "Relief" else "Wall",
						Surface = wall,
						Rng = rowRng,
					})
				end
				if asset then
					if not beat.Mirror then
						mirrorAssets[key] = asset
					end
					local scale = PlacementMath.resolveScale(asset, S, rowRng)
					local count = if beat.Kind == "SmallGroup" then rowRng:int(1, 2) else 1
					for j = 1, count do
						local v, anchorY = targetHeight(wall, asset, scale, row.Fraction)
						local jitterU = if beat.Mirror then 0 else (rowRng:next() - 0.5) * beat.Width * 0.3 * S.Randomness
						local jitterV = if anchorY == "Top" then 0 else (rowRng:next() - 0.5) * height * 0.08 * S.Randomness
						local u = wall.UMin + beat.T + jitterU
						if j > 1 then
							u += (rowRng:next() - 0.5) * beat.Width
							v += (rowRng:next() - 0.5) * height * 0.12
						end
						local _, reason = WallPlacementEngine.placeAt(ctx, wall, asset, scale, u, v + jitterV, anchorY, {
							Pass = "Wall" .. row.Name,
						})
						if reason then
							-- Nouvelle tentative, plus centrée dans le beat, sans jitter.
							WallPlacementEngine.placeAt(ctx, wall, asset, scale, wall.UMin + beat.T, v, anchorY, {
								Pass = "Wall" .. row.Name,
							})
						end
					end
				end
			end
			if bi % 8 == 0 then
				ctx.Yield()
			end
		end
	end
end


return WallPlacementEngine
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="37">
      <Properties>
        <string name="Name">UI</string>
      </Properties>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Theme</string>
          <string name="Source"><![CDATA[--[[
	Theme
	Couleurs synchronisées avec le thème de Studio (clair / sombre) et
	ré-appliquées automatiquement quand l'utilisateur change de thème.
]]

local Theme = {}
Theme.__index = Theme

-- Correspondance nom logique -> StudioStyleGuideColor (+ modificateur optionnel).
local MAP = {
	Background = { "MainBackground" },
	Header = { "Titlebar" },
	Section = { "Titlebar" },
	SectionHover = { "Titlebar", "Hover" },
	Text = { "MainText" },
	DimText = { "DimmedText" },
	Border = { "Border" },
	Input = { "InputFieldBackground" },
	InputBorder = { "InputFieldBorder" },
	Button = { "Button" },
	ButtonHover = { "Button", "Hover" },
	ButtonPressed = { "Button", "Pressed" },
	ButtonDisabled = { "Button", "Disabled" },
	ButtonText = { "ButtonText" },
	ButtonTextDisabled = { "ButtonText", "Disabled" },
	Primary = { "DialogMainButton" },
	PrimaryHover = { "DialogMainButton", "Hover" },
	PrimaryText = { "DialogMainButtonText" },
	Accent = { "LinkText" },
	Track = { "ScrollBarBackground" },
	Error = { "ErrorText" },
	Warning = { "WarningText" },
	Item = { "Item" },
	ItemHover = { "Item", "Hover" },
	Selected = { "Item", "Selected" },
}

local FALLBACK = {
	Background = Color3.fromRGB(46, 46, 46),
	Header = Color3.fromRGB(53, 53, 53),
	Section = Color3.fromRGB(60, 60, 60),
	SectionHover = Color3.fromRGB(70, 70, 70),
	Text = Color3.fromRGB(220, 220, 220),
	DimText = Color3.fromRGB(150, 150, 150),
	Border = Color3.fromRGB(34, 34, 34),
	Input = Color3.fromRGB(37, 37, 37),
	InputBorder = Color3.fromRGB(26, 26, 26),
	Button = Color3.fromRGB(64, 64, 64),
	ButtonHover = Color3.fromRGB(76, 76, 76),
	ButtonPressed = Color3.fromRGB(50, 50, 50),
	ButtonDisabled = Color3.fromRGB(52, 52, 52),
	ButtonText = Color3.fromRGB(230, 230, 230),
	ButtonTextDisabled = Color3.fromRGB(120, 120, 120),
	Primary = Color3.fromRGB(0, 122, 204),
	PrimaryHover = Color3.fromRGB(20, 140, 222),
	PrimaryText = Color3.fromRGB(255, 255, 255),
	Accent = Color3.fromRGB(53, 181, 255),
	Track = Color3.fromRGB(41, 41, 41),
	Error = Color3.fromRGB(255, 90, 90),
	Warning = Color3.fromRGB(255, 190, 60),
	Item = Color3.fromRGB(46, 46, 46),
	ItemHover = Color3.fromRGB(66, 66, 66),
	Selected = Color3.fromRGB(11, 90, 175),
}

Theme.SuccessColor = Color3.fromRGB(80, 200, 120)

function Theme.new()
	local self = setmetatable({}, Theme)
	self._bindings = {}
	self._callbacks = {}
	self._studio = nil
	pcall(function()
		self._studio = settings().Studio
	end)
	if self._studio then
		self._connection = self._studio.ThemeChanged:Connect(function()
			self:apply()
		end)
	end
	return self
end

function Theme:color(name)
	local entry = MAP[name]
	if self._studio and entry then
		local ok, c = pcall(function()
			local theme = self._studio.Theme
			local colorEnum = Enum.StudioStyleGuideColor[entry[1]]
			if entry[2] then
				return theme:GetColor(colorEnum, Enum.StudioStyleGuideModifier[entry[2]])
			end
			return theme:GetColor(colorEnum)
		end)
		if ok and c then
			return c
		end
	end
	return FALLBACK[name] or Color3.new(1, 0, 1)
end

-- Lie une propriété à une couleur logique (ré-appliquée au changement de thème).
function Theme:bind(instance, property, name)
	instance[property] = self:color(name)
	table.insert(self._bindings, { Instance = instance, Property = property, Name = name })
end

function Theme:apply()
	local alive = {}
	for _, b in ipairs(self._bindings) do
		if b.Instance.Parent ~= nil or b.Instance:IsA("LayerCollector") then
			pcall(function()
				b.Instance[b.Property] = self:color(b.Name)
			end)
			table.insert(alive, b)
		end
	end
	self._bindings = alive
	for _, cb in ipairs(self._callbacks) do
		pcall(cb)
	end
end

-- Rappel exécuté à chaque changement de thème (contrôles à états multiples).
function Theme:onApply(callback)
	table.insert(self._callbacks, callback)
end

function Theme:destroy()
	if self._connection then
		self._connection:Disconnect()
	end
	self._bindings = {}
	self._callbacks = {}
end

return Theme
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">UIController</string>
          <string name="Source"><![CDATA[--[[
	UIController
	Construit l'interface du DockWidgetPluginGui :

	  [En-tête fixe]   titre, preset, reset
	  [Zone défilante] TARGET, ASSET LIBRARY, PLACEMENT MODE, COMPOSITION,
	                   TRANSFORM, WALL OPTIONS, FLOOR OPTIONS, CEILING,
	                   COLLISION (+ zones d'exclusion / géométrie protégée),
	                   RANDOM, ACTIONS, OUTPUT, DEBUG, DIAGNOSTICS
	  [Pied fixe]      statut + progression, Generate Preview / Regenerate /
	                   Accept / Cancel

	Les contrôles de réglages sont générés depuis le schéma de Settings ; les
	boutons appellent AppController ; l'état est rafraîchi sur ses événements.
]]

local Selection = game:GetService("Selection")

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local Settings = require(Core.Settings)
local Presets = require(Core.Presets)
local Theme = require(script.Parent.Theme)
local Widgets = require(script.Parent.Widgets)

local UIController = {}
UIController.__index = UIController

local UI = Config.UI
local HEADER_HEIGHT = 62
local FOOTER_HEIGHT = 118

local ROLE_OPTIONS = { "AUTO", "FLOOR", "WALL", "CEILING", "IGNORE" }
local ROLE_FROM_OPTION = { AUTO = "Auto", FLOOR = "Floor", WALL = "Wall", CEILING = "Ceiling", IGNORE = "Ignore" }

local SECTION_KEYS = {
	Placement = { "PlacementMode", "AutoClassify" },
	Composition = { "Density", "SpacingScale", "ClusterStrength", "EmptySpaceRatio", "LargeAssetFrequency", "MediumAssetFrequency", "SmallAssetFrequency", "Symmetry", "Randomness", "Variation", "VisualRhythm" },
	Transform = { "RotationMode", "ScaleMode", "FixedScale", "MinScale", "MaxScale", "SurfaceOffset", "SurfaceEpsilon", "AlignToSlopes" },
	Wall = { "WallTreatment", "WallMode", "WallDensity", "PillarSpacing", "TopDecoration", "BaseDecoration", "CornerDecoration", "HideOriginalWalls", "AllowModuleScaling", "MaxModuleScaleDeviation", "WallSides" },
	Floor = { "FloorAlgorithm", "KeepCenterClear", "CenterClearStart", "CenterClearEnd", "CenterClearAxis", "EdgeMargin", "EdgeDepth", "PathWidth", "AllowWallContact" },
	Ceiling = { "CeilingDecoration", "CeilingDensity" },
	Collision = { "CollisionCheck", "MinimumSpacing", "PreciseCollision", "CollideWithScene", "AvoidPreviousGenerations" },
	Output = { "MaxAssets", "CandidatesPerPlacement", "AnchorClones", "StripScripts" },
	Debug = { "DebugEnabled", "DebugBounds", "DebugNormals", "DebugZones", "DebugCandidates", "DebugRejected", "DebugSnaps", "DebugSegments" },
}

function UIController.new(plugin, widget, app, settings)
	local self = setmetatable({}, UIController)
	self.Plugin = plugin
	self.Widget = widget
	self.App = app
	self.Settings = settings
	self.Theme = Theme.new()
	self._settingWidgets = {}
	self._connections = {}
	self:_build()
	self:_bind()
	self:refreshAll()
	return self
end

function UIController:_build()
	local create = Widgets.create
	local theme = self.Theme
	local root = create("Frame", {
		Name = "ProceduralComposerRoot",
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		Parent = self.Widget,
	})
	theme:bind(root, "BackgroundColor3", "Background")
	self.Root = root

	local overlay = create("Frame", {
		Name = "Overlay",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = root,
	})
	self.Overlay = overlay
	local w = Widgets.new(theme, overlay)
	self.W = w

	-- En-tête.
	local header = create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, HEADER_HEIGHT),
		BorderSizePixel = 0,
		Parent = root,
	}, {
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
			PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 4),
		}),
	})
	theme:bind(header, "BackgroundColor3", "Header")
	w:label(header, Config.PLUGIN_DISPLAY_NAME .. "  v" .. Config.VERSION, { Bold = true, TextSize = UI.HEADER_TEXT_SIZE + 1 })
	local presetRow = create("Frame", {
		Name = "PresetRow",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, UI.ROW_HEIGHT),
		LayoutOrder = w:nextOrder(),
		Parent = header,
	})
	local presetLabel = w:label(presetRow, "Preset", { Size = UDim2.new(0, 50, 1, 0) })
	presetLabel.Position = UDim2.new()
	local presetHolder = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -130, 1, 0),
		Position = UDim2.fromOffset(52, 0),
		Parent = presetRow,
	})
	self._presetDropdown = w:dropdown(presetHolder, nil, Presets.Order, self.Settings:get("Preset"), function(name)
		self.Settings:applyPreset(name)
		self.App:setStatus("Preset '" .. name .. "' applied.", "Info")
	end)
	local resetHolder = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 72, 1, 0),
		Position = UDim2.new(1, -72, 0, 0),
		Parent = presetRow,
	})
	w:button(resetHolder, "Reset", function()
		w:confirm("Reset settings", "Restore every setting to its default value (the seed is kept)?", "Reset", function()
			self.Settings:resetDefaults()
			self.App:setStatus("Settings reset to defaults.", "Info")
		end)
	end, { Size = UDim2.fromScale(1, 1), Tooltip = "Restore default settings." })

	-- Zone défilante.
	local scroll = create("ScrollingFrame", {
		Name = "Body",
		Position = UDim2.fromOffset(0, HEADER_HEIGHT),
		Size = UDim2.new(1, 0, 1, -(HEADER_HEIGHT + FOOTER_HEIGHT)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Parent = root,
	}, {
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
	})
	theme:bind(scroll, "ScrollBarImageColor3", "DimText")
	self.Scroll = scroll

	self:_buildTargetSection(scroll)
	self:_buildLibrarySection(scroll)
	self:_buildSchemaSection(scroll, "Placement Mode", "Placement", true)
	self:_buildSchemaSection(scroll, "Composition", "Composition", true)
	self:_buildSchemaSection(scroll, "Transform", "Transform", false)
	self:_buildSchemaSection(scroll, "Wall Options", "Wall", false)
	self:_buildSchemaSection(scroll, "Floor Options", "Floor", false)
	self:_buildSchemaSection(scroll, "Ceiling", "Ceiling", false)
	self:_buildCollisionSection(scroll)
	self:_buildRandomSection(scroll)
	self:_buildActionsSection(scroll)
	self:_buildSchemaSection(scroll, "Output & Performance", "Output", false)
	self:_buildDebugSection(scroll)
	self:_buildDiagnosticsSection(scroll)

	-- Pied de page.
	local footer = create("Frame", {
		Name = "Footer",
		Size = UDim2.new(1, 0, 0, FOOTER_HEIGHT),
		Position = UDim2.new(0, 0, 1, -FOOTER_HEIGHT),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = root,
	}, {
		create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 4),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
		}),
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
			PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8),
		}),
	})
	theme:bind(footer, "BackgroundColor3", "Header")
	self._status = w:progress(footer)
	local row1 = w:buttonRow(footer, {
		{ Key = "Generate", Text = "Generate Preview", Primary = true, Callback = function()
			self.App:generatePreview()
		end, Tooltip = "Generate a temporary preview with the current seed." },
		{ Key = "Regenerate", Text = "Regenerate", Callback = function()
			self.App:regenerate()
		end, Tooltip = "Generate a new variant (new seed if enabled)." },
	})
	local row2 = w:buttonRow(footer, {
		{ Key = "Accept", Text = "Accept", Callback = function()
			self.App:accept()
		end, Tooltip = "Keep the preview as Generation_NNN (Ctrl+Z undoes it)." },
		{ Key = "Cancel", Text = "Cancel", Callback = function()
			self.App:cancel()
		end, Tooltip = "Delete the preview completely." },
	})
	self._footerButtons = { Generate = row1.Generate, Regenerate = row1.Regenerate, Accept = row2.Accept, Cancel = row2.Cancel }

	root.MouseEnter:Connect(function()
		self:refreshButtons()
	end)
end

-- Sections ------------------------------------------------------------------------------

function UIController:_buildTargetSection(parent)
	local w = self.W
	local content = w:section(parent, "Target", true)
	w:buttonRow(content, {
		{ Text = "Use Current Selection", Callback = function()
			self.App:useSelectionAsTargets()
		end, Tooltip = "Use the selected Parts / Models / Folders as the zone to decorate." },
		{ Text = "Analyse Selection", Callback = function()
			self.App:analyse()
		end, Tooltip = "Re-analyse the current targets (after moving or resizing them)." },
	})
	self._targetInfo = w:info(content, "No target selected.")
	w:label(content, "Target Surfaces (role per part, forced roles override the analysis):", { Wrap = true, Color = "DimText" })
	local list = Widgets.create("Frame", {
		Name = "SurfaceList",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = w:nextOrder(),
		Parent = content,
	}, {
		Widgets.create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
	})
	self._surfaceList = list
end

function UIController:_buildLibrarySection(parent)
	local w = self.W
	local content = w:section(parent, "Asset Library", true)
	w:buttonRow(content, {
		{ Text = "Use Current Selection as Library", Callback = function()
			self.App:useSelectionAsLibrary()
		end, Tooltip = "Select one or more Folders / Models containing your assets." },
	})
	w:buttonRow(content, {
		{ Text = "Rescan Library", Callback = function()
			self.App:rescanLibrary()
		end, Tooltip = "Re-analyse the library (after editing assets or attributes)." },
	})
	self._libCount = w:keyValue(content, "Asset count")
	self._libRoots = w:info(content, "No library selected.")
	self._libCategories = w:info(content, "")
	self._libRoles = w:info(content, "")
	self._libSizes = w:info(content, "")
	self._libWarnings = w:info(content, "", "Warning")
end

function UIController:_buildSetting(parent, key)
	local w = self.W
	local entry = Settings.ByKey[key]
	local value = self.Settings:get(key)
	local function onChange(v)
		self.Settings:set(key, v)
	end
	local api
	if entry.Type == "number" then
		api = w:slider(parent, entry.Label, entry.Min, entry.Max, entry.Step, value, onChange, entry.Tooltip)
	elseif entry.Type == "int" then
		api = w:numberInput(parent, entry.Label, value, onChange, { Integer = true, Min = entry.Min, Max = entry.Max, Tooltip = entry.Tooltip })
	elseif entry.Type == "bool" then
		api = w:toggle(parent, entry.Label, value, onChange, entry.Tooltip)
	elseif entry.Type == "enum" then
		api = w:dropdown(parent, entry.Label, entry.Options, value, onChange, entry.Tooltip)
	end
	self._settingWidgets[key] = api
	return api
end

function UIController:_buildSchemaSection(parent, title, sectionKey, expanded)
	local content = self.W:section(parent, title, expanded)
	for _, key in ipairs(SECTION_KEYS[sectionKey]) do
		self:_buildSetting(content, key)
	end
	return content
end

function UIController:_buildCollisionSection(parent)
	local w = self.W
	local content = self:_buildSchemaSection(parent, "Collision", "Collision", false)
	w:label(content, "Exclusion zones", { Bold = true })
	w:buttonRow(content, {
		{ Text = "Use Selection as Zones", Callback = function()
			self.App:useSelectionAsExclusions()
		end, Tooltip = "Selected Parts become forbidden zones (spawn, path, door, NPC...)." },
		{ Text = "Clear Zones", Callback = function()
			self.App:clearExclusions()
		end },
	})
	w:buttonRow(content, {
		{ Text = "Create Center Exclusion Zone", Callback = function()
			self.App:createCenterExclusionZone()
		end, Tooltip = "Creates a visible, resizable zone Part in the middle of each analysed floor (Clear zone start/end, Floor Options). Tagged ProceduralPlacementExclude: nothing is ever placed inside." },
	})
	self._zonesInfo = w:info(content, "")
	w:label(content, "Protected geometry", { Bold = true })
	w:buttonRow(content, {
		{ Text = "Use Selection as Protected", Callback = function()
			self.App:useSelectionAsProtected()
		end, Tooltip = "Selected Parts can never be overlapped by generated assets." },
		{ Text = "Clear Protected", Callback = function()
			self.App:clearProtected()
		end },
	})
	self._protectedInfo = w:info(content, "")
end

function UIController:_buildRandomSection(parent)
	local w = self.W
	local content = w:section(parent, "Random", true)
	self:_buildSetting(content, "Seed")
	w:buttonRow(content, {
		{ Text = "Random Seed", Callback = function()
			self.App:randomizeSeed()
		end, Tooltip = "Pick a new random seed (same seed + same settings + same assets = same result)." },
	})
	self:_buildSetting(content, "NewSeedOnRegenerate")
end

function UIController:_buildActionsSection(parent)
	local w = self.W
	local content = w:section(parent, "Actions", true)
	local r1 = w:buttonRow(content, {
		{ Key = "Analyse", Text = "Analyse", Callback = function()
			self.App:analyse()
		end },
		{ Key = "Generate", Text = "Generate Preview", Primary = true, Callback = function()
			self.App:generatePreview()
		end },
	})
	local r2 = w:buttonRow(content, {
		{ Key = "Regenerate", Text = "Regenerate", Callback = function()
			self.App:regenerate()
		end },
		{ Key = "Accept", Text = "Accept", Callback = function()
			self.App:accept()
		end },
	})
	local r3 = w:buttonRow(content, {
		{ Key = "Cancel", Text = "Cancel", Callback = function()
			self.App:cancel()
		end },
		{ Key = "Clear", Text = "Clear Generated", Callback = function()
			self:_confirmClear()
		end, Tooltip = "Delete every generated folder (with confirmation, undoable)." },
	})
	self._actionButtons = {
		Analyse = r1.Analyse, Generate = r1.Generate, Regenerate = r2.Regenerate,
		Accept = r2.Accept, Cancel = r3.Cancel, Clear = r3.Clear,
	}
end

function UIController:_confirmClear()
	local count = self.App:generationCount() + (if self.App:hasPreview() then 1 else 0)
	self.W:confirm("Clear generated content",
		string.format("Delete %d generated folder(s) from '%s'? Hidden original walls will be restored. You can undo with Ctrl+Z.", count, Config.Output.ROOT_NAME),
		"Delete", function()
			self.App:clearGenerated()
		end)
end

function UIController:_buildDebugSection(parent)
	local w = self.W
	local content = self:_buildSchemaSection(parent, "Debug", "Debug", false)
	w:buttonRow(content, {
		{ Text = "Redraw Debug", Callback = function()
			self.App:redrawDebug()
		end },
		{ Text = "Clear Debug", Callback = function()
			self.App:clearDebug()
		end },
	})
end

function UIController:_buildDiagnosticsSection(parent)
	local w = self.W
	local content = w:section(parent, "Diagnostics", true)
	self._diag = {}
	for _, key in ipairs({
		"Surfaces", "Corners", "Assets in library", "Placed assets", "Placement attempts",
		"Rejected attempts", "Overlaps prevented", "Exclusion rejections", "Modules fitted", "Generation time",
	}) do
		self._diag[key] = w:keyValue(content, key)
	end
	self._diagWarnings = w:info(content, "", "Warning")
	self._diagPasses = w:info(content, "")
end

-- Liaisons ------------------------------------------------------------------------------------

function UIController:_bind()
	table.insert(self._connections, self.Settings:onChanged(function(key, value)
		local api = self._settingWidgets[key]
		if api and api.Set then
			api.Set(value)
		end
		if key == "Preset" then
			self._presetDropdown.Set(value)
		elseif string.sub(key, 1, 5) == "Debug" then
			self.App:redrawDebug()
		elseif key == "AutoClassify" then
			if self.App.Registry:count() > 0 then
				self.App.Registry:finalizeRoles(value)
				self.App.LibrarySummary = self.App.Registry:summary()
				self:refreshLibrary()
			end
		elseif key == "WallSides" then
			if self.App.Analysis then
				self.App:analyse()
			end
		end
	end))
	self.App:onChanged(function(kind)
		if kind == "status" then
			self:refreshStatus()
		elseif kind == "analysis" then
			self:refreshTargets()
			self:refreshStatus()
		elseif kind == "library" then
			self:refreshLibrary()
			self:refreshStatus()
		elseif kind == "zones" then
			self:refreshZones()
			self:refreshStatus()
		else
			self:refreshAll()
		end
		self:refreshButtons()
	end)
end

-- Rafraîchissements -------------------------------------------------------------------------------

function UIController:refreshStatus()
	local s = self.App.Status
	self._status.Set(s.Progress, s.Text, s.Level)
end

function UIController:refreshButtons()
	local app = self.App
	local busy = app.Busy
	local hasPreview = app:hasPreview()
	local hasAny = hasPreview or app:generationCount() > 0
	for _, set in ipairs({ self._footerButtons, self._actionButtons }) do
		if set.Generate then
			set.Generate.SetEnabled(not busy)
		end
		if set.Regenerate then
			set.Regenerate.SetEnabled(not busy and hasPreview)
		end
		if set.Accept then
			set.Accept.SetEnabled(not busy and hasPreview)
		end
		if set.Cancel then
			set.Cancel.SetEnabled(not busy and hasPreview)
		end
	end
	self._actionButtons.Analyse.SetEnabled(not busy)
	self._actionButtons.Clear.SetEnabled(not busy and hasAny)
end

function UIController:refreshTargets()
	local app = self.App
	local analysis = app.Analysis
	for _, child in ipairs(self._surfaceList:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
	if not analysis then
		self._targetInfo.Set(if #app.TargetRoots > 0 then "Targets set but not analysed." else "No target selected.")
		return
	end
	local parallel = ""
	if #analysis.WallPairs > 0 then
		local d = {}
		for i, p in ipairs(analysis.WallPairs) do
			if i > 3 then
				break
			end
			table.insert(d, string.format("%.1f", p.Distance))
		end
		parallel = "\nDistance between parallel walls: " .. table.concat(d, ", ") .. " studs"
	end
	self._targetInfo.Set(string.format("%d part(s) · %d surface(s): %d floor, %d wall, %d ceiling, %d slope · %d corner(s)%s",
		#analysis.Parts, #analysis.Surfaces, #analysis.Floors, #analysis.Walls, #analysis.Ceilings, #analysis.Slopes, #analysis.Corners, parallel))

	-- Rôles détectés par Part.
	local rolesByPart = {}
	for _, s in ipairs(analysis.Surfaces) do
		local t = rolesByPart[s.Part]
		if not t then
			t = {}
			rolesByPart[s.Part] = t
		end
		table.insert(t, string.format("%s %.0f×%.0f", s.Role, s.UMax - s.UMin, s.VMax - s.VMin))
	end
	local w = self.W
	local create = Widgets.create
	for i, info in ipairs(analysis.PartInfos) do
		if i > UI.MAX_SURFACE_ROWS then
			w:info(self._surfaceList, string.format("... and %d more part(s).", #analysis.PartInfos - UI.MAX_SURFACE_ROWS))
			break
		end
		local part = info.Part
		local row = create("Frame", {
			Name = "PartRow",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, UI.ROW_HEIGHT),
			LayoutOrder = i,
			Parent = self._surfaceList,
		})
		local detected = rolesByPart[part]
		local text = part.Name .. "  ·  " .. (if detected then table.concat(detected, ", ") else "ignored")
		local nameButton = create("TextButton", {
			BackgroundTransparency = 1,
			Size = UDim2.new(0.64, -4, 1, 0),
			Font = UI.FONT,
			TextSize = UI.TEXT_SIZE,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = text,
			Parent = row,
		})
		self.Theme:bind(nameButton, "TextColor3", if detected then "Text" else "DimText")
		nameButton.Activated:Connect(function()
			if part.Parent then
				Selection:Set({ part })
			end
		end)
		w:tooltip(nameButton, part:GetFullName() .. "\nClick to select this part.")
		local holder = create("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(0.36, 0, 1, 0),
			Position = UDim2.new(0.64, 0, 0, 0),
			Parent = row,
		})
		local current = string.upper(app:getOverride(part))
		w:dropdown(holder, nil, ROLE_OPTIONS, current, function(option)
			app:setOverride(part, ROLE_FROM_OPTION[option])
		end)
	end
end

function UIController:refreshLibrary()
	local app = self.App
	local summary = app.LibrarySummary
	local roots = {}
	for _, r in ipairs(app.LibraryRoots) do
		if r.Parent then
			table.insert(roots, r.Name)
		end
	end
	if not summary then
		self._libCount.Set(0)
		self._libRoots.Set("No library selected.")
		self._libCategories.Set("")
		self._libRoles.Set("")
		self._libSizes.Set("")
		self._libWarnings.Set("")
		return
	end
	self._libCount.Set(summary.Count)
	self._libRoots.Set("Library: " .. (if #roots > 0 then table.concat(roots, ", ") else "-"))
	self._libCategories.Set("Categories detected: " .. (if #summary.Categories > 0 then table.concat(summary.Categories, ", ") else "-"))
	local roleParts = {}
	for _, role in ipairs(Config.Roles) do
		local n = summary.RoleCounts[role] or 0
		if n > 0 then
			table.insert(roleParts, role .. " " .. n)
		end
	end
	self._libRoles.Set("Roles: " .. (if #roleParts > 0 then table.concat(roleParts, " · ") else "-"))
	local s = summary.SizeCounts
	self._libSizes.Set(string.format("Sizes: Small %d · Medium %d · Large %d · Hero %d", s.Small or 0, s.Medium or 0, s.Large or 0, s.Hero or 0))
	local warnings = {}
	for i, wtext in ipairs(summary.Warnings) do
		if i > 6 then
			table.insert(warnings, string.format("... %d more (see Output).", #summary.Warnings - 6))
			break
		end
		table.insert(warnings, "• " .. wtext)
	end
	self._libWarnings.Set(table.concat(warnings, "\n"))
end

function UIController:refreshZones()
	local app = self.App
	local tagged = app:taggedExclusionCount()
	self._zonesInfo.Set(string.format("%d selected zone part(s) · %d tagged '%s'", #app.ExclusionParts, tagged, Config.Tags.EXCLUDE))
	self._protectedInfo.Set(string.format("%d protected part(s) (tag '%s' also supported)", #app.ProtectedParts, Config.Tags.PROTECTED))
end

function UIController:refreshDiagnostics()
	local plan = self.App.LastPlan
	if not plan then
		for _, api in pairs(self._diag) do
			api.Set("-")
		end
		self._diagWarnings.Set("")
		self._diagPasses.Set("")
		return
	end
	for _, line in ipairs(plan.Diagnostics:summaryLines()) do
		local api = self._diag[line[1]]
		if api then
			api.Set(line[2])
		end
	end
	local warnings = {}
	for i, wtext in ipairs(plan.Diagnostics.Warnings) do
		if i > 8 then
			table.insert(warnings, string.format("... %d more.", #plan.Diagnostics.Warnings - 8))
			break
		end
		table.insert(warnings, "• " .. wtext)
	end
	self._diagWarnings.Set(table.concat(warnings, "\n"))
	local passes = {}
	local names = {}
	for name in pairs(plan.Diagnostics.PerPass) do
		table.insert(names, name)
	end
	table.sort(names)
	for _, name in ipairs(names) do
		table.insert(passes, name .. " " .. plan.Diagnostics.PerPass[name])
	end
	self._diagPasses.Set(if #passes > 0 then "Per pass: " .. table.concat(passes, " · ") else "")
end

function UIController:refreshAll()
	self:refreshStatus()
	self:refreshTargets()
	self:refreshLibrary()
	self:refreshZones()
	self:refreshDiagnostics()
	self:refreshButtons()
end

function UIController:destroy()
	for _, disconnect in ipairs(self._connections) do
		pcall(disconnect)
	end
	self.Theme:destroy()
	if self.Root then
		self.Root:Destroy()
	end
end

return UIController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">Widgets</string>
          <string name="Source"><![CDATA[--[[
	Widgets
	Bibliothèque de composants d'interface pour DockWidgetPluginGui, cohérente
	avec le thème de Studio : sections repliables, boutons, cases à cocher,
	sliders avec saisie numérique, listes déroulantes, champs numériques,
	lignes clé/valeur, barre de progression, boîte de confirmation, infobulles.

	Chaque contrôle renvoie une petite API { Instance, Set(value), ... }.
	Set() ne rappelle jamais le callback (pas de boucle avec les Settings).
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)

local Widgets = {}
Widgets.__index = Widgets

local UI = Config.UI
local ROW = UI.ROW_HEIGHT
local PAD = UI.PADDING

local function create(className, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
Widgets.create = create

local function decimalsForStep(step)
	if not step or step >= 1 then
		return 0
	elseif step >= 0.1 then
		return 1
	elseif step >= 0.01 then
		return 2
	end
	return 3
end

local function formatNumber(value, decimals)
	return string.format("%." .. tostring(decimals) .. "f", value)
end

function Widgets.new(theme, overlay)
	local self = setmetatable({}, Widgets)
	self.Theme = theme
	self.Overlay = overlay
	self._order = 0
	return self
end

function Widgets:nextOrder()
	self._order += 1
	return self._order
end

function Widgets:corner(inst, radius)
	create("UICorner", { CornerRadius = UDim.new(0, radius or 4), Parent = inst })
end

function Widgets:stroke(inst, colorName)
	local s = create("UIStroke", { Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = inst })
	self.Theme:bind(s, "Color", colorName or "Border")
	return s
end

-- Texte ---------------------------------------------------------------------------

function Widgets:label(parent, text, opts)
	opts = opts or {}
	local l = create("TextLabel", {
		Name = opts.Name or "Label",
		BackgroundTransparency = 1,
		Size = opts.Size or UDim2.new(1, 0, 0, ROW),
		AutomaticSize = if opts.Wrap then Enum.AutomaticSize.Y else Enum.AutomaticSize.None,
		Font = if opts.Bold then UI.FONT_BOLD else UI.FONT,
		TextSize = opts.TextSize or UI.TEXT_SIZE,
		Text = text,
		TextWrapped = opts.Wrap == true,
		TextXAlignment = opts.Align or Enum.TextXAlignment.Left,
		TextYAlignment = if opts.Wrap then Enum.TextYAlignment.Top else Enum.TextYAlignment.Center,
		TextTruncate = if opts.Wrap then Enum.TextTruncate.None else Enum.TextTruncate.AtEnd,
		LayoutOrder = opts.Order or self:nextOrder(),
		RichText = opts.Rich == true,
		Parent = parent,
	})
	self.Theme:bind(l, "TextColor3", opts.Color or "Text")
	return l
end

function Widgets:info(parent, text, colorName)
	local l = self:label(parent, text, { Wrap = true, Color = colorName or "DimText" })
	create("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2), Parent = l })
	local api = { Instance = l }
	function api.Set(newText, newColor)
		l.Text = newText
		if newColor then
			l.TextColor3 = if typeof(newColor) == "Color3" then newColor else self.Theme:color(newColor)
		end
	end
	return api
end

-- Infobulle simple dans l'overlay.
function Widgets:tooltip(target, text)
	if not text or text == "" then
		return
	end
	local tip
	target.MouseEnter:Connect(function()
		if tip then
			tip:Destroy()
		end
		local overlay = self.Overlay
		local pos = target.AbsolutePosition - overlay.AbsolutePosition
		tip = create("TextLabel", {
			Name = "Tooltip",
			Size = UDim2.new(0, math.min(260, overlay.AbsoluteSize.X - 16), 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Position = UDim2.fromOffset(math.clamp(pos.X, 4, math.max(4, overlay.AbsoluteSize.X - 264)), pos.Y + target.AbsoluteSize.Y + 2),
			Font = UI.FONT,
			TextSize = UI.TEXT_SIZE - 1,
			TextWrapped = true,
			Text = text,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 50,
			Parent = overlay,
		})
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
			PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = tip,
		})
		tip.BackgroundColor3 = self.Theme:color("Header")
		tip.TextColor3 = self.Theme:color("Text")
		self:stroke(tip, "Border")
		self:corner(tip, 3)
	end)
	target.MouseLeave:Connect(function()
		if tip then
			tip:Destroy()
			tip = nil
		end
	end)
end

-- Section repliable -------------------------------------------------------------------

function Widgets:section(parent, title, expanded)
	local container = create("Frame", {
		Name = "Section_" .. title,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = self:nextOrder(),
		Parent = parent,
	}, {
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 0) }),
	})
	local header = create("TextButton", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, ROW + 4),
		AutoButtonColor = false,
		Font = UI.FONT_BOLD,
		TextSize = UI.HEADER_TEXT_SIZE,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		LayoutOrder = 1,
		Parent = container,
	})
	self.Theme:bind(header, "BackgroundColor3", "Section")
	self.Theme:bind(header, "TextColor3", "Text")
	header.BorderSizePixel = 0
	local arrow = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 18, 1, 0),
		Position = UDim2.fromOffset(6, 0),
		Font = UI.FONT_BOLD,
		TextSize = UI.TEXT_SIZE,
		Text = if expanded then "▼" else "▶",
		Parent = header,
	})
	self.Theme:bind(arrow, "TextColor3", "DimText")
	local titleLabel = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -30, 1, 0),
		Position = UDim2.fromOffset(26, 0),
		Font = UI.FONT_BOLD,
		TextSize = UI.HEADER_TEXT_SIZE,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = string.upper(title),
		Parent = header,
	})
	self.Theme:bind(titleLabel, "TextColor3", "Text")
	local content = create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = expanded,
		LayoutOrder = 2,
		Parent = container,
	}, {
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }),
		create("UIPadding", {
			PaddingLeft = UDim.new(0, PAD + 2), PaddingRight = UDim.new(0, PAD + 2),
			PaddingTop = UDim.new(0, PAD), PaddingBottom = UDim.new(0, PAD + 2),
		}),
	})
	header.MouseEnter:Connect(function()
		header.BackgroundColor3 = self.Theme:color("SectionHover")
	end)
	header.MouseLeave:Connect(function()
		header.BackgroundColor3 = self.Theme:color("Section")
	end)
	header.Activated:Connect(function()
		content.Visible = not content.Visible
		arrow.Text = if content.Visible then "▼" else "▶"
	end)
	return content, container
end

-- Ligne libellé + contrôle.
function Widgets:row(parent, labelText, tooltip, labelWidth)
	local row = create("Frame", {
		Name = "Row_" .. labelText,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, ROW),
		LayoutOrder = self:nextOrder(),
		Parent = parent,
	})
	local lw = labelWidth or 0.46
	local l = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(lw, -4, 1, 0),
		Font = UI.FONT,
		TextSize = UI.TEXT_SIZE,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = labelText,
		Parent = row,
	})
	self.Theme:bind(l, "TextColor3", "Text")
	self:tooltip(l, tooltip)
	local control = create("Frame", {
		Name = "Control",
		BackgroundTransparency = 1,
		Size = UDim2.new(1 - lw, 0, 1, 0),
		Position = UDim2.new(lw, 0, 0, 0),
		Parent = row,
	})
	return row, control, l
end

-- Boutons ---------------------------------------------------------------------------------

function Widgets:button(parent, text, callback, opts)
	opts = opts or {}
	local primary = opts.Primary == true
	local b = create("TextButton", {
		Name = "Button_" .. text,
		Size = opts.Size or UDim2.new(1, 0, 0, ROW + 2),
		AutoButtonColor = false,
		Font = if primary then UI.FONT_BOLD else UI.FONT,
		TextSize = UI.TEXT_SIZE,
		Text = text,
		LayoutOrder = opts.Order or self:nextOrder(),
		Parent = parent,
	})
	b.BorderSizePixel = 0
	self:corner(b, 4)
	self:stroke(b, "Border")
	local enabled = true
	local hovering = false
	local function refresh()
		if not enabled then
			b.BackgroundColor3 = self.Theme:color("ButtonDisabled")
			b.TextColor3 = self.Theme:color("ButtonTextDisabled")
		elseif primary then
			b.BackgroundColor3 = self.Theme:color(if hovering then "PrimaryHover" else "Primary")
			b.TextColor3 = self.Theme:color("PrimaryText")
		else
			b.BackgroundColor3 = self.Theme:color(if hovering then "ButtonHover" else "Button")
			b.TextColor3 = self.Theme:color("ButtonText")
		end
	end
	refresh()
	self.Theme:onApply(refresh)
	b.MouseEnter:Connect(function()
		hovering = true
		refresh()
	end)
	b.MouseLeave:Connect(function()
		hovering = false
		refresh()
	end)
	b.Activated:Connect(function()
		if enabled and callback then
			task.spawn(callback)
		end
	end)
	self:tooltip(b, opts.Tooltip)
	local api = { Instance = b }
	function api.SetEnabled(value)
		enabled = value
		refresh()
	end
	function api.SetText(value)
		b.Text = value
	end
	api.Refresh = refresh
	return api
end

-- Rangée de boutons de largeur égale.
function Widgets:buttonRow(parent, defs)
	local row = create("Frame", {
		Name = "ButtonRow",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, ROW + 2),
		LayoutOrder = self:nextOrder(),
		Parent = parent,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 4),
		}),
	})
	local apis = {}
	local n = #defs
	for i, def in ipairs(defs) do
		local api = self:button(row, def.Text, def.Callback, {
			Primary = def.Primary,
			Tooltip = def.Tooltip,
			Order = i,
			Size = UDim2.new(1 / n, -math.ceil(4 * (n - 1) / n), 1, 0),
		})
		apis[def.Key or def.Text] = api
	end
	return apis, row
end

-- Case à cocher --------------------------------------------------------------------------

function Widgets:toggle(parent, label, value, onChange, tooltip)
	local _, control = self:row(parent, label, tooltip, 0.8)
	local box = create("TextButton", {
		Name = "Toggle",
		Size = UDim2.new(0, ROW - 4, 0, ROW - 4),
		Position = UDim2.new(1, -(ROW - 4), 0.5, -(ROW - 4) / 2),
		AutoButtonColor = false,
		Font = UI.FONT_BOLD,
		TextSize = UI.TEXT_SIZE,
		Text = "",
		Parent = control,
	})
	box.BorderSizePixel = 0
	self:corner(box, 3)
	self:stroke(box, "InputBorder")
	local current = value == true
	local function refresh()
		box.Text = if current then "✓" else ""
		box.BackgroundColor3 = self.Theme:color(if current then "Primary" else "Input")
		box.TextColor3 = self.Theme:color("PrimaryText")
	end
	refresh()
	self.Theme:onApply(refresh)
	box.Activated:Connect(function()
		current = not current
		refresh()
		if onChange then
			onChange(current)
		end
	end)
	local api = { Instance = box }
	function api.Set(v)
		current = v == true
		refresh()
	end
	return api
end

-- Champ texte numérique (utilisé seul ou avec un slider).
function Widgets:_numberBox(parent, value, decimals, size, position)
	local box = create("TextBox", {
		Name = "NumberBox",
		Size = size,
		Position = position or UDim2.new(),
		ClearTextOnFocus = false,
		Font = UI.FONT,
		TextSize = UI.TEXT_SIZE,
		Text = formatNumber(value, decimals),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = parent,
	})
	box.BorderSizePixel = 0
	self.Theme:bind(box, "BackgroundColor3", "Input")
	self.Theme:bind(box, "TextColor3", "Text")
	self:corner(box, 3)
	self:stroke(box, "InputBorder")
	return box
end

function Widgets:numberInput(parent, label, value, onChange, opts)
	opts = opts or {}
	local _, control = self:row(parent, label, opts.Tooltip)
	local decimals = if opts.Integer then 0 else decimalsForStep(opts.Step)
	local box = self:_numberBox(control, value, decimals, UDim2.new(1, 0, 1, -2), UDim2.fromOffset(0, 1))
	local current = value
	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then
			if opts.Integer then
				n = math.floor(n + 0.5)
			end
			if opts.Min then
				n = math.max(opts.Min, n)
			end
			if opts.Max then
				n = math.min(opts.Max, n)
			end
			current = n
			if onChange then
				onChange(n)
			end
		end
		box.Text = formatNumber(current, decimals)
	end)
	local api = { Instance = box }
	function api.Set(v)
		current = v
		box.Text = formatNumber(v, decimals)
	end
	return api
end

-- Slider -------------------------------------------------------------------------------------

function Widgets:slider(parent, label, minValue, maxValue, step, value, onChange, tooltip)
	local _, control = self:row(parent, label, tooltip)
	local decimals = decimalsForStep(step)
	local boxWidth = 52
	local track = create("TextButton", {
		Name = "Track",
		Size = UDim2.new(1, -(boxWidth + 8), 0, 6),
		Position = UDim2.new(0, 0, 0.5, -3),
		AutoButtonColor = false,
		Text = "",
		Parent = control,
	})
	track.BorderSizePixel = 0
	self.Theme:bind(track, "BackgroundColor3", "Track")
	self:corner(track, 3)
	local fill = create("Frame", { Name = "Fill", Size = UDim2.new(0, 0, 1, 0), Parent = track })
	fill.BorderSizePixel = 0
	self.Theme:bind(fill, "BackgroundColor3", "Primary")
	self:corner(fill, 3)
	local knob = create("Frame", {
		Name = "Knob",
		Size = UDim2.fromOffset(12, 12),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Parent = track,
	})
	knob.BorderSizePixel = 0
	self.Theme:bind(knob, "BackgroundColor3", "Text")
	self:corner(knob, 6)
	local box = self:_numberBox(control, value, decimals, UDim2.new(0, boxWidth, 1, -2), UDim2.new(1, -boxWidth, 0, 1))

	local current = value
	local function quantize(v)
		v = math.clamp(v, minValue, maxValue)
		if step and step > 0 then
			v = minValue + math.floor((v - minValue) / step + 0.5) * step
			v = math.clamp(v, minValue, maxValue)
		end
		return tonumber(formatNumber(v, math.max(decimals, 3))) or v
	end
	local function render()
		local t = if maxValue > minValue then (current - minValue) / (maxValue - minValue) else 0
		t = math.clamp(t, 0, 1)
		fill.Size = UDim2.new(t, 0, 1, 0)
		knob.Position = UDim2.new(t, 0, 0.5, 0)
		box.Text = formatNumber(current, decimals)
	end
	render()
	local function setFromX(x)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local t = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		local v = quantize(minValue + t * (maxValue - minValue))
		if v ~= current then
			current = v
			render()
			if onChange then
				onChange(v)
			end
		end
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		setFromX(input.Position.X)
		-- Capture plein écran pendant le glisser (la souris peut sortir du slider).
		local capture = create("TextButton", {
			Name = "DragCapture",
			BackgroundTransparency = 1,
			Text = "",
			Size = UDim2.fromScale(1, 1),
			ZIndex = 100,
			Parent = self.Overlay,
		})
		local function finish()
			if capture then
				capture:Destroy()
				capture = nil
			end
		end
		capture.InputChanged:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseMovement then
				setFromX(i.Position.X)
			end
		end)
		capture.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then
				finish()
			end
		end)
		capture.MouseButton1Up:Connect(finish)
		capture.MouseLeave:Connect(finish)
	end)
	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then
			local v = quantize(n)
			if v ~= current then
				current = v
				if onChange then
					onChange(v)
				end
			end
		end
		render()
	end)
	local api = { Instance = track }
	function api.Set(v)
		current = v
		render()
	end
	return api
end

-- Liste déroulante ----------------------------------------------------------------------------

function Widgets:dropdown(parent, label, options, value, onChange, tooltip, labelWidth)
	local control
	if label then
		local _, c = self:row(parent, label, tooltip, labelWidth)
		control = c
	else
		control = parent
	end
	local button = create("TextButton", {
		Name = "Dropdown",
		Size = UDim2.new(1, 0, 1, -2),
		Position = UDim2.fromOffset(0, 1),
		AutoButtonColor = false,
		Font = UI.FONT,
		TextSize = UI.TEXT_SIZE,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "",
		Parent = control,
	})
	button.BorderSizePixel = 0
	self.Theme:bind(button, "BackgroundColor3", "Input")
	self.Theme:bind(button, "TextColor3", "Text")
	self:corner(button, 3)
	self:stroke(button, "InputBorder")
	create("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 18), Parent = button })
	local caret = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 14, 1, 0),
		Position = UDim2.new(1, 2, 0, 0),
		Font = UI.FONT,
		TextSize = UI.TEXT_SIZE - 2,
		Text = "▼",
		Parent = button,
	})
	self.Theme:bind(caret, "TextColor3", "DimText")
	local current = value
	local opts = options
	button.Text = tostring(current)

	local popup
	local function close()
		if popup then
			popup:Destroy()
			popup = nil
		end
	end
	button.Activated:Connect(function()
		if popup then
			close()
			return
		end
		local overlay = self.Overlay
		popup = create("TextButton", {
			Name = "DropdownBlocker",
			BackgroundTransparency = 1,
			Text = "",
			Size = UDim2.fromScale(1, 1),
			ZIndex = 60,
			Parent = overlay,
		})
		popup.Activated:Connect(close)
		local rowH = ROW
		local visible = math.min(#opts, 10)
		local pos = button.AbsolutePosition - overlay.AbsolutePosition
		local height = visible * rowH + 4
		local y = pos.Y + button.AbsoluteSize.Y + 2
		if y + height > overlay.AbsoluteSize.Y then
			y = math.max(0, pos.Y - height - 2)
		end
		local list = create("ScrollingFrame", {
			Name = "List",
			Position = UDim2.fromOffset(pos.X, y),
			Size = UDim2.fromOffset(math.max(button.AbsoluteSize.X, 120), height),
			CanvasSize = UDim2.fromOffset(0, #opts * rowH + 4),
			ScrollBarThickness = 6,
			ZIndex = 61,
			Parent = popup,
		}, {
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
			create("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }),
		})
		list.BorderSizePixel = 0
		list.BackgroundColor3 = self.Theme:color("Input")
		self:stroke(list, "Border")
		for i, option in ipairs(opts) do
			local item = create("TextButton", {
				Name = "Option",
				Size = UDim2.new(1, 0, 0, rowH),
				AutoButtonColor = false,
				Font = if option == current then UI.FONT_BOLD else UI.FONT,
				TextSize = UI.TEXT_SIZE,
				TextXAlignment = Enum.TextXAlignment.Left,
				Text = "  " .. tostring(option),
				LayoutOrder = i,
				ZIndex = 62,
				Parent = list,
			})
			item.BorderSizePixel = 0
			item.BackgroundColor3 = self.Theme:color(if option == current then "Selected" else "Item")
			item.TextColor3 = self.Theme:color("Text")
			item.MouseEnter:Connect(function()
				if option ~= current then
					item.BackgroundColor3 = self.Theme:color("ItemHover")
				end
			end)
			item.MouseLeave:Connect(function()
				item.BackgroundColor3 = self.Theme:color(if option == current then "Selected" else "Item")
			end)
			item.Activated:Connect(function()
				close()
				if option ~= current then
					current = option
					button.Text = tostring(option)
					if onChange then
						onChange(option)
					end
				end
			end)
		end
	end)
	local api = { Instance = button }
	function api.Set(v)
		current = v
		button.Text = tostring(v)
	end
	function api.SetOptions(newOptions)
		opts = newOptions
	end
	return api
end

-- Clé / valeur ------------------------------------------------------------------------------------

function Widgets:keyValue(parent, key)
	local _, control = self:row(parent, key, nil, 0.5)
	local v = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = UI.FONT_BOLD,
		TextSize = UI.TEXT_SIZE,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "-",
		Parent = control,
	})
	self.Theme:bind(v, "TextColor3", "Text")
	local api = { Instance = v }
	function api.Set(value)
		v.Text = tostring(value)
	end
	return api
end

-- Barre de progression + statut ----------------------------------------------------------------

function Widgets:progress(parent)
	local frame = create("Frame", {
		Name = "Status",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = self:nextOrder(),
		Parent = parent,
	}, {
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }),
	})
	local bar = create("Frame", { Name = "Bar", Size = UDim2.new(1, 0, 0, 4), LayoutOrder = 2, Visible = false, Parent = frame })
	bar.BorderSizePixel = 0
	self.Theme:bind(bar, "BackgroundColor3", "Track")
	self:corner(bar, 2)
	local fill = create("Frame", { Size = UDim2.new(0, 0, 1, 0), Parent = bar })
	fill.BorderSizePixel = 0
	self.Theme:bind(fill, "BackgroundColor3", "Primary")
	self:corner(fill, 2)
	local text = create("TextLabel", {
		Name = "Text",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = UI.FONT,
		TextSize = UI.TEXT_SIZE,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		LayoutOrder = 1,
		Parent = frame,
	})
	self.Theme:bind(text, "TextColor3", "DimText")
	local api = { Instance = frame }
	function api.Set(fraction, message, level)
		text.Text = message or ""
		if level == "Error" then
			text.TextColor3 = self.Theme:color("Error")
		elseif level == "Warning" then
			text.TextColor3 = self.Theme:color("Warning")
		elseif level == "Success" then
			text.TextColor3 = self.Theme.SuccessColor
		else
			text.TextColor3 = self.Theme:color("DimText")
		end
		if fraction then
			bar.Visible = true
			fill.Size = UDim2.new(math.clamp(fraction, 0, 1), 0, 1, 0)
		else
			bar.Visible = false
		end
	end
	return api
end

-- Boîte de confirmation modale ---------------------------------------------------------------------

function Widgets:confirm(title, message, confirmText, onConfirm)
	local overlay = self.Overlay
	local blocker = create("TextButton", {
		Name = "ConfirmBlocker",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 80,
		Parent = overlay,
	})
	local dialog = create("Frame", {
		Name = "Dialog",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -40, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 81,
		Parent = blocker,
	}, {
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
			PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12),
		}),
	})
	dialog.BackgroundColor3 = self.Theme:color("Background")
	self:stroke(dialog, "Border")
	self:corner(dialog, 6)
	local t = self:label(dialog, title, { Bold = true, Order = 1, TextSize = UI.HEADER_TEXT_SIZE })
	t.ZIndex = 82
	local m = self:label(dialog, message, { Wrap = true, Order = 2 })
	m.ZIndex = 82
	local apis, row = self:buttonRow(dialog, {
		{ Text = "Cancel", Key = "No", Callback = function()
			blocker:Destroy()
		end },
		{ Text = confirmText or "Confirm", Key = "Yes", Primary = true, Callback = function()
			blocker:Destroy()
			onConfirm()
		end },
	})
	row.LayoutOrder = 3
	for _, api in pairs(apis) do
		api.Instance.ZIndex = 82
	end
end

return Widgets
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>