<roblox version="4">
  <Item class="Script" referent="0">
    <Properties>
      <string name="Name">ProceduralComposer</string>
      <token name="RunContext">0</token>
      <string name="Source"><![CDATA[--[[
	Procedural Composer — plugin Roblox Studio
	Point d'entrée (MainPlugin) : barre d'outils, DockWidgetPluginGui,
	chargement des réglages, contrôleurs.

	Architecture :
	  Core/        Config, Settings, Presets, Logger, Utilities, MathUtil, RandomGenerator
	  Analysis/    SelectionAnalyzer, GeometryAnalyzer, AssetAnalyzer, AssetRegistry
	  Placement/   PlacementMath, CollisionEngine, ExclusionZones, SnapEngine,
	               ModularFitter, CandidateScoring, CompositionPlanner, AssetSelector,
	               PlacementContext, FloorPlacementEngine, WallPlacementEngine,
	               ArchitectureEngine, CornerEngine, CeilingPlacementEngine
	  Generation/  AppController, GenerationManager, OutputBuilder, PreviewManager,
	               HistoryManager, DebugVisualizer, Diagnostics
	  UI/          Theme, Widgets, UIController
]]

local RunService = game:GetService("RunService")

-- Le plugin ne fait rien en mode Play / serveur de test.
if not RunService:IsEdit() then
	return
end

local PREFIX = "[Procedural Composer] "
local ICON = "rbxasset://textures/ui/GuiImagePlaceholder.png"

-- 1) Barre d'outils et bouton créés AVANT tout chargement de module :
--    le bouton apparaît toujours, même si un module échoue.
local toolbar = plugin:CreateToolbar("Procedural Composer")
local toggleButton = toolbar:CreateButton(
	"ProceduralComposerToggle",
	"Open the Procedural Composer panel (procedural level design from your asset library)",
	ICON,
	"Composer"
)
toggleButton.ClickableWhenViewportHidden = true

-- 2) Chargement protégé des modules, erreur lisible dans l'Output.
local ok, loadError = pcall(function()
	for _, module in ipairs({ script.Core.Config, script.Core.Settings, script.Core.Logger, script.Generation.AppController, script.UI.UIController }) do
		require(module :: any)
	end
end)
if not ok then
	warn(PREFIX .. "failed to load: " .. tostring(loadError))
	toggleButton.Click:Connect(function()
		warn(PREFIX .. "the plugin could not start: " .. tostring(loadError))
	end)
	return
end

local Core = script.Core
local Config = require(Core.Config)
local Settings = require(Core.Settings)
local Logger = require(Core.Logger)
local AppController = require(script.Generation.AppController)
local UIController = require(script.UI.UIController)

local widgetInfo = DockWidgetPluginGuiInfo.new(
	Enum.InitialDockState.Right,
	false,
	false,
	Config.UI.DEFAULT_WIDTH,
	Config.UI.DEFAULT_HEIGHT,
	Config.UI.MIN_WIDTH,
	Config.UI.MIN_HEIGHT
)
local widget
do
	-- API récente (asynchrone) avec repli sur l'ancienne.
	local okAsync, result = pcall(function()
		return (plugin :: any):CreateDockWidgetPluginGuiAsync(Config.UI.WIDGET_ID, widgetInfo)
	end)
	if okAsync and result then
		widget = result
	else
		widget = (plugin :: any):CreateDockWidgetPluginGui(Config.UI.WIDGET_ID, widgetInfo)
	end
end
widget.Title = Config.PLUGIN_DISPLAY_NAME
widget.Name = Config.UI.WIDGET_ID
widget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local settings = Settings.new(plugin)
settings:load()

local app = AppController.new(plugin, settings)
local uiOk, uiResult = pcall(UIController.new, plugin, widget, app, settings)
if not uiOk then
	warn(PREFIX .. "failed to build the interface: " .. tostring(uiResult))
end
local ui = if uiOk then uiResult else nil

toggleButton:SetActive(widget.Enabled)
toggleButton.Click:Connect(function()
	widget.Enabled = not widget.Enabled
end)
widget:GetPropertyChangedSignal("Enabled"):Connect(function()
	toggleButton:SetActive(widget.Enabled)
	if not widget.Enabled then
		app:clearDebug()
	end
end)

plugin.Unloading:Connect(function()
	settings:save()
	if ui then
		ui:destroy()
	end
	app:destroy()
end)

Logger.verbose("v" .. Config.VERSION .. " loaded.")
]]></string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">Analysis</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">AssetAnalyzer</string>
          <string name="Source"><![CDATA[--[[
	AssetAnalyzer
	Mesure précisément un asset (Model, Part, assemblage...) sans jamais le
	modifier, et produit une fiche AssetData.

	Repère de référence (RefFrame) :
	  - origine = position du pivot (Model:ScaleTo met à l'échelle autour de ce point) ;
	  - orientation = lacet du pivot, axe Y = haut du monde tel que l'asset est
	    rangé dans la bibliothèque (les assets sont stockés debout).
	  Un pivot décalé ou basculé n'a donc aucune influence : toutes les
	  positions sont calculées à partir de la boîte réelle mesurée dans ce repère.
	  L'avant canonique de l'asset est -Z (LookVector), modifiable par
	  l'Attachment "Facing" ou l'attribut FacingYaw.

	Toutes les mesures (boîte, sous-boîtes de collision, attachments) sont
	exprimées dans ce repère, à l'échelle 1.
]]

local CollectionService = game:GetService("CollectionService")

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local MathUtil = require(Core.MathUtil)
local Utilities = require(Core.Utilities)

local AssetAnalyzer = {}

local A = Config.Assets

local ATTACHMENT_NAMES = {
	Placement_Base = "PlacementBase",
	Placement_Back = "PlacementBack",
	Snap_Left = "SnapLeft",
	Snap_Right = "SnapRight",
	Snap_Top = "SnapTop",
	Snap_Bottom = "SnapBottom",
	Facing = "Facing",
}

local ROLE_ALIASES = {
	large = "LargeStructure",
	largestructure = "LargeStructure",
	hero = "LargeStructure",
	module = "WallModule",
	wallmodule = "WallModule",
	section = "WallModule",
	pillar = "Pillar",
	column = "Pillar",
	arch = "Arch",
	top = "WallTop",
	walltop = "WallTop",
	trim = "WallTop",
	cornice = "WallTop",
	base = "WallBase",
	wallbase = "WallBase",
	baseboard = "WallBase",
	relief = "Relief",
	filler = "Filler",
	floor = "Floor",
	wall = "Wall",
	corner = "Corner",
	ceiling = "Ceiling",
}

function AssetAnalyzer.normalizeRoleName(name)
	if type(name) ~= "string" then
		return nil
	end
	local key = string.lower((string.gsub(name, "%s", "")))
	return ROLE_ALIASES[key]
end

local function parseRoles(instance, stopAt)
	local roles = {}
	local found = false
	local value = Utilities.getInheritedAttribute(instance, "PlacementType", "string", stopAt)
	if value then
		for token in string.gmatch(value, "[^,;|]+") do
			local role = AssetAnalyzer.normalizeRoleName(token)
			if role then
				roles[role] = true
				found = true
			end
		end
	end
	local ok, tags = pcall(CollectionService.GetTags, CollectionService, instance)
	if ok then
		for _, tag in ipairs(tags) do
			if string.sub(tag, 1, #Config.Tags.ROLE_PREFIX) == Config.Tags.ROLE_PREFIX then
				local role = AssetAnalyzer.normalizeRoleName(string.sub(tag, #Config.Tags.ROLE_PREFIX + 1))
				if role then
					roles[role] = true
					found = true
				end
			end
		end
	end
	return roles, found
end

-- Lecture des métadonnées optionnelles (attributs hérités des dossiers parents).
function AssetAnalyzer.readMetadata(instance, stopAt)
	local function num(name)
		return Utilities.getInheritedAttribute(instance, name, "number", stopAt)
	end
	local function bool(name)
		return Utilities.getInheritedAttribute(instance, name, "boolean", stopAt)
	end
	local function str(name)
		return Utilities.getInheritedAttribute(instance, name, "string", stopAt)
	end
	local roles, explicit = parseRoles(instance, stopAt)
	local minScale = num("MinScale")
	local maxScale = num("MaxScale")
	if minScale and maxScale and minScale > maxScale then
		minScale, maxScale = maxScale, minScale
	end
	local sizeClass = str("SizeClass")
	if sizeClass and not table.find(A.SIZE_CLASS_ORDER, sizeClass) then
		sizeClass = nil
	end
	local allowRotation = bool("AllowRotation")
	local allowMirror = bool("AllowMirror")
	local allowScale = bool("AllowScale")
	local canTouchWall = bool("CanTouchWall")
	return {
		Roles = roles,
		ExplicitRoles = explicit,
		Weight = math.max(0, num("Weight") or A.DEFAULT_WEIGHT),
		MinScale = if minScale then math.max(0.05, minScale) else nil,
		MaxScale = if maxScale then math.max(0.05, maxScale) else nil,
		AllowRotation = if allowRotation == nil then true else allowRotation,
		AllowMirror = if allowMirror == nil then true else allowMirror,
		AllowScale = if allowScale == nil then true else allowScale,
		WallOffset = num("WallOffset") or 0,
		FloorOffset = num("FloorOffset") or 0,
		Category = str("Category"),
		Importance = num("Importance"),
		RepeatLimit = num("RepeatLimit"),
		MinSpacing = num("MinSpacing"),
		PreferredHeight = num("PreferredHeight"),
		CanTouchWall = if canTouchWall == nil then true else canTouchWall,
		CanOverlapDecoration = bool("CanOverlapDecoration") == true,
		UniqueAsset = bool("UniqueAsset") == true,
		SizeClass = sizeClass,
		Stretchable = bool("Stretchable") == true,
		CeilingFlip = bool("CeilingFlip") == true,
		WallYaw = num("WallYaw"),
		FacingYaw = num("FacingYaw"),
		AlignToSurface = bool("AlignToSurface"),
		UsePivotOrientation = bool("UsePivotOrientation") == true,
	}
end

local function isVisible(part)
	return part.Transparency < 0.999
end

-- Grille d'occupation : réduit un asset de centaines de parts à quelques boîtes.
local function occupancyBoxes(localBoxes, bmin, bmax, n)
	local size = bmax - bmin
	local cell = Vector3.new(math.max(size.X / n, 1e-3), math.max(size.Y / n, 1e-3), math.max(size.Z / n, 1e-3))
	local occupied = {}
	local function index(x, y, z)
		return x + (y - 1) * n + (z - 1) * n * n
	end
	local function cellRange(lo, hi, origin, step)
		local a = math.clamp(math.floor((lo - origin) / step) + 1, 1, n)
		local b = math.clamp(math.floor((hi - origin) / step - 1e-6) + 1, 1, n)
		return a, math.max(a, b)
	end
	for _, box in ipairs(localBoxes) do
		local x0, x1 = cellRange(box.Min.X, box.Max.X, bmin.X, cell.X)
		local y0, y1 = cellRange(box.Min.Y, box.Max.Y, bmin.Y, cell.Y)
		local z0, z1 = cellRange(box.Min.Z, box.Max.Z, bmin.Z, cell.Z)
		for z = z0, z1 do
			for y = y0, y1 do
				for x = x0, x1 do
					occupied[index(x, y, z)] = true
				end
			end
		end
	end
	local boxes = {}
	for z = 1, n do
		for y = 1, n do
			local x = 1
			while x <= n do
				if occupied[index(x, y, z)] then
					local startX = x
					while x + 1 <= n and occupied[index(x + 1, y, z)] do
						x += 1
					end
					local lo = bmin + Vector3.new((startX - 1) * cell.X, (y - 1) * cell.Y, (z - 1) * cell.Z)
					local hi = bmin + Vector3.new(x * cell.X, y * cell.Y, z * cell.Z)
					table.insert(boxes, { CFrame = CFrame.new((lo + hi) * 0.5), Size = hi - lo })
				end
				x += 1
			end
		end
	end
	return boxes
end

local function findAttachments(instance)
	local found = {}
	for _, d in ipairs(instance:GetDescendants()) do
		if d:IsA("Attachment") and ATTACHMENT_NAMES[d.Name] and not found[d.Name] then
			found[d.Name] = d
		end
	end
	return found
end

local function clamp01(x)
	return math.clamp(x, 0, 1)
end

--[[
	Classification automatique par la forme.
	Renvoie les scores de rôle (0..1), le lacet mural conseillé et une étiquette de forme.
]]
function AssetAnalyzer.classifyShape(size, fillRatio)
	local sx, sy, sz = size.X, size.Y, size.Z
	local hmax = math.max(sx, sz)
	local hmin = math.min(sx, sz)
	local eps = 1e-4

	-- Orientation murale : l'axe horizontal le plus fin doit faire face au mur
	-- (et l'axe le plus long suit le mur).
	local wallYaw = if sx + eps < sz * 0.8 then math.pi / 2 else 0
	local wx = if wallYaw == 0 then sx else sz
	local wd = if wallYaw == 0 then sz else sx
	local wh = sy

	local depthToWidth = wd / math.max(wx, eps)
	local depthToHeight = wd / math.max(wh, eps)
	local heightRatio = wh / math.max(wx, eps)
	local slenderness = sy / math.max(hmax, eps)
	local sectionRatio = hmin / math.max(hmax, eps)
	local elongation = hmax / math.max(sy, hmin, eps)
	local flatH = sy / math.max(hmax, eps)

	local scores = {}
	local shape = "Blocky"

	local isRelief = depthToWidth <= A.RELIEF_MAX_DEPTH_RATIO and depthToHeight <= A.RELIEF_MAX_DEPTH_RATIO and wh >= A.RELIEF_MIN_HEIGHT_RATIO * wx
	local isShallow = depthToWidth <= A.WALL_PROP_MAX_DEPTH_RATIO and depthToHeight <= A.WALL_PROP_MAX_DEPTH_RATIO
	local isPanel = depthToWidth <= A.PANEL_MAX_DEPTH_RATIO and depthToHeight <= A.PANEL_MAX_DEPTH_RATIO
		and heightRatio >= A.PANEL_MIN_HEIGHT_RATIO and heightRatio <= A.PANEL_MAX_HEIGHT_RATIO
	local isPillar = slenderness >= A.PILLAR_MIN_SLENDERNESS and sectionRatio >= A.PILLAR_MIN_SECTION_RATIO
	local isTrim = elongation >= A.TRIM_MIN_ELONGATION and hmax >= 3 * hmin
	local isFlatFloor = flatH <= A.FLAT_FLOOR_MAX_RATIO and not isTrim

	scores.Floor = 0.8
	scores.Wall = if isRelief then 1 elseif isShallow and not isPillar and not isTrim then 0.45 else 0.05
	scores.Relief = if isRelief then 1 else 0
	scores.WallModule = if isPanel and not isPillar then (if isRelief then 0.6 else 0.9) else 0
	scores.Arch = if scores.WallModule > 0 and fillRatio <= A.ARCH_MAX_FILL_RATIO then 0.8 else 0
	scores.Pillar = if isPillar then 1 elseif slenderness >= 1.6 and sectionRatio >= A.PILLAR_MIN_SECTION_RATIO then 0.5 else 0
	scores.WallTop = if isTrim then 1 else 0
	scores.WallBase = if isTrim then 1 else 0
	scores.Corner = if isPillar then 0.9 elseif sy >= 0.8 * hmax and sectionRatio >= 0.6 then 0.6 else 0
	scores.Ceiling = if slenderness >= 1.5 and hmax <= 6 then 0.5 elseif isFlatFloor then 0.45 else 0
	scores.LargeStructure = 0
	scores.Filler = 0

	if isRelief then
		shape = "Relief"
		scores.Floor = 0.15
	elseif isPillar then
		shape = "Vertical"
		scores.Floor = 0.7
	elseif isTrim then
		shape = "Trim"
		scores.Floor = 0.5
	elseif isPanel then
		shape = "Panel"
		scores.Floor = 0.35
	elseif isFlatFloor then
		shape = "FlatHorizontal"
		scores.Floor = 0.7
		scores.Wall = 0.05
	end
	for k, v in pairs(scores) do
		scores[k] = clamp01(v)
	end
	return scores, wallYaw, shape
end

--[[
	Analyse d'un asset.
	context = { LibraryRoot = Instance, Key = string, Order = number }
	Renvoie AssetData ou (nil, raison).
]]
function AssetAnalyzer.analyze(instance, context)
	context = context or {}
	local ok, result, reason = pcall(function()
		local parts = Utilities.collectBaseParts(instance, Config.Performance.MAX_ANALYZE_PARTS_PER_ASSET)
		if #parts == 0 then
			return nil, "contains no BasePart"
		end
		local meta = AssetAnalyzer.readMetadata(instance, context.LibraryRoot)
		local pivot = (instance :: any):GetPivot()
		local attachments = findAttachments(instance)

		-- Repère de référence : position du pivot + lacet (haut = haut du monde).
		local rotation = if meta.UsePivotOrientation then pivot.Rotation else MathUtil.yawOnly(pivot)
		local ref = CFrame.new(pivot.Position) * rotation

		-- Avant de l'asset : Attachment "Facing" puis attribut FacingYaw.
		local facingAtt = attachments.Facing
		if facingAtt then
			local front = ref:VectorToObjectSpace(facingAtt.WorldCFrame.LookVector)
			front = Vector3.new(front.X, 0, front.Z)
			if front.Magnitude > 0.2 then
				front = front.Unit
				local theta = math.atan2(front.X, -front.Z)
				ref = ref * CFrame.Angles(0, -theta, 0)
			end
		end
		if meta.FacingYaw then
			ref = ref * CFrame.Angles(0, -math.rad(meta.FacingYaw), 0)
		end

		-- Boîte visuelle réelle dans le repère de référence.
		local useParts = parts
		if A.IGNORE_INVISIBLE_PARTS_IN_BOUNDS then
			local visible = {}
			for _, p in ipairs(parts) do
				if isVisible(p) then
					table.insert(visible, p)
				end
			end
			if #visible > 0 then
				useParts = visible
			end
		end
		local bmin = Vector3.new(math.huge, math.huge, math.huge)
		local bmax = Vector3.new(-math.huge, -math.huge, -math.huge)
		local localBoxes = table.create(#useParts)
		local partsVolume = 0
		for _, p in ipairs(useParts) do
			local lo, hi = MathUtil.obbBoundsInFrame(ref, p.CFrame, p.Size)
			bmin = MathUtil.componentMin(bmin, lo)
			bmax = MathUtil.componentMax(bmax, hi)
			table.insert(localBoxes, { Min = lo, Max = hi, CFrame = ref:ToObjectSpace(p.CFrame), Size = p.Size })
			partsVolume += p.Size.X * p.Size.Y * p.Size.Z
		end
		local size = bmax - bmin
		if size.X <= 1e-4 or size.Y <= 1e-4 or size.Z <= 1e-4 then
			-- Asset "plat" (decal sur une part d'épaisseur nulle) : on impose une épaisseur minimale.
			local fix = Vector3.new(math.max(size.X, 0.01), math.max(size.Y, 0.01), math.max(size.Z, 0.01))
			local c = (bmin + bmax) * 0.5
			bmin, bmax = c - fix * 0.5, c + fix * 0.5
			size = fix
		end
		local boundsVolume = size.X * size.Y * size.Z
		local fillRatio = math.clamp(partsVolume / math.max(boundsVolume, 1e-6), 0, 1)

		-- Sous-boîtes pour la collision précise.
		local subBoxes = {}
		if #localBoxes <= A.MAX_EXACT_SUB_BOXES then
			for _, b in ipairs(localBoxes) do
				table.insert(subBoxes, { CFrame = b.CFrame, Size = b.Size })
			end
		else
			subBoxes = occupancyBoxes(localBoxes, bmin, bmax, A.OCCUPANCY_GRID)
		end

		-- Attachments exprimés dans le repère de référence.
		local localAttachments = {}
		for name, att in pairs(attachments) do
			localAttachments[ATTACHMENT_NAMES[name]] = ref:ToObjectSpace(att.WorldCFrame)
		end

		local scriptCount = 0
		for _, d in ipairs(instance:GetDescendants()) do
			if d:IsA("LuaSourceContainer") then
				scriptCount += 1
			end
		end

		local roleScores, wallYaw, shape = AssetAnalyzer.classifyShape(size, fillRatio)
		if meta.WallYaw then
			wallYaw = math.rad(meta.WallYaw)
		elseif facingAtt or meta.FacingYaw then
			-- L'avant est explicitement défini : il fait face à l'espace libre.
			wallYaw = 0
		end

		local isModel = instance:IsA("Model")
		local isPart = instance:IsA("BasePart")
		local singleStretchPart = nil
		if isPart and meta.Stretchable then
			singleStretchPart = instance
		elseif isModel and meta.Stretchable and #parts == 1 then
			singleStretchPart = parts[1]
		end

		local characteristic = 0.5 * math.max(size.X, size.Y, size.Z) + 0.5 * boundsVolume ^ (1 / 3)

		return {
			Key = context.Key or instance.Name,
			Order = context.Order or 0,
			Name = instance.Name,
			Instance = instance,
			FullName = Utilities.fullName(instance),
			LibraryRoot = context.LibraryRoot,
			Category = meta.Category or context.Category or "Default",
			IsModel = isModel,
			IsBasePart = isPart,
			PartCount = #parts,
			ScriptCount = scriptCount,
			RefFrame = ref,
			PivotFromRef = ref:ToObjectSpace(pivot),
			BoundsMin = bmin,
			BoundsMax = bmax,
			Size = size,
			Center = (bmin + bmax) * 0.5,
			FootprintRadius = 0.5 * math.sqrt(size.X * size.X + size.Z * size.Z),
			CharacteristicSize = characteristic,
			FillRatio = fillRatio,
			SubBoxes = subBoxes,
			Attachments = localAttachments,
			Meta = meta,
			AutoRoleScores = roleScores,
			RoleScores = roleScores,
			WallYaw = wallYaw,
			Shape = shape,
			IsFlat = size.Y <= Config.Precision.FLAT_ASSET_THICKNESS or shape == "FlatHorizontal",
			StretchPart = singleStretchPart,
			SizeClass = meta.SizeClass or "Medium",
		}, nil
	end)
	if not ok then
		return nil, "analysis error: " .. tostring(result)
	end
	return result, reason
end

return AssetAnalyzer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">AssetRegistry</string>
          <string name="Source"><![CDATA[--[[
	AssetRegistry
	Scanne récursivement une ou plusieurs bibliothèques (Folder, Model,
	sous-dossiers...), analyse chaque asset une seule fois (cache), classe les
	assets par taille (Small / Medium / Large / Hero) et par rôle, et fournit
	des requêtes rapides aux moteurs de placement.

	Règles de parcours :
	  - Folder (ou tout conteneur non-Model)  -> parcouru récursivement ;
	  - Model  -> un asset (jamais découpé), sauf une racine sélectionnée
	    qui ne contient aucune BasePart directe ni PrimaryPart : elle est alors
	    traitée comme un conteneur ;
	  - BasePart isolée -> un asset.
	L'ordre des assets est stable (chemin + index) : indispensable au déterminisme.
]]

local CollectionService = game:GetService("CollectionService")

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local Utilities = require(Core.Utilities)
local AssetAnalyzer = require(script.Parent.AssetAnalyzer)

local AssetRegistry = {}
AssetRegistry.__index = AssetRegistry

local A = Config.Assets

function AssetRegistry.new()
	local self = setmetatable({}, AssetRegistry)
	self.Assets = {}
	self.Roots = {}
	self.Categories = {}
	self.Warnings = {}
	self._cache = setmetatable({}, { __mode = "k" })
	self._byRole = {}
	return self
end

local function isIgnored(instance)
	local ok, tagged = pcall(CollectionService.HasTag, CollectionService, instance, Config.Tags.IGNORE)
	return ok and tagged
end

local function modelLooksLikeAsset(model)
	if model.PrimaryPart then
		return true
	end
	for _, child in ipairs(model:GetChildren()) do
		if child:IsA("BasePart") then
			return true
		end
	end
	return false
end

-- Signature légère pour invalider le cache si l'asset source a changé.
local function signature(instance)
	local ok, pivot = pcall(function()
		return (instance :: any):GetPivot()
	end)
	local count = #instance:GetDescendants()
	local p = if ok then pivot.Position else Vector3.new()
	return string.format("%d|%.3f|%.3f|%.3f", count, p.X, p.Y, p.Z)
end

function AssetRegistry:_collect(roots)
	local entries = {}
	local usedKeys = {}

	local function addAsset(instance, root, path, category)
		if #entries >= Config.Performance.MAX_LIBRARY_ASSETS then
			return
		end
		local key = path
		local n = usedKeys[key] or 0
		usedKeys[key] = n + 1
		if n > 0 then
			key = key .. "#" .. tostring(n + 1)
		end
		table.insert(entries, { Instance = instance, Root = root, Key = key, Category = category })
	end

	local function visit(instance, root, path, category, depth)
		if isIgnored(instance) then
			return
		end
		if instance:IsA("Model") then
			if depth == 0 and not modelLooksLikeAsset(instance) then
				for _, child in ipairs(instance:GetChildren()) do
					visit(child, root, path .. "/" .. child.Name, category, depth + 1)
				end
			else
				addAsset(instance, root, path, category)
			end
		elseif instance:IsA("BasePart") then
			addAsset(instance, root, path, category)
		elseif not instance:IsA("LuaSourceContainer") and #instance:GetChildren() > 0 then
			for _, child in ipairs(instance:GetChildren()) do
				-- La catégorie par défaut est le premier sous-dossier sous la racine.
				local childCategory = category
				if depth == 0 and child:IsA("Folder") then
					childCategory = child.Name
				end
				visit(child, root, path .. "/" .. child.Name, childCategory, depth + 1)
			end
		end
	end

	for _, root in ipairs(roots) do
		if typeof(root) == "Instance" and root.Parent ~= nil then
			visit(root, root, root.Name, root.Name, 0)
		end
	end
	return entries
end

function AssetRegistry:_assignSizeClasses()
	local assets = self.Assets
	local sizes = {}
	for _, a in ipairs(assets) do
		table.insert(sizes, a.CharacteristicSize)
	end
	table.sort(sizes)
	local function percentile(p)
		if #sizes == 0 then
			return 0
		end
		local idx = math.clamp(math.floor(p * (#sizes - 1) + 0.5) + 1, 1, #sizes)
		return sizes[idx]
	end
	local usePercentile = #assets >= A.PERCENTILE_MIN_ASSETS
	local tSmall, tMedium, tLarge
	if usePercentile then
		tSmall = percentile(A.PERCENTILE_THRESHOLDS.Small)
		tMedium = percentile(A.PERCENTILE_THRESHOLDS.Medium)
		tLarge = percentile(A.PERCENTILE_THRESHOLDS.Large)
	else
		tSmall = A.ABSOLUTE_SIZE_THRESHOLDS.Small
		tMedium = A.ABSOLUTE_SIZE_THRESHOLDS.Medium
		tLarge = A.ABSOLUTE_SIZE_THRESHOLDS.Large
	end
	self.SizeThresholds = { Small = tSmall, Medium = tMedium, Large = tLarge, Percentile = usePercentile }
	for _, a in ipairs(assets) do
		if a.Meta.SizeClass then
			a.SizeClass = a.Meta.SizeClass
		else
			local c = a.CharacteristicSize
			if usePercentile then
				if c <= tSmall then
					a.SizeClass = "Small"
				elseif c <= tMedium then
					a.SizeClass = "Medium"
				elseif c < tLarge then
					a.SizeClass = "Large"
				else
					a.SizeClass = "Hero"
				end
			else
				if c < tSmall then
					a.SizeClass = "Small"
				elseif c < tMedium then
					a.SizeClass = "Medium"
				elseif c < tLarge then
					a.SizeClass = "Large"
				else
					a.SizeClass = "Hero"
				end
			end
		end
		a.Importance = a.Meta.Importance or A.SIZE_CLASS_IMPORTANCE[a.SizeClass] or A.DEFAULT_IMPORTANCE
	end
end

-- Détermine les scores de rôle finaux (métadonnées > analyse automatique > sol par défaut).
function AssetRegistry:finalizeRoles(autoClassify)
	local moduleWidths = {}
	for _, a in ipairs(self.Assets) do
		if a.AutoRoleScores.WallModule and a.AutoRoleScores.WallModule >= A.ROLE_SCORE_THRESHOLD then
			table.insert(moduleWidths, if a.WallYaw == 0 then a.Size.X else a.Size.Z)
		end
	end
	table.sort(moduleWidths)
	local medianModule = if #moduleWidths > 0 then moduleWidths[math.ceil(#moduleWidths / 2)] else 0

	for _, a in ipairs(self.Assets) do
		local scores
		if a.Meta.ExplicitRoles then
			scores = {}
			for role in pairs(a.Meta.Roles) do
				scores[role] = 1
			end
			if scores.LargeStructure and not scores.Floor then
				scores.Floor = 1
			end
		elseif autoClassify then
			scores = table.clone(a.AutoRoleScores)
			if a.SizeClass == "Hero" then
				scores.LargeStructure = 1
			end
			if (scores.WallModule or 0) >= A.ROLE_SCORE_THRESHOLD and medianModule > 0 then
				local width = if a.WallYaw == 0 then a.Size.X else a.Size.Z
				if width <= medianModule * 0.5 then
					scores.Filler = 0.8
				end
			end
		else
			scores = { Floor = 1 }
		end
		a.RoleScores = scores
	end
	self:_indexRoles()
end

function AssetRegistry:_indexRoles()
	self._byRole = {}
	for _, role in ipairs(Config.Roles) do
		local list = {}
		for _, a in ipairs(self.Assets) do
			local s = a.RoleScores[role] or 0
			if s >= A.ROLE_SCORE_THRESHOLD then
				table.insert(list, a)
			end
		end
		table.sort(list, function(x, y)
			local sx, sy = x.RoleScores[role] or 0, y.RoleScores[role] or 0
			if math.abs(sx - sy) > 1e-6 then
				return sx > sy
			end
			return x.Order < y.Order
		end)
		self._byRole[role] = list
	end
end

--[[
	Scanne les racines. `onProgress(fraction, text)` optionnel.
	Renvoie un résumé.
]]
function AssetRegistry:scan(roots, autoClassify, onProgress)
	self.Roots = roots
	self.Assets = {}
	self.Warnings = {}
	self.Categories = {}
	local entries = self:_collect(roots)
	if #entries >= Config.Performance.MAX_LIBRARY_ASSETS then
		table.insert(self.Warnings, string.format("Library truncated to %d assets.", Config.Performance.MAX_LIBRARY_ASSETS))
	end
	local yielder = Utilities.createYielder()
	local categorySet = {}
	local scriptAssets = 0
	for i, entry in ipairs(entries) do
		local cached = self._cache[entry.Instance]
		local sig = signature(entry.Instance)
		local data, reason
		if cached and cached.Signature == sig and cached.Root == entry.Root then
			data = cached.Data
		else
			data, reason = AssetAnalyzer.analyze(entry.Instance, {
				LibraryRoot = entry.Root,
				Key = entry.Key,
				Order = i,
				Category = entry.Category,
			})
			if data then
				self._cache[entry.Instance] = { Signature = sig, Root = entry.Root, Data = data }
			end
		end
		if data then
			data.Order = i
			data.Key = entry.Key
			table.insert(self.Assets, data)
			if not categorySet[data.Category] then
				categorySet[data.Category] = true
				table.insert(self.Categories, data.Category)
			end
			if data.ScriptCount > 0 then
				scriptAssets += 1
			end
		else
			table.insert(self.Warnings, string.format("Asset '%s' skipped: %s.", entry.Key, tostring(reason)))
		end
		if onProgress and i % 10 == 0 then
			onProgress(i / #entries, string.format("Analysing assets %d/%d", i, #entries))
		end
		yielder()
	end
	table.sort(self.Categories)
	if scriptAssets > 0 then
		table.insert(self.Warnings, string.format("%d asset(s) contain scripts. Enable 'Strip scripts from clones' if they should not run in generated copies.", scriptAssets))
	end
	if #self.Assets == 0 then
		table.insert(self.Warnings, "The library contains no usable asset (a usable asset must contain at least one BasePart).")
	end
	self:_assignSizeClasses()
	self:finalizeRoles(autoClassify)
	return self:summary()
end

-- Retire les assets dont la source a été supprimée depuis le scan.
function AssetRegistry:validate()
	local alive = {}
	local removed = 0
	for _, a in ipairs(self.Assets) do
		if Utilities.isAlive(a.Instance) then
			table.insert(alive, a)
		else
			removed += 1
		end
	end
	if removed > 0 then
		self.Assets = alive
		self:_indexRoles()
	end
	return removed
end

function AssetRegistry:getByRole(role)
	return self._byRole[role] or {}
end

function AssetRegistry:count()
	return #self.Assets
end

function AssetRegistry:summary()
	local roleCounts = {}
	for _, role in ipairs(Config.Roles) do
		roleCounts[role] = #(self._byRole[role] or {})
	end
	local sizeCounts = { Small = 0, Medium = 0, Large = 0, Hero = 0 }
	for _, a in ipairs(self.Assets) do
		sizeCounts[a.SizeClass] = (sizeCounts[a.SizeClass] or 0) + 1
	end
	return {
		Count = #self.Assets,
		Categories = self.Categories,
		RoleCounts = roleCounts,
		SizeCounts = sizeCounts,
		Warnings = self.Warnings,
	}
end

return AssetRegistry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">GeometryAnalyzer</string>
          <string name="Source"><![CDATA[--[[
	GeometryAnalyzer
	Analyse la géométrie cible à partir de l'orientation réelle des Parts
	(jamais de leur nom) et produit des "surfaces" exploitables :

	  Surface = {
	    Id, Index, Role ("Floor" | "Wall" | "Ceiling" | "Slope"),
	    Part, PartName, FaceName,
	    Frame   : CFrame (X = U, Y = N normale sortante, Z = V),
	    Normal, U, V,
	    SizeU, SizeV,                  -- dimensions de la face
	    UMin, UMax, VMin, VMax,        -- plage utilisable (après découpes)
	    Thickness, Tilt, IsAnalytic,
	    Walls      : (sols) murs adjacents en coordonnées 2D du sol
	    Obstacles  : polygones 2D des autres géométries cibles/protégées
	    Ends       : (murs) extrémités { Min = {Type = "Free"|"Corner"}, Max = ... }
	    SupportFloor, CeilingAbove : relations
	  }

	Tout est calculé dans les repères locaux des faces : une zone tournée de
	37° dans le Workspace donne exactement la même composition relative.
]]

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)
local MathUtil = require(Core.MathUtil)
local Utilities = require(Core.Utilities)

local GeometryAnalyzer = {}

local G = Config.Geometry
local UP = MathUtil.UP
local EPS = Config.Precision.NUMERIC_EPSILON

GeometryAnalyzer.Roles = { "Auto", "Floor", "Wall", "Ceiling", "Ignore" }

local ROLE_ORDER = { Floor = 1, Slope = 2, Wall = 3, Ceiling = 4 }
local FACE_NAMES = {
	{ [1] = "Right", [-1] = "Left" },
	{ [1] = "Top", [-1] = "Bottom" },
	{ [1] = "Back", [-1] = "Front" },
}

local COS_FLOOR = math.cos(math.rad(G.FLOOR_MAX_ANGLE_DEG))
local SIN_WALL = math.sin(math.rad(G.WALL_MAX_TILT_DEG))

-- Normalise un rôle saisi (UI / attribut) : "FLOOR", "floor" -> "Floor".
function GeometryAnalyzer.normalizeRole(value)
	if type(value) ~= "string" then
		return "Auto"
	end
	local lower = string.lower(value)
	for _, role in ipairs(GeometryAnalyzer.Roles) do
		if string.lower(role) == lower then
			return role
		end
	end
	return "Auto"
end

-- Classe une normale selon son orientation.
function GeometryAnalyzer.classifyNormal(n)
	local d = n:Dot(UP)
	if d >= COS_FLOOR then
		return "Floor"
	elseif d <= -COS_FLOOR then
		return "Ceiling"
	elseif math.abs(d) <= SIN_WALL then
		return "Wall"
	end
	return if d > 0 then "Slope" else "Ceiling"
end

-- Informations d'une Part ---------------------------------------------------------

local function isAnalyticBox(part)
	return part.ClassName == "Part" and (part :: any).Shape == Enum.PartType.Block
end

function GeometryAnalyzer.partInfo(part)
	local cf = part.CFrame
	local size = part.Size
	local info = {
		Part = part,
		CFrame = cf,
		Size = size,
		Axes = { cf.XVector, cf.YVector, cf.ZVector },
		Dims = { size.X, size.Y, size.Z },
		IsWedge = part:IsA("WedgePart"),
		IsAnalytic = isAnalyticBox(part) or part:IsA("WedgePart"),
	}
	local order = { 1, 2, 3 }
	table.sort(order, function(a, b)
		if math.abs(info.Dims[a] - info.Dims[b]) > EPS then
			return info.Dims[a] < info.Dims[b]
		end
		return a < b
	end)
	info.ThinIndex = order[1]
	info.MidIndex = order[2]
	info.LongIndex = order[3]
	info.ThinRatio = info.Dims[order[1]] / math.max(info.Dims[order[2]], EPS)
	info.IsSlab = info.ThinRatio <= G.SLAB_THIN_RATIO
	return info
end

local function makeFace(info, axisIndex, sign)
	local n = info.Axes[axisIndex] * sign
	local tangents = {}
	for i = 1, 3 do
		if i ~= axisIndex then
			table.insert(tangents, { Axis = info.Axes[i], Half = info.Dims[i] * 0.5 })
		end
	end
	return {
		Normal = n,
		Center = info.CFrame.Position + n * (info.Dims[axisIndex] * 0.5),
		T1 = tangents[1],
		T2 = tangents[2],
		Thickness = info.Dims[axisIndex],
		Name = FACE_NAMES[axisIndex][sign],
		AxisIndex = axisIndex,
		Sign = sign,
		Analytic = info.IsAnalytic,
	}
end

-- Face inclinée d'un WedgePart (la pente descend de l'arrière-haut vers l'avant-bas).
local function wedgeSlopeFace(info)
	local h = info.Dims[2] * 0.5
	local d = info.Dims[3] * 0.5
	local cf = info.CFrame
	local nLocal = MathUtil.safeUnit(Vector3.new(0, d, -h), Vector3.new(0, 1, 0))
	local tLocal = MathUtil.safeUnit(Vector3.new(0, h, d), Vector3.new(0, 0, 1))
	return {
		Normal = cf:VectorToWorldSpace(nLocal),
		Center = cf.Position,
		T1 = { Axis = info.Axes[1], Half = info.Dims[1] * 0.5 },
		T2 = { Axis = cf:VectorToWorldSpace(tLocal), Half = math.sqrt(h * h + d * d) },
		Thickness = math.min(info.Dims[2], info.Dims[3]),
		Name = "Slope",
		Analytic = true,
	}
end

local function allFaces(info)
	local faces = {}
	for axis = 1, 3 do
		for _, sign in ipairs({ 1, -1 }) do
			local skip = info.IsWedge and ((axis == 2 and sign == 1) or (axis == 3 and sign == -1))
			if not skip then
				table.insert(faces, makeFace(info, axis, sign))
			end
		end
	end
	if info.IsWedge then
		table.insert(faces, wedgeSlopeFace(info))
	end
	return faces
end

local function faceArea(face)
	return face.T1.Half * face.T2.Half * 4
end

local function mostUpFace(faces)
	local best, bestDot = nil, -math.huge
	for _, f in ipairs(faces) do
		local d = f.Normal:Dot(UP)
		if d > bestDot + EPS or (math.abs(d - bestDot) <= EPS and best and faceArea(f) > faceArea(best)) then
			best, bestDot = f, d
		end
	end
	return best
end

local function mostDownFace(faces)
	local best, bestDot = nil, math.huge
	for _, f in ipairs(faces) do
		local d = f.Normal:Dot(UP)
		if d < bestDot - EPS or (math.abs(d - bestDot) <= EPS and best and faceArea(f) > faceArea(best)) then
			best, bestDot = f, d
		end
	end
	return best
end

-- Les deux faces verticales les plus larges (même axe local).
local function broadVerticalFaces(info)
	local bestAxis, bestScore = nil, -math.huge
	for axis = 1, 3 do
		local verticality = 1 - math.abs(info.Axes[axis]:Dot(UP))
		if verticality > 0.5 then
			local area = 1
			for i = 1, 3 do
				if i ~= axis then
					area *= info.Dims[i]
				end
			end
			local score = area * verticality
			if score > bestScore then
				bestAxis, bestScore = axis, score
			end
		end
	end
	if not bestAxis then
		return {}
	end
	return { makeFace(info, bestAxis, 1), makeFace(info, bestAxis, -1) }
end

-- Construction d'une surface ------------------------------------------------------

local function buildSurface(face, role, info)
	local n = face.Normal
	local u
	if role == "Wall" then
		u = MathUtil.safeUnit(n:Cross(UP), nil)
		if u.Magnitude < 0.5 then
			u = MathUtil.safeUnit(MathUtil.projectOnPlane(face.T1.Axis, n), Vector3.new(1, 0, 0))
		end
	else
		local long = if face.T1.Half >= face.T2.Half then face.T1 else face.T2
		u = MathUtil.safeUnit(MathUtil.projectOnPlane(long.Axis, n), MathUtil.anyPerpendicular(n))
	end
	local v = u:Cross(n)
	local frame = CFrame.fromMatrix(face.Center, u, n)
	local halfU = math.abs(face.T1.Axis:Dot(u)) * face.T1.Half + math.abs(face.T2.Axis:Dot(u)) * face.T2.Half
	local halfV = math.abs(face.T1.Axis:Dot(v)) * face.T1.Half + math.abs(face.T2.Axis:Dot(v)) * face.T2.Half
	return {
		Role = role,
		Part = info.Part,
		PartName = Utilities.fullName(info.Part),
		FaceName = face.Name,
		Frame = frame,
		Normal = n,
		U = u,
		V = v,
		SizeU = halfU * 2,
		SizeV = halfV * 2,
		UMin = -halfU,
		UMax = halfU,
		VMin = -halfV,
		VMax = halfV,
		Thickness = face.Thickness,
		Tilt = math.deg(math.acos(math.clamp(math.abs(n:Dot(UP)), -1, 1))),
		IsAnalytic = face.Analytic,
		Walls = {},
		Obstacles = {},
		Ends = { Min = { Type = "Free" }, Max = { Type = "Free" } },
		Corners = {},
		Info = info,
	}
end

function GeometryAnalyzer.usableArea(surface)
	return math.max(0, surface.UMax - surface.UMin) * math.max(0, surface.VMax - surface.VMin)
end

function GeometryAnalyzer.surfaceHeightWorld(surface, u, v)
	return surface.Frame:PointToWorldSpace(Vector3.new(u, 0, v)).Y
end

-- Choix des faces par rôle -------------------------------------------------------------

-- Rôle automatique d'une Part : ("Floor" | "Wall" | "Slope" | "Ceiling" | nil, faces)
local function autoRole(info)
	local faces = allFaces(info)
	if info.IsWedge then
		local slope = faces[#faces]
		local cls = GeometryAnalyzer.classifyNormal(slope.Normal)
		if cls == "Floor" or cls == "Slope" then
			return cls, { slope }
		end
		local top = mostUpFace(faces)
		if top and GeometryAnalyzer.classifyNormal(top.Normal) == "Floor" then
			return "Floor", { top }
		end
		return nil, {}
	end
	if info.IsSlab then
		local a = info.Axes[info.ThinIndex]
		local upDot = math.abs(a:Dot(UP))
		if upDot >= COS_FLOOR then
			local sign = if a:Dot(UP) >= 0 then 1 else -1
			return "Floor", { makeFace(info, info.ThinIndex, sign) }
		elseif upDot <= SIN_WALL then
			return "Wall", { makeFace(info, info.ThinIndex, 1), makeFace(info, info.ThinIndex, -1) }
		else
			local sign = if a:Dot(UP) >= 0 then 1 else -1
			return "Slope", { makeFace(info, info.ThinIndex, sign) }
		end
	end
	local top = mostUpFace(faces)
	if top then
		local cls = GeometryAnalyzer.classifyNormal(top.Normal)
		if cls == "Floor" or cls == "Slope" then
			return cls, { top }
		end
	end
	return nil, {}
end

local function forcedFaces(info, role)
	local faces = allFaces(info)
	if role == "Floor" then
		local f = mostUpFace(faces)
		return if f then { f } else {}
	elseif role == "Ceiling" then
		local f = mostDownFace(faces)
		return if f then { f } else {}
	elseif role == "Wall" then
		return broadVerticalFaces(info)
	end
	return {}
end

-- Relations ---------------------------------------------------------------------------

local function projectToSurface2D(surface, worldPoint)
	local l = surface.Frame:PointToObjectSpace(worldPoint)
	return Vector2.new(l.X, l.Z), l.Y
end

local function pointNearRect(surface, p2, tolerance)
	return p2.X >= surface.UMin - tolerance and p2.X <= surface.UMax + tolerance
		and p2.Y >= surface.VMin - tolerance and p2.Y <= surface.VMax + tolerance
end

-- Hauteur (en coordonnée V du mur) où le plan d'une surface horizontale coupe le mur.
local function wallVAtPlane(wall, plane, uSample)
	local base = wall.Frame:PointToWorldSpace(Vector3.new(uSample, 0, 0))
	-- Intersection de la droite base + V*t avec le plan de `plane`.
	local denom = wall.V:Dot(plane.Normal)
	if math.abs(denom) < 0.2 then
		return nil
	end
	local t = (plane.Frame.Position - base):Dot(plane.Normal) / denom
	return t
end

-- Le pied du mur est-il au-dessus de la surface horizontale `plane` (plan) ?
local function wallOverlapsPlan(wall, plane)
	local samples = 7
	for i = 0, samples - 1 do
		local u = wall.UMin + (wall.UMax - wall.UMin) * (i / (samples - 1))
		local vAt = wallVAtPlane(wall, plane, u)
		local vRef = if vAt then vAt else wall.VMin
		local p = wall.Frame:PointToWorldSpace(Vector3.new(u, 0, vRef))
		-- On recule légèrement dans le mur (épaisseur) pour tester le recouvrement en plan.
		local inside = p - wall.Normal * (wall.Thickness * 0.5)
		local p2 = projectToSurface2D(plane, inside)
		if pointNearRect(plane, p2, G.WALL_FLOOR_PLAN_TOLERANCE + wall.Thickness) then
			return true
		end
	end
	return false
end

local function clipWallVertically(wall, floors, ceilings)
	local uMid = (wall.UMin + wall.UMax) * 0.5
	for _, f in ipairs(floors) do
		if f.Part ~= wall.Part and wallOverlapsPlan(wall, f) then
			local vF = wallVAtPlane(wall, f, uMid)
			if vF and vF > wall.VMin - G.WALL_FLOOR_CONTACT_TOLERANCE and vF < wall.VMax - G.MIN_SURFACE_EXTENT then
				if vF > wall.VMin then
					wall.VMin = vF
				end
				if not wall.SupportFloor or vF >= (wall.SupportFloorV or -math.huge) then
					wall.SupportFloor = f
					wall.SupportFloorV = vF
				end
			end
		end
	end
	for _, c in ipairs(ceilings) do
		if c.Part ~= wall.Part and wallOverlapsPlan(wall, c) then
			local vC = wallVAtPlane(wall, c, uMid)
			if vC and vC < wall.VMax + G.WALL_FLOOR_CONTACT_TOLERANCE and vC > wall.VMin + G.MIN_SURFACE_EXTENT then
				if vC < wall.VMax then
					wall.VMax = vC
				end
				wall.CeilingAbove = c
			end
		end
	end
end

-- Détection d'un coin intérieur entre deux murs et découpe de leurs plages U.
local function detectCorner(a, b)
	local dotN = a.Normal:Dot(b.Normal)
	if math.abs(dotN) > G.CORNER_MAX_ABS_DOT then
		return nil
	end
	local denomA = a.U:Dot(b.Normal)
	local denomB = b.U:Dot(a.Normal)
	if math.abs(denomA) < 0.3 or math.abs(denomB) < 0.3 then
		return nil
	end
	local cA, cB = a.Frame.Position, b.Frame.Position
	-- Coin intérieur : chaque mur est devant l'autre.
	if (cB - cA):Dot(a.Normal) <= 0 or (cA - cB):Dot(b.Normal) <= 0 then
		return nil
	end
	local uA = (cB - cA):Dot(b.Normal) / denomA
	local uB = (cA - cB):Dot(a.Normal) / denomB
	local tolA = G.CORNER_TOLERANCE + b.Thickness
	local tolB = G.CORNER_TOLERANCE + a.Thickness
	if uA < a.UMin - tolA or uA > a.UMax + tolA then
		return nil
	end
	if uB < b.UMin - tolB or uB > b.UMax + tolB then
		return nil
	end
	-- Plage verticale commune (monde).
	local aBottom = a.Frame:PointToWorldSpace(Vector3.new(uA, 0, a.VMin)).Y
	local aTop = a.Frame:PointToWorldSpace(Vector3.new(uA, 0, a.VMax)).Y
	local bBottom = b.Frame:PointToWorldSpace(Vector3.new(uB, 0, b.VMin)).Y
	local bTop = b.Frame:PointToWorldSpace(Vector3.new(uB, 0, b.VMax)).Y
	local bottom = math.max(aBottom, bBottom)
	local top = math.min(aTop, bTop)
	if top - bottom < G.MIN_SURFACE_EXTENT then
		return nil
	end

	-- Découpe : la partie de A située derrière la face de B est inutilisable (et réciproquement).
	local aSide, bSide
	if denomA > 0 then
		if uA > a.UMin then
			a.UMin = math.min(uA, a.UMax)
		end
		aSide = "Min"
	else
		if uA < a.UMax then
			a.UMax = math.max(uA, a.UMin)
		end
		aSide = "Max"
	end
	if denomB > 0 then
		if uB > b.UMin then
			b.UMin = math.min(uB, b.UMax)
		end
		bSide = "Min"
	else
		if uB < b.UMax then
			b.UMax = math.max(uB, b.UMin)
		end
		bSide = "Max"
	end

	local cornerPoint = a.Frame:PointToWorldSpace(Vector3.new(uA, 0, 0))
	local position = Vector3.new(cornerPoint.X, bottom, cornerPoint.Z)
	-- Pour des murs non parfaitement verticaux, on projette le point à la hauteur `bottom` le long de V.
	if math.abs(a.V.Y) > 0.5 then
		local t = (bottom - cornerPoint.Y) / a.V.Y
		position = cornerPoint + a.V * t
	end
	local corner = {
		WallA = a,
		WallB = b,
		SideA = aSide,
		SideB = bSide,
		Position = position,
		Height = top - bottom,
		NormalA = a.Normal,
		NormalB = b.Normal,
		Bisector = MathUtil.safeUnit(a.Normal + b.Normal, a.Normal),
		AngleDeg = math.deg(math.acos(math.clamp(-dotN, -1, 1))),
	}
	a.Ends[aSide] = { Type = "Corner", Corner = corner, Other = b }
	b.Ends[bSide] = { Type = "Corner", Corner = corner, Other = a }
	table.insert(a.Corners, corner)
	table.insert(b.Corners, corner)
	return corner
end

-- Obstacles 2D : autres géométries qui empiètent dans l'espace libre devant la surface.
local function computeObstacles(surface, parts, probeDepth)
	local frame = surface.Frame
	local regionCf = frame * CFrame.new((surface.UMin + surface.UMax) * 0.5, probeDepth * 0.5, (surface.VMin + surface.VMax) * 0.5)
	local regionSize = Vector3.new(surface.UMax - surface.UMin, probeDepth, surface.VMax - surface.VMin)
	for _, part in ipairs(parts) do
		if part ~= surface.Part then
			local ok = MathUtil.obbIntersects(regionCf, regionSize, part.CFrame, part.Size, Config.Precision.CONTACT_TOLERANCE, 0)
			if ok then
				local poly, hMin, hMax = MathUtil.projectOBBToSurface(frame, part.CFrame, part.Size)
				if hMax > Config.Precision.CONTACT_TOLERANCE and #poly >= 3 then
					table.insert(surface.Obstacles, { Polygon = poly, Part = part, HMin = hMin, HMax = hMax })
				end
			end
		end
	end
end

-- Murs adjacents à un sol, exprimés en 2D dans le repère du sol.
local function computeFloorWalls(floor, walls)
	for _, w in ipairs(walls) do
		if w.Part ~= floor.Part and w.UMax - w.UMin > G.MIN_SURFACE_EXTENT then
			local p0w = w.Frame:PointToWorldSpace(Vector3.new(w.UMin, 0, w.VMin))
			local p1w = w.Frame:PointToWorldSpace(Vector3.new(w.UMax, 0, w.VMin))
			local p0, h0 = projectToSurface2D(floor, p0w)
			local p1, h1 = projectToSurface2D(floor, p1w)
			local heightOk = math.abs(h0) <= G.WALL_FLOOR_CONTACT_TOLERANCE + 0.05 or math.abs(h1) <= G.WALL_FLOOR_CONTACT_TOLERANCE + 0.05
			local nearOk = false
			local tol = G.WALL_FLOOR_PLAN_TOLERANCE
			for i = 0, 4 do
				local p = p0:Lerp(p1, i / 4)
				if pointNearRect(floor, p, tol) then
					nearOk = true
					break
				end
			end
			local n2 = Vector2.new(w.Normal:Dot(floor.U), w.Normal:Dot(floor.V))
			if heightOk and nearOk and n2.Magnitude > 0.5 then
				table.insert(floor.Walls, {
					Surface = w,
					P0 = p0,
					P1 = p1,
					Normal = n2.Unit,
					Length = (p1 - p0).Magnitude,
				})
			end
		end
	end
end

-- Recouvrement en plan (approximatif : AABB dans le repère du sol) entre deux surfaces horizontales.
local function planOverlapFraction(lower, upper)
	local corners = {
		upper.Frame:PointToWorldSpace(Vector3.new(upper.UMin, 0, upper.VMin)),
		upper.Frame:PointToWorldSpace(Vector3.new(upper.UMax, 0, upper.VMin)),
		upper.Frame:PointToWorldSpace(Vector3.new(upper.UMax, 0, upper.VMax)),
		upper.Frame:PointToWorldSpace(Vector3.new(upper.UMin, 0, upper.VMax)),
	}
	local minU, minV, maxU, maxV = math.huge, math.huge, -math.huge, -math.huge
	for _, c in ipairs(corners) do
		local p = projectToSurface2D(lower, c)
		minU = math.min(minU, p.X)
		minV = math.min(minV, p.Y)
		maxU = math.max(maxU, p.X)
		maxV = math.max(maxV, p.Y)
	end
	local ou = math.max(0, math.min(maxU, lower.UMax) - math.max(minU, lower.UMin))
	local ov = math.max(0, math.min(maxV, lower.VMax) - math.max(minV, lower.VMin))
	local overlap = ou * ov
	local ref = math.min(GeometryAnalyzer.usableArea(lower), (maxU - minU) * (maxV - minV))
	if ref <= EPS then
		return 0
	end
	return overlap / ref
end

-- Distance d'un point intérieur au bord d'un rectangle de surface le long d'une direction 2D.
local function rayRectDistance(surface, p2, dir2)
	local t = math.huge
	if dir2.X > 1e-6 then
		t = math.min(t, (surface.UMax - p2.X) / dir2.X)
	elseif dir2.X < -1e-6 then
		t = math.min(t, (surface.UMin - p2.X) / dir2.X)
	end
	if dir2.Y > 1e-6 then
		t = math.min(t, (surface.VMax - p2.Y) / dir2.Y)
	elseif dir2.Y < -1e-6 then
		t = math.min(t, (surface.VMin - p2.Y) / dir2.Y)
	end
	return math.max(0, t)
end

--[[
	Choix de la (des) face(s) utile(s) d'un mur :
	  - sol le plus proche : face tournée vers la plus grande partie du sol ;
	    si le mur coupe le sol en deux parties significatives, c'est un
	    séparateur et les deux faces sont décorées ;
	  - pas de sol : face tournée vers la caméra ;
	  - sinon : les deux faces.
]]
local function chooseWallFaces(wallInfo, faces, floors, camera)
	local center = wallInfo.CFrame.Position
	local bestFloor, bestDist = nil, math.huge
	for _, f in ipairs(floors) do
		if f.Part ~= wallInfo.Part then
			local p2 = projectToSurface2D(f, center)
			local du = math.max(0, math.max(f.UMin - p2.X, p2.X - f.UMax))
			local dv = math.max(0, math.max(f.VMin - p2.Y, p2.Y - f.VMax))
			local dist = math.sqrt(du * du + dv * dv)
			if dist < bestDist then
				bestFloor, bestDist = f, dist
			end
		end
	end
	if bestFloor then
		local f = bestFloor
		local p2 = projectToSurface2D(f, center)
		local inside = p2.X > f.UMin and p2.X < f.UMax and p2.Y > f.VMin and p2.Y < f.VMax
		local scored = {}
		for _, face in ipairs(faces) do
			local n2 = Vector2.new(face.Normal:Dot(f.U), face.Normal:Dot(f.V))
			local score
			if n2.Magnitude < 0.3 then
				score = -math.huge
			elseif inside then
				score = rayRectDistance(f, p2, n2.Unit)
			else
				local toCenter = Vector2.new((f.UMin + f.UMax) * 0.5, (f.VMin + f.VMax) * 0.5) - p2
				score = n2.Unit:Dot(toCenter)
			end
			table.insert(scored, { Face = face, Score = score })
		end
		table.sort(scored, function(a, b)
			return a.Score > b.Score
		end)
		if inside and #scored == 2 and scored[2].Score > -math.huge then
			local d1, d2 = scored[1].Score, scored[2].Score
			if d2 >= math.max(G.DIVIDER_MIN_SIDE_DISTANCE, G.DIVIDER_MIN_SIDE_FRACTION * (d1 + d2)) then
				return faces
			end
		end
		return { scored[1].Face }
	end
	if camera then
		local camPos = camera.CFrame.Position
		local best, bestD = faces[1], -math.huge
		for _, face in ipairs(faces) do
			local d = (camPos - face.Center):Dot(face.Normal)
			if d > bestD then
				best, bestD = face, d
			end
		end
		return { best }
	end
	return faces
end

-- Tri stable et invariant par rotation : dans le repère de la plus grande surface.
local function sortSurfaces(surfaces)
	local ref = nil
	local refArea = -1
	for _, s in ipairs(surfaces) do
		local area = s.SizeU * s.SizeV
		if area > refArea + EPS then
			ref, refArea = s, area
		end
	end
	local refFrame = if ref then ref.Frame else CFrame.new()
	local function key(s)
		local l = refFrame:PointToObjectSpace(s.Frame.Position)
		return l
	end
	table.sort(surfaces, function(a, b)
		local ra, rb = ROLE_ORDER[a.Role] or 9, ROLE_ORDER[b.Role] or 9
		if ra ~= rb then
			return ra < rb
		end
		local ka, kb = key(a), key(b)
		local q = 0.01
		for _, axis in ipairs({ "Y", "X", "Z" }) do
			local va = Utilities.round(ka[axis], q)
			local vb = Utilities.round(kb[axis], q)
			if math.abs(va - vb) > q * 0.5 then
				return va < vb
			end
		end
		if math.abs(a.SizeU - b.SizeU) > 0.01 then
			return a.SizeU < b.SizeU
		end
		return a.SizeV < b.SizeV
	end)
	return refFrame
end

--[[
	Analyse principale.
	targets    : BaseParts cibles
	options    : { Overrides = {[Part] = role}, WallSides = "Auto"|"Both",
	               ObstacleParts = {BasePart}, Camera = Camera? }
]]
function GeometryAnalyzer.analyze(targets, options)
	options = options or {}
	local overrides = options.Overrides or {}
	local warnings = {}
	local infos = {}

	-- 1) Rôles automatiques / forcés.
	local pending = {}
	for _, part in ipairs(targets) do
		local info = GeometryAnalyzer.partInfo(part)
		table.insert(infos, info)
		local forced = overrides[part]
		if forced == nil or forced == "Auto" then
			local attrRole = Utilities.getAttribute(part, Config.Attr.SurfaceRole, "string", nil)
			if attrRole then
				forced = GeometryAnalyzer.normalizeRole(attrRole)
			end
		end
		forced = GeometryAnalyzer.normalizeRole(forced)
		local role, faces
		if forced == "Ignore" then
			role, faces = nil, {}
		elseif forced ~= "Auto" then
			role, faces = forced, forcedFaces(info, forced)
		else
			role, faces = autoRole(info)
		end
		info.AutoRole = role
		info.Forced = forced ~= "Auto"
		if role then
			table.insert(pending, { Info = info, Role = role, Faces = faces, Forced = forced ~= "Auto" })
		end
	end

	-- 2) Sols / pentes / plafonds forcés d'abord (les murs en ont besoin pour choisir leur face).
	local floors, ceilings, slopes = {}, {}, {}
	for _, p in ipairs(pending) do
		if p.Role == "Floor" or p.Role == "Slope" or p.Role == "Ceiling" then
			for _, face in ipairs(p.Faces) do
				local s = buildSurface(face, p.Role, p.Info)
				s.Forced = p.Forced
				if p.Role == "Floor" then
					table.insert(floors, s)
				elseif p.Role == "Slope" then
					table.insert(slopes, s)
				else
					table.insert(ceilings, s)
				end
			end
		end
	end

	-- 3) Murs : choix de la face utile.
	local walls = {}
	for _, p in ipairs(pending) do
		if p.Role == "Wall" then
			local chosen = p.Faces
			if options.WallSides ~= "Both" and #p.Faces == 2 then
				chosen = chooseWallFaces(p.Info, p.Faces, floors, options.Camera)
			end
			for _, face in ipairs(chosen) do
				local s = buildSurface(face, "Wall", p.Info)
				s.Forced = p.Forced
				table.insert(walls, s)
			end
		end
	end

	-- 4) Promotion en plafond : dalle horizontale au-dessus d'un sol, reliée par des murs.
	local promoted = {}
	for _, s in ipairs(floors) do
		local slabInfo = s.Info
		if not s.Forced and slabInfo.IsSlab and not slabInfo.IsWedge
			and math.abs(slabInfo.Axes[slabInfo.ThinIndex]:Dot(UP)) >= COS_FLOOR then
			local info = slabInfo
			local bottomFace = makeFace(info, info.ThinIndex, if info.Axes[info.ThinIndex]:Dot(UP) >= 0 then -1 else 1)
			local bottomY = bottomFace.Center.Y
			for _, f in ipairs(floors) do
				if f ~= s and f.Part ~= s.Part and f.Frame.Position.Y < bottomY - G.MIN_ROOM_HEIGHT then
					if planOverlapFraction(f, s) >= G.CEILING_MIN_OVERLAP then
						local connected = false
						for _, w in ipairs(walls) do
							local wBottom = w.Frame:PointToWorldSpace(Vector3.new(0, 0, w.VMin)).Y
							local wTop = w.Frame:PointToWorldSpace(Vector3.new(0, 0, w.VMax)).Y
							if wBottom <= f.Frame.Position.Y + G.WALL_FLOOR_CONTACT_TOLERANCE
								and wTop >= bottomY - G.WALL_FLOOR_CONTACT_TOLERANCE
								and wallOverlapsPlan(w, f) then
								connected = true
								break
							end
						end
						if connected then
							promoted[s] = bottomFace
							break
						end
					end
				end
			end
		end
	end
	if next(promoted) then
		local keptFloors = {}
		for _, s in ipairs(floors) do
			local bottomFace = promoted[s]
			if bottomFace then
				local c = buildSurface(bottomFace, "Ceiling", s.Info)
				table.insert(ceilings, c)
				-- Le dessus reste un sol seulement si des murs d'un étage supérieur y reposent.
				local topY = s.Frame.Position.Y
				local upperWalls = false
				for _, w in ipairs(walls) do
					local wBottom = w.Frame:PointToWorldSpace(Vector3.new(0, 0, w.VMin)).Y
					if math.abs(wBottom - topY) <= G.WALL_FLOOR_CONTACT_TOLERANCE and wallOverlapsPlan(w, s) then
						upperWalls = true
						break
					end
				end
				if upperWalls then
					table.insert(keptFloors, s)
				end
			else
				table.insert(keptFloors, s)
			end
		end
		floors = keptFloors
	end

	-- 5) Découpes verticales des murs (sol / plafond), puis coins.
	local horizontalSupports = {}
	Utilities.appendAll(horizontalSupports, floors)
	Utilities.appendAll(horizontalSupports, slopes)
	for _, w in ipairs(walls) do
		clipWallVertically(w, horizontalSupports, ceilings)
	end
	local corners = {}
	for i = 1, #walls do
		for j = i + 1, #walls do
			if walls[i].Part ~= walls[j].Part then
				local c = detectCorner(walls[i], walls[j])
				if c then
					table.insert(corners, c)
				end
			end
		end
	end

	-- 6) Paires de murs parallèles (face à face).
	local wallPairs = {}
	for i = 1, #walls do
		for j = i + 1, #walls do
			local a, b = walls[i], walls[j]
			if a.Normal:Dot(b.Normal) <= -G.PARALLEL_DOT then
				local distance = (b.Frame.Position - a.Frame.Position):Dot(a.Normal)
				if distance > 0 then
					table.insert(wallPairs, { A = a, B = b, Distance = distance })
				end
			end
		end
	end

	-- 7) Assemblage, filtrage des surfaces trop petites.
	local all = {}
	for _, list in ipairs({ floors, slopes, walls, ceilings }) do
		for _, s in ipairs(list) do
			if s.UMax - s.UMin >= G.MIN_SURFACE_EXTENT and s.VMax - s.VMin >= G.MIN_SURFACE_EXTENT then
				table.insert(all, s)
			else
				table.insert(warnings, string.format("Surface on '%s' (%s) is too small to decorate and was skipped.", s.PartName, s.FaceName))
			end
		end
	end
	local refFrame = sortSurfaces(all)

	-- 8) Obstacles et adjacences.
	local obstacleParts = table.clone(targets)
	for _, p in ipairs(options.ObstacleParts or {}) do
		if not table.find(obstacleParts, p) then
			table.insert(obstacleParts, p)
		end
	end
	local result = {
		Surfaces = all,
		Floors = {},
		Walls = {},
		Ceilings = {},
		Slopes = {},
		Corners = corners,
		WallPairs = wallPairs,
		PartInfos = infos,
		Parts = targets,
		RefFrame = refFrame,
		Warnings = warnings,
	}
	for index, s in ipairs(all) do
		s.Index = index
		s.Id = string.format("S%02d", index)
		if s.Role == "Floor" then
			table.insert(result.Floors, s)
		elseif s.Role == "Wall" then
			table.insert(result.Walls, s)
		elseif s.Role == "Ceiling" then
			table.insert(result.Ceilings, s)
		elseif s.Role == "Slope" then
			table.insert(result.Slopes, s)
		end
		local depth = if s.Role == "Wall" then G.EXCLUSION_PROBE_DEPTH * 0.25 else G.OBSTACLE_PROBE_HEIGHT
		computeObstacles(s, obstacleParts, depth)
	end
	for _, f in ipairs(result.Floors) do
		computeFloorWalls(f, result.Walls)
	end
	for _, f in ipairs(result.Slopes) do
		computeFloorWalls(f, result.Walls)
	end

	if #all == 0 and #targets > 0 then
		table.insert(warnings, "No usable surface found. Use the Target Surfaces list to force a role (FLOOR / WALL / CEILING).")
	end
	return result
end

return GeometryAnalyzer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">SelectionAnalyzer</string>
          <string name="Source"><![CDATA[--[[
	SelectionAnalyzer
	Transforme la Selection de Studio en listes exploitables :
	  - cibles (BaseParts à analyser : Part, Model, Folder, combinaisons...)
	  - racines de bibliothèque d'assets
	  - zones d'exclusion / géométrie protégée
	Ne modifie jamais rien.
]]

local CollectionService = game:GetService("CollectionService")

local Core = script.Parent.Parent.Core
local Config = require(Core.Config)

local SelectionAnalyzer = {}

local function isGeneratedContent(instance)
	local root = workspace:FindFirstChild(Config.Output.ROOT_NAME)
	return root ~= nil and (instance == root or instance:IsDescendantOf(root))
end

local function hasIgnoreTag(instance)
	for _, tag in ipairs({ Config.Tags.IGNORE, Config.Tags.EXCLUDE }) do
		local ok, tagged = pcall(CollectionService.HasTag, CollectionService, instance, tag)
		if ok and tagged then
			return true
		end
	end
	return false
end

function SelectionAnalyzer.getSelection()
	local ok, selection = pcall(function()
		return game:GetService("Selection"):Get()
	end)
	if ok then
		return selection
	end
	return {}
end

-- Collecte les BaseParts de plusieurs racines, sans doublon, ordre de parcours stable.
function SelectionAnalyzer.collectParts(roots, excludeRoots)
	local parts = {}
	local seen = {}
	excludeRoots = excludeRoots or {}

	local function excluded(instance)
		for _, ex in ipairs(excludeRoots) do
			if instance == ex or instance:IsDescendantOf(ex) then
				return true
			end
		end
		return false
	end

	local function consider(instance)
		if seen[instance] then
			return
		end
		if not instance:IsA("BasePart") or instance:IsA("Terrain") then
			return
		end
		if excluded(instance) or isGeneratedContent(instance) or hasIgnoreTag(instance) then
			return
		end
		seen[instance] = true
		table.insert(parts, instance)
	end

	for _, root in ipairs(roots) do
		if typeof(root) == "Instance" and root.Parent ~= nil then
			consider(root)
			for _, d in ipairs(root:GetDescendants()) do
				consider(d)
			end
		end
	end
	return parts
end

-- Cibles : toutes les BaseParts sous la sélection.
function SelectionAnalyzer.resolveTargets(selection, excludeRoots)
	local warnings = {}
	if #selection == 0 then
		return {}, { "Nothing is selected. Select a Part, Model or Folder that forms the zone to decorate." }
	end
	local parts = SelectionAnalyzer.collectParts(selection, excludeRoots)
	if #parts == 0 then
		table.insert(warnings, "The selection contains no BasePart (generated content and ignored parts are skipped).")
	end
	if #parts > Config.Performance.MAX_SURFACES then
		table.insert(warnings, string.format("Selection has %d parts; only the first %d are analysed.", #parts, Config.Performance.MAX_SURFACES))
		local trimmed = {}
		for i = 1, Config.Performance.MAX_SURFACES do
			trimmed[i] = parts[i]
		end
		parts = trimmed
	end
	return parts, warnings
end

-- Bibliothèque : on garde les racines telles quelles (Folder, Model, Part...).
-- Si un élément est déjà descendant d'une autre racine sélectionnée, il est ignoré.
function SelectionAnalyzer.resolveLibraryRoots(selection)
	local warnings = {}
	local roots = {}
	for _, instance in ipairs(selection) do
		if typeof(instance) == "Instance" and instance.Parent ~= nil and not isGeneratedContent(instance) then
			local nested = false
			for _, other in ipairs(selection) do
				if other ~= instance and instance:IsDescendantOf(other) then
					nested = true
					break
				end
			end
			if not nested then
				table.insert(roots, instance)
			end
		end
	end
	if #roots == 0 then
		table.insert(warnings, "Select one or more Folders / Models containing your assets.")
	end
	return roots, warnings
end

-- Zones d'exclusion et géométrie protégée : BaseParts sous la sélection.
function SelectionAnalyzer.resolveZoneParts(selection)
	return SelectionAnalyzer.collectParts(selection, nil)
end

-- Parts taguées dans la scène (ProceduralPlacementExclude / Protected).
function SelectionAnalyzer.getTaggedParts(tag)
	local parts = {}
	local ok, tagged = pcall(CollectionService.GetTagged, CollectionService, tag)
	if not ok then
		return parts
	end
	for _, instance in ipairs(tagged) do
		if instance:IsA("BasePart") then
			table.insert(parts, instance)
		elseif instance:IsA("Model") or instance:IsA("Folder") then
			for _, d in ipairs(instance:GetDescendants()) do
				if d:IsA("BasePart") then
					table.insert(parts, d)
				end
			end
		end
	end
	return parts
end

return SelectionAnalyzer
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Core</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	Toutes les constantes du moteur sont centralisées ici. Aucun "magic number"
	ne doit apparaître ailleurs dans le code : les modules lisent ces valeurs.
	Les paramètres réglables par l'utilisateur (densité, seed...) vivent dans
	Settings ; ici se trouvent les constantes techniques.
]]

local Config = {}

Config.PLUGIN_ID = "ProceduralComposer"
Config.PLUGIN_DISPLAY_NAME = "Procedural Composer"
Config.VERSION = "1.0.0"
Config.SETTINGS_KEY = "ProceduralComposer_Settings_v1"
Config.WINDOW_SETTINGS_KEY = "ProceduralComposer_Window_v1"

-- Organisation de la sortie ------------------------------------------------
Config.Output = {
	ROOT_NAME = "ProceduralAssetPlacement_Generated",
	PREVIEW_NAME = "Generation_Preview",
	GENERATION_PREFIX = "Generation_",
	GENERATION_DIGITS = 3,
	ITEM_DIGITS = 3,
	HIDDEN_WALLS_FOLDER = "_HiddenOriginalWalls",
	GENERATED_BY = "ProceduralComposer",
	Subfolders = {
		Floor = "FloorDecor",
		Wall = "WallDecor",
		Architecture = "Architecture",
		Ceiling = "CeilingDecor",
		Corner = "CornerDecor",
	},
	SUBFOLDER_ORDER = { "Architecture", "Corner", "Wall", "Floor", "Ceiling" },
}

-- Zones d'exclusion créées par le plugin (dossier séparé : "Clear Generated" ne les supprime pas).
Config.ExclusionZone = {
	FOLDER_NAME = "ProceduralExclusionZones",
	PART_NAME = "CenterExclusionZone",
	HEIGHT = 12,
	TRANSPARENCY = 0.75,
	COLOR = Color3.fromRGB(255, 70, 70),
}

-- Attributs posés sur les objets générés / dossiers ------------------------
Config.Attr = {
	IsPreview = "PCP_IsPreview",
	GenerationIndex = "PCP_GenerationIndex",
	GenerationId = "GenerationId",
	GeneratedBy = "GeneratedBy",
	Seed = "Seed",
	SourceAsset = "SourceAsset",
	PlacementType = "PlacementType",
	TargetSurface = "TargetSurface",
	SizeClass = "SizeClass",
	Scale = "PlacementScale",
	Layer = "Layer",
	OriginalTransparency = "PCP_OriginalTransparency",
	Settings = "PCP_SettingsSnapshot",
	-- Attribut optionnel qu'un utilisateur peut poser sur une Part cible pour forcer son rôle.
	SurfaceRole = "SurfaceRole",
}

-- Tags CollectionService ----------------------------------------------------
Config.Tags = {
	EXCLUDE = "ProceduralPlacementExclude",
	PROTECTED = "ProceduralPlacementProtected",
	IGNORE = "ProceduralPlacementIgnore",
	-- Préfixe des tags de rôle d'asset : "ProceduralPlacement_Floor", "ProceduralPlacement_Wall"...
	ROLE_PREFIX = "ProceduralPlacement_",
}

-- Précision géométrique -----------------------------------------------------
Config.Precision = {
	-- Valeur par défaut de SURFACE_EPSILON (modifiable dans Settings).
	DEFAULT_SURFACE_EPSILON = 0.02,
	MIN_SURFACE_EPSILON = 0.001,
	MAX_SURFACE_EPSILON = 0.25,
	-- Tolérance de contact : deux boîtes qui se touchent exactement ne sont pas en collision.
	CONTACT_TOLERANCE = 0.015,
	-- Epsilon numérique pour les comparaisons flottantes.
	NUMERIC_EPSILON = 1e-6,
	-- Seuil sous lequel un objet est considéré "plat" (risque de z-fighting au sol).
	FLAT_ASSET_THICKNESS = 0.35,
	-- Longueur minimale pour qu'un vecteur soit normalisable.
	MIN_VECTOR_LENGTH = 1e-5,
}

-- Analyse de la géométrie cible --------------------------------------------
Config.Geometry = {
	-- Une normale est "sol" si son angle avec la verticale est inférieur à ce seuil.
	FLOOR_MAX_ANGLE_DEG = 30,
	-- Une normale est "mur" si elle est à moins de ce seuil de l'horizontale.
	WALL_MAX_TILT_DEG = 15,
	-- Une Part est une "dalle" si (plus petite dimension / dimension médiane) <= ce ratio.
	SLAB_THIN_RATIO = 0.45,
	-- Taille minimale (studs) d'une surface exploitable.
	MIN_SURFACE_EXTENT = 0.5,
	-- Tolérance de contact entre un mur et un sol pour les considérer adjacents.
	WALL_FLOOR_CONTACT_TOLERANCE = 1.5,
	-- Distance max horizontale entre le pied d'un mur et le bord d'un sol.
	WALL_FLOOR_PLAN_TOLERANCE = 2.0,
	-- Tolérance pour la détection de coins (en plus de l'épaisseur des murs).
	CORNER_TOLERANCE = 2.0,
	-- |dot(N1, N2)| au-delà duquel deux murs sont considérés parallèles.
	PARALLEL_DOT = 0.96,
	-- |dot(N1, N2)| en dessous duquel deux murs peuvent former un coin (angle 30°..150°).
	CORNER_MAX_ABS_DOT = 0.866,
	-- Hauteur minimale entre un sol et une dalle au-dessus pour la considérer plafond.
	MIN_ROOM_HEIGHT = 4,
	-- Recouvrement minimal (fraction d'aire) sol/plafond.
	CEILING_MIN_OVERLAP = 0.3,
	-- Hauteur d'analyse au-dessus d'un sol pour projeter les obstacles.
	OBSTACLE_PROBE_HEIGHT = 64,
	-- Profondeur de projection des zones d'exclusion devant une surface.
	EXCLUSION_PROBE_DEPTH = 64,
	EXCLUSION_PROBE_BACK = 4,
	-- Mur "séparateur" (les deux faces décorées) : chaque côté doit offrir au moins
	-- cette fraction de la profondeur du sol et cette distance minimale.
	DIVIDER_MIN_SIDE_FRACTION = 0.25,
	DIVIDER_MIN_SIDE_DISTANCE = 6,
	-- Parts non-boîtes (MeshPart, Union...) : on sonde la surface réelle par raycast.
	RAYCAST_PROBE_HEIGHT = 4,
	RAYCAST_MAX_SINK = 2,
}

-- Analyse des assets ---------------------------------------------------------
Config.Assets = {
	-- Ignorer les parts totalement invisibles pour calculer la boîte visuelle.
	IGNORE_INVISIBLE_PARTS_IN_BOUNDS = true,
	-- Au-delà de ce nombre de parts, la collision précise utilise une grille d'occupation.
	MAX_EXACT_SUB_BOXES = 24,
	OCCUPANCY_GRID = 4,
	-- Classes de taille : seuils absolus (studs) utilisés pour les petites bibliothèques.
	ABSOLUTE_SIZE_THRESHOLDS = { Small = 3.0, Medium = 8.0, Large = 18.0 },
	-- Seuils percentiles pour les bibliothèques d'au moins PERCENTILE_MIN_ASSETS assets.
	PERCENTILE_THRESHOLDS = { Small = 0.40, Medium = 0.78, Large = 0.94 },
	PERCENTILE_MIN_ASSETS = 8,
	-- Classification automatique par forme.
	-- Les rapports de profondeur sont mesurés par rapport à la largeur ET à la hauteur :
	-- un objet aussi profond que large (arbre, rocher) n'est jamais un objet mural.
	RELIEF_MAX_DEPTH_RATIO = 0.25,
	RELIEF_MIN_HEIGHT_RATIO = 0.25,
	WALL_PROP_MAX_DEPTH_RATIO = 0.6,
	PANEL_MAX_DEPTH_RATIO = 0.4,
	PANEL_MIN_HEIGHT_RATIO = 0.5,
	PANEL_MAX_HEIGHT_RATIO = 3.0,
	PILLAR_MIN_SLENDERNESS = 2.2,
	PILLAR_MIN_SECTION_RATIO = 0.35,
	TRIM_MIN_ELONGATION = 3.0,
	FLAT_FLOOR_MAX_RATIO = 0.12,
	ARCH_MAX_FILL_RATIO = 0.4,
	ROLE_SCORE_THRESHOLD = 0.35,
	-- Poids / valeurs par défaut des métadonnées.
	DEFAULT_WEIGHT = 1,
	DEFAULT_IMPORTANCE = 1,
	SIZE_CLASS_ORDER = { "Small", "Medium", "Large", "Hero" },
	SIZE_CLASS_IMPORTANCE = { Small = 0.6, Medium = 1.0, Large = 1.6, Hero = 2.4 },
}

-- Liste des rôles d'assets reconnus (PlacementType).
Config.Roles = {
	"Floor", "Wall", "Corner", "Ceiling", "LargeStructure",
	"WallModule", "Pillar", "Arch", "WallTop", "WallBase", "Relief", "Filler",
}

-- Collision -------------------------------------------------------------------
Config.Collision = {
	MIN_CELL_SIZE = 4,
	MAX_CELL_SIZE = 64,
	CELL_SIZE_FACTOR = 2,
	-- Index 2D (voisinage) par surface.
	NEIGHBOR_CELL_SIZE = 8,
	-- Nombre max de cellules parcourues par une requête (évite les boîtes géantes).
	MAX_QUERY_CELLS = 4096,
	-- Pas de lancer de rayon dans la grille (fraction de la taille de cellule).
	RAY_STEP_FACTOR = 0.5,
	-- Les parts de la scène invisibles et non collidables sont ignorées.
	IGNORE_INVISIBLE_SCENE_PARTS = true,
}

-- Composition -----------------------------------------------------------------
Config.Composition = {
	-- Plafond de sécurité de couverture du sol (fraction d'aire) à densité 0.5.
	MAX_FLOOR_COVERAGE = 0.34,
	-- Budget des petits éléments de remplissage : une "cellule" de dispersion
	-- par élément (au moins SCATTER_CELL_MIN studs, ou SCATTER_CELL_RADII rayons).
	SCATTER_CELL_MIN = 10,
	SCATTER_CELL_RADII = 8,
	-- Espacement minimal (studs) entre deux beats de bord.
	EDGE_BEAT_MIN_SPACING = 5,
	-- Nombre max d'échecs consécutifs avant d'arrêter une passe.
	MAX_CONSECUTIVE_FAILURES = 30,
	-- Nombre de candidats par tentative (valeur par défaut, réglable).
	DEFAULT_CANDIDATES = 18,
	-- Parmi combien des meilleurs candidats on tire (selon Randomness).
	MIN_TOP_CHOICES = 1,
	MAX_TOP_CHOICES = 5,
	-- Surface (studs²) par "héros" potentiel.
	HERO_AREA = 1400,
	CLUSTER_AREA = 420,
	-- Taille des groupes.
	MIN_CLUSTER_MEMBERS = 1,
	MAX_CLUSTER_MEMBERS = 6,
	-- Espacement entre groupes (multiplié par le rayon du groupe).
	CLUSTER_BREATHING = 1.6,
	-- Palette : fraction des assets utilisés par surface selon Variation.
	PALETTE_MIN_FRACTION = 0.35,
	PALETTE_MIN_COUNT = 3,
	-- Pénalités de répétition.
	REPEAT_LAST_FACTOR = 0.3,
	REPEAT_RECENT_FACTOR = 0.65,
	RECENT_HISTORY = 4,
	-- Rythme visuel : nombre de "vagues" le long de la grande dimension.
	RHYTHM_MIN_WAVES = 1.5,
	RHYTHM_MAX_WAVES = 5,
	-- Bruit de densité (zones respirantes cohérentes).
	NOISE_SCALE = 22,
	-- Beats (séquences 1D pour bords, murs, plafonds).
	BEAT_BASE_SPACING = 1.0,
	BEAT_MAX = 400,
	-- Surface trop petite : en dessous de cette aire on ne place qu'un seul point focal.
	TINY_AREA = 16,
	-- Profondeur de bande de bord par défaut quand EdgeDepth vaut 0.
	MIN_EDGE_DEPTH = 1.5,
	-- Ratio d'allongement au-delà duquel un sol est un couloir.
	CORRIDOR_ASPECT = 3,
	-- Rotation : jitter max (degrés) à Randomness = 1 pour les modes orientés.
	MAX_ROTATION_JITTER_DEG = 14,
	-- Symétrie : décalage max (studs) accepté pour un élément miroir.
	MIRROR_SEARCH_RADIUS = 1.5,
	-- Plafond : fraction max de la hauteur de pièce occupée par un élément suspendu.
	CEILING_MAX_DROP_RATIO = 0.45,
	-- Mur : marges.
	WALL_EDGE_MARGIN = 0.25,
	WALL_PROP_DEFAULT_HEIGHT = 0.6,
	WALL_RELIEF_DEFAULT_HEIGHT = 0.5,
	WALL_HANGING_TOP_MARGIN = 0.1,
}

-- Score des positions candidates -------------------------------------------------
-- Chaque terme est normalisé dans [-1, 1] puis multiplié par son poids.
Config.Scoring = {
	Weights = {
		Crowding = 2.5,
		ClusterCohesion = 2.2,
		LargeSeparation = 3.0,
		Repetition = 1.2,
		Edge = 1.6,
		Wall = 0.9,
		Center = 1.6,
		Balance = 0.9,
		Rhythm = 1.1,
		Empty = 1.9,
		Thirds = 1.3,
		ClusterSeparation = 2.0,
		Noise = 1.0,
	},
	-- Rayon de recherche de voisins (multiple du rayon d'empreinte).
	NEIGHBOR_RADIUS_FACTOR = 4,
	-- Espacement souhaité entre éléments non groupés (multiple de la somme des rayons).
	DESIRED_GAP_FACTOR = 0.6,
	-- Deux grands éléments doivent être séparés de ce multiple de leurs rayons.
	LARGE_SEPARATION_FACTOR = 2.5,
	-- Rayon de pénalité de répétition du même asset.
	REPEAT_RADIUS_FACTOR = 5,
	-- Écart idéal entre membres d'un groupe (multiple du rayon du satellite).
	CLUSTER_GAP_FACTOR = 0.35,
	-- Taille de zone par groupe / par héros, en rayons d'empreinte typiques.
	CLUSTER_SPACING_RADII = 9,
	HERO_SPACING_RADII = 7,
	-- Zone (en rayons de l'asset) par élément de classe Hero.
	HERO_CLASS_ZONE_RADII = 12,
	-- Nombre max de tests de collision par placement (après tri des candidats).
	MAX_COLLISION_TESTS = 8,
	-- Tentatives de choix d'asset avant d'abandonner un placement.
	MAX_ASSET_RETRIES = 3,
}

-- Assemblage modulaire ----------------------------------------------------------
Config.Fitting = {
	QUANTUM = 0.05,
	MAX_UNITS = 12000,
	DEFAULT_MAX_SCALE_DEVIATION = 0.08,
	MAX_STRETCH = 1.6,
	MIN_STRETCH = 0.7,
	-- Reste (studs) toléré en marge centrée quand aucune autre solution n'existe.
	END_MARGIN_TOLERANCE = 0.3,
	-- Largeur minimale d'une pièce de remplissage.
	MIN_FILLER_WIDTH = 0.75,
	-- Écart max entre modules quand les espacements sont autorisés (fraction de largeur).
	MAX_GAP_FRACTION = 0.35,
	-- Coûts de l'optimiseur.
	MODULE_COST = 1.0,
	FILLER_COST = 3.0,
	DEFORMATION_COST = 60.0,
	NOISE_COST = 0.35,
	-- Regroupement des modules par hauteur (fraction).
	HEIGHT_BUCKET_TOLERANCE = 0.12,
	-- Tolérance d'exactitude finale.
	LENGTH_TOLERANCE = 1e-4,
}

-- Architecture --------------------------------------------------------------------
Config.Architecture = {
	-- Couches de profondeur : chaque couche est avancée de n * SURFACE_EPSILON.
	LAYER_MODULE = 1,
	LAYER_PILLAR = 2,
	LAYER_TRIM = 3,
	LAYER_DETAIL = 4,
	LAYER_PROP = 5,
	-- Un pilier est "posé sur le mur" s'il est plus profond que les modules de cette marge.
	PILLAR_DEPTH_MARGIN = 0.1,
	-- Hauteur par défaut des reliefs dans une travée (fraction de hauteur).
	DETAIL_HEIGHT = 0.55,
	-- Écart minimal pour empiler plusieurs rangées de modules.
	MIN_ROW_FILL = 0.35,
	-- Portion de travées remplacées par des arches (modulée par VisualRhythm).
	ARCH_BAY_RATIO = 0.34,
	-- Distance devant la façade pour les rayons de projection des détails.
	DETAIL_RAY_START = 50,
}

-- Performance ----------------------------------------------------------------------
Config.Performance = {
	-- Budget (secondes) avant de rendre la main à Studio pendant la planification.
	YIELD_BUDGET = 0.012,
	-- Nombre de clones instanciés entre deux yields.
	INSTANTIATE_BATCH = 120,
	-- Limites de sécurité.
	HARD_MAX_ASSETS = 5000,
	MAX_SURFACES = 400,
	MAX_LIBRARY_ASSETS = 2000,
	MAX_ANALYZE_PARTS_PER_ASSET = 20000,
}

-- Debug visuel ---------------------------------------------------------------------
Config.Debug = {
	FOLDER_NAME = "ProceduralComposer_Debug",
	MAX_CANDIDATES = 1500,
	MAX_REJECTED = 1500,
	POINT_RADIUS = 0.35,
	NORMAL_LENGTH = 6,
	LINE_THICKNESS = 3,
	BOX_TRANSPARENCY = 0.82,
	ZONE_TRANSPARENCY = 0.7,
	Colors = {
		Bounds = Color3.fromRGB(80, 170, 255),
		Architecture = Color3.fromRGB(255, 170, 60),
		Normal = Color3.fromRGB(80, 255, 120),
		Exclusion = Color3.fromRGB(255, 60, 60),
		CenterClear = Color3.fromRGB(255, 220, 40),
		Candidate = Color3.fromRGB(90, 255, 90),
		Rejected = Color3.fromRGB(255, 70, 70),
		Snap = Color3.fromRGB(40, 240, 255),
		Segment = Color3.fromRGB(230, 70, 255),
		Corner = Color3.fromRGB(255, 140, 0),
		Surface = Color3.fromRGB(255, 255, 255),
	},
}

-- Interface -----------------------------------------------------------------------
Config.UI = {
	WIDGET_ID = "ProceduralComposerWidget",
	DEFAULT_WIDTH = 380,
	DEFAULT_HEIGHT = 760,
	MIN_WIDTH = 300,
	MIN_HEIGHT = 360,
	ROW_HEIGHT = 24,
	PADDING = 6,
	FONT = Enum.Font.SourceSans,
	FONT_BOLD = Enum.Font.SourceSansBold,
	TEXT_SIZE = 14,
	HEADER_TEXT_SIZE = 15,
	SETTINGS_SAVE_DELAY = 0.6,
	MAX_SURFACE_ROWS = 60,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Logger</string>
          <string name="Source"><![CDATA[--[[
	Logger
	Messages lisibles dans l'Output de Studio + relais vers l'interface
	(barre de statut). Aucun module ne fait de print() directement.
]]

local Config = require(script.Parent.Config)

local Logger = {}

local PREFIX = "[" .. Config.PLUGIN_DISPLAY_NAME .. "] "
local sinks = {}

Logger.Level = {
	Info = "Info",
	Success = "Success",
	Warning = "Warning",
	Error = "Error",
}

local function dispatch(level, message)
	for _, sink in ipairs(sinks) do
		local ok, err = pcall(sink, level, message)
		if not ok then
			warn(PREFIX .. "Logger sink error: " .. tostring(err))
		end
	end
end

function Logger.addSink(callback)
	table.insert(sinks, callback)
	return function()
		local index = table.find(sinks, callback)
		if index then
			table.remove(sinks, index)
		end
	end
end

function Logger.info(message)
	print(PREFIX .. message)
	dispatch(Logger.Level.Info, message)
end

function Logger.success(message)
	print(PREFIX .. message)
	dispatch(Logger.Level.Success, message)
end

function Logger.warn(message)
	warn(PREFIX .. message)
	dispatch(Logger.Level.Warning, message)
end

function Logger.error(message)
	warn(PREFIX .. "ERROR: " .. message)
	dispatch(Logger.Level.Error, message)
end

-- Message uniquement dans l'Output (détails techniques).
function Logger.verbose(message)
	print(PREFIX .. message)
end

return Logger
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">MathUtil</string>
          <string name="Source"><![CDATA[--[[
	MathUtil
	Géométrie : boîtes orientées (OBB), test SAT 3D, polygones convexes 2D,
	projections sur les repères de surface, intersections rayon/boîte.

	Convention des repères de surface (voir GeometryAnalyzer) :
	  Frame.XVector = U (axe principal / longueur)
	  Frame.YVector = N (normale sortante, côté espace libre)
	  Frame.ZVector = V (axe secondaire ; "hauteur" pour un mur)
	Un point 2D (u, v) de la surface vaut Frame * Vector3.new(u, 0, v).
]]

local Config = require(script.Parent.Config)

local MathUtil = {}

local EPS = Config.Precision.NUMERIC_EPSILON
local MIN_LEN = Config.Precision.MIN_VECTOR_LENGTH

MathUtil.UP = Vector3.new(0, 1, 0)

-- Vecteurs ---------------------------------------------------------------------

function MathUtil.safeUnit(v, fallback)
	local m = v.Magnitude
	if m < MIN_LEN or m ~= m then
		return fallback or Vector3.new(0, 0, 0)
	end
	return v / m
end

function MathUtil.projectOnPlane(v, normal)
	return v - normal * v:Dot(normal)
end

function MathUtil.anyPerpendicular(n)
	local ref = if math.abs(n.Y) < 0.9 then Vector3.new(0, 1, 0) else Vector3.new(1, 0, 0)
	return MathUtil.safeUnit(ref:Cross(n), Vector3.new(1, 0, 0))
end

function MathUtil.absVector(v)
	return Vector3.new(math.abs(v.X), math.abs(v.Y), math.abs(v.Z))
end

function MathUtil.componentMin(a, b)
	return Vector3.new(math.min(a.X, b.X), math.min(a.Y, b.Y), math.min(a.Z, b.Z))
end

function MathUtil.componentMax(a, b)
	return Vector3.new(math.max(a.X, b.X), math.max(a.Y, b.Y), math.max(a.Z, b.Z))
end

function MathUtil.v2(u, v)
	return Vector2.new(u, v)
end

function MathUtil.cross2(a, b)
	return a.X * b.Y - a.Y * b.X
end

-- Rotation autour de Y (convention CFrame.Angles(0, yaw, 0)).
function MathUtil.rotY(yaw)
	return CFrame.Angles(0, yaw, 0)
end

-- Angle de lacet pour que l'avant canonique (-Z) pointe vers la direction 2D (du, dv)
-- exprimée dans le repère (X, Z) courant.
function MathUtil.yawFacing(du, dv)
	if math.abs(du) < EPS and math.abs(dv) < EPS then
		return 0
	end
	return math.atan2(-du, -dv)
end

-- Repère "debout" : Y = haut monde, X = projection horizontale de `forwardHint`.
function MathUtil.uprightRotation(xHint)
	local up = MathUtil.UP
	local x = MathUtil.safeUnit(MathUtil.projectOnPlane(xHint, up), nil)
	if x.Magnitude < 0.5 then
		x = Vector3.new(1, 0, 0)
	end
	return CFrame.fromMatrix(Vector3.new(0, 0, 0), x, up)
end

-- Rotation "lacet seul" d'un CFrame (Y monde conservé) ; sert au repère de référence des assets.
function MathUtil.yawOnly(cf)
	local look = MathUtil.projectOnPlane(cf.LookVector, MathUtil.UP)
	if look.Magnitude < 0.2 then
		-- Pivot fortement basculé : on se rabat sur RightVector puis UpVector.
		local right = MathUtil.projectOnPlane(cf.RightVector, MathUtil.UP)
		if right.Magnitude >= 0.2 then
			right = right.Unit
			return CFrame.fromMatrix(Vector3.new(0, 0, 0), right, MathUtil.UP)
		end
		look = MathUtil.projectOnPlane(cf.UpVector, MathUtil.UP)
		if look.Magnitude < 0.2 then
			return CFrame.new()
		end
	end
	look = look.Unit
	local right = look:Cross(MathUtil.UP)
	return CFrame.fromMatrix(Vector3.new(0, 0, 0), right, MathUtil.UP)
end

-- Boîtes orientées ------------------------------------------------------------------

function MathUtil.obbCorners(cf, size)
	local h = size * 0.5
	local corners = table.create(8)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sy in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				table.insert(corners, cf:PointToWorldSpace(Vector3.new(h.X * sx, h.Y * sy, h.Z * sz)))
			end
		end
	end
	return corners
end

-- Boîte englobante alignée monde (min, max) d'une OBB, calcul analytique.
function MathUtil.obbAABB(cf, size)
	local h = size * 0.5
	local rx, ry, rz = cf.XVector, cf.YVector, cf.ZVector
	local ex = math.abs(rx.X) * h.X + math.abs(ry.X) * h.Y + math.abs(rz.X) * h.Z
	local ey = math.abs(rx.Y) * h.X + math.abs(ry.Y) * h.Y + math.abs(rz.Y) * h.Z
	local ez = math.abs(rx.Z) * h.X + math.abs(ry.Z) * h.Y + math.abs(rz.Z) * h.Z
	local e = Vector3.new(ex, ey, ez)
	local p = cf.Position
	return p - e, p + e
end

-- Boîte englobante (dans un repère local `frame`) d'une OBB monde.
function MathUtil.obbBoundsInFrame(frame, cf, size)
	local rel = frame:ToObjectSpace(cf)
	return MathUtil.obbAABB(rel, size)
end

-- Rayon de projection d'une OBB sur un axe.
local function projectRadius(axis, x, y, z, h)
	return math.abs(axis:Dot(x)) * h.X + math.abs(axis:Dot(y)) * h.Y + math.abs(axis:Dot(z)) * h.Z
end

--[[
	Test SAT 3D entre deux OBB.
	`tolerance` > 0 : les boîtes doivent s'interpénétrer de plus de `tolerance`
	pour être en collision (contact exact autorisé).
	`inflate` : distance minimale exigée entre les boîtes (espacement).
]]
function MathUtil.obbIntersects(cfA, sizeA, cfB, sizeB, tolerance, inflate)
	tolerance = tolerance or 0
	inflate = inflate or 0
	local hA = sizeA * 0.5
	local hB = sizeB * 0.5
	local ax, ay, az = cfA.XVector, cfA.YVector, cfA.ZVector
	local bx, by, bz = cfB.XVector, cfB.YVector, cfB.ZVector
	local d = cfB.Position - cfA.Position
	local margin = inflate - tolerance

	local axesA = { ax, ay, az }
	local axesB = { bx, by, bz }

	local function separated(axis)
		local len = axis.Magnitude
		if len < MIN_LEN then
			return false
		end
		local n = axis / len
		local ra = projectRadius(n, ax, ay, az, hA)
		local rb = projectRadius(n, bx, by, bz, hB)
		return math.abs(d:Dot(n)) >= ra + rb + margin
	end

	for i = 1, 3 do
		if separated(axesA[i]) then
			return false
		end
		if separated(axesB[i]) then
			return false
		end
	end
	for i = 1, 3 do
		for j = 1, 3 do
			if separated(axesA[i]:Cross(axesB[j])) then
				return false
			end
		end
	end
	return true
end

-- Intersection rayon / OBB. Renvoie la distance d'entrée (>= 0) ou nil.
function MathUtil.rayOBB(origin, direction, cf, size, maxDistance)
	local h = size * 0.5
	local localOrigin = cf:PointToObjectSpace(origin)
	local localDir = cf:VectorToObjectSpace(direction)
	local tMin = 0
	local tMax = maxDistance or math.huge
	local o = { localOrigin.X, localOrigin.Y, localOrigin.Z }
	local dir = { localDir.X, localDir.Y, localDir.Z }
	local ext = { h.X, h.Y, h.Z }
	for i = 1, 3 do
		if math.abs(dir[i]) < EPS then
			if o[i] < -ext[i] or o[i] > ext[i] then
				return nil
			end
		else
			local t1 = (-ext[i] - o[i]) / dir[i]
			local t2 = (ext[i] - o[i]) / dir[i]
			if t1 > t2 then
				t1, t2 = t2, t1
			end
			tMin = math.max(tMin, t1)
			tMax = math.min(tMax, t2)
			if tMin > tMax then
				return nil
			end
		end
	end
	return tMin
end

-- Transforme les 8 coins de la boîte [bmin, bmax] par la rotation `rot` et renvoie l'AABB.
function MathUtil.rotatedBounds(bmin, bmax, rot)
	local lo = Vector3.new(math.huge, math.huge, math.huge)
	local hi = Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, x in ipairs({ bmin.X, bmax.X }) do
		for _, y in ipairs({ bmin.Y, bmax.Y }) do
			for _, z in ipairs({ bmin.Z, bmax.Z }) do
				local p = rot:VectorToWorldSpace(Vector3.new(x, y, z))
				lo = MathUtil.componentMin(lo, p)
				hi = MathUtil.componentMax(hi, p)
			end
		end
	end
	return lo, hi
end

-- Polygones 2D (convexes) -------------------------------------------------------------

-- Enveloppe convexe (monotone chain), sens antihoraire.
function MathUtil.convexHull(points)
	local pts = table.clone(points)
	if #pts < 3 then
		return pts
	end
	table.sort(pts, function(a, b)
		if math.abs(a.X - b.X) > EPS then
			return a.X < b.X
		end
		return a.Y < b.Y
	end)
	local function cross(o, a, b)
		return (a.X - o.X) * (b.Y - o.Y) - (a.Y - o.Y) * (b.X - o.X)
	end
	local lower = {}
	for _, p in ipairs(pts) do
		while #lower >= 2 and cross(lower[#lower - 1], lower[#lower], p) <= EPS do
			table.remove(lower)
		end
		table.insert(lower, p)
	end
	local upper = {}
	for i = #pts, 1, -1 do
		local p = pts[i]
		while #upper >= 2 and cross(upper[#upper - 1], upper[#upper], p) <= EPS do
			table.remove(upper)
		end
		table.insert(upper, p)
	end
	table.remove(lower)
	table.remove(upper)
	for _, p in ipairs(upper) do
		table.insert(lower, p)
	end
	return lower
end

function MathUtil.rectPolygon(u0, v0, u1, v1)
	return {
		Vector2.new(u0, v0),
		Vector2.new(u1, v0),
		Vector2.new(u1, v1),
		Vector2.new(u0, v1),
	}
end

function MathUtil.polygonBounds(poly)
	local minU, minV = math.huge, math.huge
	local maxU, maxV = -math.huge, -math.huge
	for _, p in ipairs(poly) do
		minU = math.min(minU, p.X)
		minV = math.min(minV, p.Y)
		maxU = math.max(maxU, p.X)
		maxV = math.max(maxV, p.Y)
	end
	return minU, minV, maxU, maxV
end

function MathUtil.polygonArea(poly)
	local a = 0
	for i = 1, #poly do
		local p = poly[i]
		local q = poly[(i % #poly) + 1]
		a += p.X * q.Y - q.X * p.Y
	end
	return math.abs(a) * 0.5
end

function MathUtil.polygonCentroid(poly)
	local sum = Vector2.new(0, 0)
	for _, p in ipairs(poly) do
		sum += p
	end
	return sum / math.max(1, #poly)
end

local function projectPolygon(poly, axis)
	local lo, hi = math.huge, -math.huge
	for _, p in ipairs(poly) do
		local d = p:Dot(axis)
		if d < lo then
			lo = d
		end
		if d > hi then
			hi = d
		end
	end
	return lo, hi
end

-- SAT 2D entre polygones convexes. `tolerance` > 0 autorise le contact.
function MathUtil.polygonsIntersect(a, b, tolerance)
	tolerance = tolerance or 0
	if #a == 0 or #b == 0 then
		return false
	end
	for _, poly in ipairs({ a, b }) do
		local n = #poly
		for i = 1, n do
			local p = poly[i]
			local q = poly[(i % n) + 1]
			local edge = q - p
			local len = edge.Magnitude
			if len > EPS then
				local axis = Vector2.new(-edge.Y, edge.X) / len
				local aLo, aHi = projectPolygon(a, axis)
				local bLo, bHi = projectPolygon(b, axis)
				if aHi - tolerance <= bLo or bHi - tolerance <= aLo then
					return false
				end
			end
		end
	end
	return true
end

-- Tous les sommets de `inner` sont-ils dans le rectangle [u0,u1]×[v0,v1] ?
function MathUtil.polygonInsideRect(poly, u0, v0, u1, v1, tolerance)
	tolerance = tolerance or 0
	for _, p in ipairs(poly) do
		if p.X < u0 - tolerance or p.X > u1 + tolerance or p.Y < v0 - tolerance or p.Y > v1 + tolerance then
			return false
		end
	end
	return true
end

function MathUtil.pointInConvexPolygon(point, poly)
	local n = #poly
	if n < 3 then
		return false
	end
	local sign = 0
	for i = 1, n do
		local p = poly[i]
		local q = poly[(i % n) + 1]
		local c = MathUtil.cross2(q - p, point - p)
		if math.abs(c) > EPS then
			local s = if c > 0 then 1 else -1
			if sign == 0 then
				sign = s
			elseif s ~= sign then
				return false
			end
		end
	end
	return true
end

-- Distance d'un point à un segment 2D ; renvoie aussi le paramètre t du projeté.
function MathUtil.pointSegmentDistance(p, a, b)
	local ab = b - a
	local len2 = ab:Dot(ab)
	if len2 < EPS then
		return (p - a).Magnitude, 0
	end
	local t = math.clamp((p - a):Dot(ab) / len2, 0, 1)
	return (p - (a + ab * t)).Magnitude, t
end

-- Projection sur une surface ---------------------------------------------------------

-- Coordonnées locales (u, h, v) d'un point monde dans le repère d'une surface.
function MathUtil.toSurfaceLocal(frame, worldPoint)
	return frame:PointToObjectSpace(worldPoint)
end

-- Point monde depuis (u, v) et hauteur h le long de la normale.
function MathUtil.fromSurface(frame, u, v, h)
	return frame:PointToWorldSpace(Vector3.new(u, h or 0, v))
end

-- Projette une OBB sur le plan d'une surface : enveloppe convexe 2D (u, v) + étendue en h.
function MathUtil.projectOBBToSurface(frame, cf, size)
	local pts = {}
	local hMin, hMax = math.huge, -math.huge
	for _, corner in ipairs(MathUtil.obbCorners(cf, size)) do
		local l = frame:PointToObjectSpace(corner)
		table.insert(pts, Vector2.new(l.X, l.Z))
		hMin = math.min(hMin, l.Y)
		hMax = math.max(hMax, l.Y)
	end
	return MathUtil.convexHull(pts), hMin, hMax
end

return MathUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Presets</string>
          <string name="Source"><![CDATA[--[[
	Presets
	Un preset ne fait que modifier les paramètres du moteur. Il ne contient
	aucune règle propre à un jeu, un biome ou une bibliothèque d'assets.
]]

local Presets = {}

Presets.Order = {
	"Balanced", "EdgesOnly", "Sparse", "Dense", "WallDecor", "Architectural",
	"Nature", "Industrial", "CleanCorridor", "Chaotic",
}

-- Paramètres remis à leur valeur par défaut avant d'appliquer un preset.
Presets.ResetKeys = {
	"Density", "SpacingScale", "ClusterStrength", "EmptySpaceRatio",
	"LargeAssetFrequency", "MediumAssetFrequency", "SmallAssetFrequency",
	"Symmetry", "Randomness", "Variation", "VisualRhythm",
	"RotationMode", "ScaleMode", "MinScale", "MaxScale",
	"WallTreatment", "WallMode", "WallDensity", "PillarSpacing",
	"TopDecoration", "BaseDecoration", "CornerDecoration",
	"FloorAlgorithm", "KeepCenterClear", "CenterClearStart", "CenterClearEnd",
	"EdgeDepth", "PathWidth", "CeilingDensity", "MinimumSpacing", "CenterClearAxis",
}

Presets.Values = {
	Balanced = {},

	-- Décor uniquement sur les côtés : le centre de la zone reste toujours vide.
	EdgesOnly = {
		KeepCenterClear = true,
		CenterClearStart = 0.2,
		CenterClearEnd = 0.8,
		CenterClearAxis = "Auto",
		FloorAlgorithm = "EdgeDecoration",
		EdgeDepth = 10,
		EmptySpaceRatio = 0.3,
		ClusterStrength = 0.7,
	},

	Sparse = {
		Density = 0.25,
		EmptySpaceRatio = 0.6,
		ClusterStrength = 0.7,
		LargeAssetFrequency = 0.35,
		SmallAssetFrequency = 0.4,
		SpacingScale = 1.6,
		WallDensity = 0.3,
		CeilingDensity = 0.2,
	},

	Dense = {
		Density = 0.85,
		EmptySpaceRatio = 0.15,
		ClusterStrength = 0.55,
		SmallAssetFrequency = 0.9,
		MediumAssetFrequency = 0.75,
		SpacingScale = 0.7,
		WallDensity = 0.75,
		CeilingDensity = 0.6,
		MinimumSpacing = 0.25,
	},

	WallDecor = {
		WallTreatment = "Keep",
		WallMode = "Hybrid",
		WallDensity = 0.7,
		Density = 0.3,
		FloorAlgorithm = "EdgeDecoration",
		EdgeDepth = 6,
	},

	Architectural = {
		WallTreatment = "Rebuild",
		WallMode = "Architectural",
		WallDensity = 0.6,
		Symmetry = 0.8,
		Randomness = 0.2,
		VisualRhythm = 0.7,
		RotationMode = "AlignToWall",
		FloorAlgorithm = "EdgeDecoration",
		Density = 0.35,
		TopDecoration = true,
		BaseDecoration = true,
		CornerDecoration = true,
	},

	Nature = {
		Density = 0.55,
		ClusterStrength = 0.8,
		EmptySpaceRatio = 0.35,
		Randomness = 0.7,
		Variation = 0.8,
		RotationMode = "Random360",
		ScaleMode = "RandomRange",
		MinScale = 0.85,
		MaxScale = 1.2,
		FloorAlgorithm = "Hybrid",
		Symmetry = 0,
	},

	Industrial = {
		Density = 0.5,
		ClusterStrength = 0.45,
		Randomness = 0.25,
		Variation = 0.45,
		RotationMode = "Random90",
		FloorAlgorithm = "EdgeDecoration",
		WallTreatment = "Cover",
		WallMode = "Modular",
		VisualRhythm = 0.65,
		Symmetry = 0.3,
		CeilingDensity = 0.55,
	},

	CleanCorridor = {
		Density = 0.35,
		KeepCenterClear = true,
		CenterClearStart = 0.25,
		CenterClearEnd = 0.75,
		FloorAlgorithm = "EdgeDecoration",
		Symmetry = 0.75,
		Randomness = 0.2,
		VisualRhythm = 0.8,
		RotationMode = "AlignToWall",
		EmptySpaceRatio = 0.4,
	},

	Chaotic = {
		Density = 0.8,
		ClusterStrength = 0.2,
		EmptySpaceRatio = 0.1,
		Randomness = 1,
		Variation = 1,
		RotationMode = "Random360",
		ScaleMode = "RandomRange",
		MinScale = 0.7,
		MaxScale = 1.35,
		FloorAlgorithm = "Scatter",
		VisualRhythm = 0.1,
	},
}

return Presets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">RandomGenerator</string>
          <string name="Source"><![CDATA[--[[
	RandomGenerator
	Générateur pseudo-aléatoire 100 % déterministe (SplitMix32), indépendant de
	math.random et de l'implémentation de Random côté moteur.

	Même seed => même suite de nombres, sur toutes les machines et versions.
	`fork(name)` dérive un sous-flux stable : modifier les réglages du sol ne
	change pas le résultat des murs, ce qui rend l'itération beaucoup plus
	agréable.

	Contient aussi un bruit de valeur 2D (value noise) déterministe, utilisé
	pour créer des zones "respirantes" cohérentes plutôt que du bruit blanc.
]]

local Utilities = require(script.Parent.Utilities)

local TWO_32 = 4294967296
local GOLDEN = 0x9E3779B9

local RandomGenerator = {}
RandomGenerator.__index = RandomGenerator

-- Multiplication 32 bits exacte (équivalent de Math.imul) en double précision.
local function imul(a, b)
	local aLo = bit32.band(a, 0xFFFF)
	local aHi = bit32.rshift(a, 16)
	local bLo = bit32.band(b, 0xFFFF)
	local bHi = bit32.rshift(b, 16)
	local lo = aLo * bLo
	local mid = (aHi * bLo + aLo * bHi) % 65536
	return (lo + mid * 65536) % TWO_32
end
RandomGenerator.imul = imul

local function mix32(z)
	z = imul(bit32.bxor(z, bit32.rshift(z, 16)), 0x85EBCA6B)
	z = imul(bit32.bxor(z, bit32.rshift(z, 13)), 0xC2B2AE35)
	return bit32.bxor(z, bit32.rshift(z, 16))
end
RandomGenerator.mix32 = mix32

local function normalizeSeed(seed)
	if type(seed) == "string" then
		return Utilities.hashString(seed)
	end
	seed = tonumber(seed) or 0
	seed = math.floor(math.abs(seed)) % TWO_32
	return seed
end
RandomGenerator.normalizeSeed = normalizeSeed

function RandomGenerator.new(seed)
	local self = setmetatable({}, RandomGenerator)
	self.Seed = normalizeSeed(seed)
	self._state = mix32((self.Seed + GOLDEN) % TWO_32)
	return self
end

function RandomGenerator:nextUInt32()
	self._state = (self._state + GOLDEN) % TWO_32
	return mix32(self._state)
end

-- Réel uniforme dans [0, 1).
function RandomGenerator:next()
	return self:nextUInt32() / TWO_32
end

function RandomGenerator:range(a, b)
	return a + (b - a) * self:next()
end

-- Entier uniforme dans [a, b].
function RandomGenerator:int(a, b)
	if b < a then
		a, b = b, a
	end
	return a + math.floor(self:next() * (b - a + 1))
end

function RandomGenerator:chance(p)
	return self:next() < p
end

function RandomGenerator:sign()
	return if self:next() < 0.5 then -1 else 1
end

function RandomGenerator:pick(list)
	if #list == 0 then
		return nil
	end
	return list[self:int(1, #list)]
end

-- Tirage pondéré : renvoie l'index choisi (ou nil si tous les poids sont nuls).
function RandomGenerator:weightedIndex(weights)
	local total = 0
	for _, w in ipairs(weights) do
		if w > 0 then
			total += w
		end
	end
	if total <= 0 then
		return nil
	end
	local r = self:next() * total
	local acc = 0
	local lastPositive = nil
	for i, w in ipairs(weights) do
		if w > 0 then
			acc += w
			lastPositive = i
			if r < acc then
				return i
			end
		end
	end
	return lastPositive
end

function RandomGenerator:shuffle(list)
	for i = #list, 2, -1 do
		local j = self:int(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- Loi approximativement normale (somme de 3 uniformes), centrée, écart-type ~ 1.
function RandomGenerator:gaussian()
	return (self:next() + self:next() + self:next() - 1.5) * 2
end

-- Sous-flux déterministe nommé.
function RandomGenerator:fork(name)
	local h = Utilities.hashString(tostring(name))
	return RandomGenerator.new(bit32.bxor(self.Seed, mix32((h + 0x632BE5AB) % TWO_32)))
end

-- Nouvelle seed aléatoire (non déterministe) pour le bouton "Random Seed".
function RandomGenerator.randomSeed()
	local r = Random.new()
	return r:NextInteger(1, 2147483646)
end

-- Bruit de valeur 2D ----------------------------------------------------------

local function latticeValue(seed, ix, iy)
	local x = ix % TWO_32
	local y = iy % TWO_32
	local h = mix32(bit32.bxor(seed, imul(x, 0x27D4EB2D)))
	h = mix32(bit32.bxor(h, imul(y, 0x165667B1)))
	return h / TWO_32
end

-- Renvoie une valeur lisse dans [0, 1].
function RandomGenerator.noise2D(seed, x, y)
	local x0 = math.floor(x)
	local y0 = math.floor(y)
	local fx = x - x0
	local fy = y - y0
	local sx = fx * fx * (3 - 2 * fx)
	local sy = fy * fy * (3 - 2 * fy)
	local v00 = latticeValue(seed, x0, y0)
	local v10 = latticeValue(seed, x0 + 1, y0)
	local v01 = latticeValue(seed, x0, y0 + 1)
	local v11 = latticeValue(seed, x0 + 1, y0 + 1)
	local a = v00 + (v10 - v00) * sx
	local b = v01 + (v11 - v01) * sx
	return a + (b - a) * sy
end

-- Bruit fractal à 2 octaves, plus naturel.
function RandomGenerator.fractalNoise2D(seed, x, y)
	local n1 = RandomGenerator.noise2D(seed, x, y)
	local n2 = RandomGenerator.noise2D((seed + 1013904223) % TWO_32, x * 2.03, y * 2.03)
	return (n1 * 2 + n2) / 3
end

return RandomGenerator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Settings</string>
          <string name="Source"><![CDATA[--[[
	Settings
	Schéma unique de tous les paramètres réglables : type, bornes, valeur par
	défaut, libellé et section d'interface. L'UI est générée à partir de ce
	schéma, la validation aussi, et la persistance passe par
	plugin:SetSetting / plugin:GetSetting.
]]

local Config = require(script.Parent.Config)
local Utilities = require(script.Parent.Utilities)
local Presets = require(script.Parent.Presets)

local Settings = {}
Settings.__index = Settings

local ROTATION_MODES = {
	"Fixed", "Random90", "Random180", "Random360",
	"AlignToSurface", "AlignToWall", "FaceCenter", "FaceAway", "FollowPath",
}

-- Schéma ordonné. Type : "number" | "int" | "bool" | "enum".
Settings.Schema = {
	-- PLACEMENT MODE
	{ Key = "PlacementMode", Type = "enum", Default = "Auto", Options = { "Auto", "Floor", "Wall", "Architecture", "Hybrid" }, Section = "Placement", Label = "Placement mode",
		Tooltip = "Auto: le moteur décide tout. Floor/Wall: uniquement ces surfaces. Architecture: façades murales + coins. Hybrid: tout, avec vos algorithmes choisis." },
	{ Key = "AutoClassify", Type = "bool", Default = true, Section = "Placement", Label = "Auto-classify assets",
		Tooltip = "Déduit le rôle des assets sans métadonnées à partir de leur forme." },

	-- COMPOSITION
	{ Key = "Density", Type = "number", Default = 0.5, Min = 0, Max = 1, Step = 0.01, Section = "Composition", Label = "Density" },
	{ Key = "SpacingScale", Type = "number", Default = 1, Min = 0.25, Max = 3, Step = 0.05, Section = "Composition", Label = "Spacing" },
	{ Key = "ClusterStrength", Type = "number", Default = 0.6, Min = 0, Max = 1, Step = 0.01, Section = "Composition", Label = "Cluster strength" },
	{ Key = "EmptySpaceRatio", Type = "number", Default = 0.35, Min = 0, Max = 0.9, Step = 0.01, Section = "Composition", Label = "Empty space" },
	{ Key = "LargeAssetFrequency", Type = "number", Default = 0.5, Min = 0, Max = 1, Step = 0.01, Section = "Composition", Label = "Large asset frequency" },
	{ Key = "MediumAssetFrequency", Type = "number", Default = 0.6, Min = 0, Max = 1, Step = 0.01, Section = "Composition", Label = "Medium asset frequency" },
	{ Key = "SmallAssetFrequency", Type = "number", Default = 0.7, Min = 0, Max = 1, Step = 0.01, Section = "Composition", Label = "Small asset frequency" },
	{ Key = "Symmetry", Type = "number", Default = 0, Min = 0, Max = 1, Step = 0.01, Section = "Composition", Label = "Symmetry" },
	{ Key = "Randomness", Type = "number", Default = 0.45, Min = 0, Max = 1, Step = 0.01, Section = "Composition", Label = "Randomness" },
	{ Key = "Variation", Type = "number", Default = 0.6, Min = 0, Max = 1, Step = 0.01, Section = "Composition", Label = "Variation" },
	{ Key = "VisualRhythm", Type = "number", Default = 0.5, Min = 0, Max = 1, Step = 0.01, Section = "Composition", Label = "Visual rhythm" },

	-- TRANSFORM
	{ Key = "RotationMode", Type = "enum", Default = "Random360", Options = ROTATION_MODES, Section = "Transform", Label = "Rotation" },
	{ Key = "ScaleMode", Type = "enum", Default = "Preserve", Options = { "Preserve", "Fixed", "RandomRange" }, Section = "Transform", Label = "Scale" },
	{ Key = "FixedScale", Type = "number", Default = 1, Min = 0.1, Max = 10, Step = 0.05, Section = "Transform", Label = "Fixed scale" },
	{ Key = "MinScale", Type = "number", Default = 0.85, Min = 0.1, Max = 10, Step = 0.05, Section = "Transform", Label = "Min scale" },
	{ Key = "MaxScale", Type = "number", Default = 1.15, Min = 0.1, Max = 10, Step = 0.05, Section = "Transform", Label = "Max scale" },
	{ Key = "SurfaceOffset", Type = "number", Default = 0, Min = -5, Max = 5, Step = 0.01, Section = "Transform", Label = "Surface offset" },
	{ Key = "SurfaceEpsilon", Type = "number", Default = Config.Precision.DEFAULT_SURFACE_EPSILON, Min = Config.Precision.MIN_SURFACE_EPSILON, Max = Config.Precision.MAX_SURFACE_EPSILON, Step = 0.001, Section = "Transform", Label = "Surface epsilon",
		Tooltip = "SURFACE_EPSILON : décalage anti z-fighting appliqué aux décorations murales et aux superpositions." },
	{ Key = "AlignToSlopes", Type = "bool", Default = false, Section = "Transform", Label = "Align to slopes",
		Tooltip = "Incliner les assets selon la pente (sinon ils restent verticaux et sont légèrement enfoncés)." },

	-- WALL OPTIONS
	{ Key = "WallTreatment", Type = "enum", Default = "Keep", Options = { "Keep", "Cover", "Rebuild" }, Section = "Wall", Label = "Wall treatment",
		Tooltip = "Keep: décorations seulement. Cover: façade décorative devant le mur. Rebuild: structure architecturale complète." },
	{ Key = "WallMode", Type = "enum", Default = "Hybrid", Options = { "Hybrid", "Props", "Relief", "Modular", "Architectural" }, Section = "Wall", Label = "Wall mode" },
	{ Key = "WallDensity", Type = "number", Default = 0.5, Min = 0, Max = 1, Step = 0.01, Section = "Wall", Label = "Wall density" },
	{ Key = "PillarSpacing", Type = "number", Default = 16, Min = 2, Max = 200, Step = 0.5, Section = "Wall", Label = "Pillar spacing" },
	{ Key = "TopDecoration", Type = "bool", Default = true, Section = "Wall", Label = "Top decoration" },
	{ Key = "BaseDecoration", Type = "bool", Default = true, Section = "Wall", Label = "Base decoration" },
	{ Key = "CornerDecoration", Type = "bool", Default = true, Section = "Wall", Label = "Corner decoration" },
	{ Key = "HideOriginalWalls", Type = "bool", Default = false, Section = "Wall", Label = "Hide original walls (Rebuild)",
		Tooltip = "En mode Rebuild, rend les murs d'origine invisibles (Transparency). Réversible : Cancel, Clear Generated et Ctrl+Z restaurent." },
	{ Key = "AllowModuleScaling", Type = "bool", Default = true, Section = "Wall", Label = "Allow module scaling" },
	{ Key = "MaxModuleScaleDeviation", Type = "number", Default = Config.Fitting.DEFAULT_MAX_SCALE_DEVIATION, Min = 0, Max = 0.3, Step = 0.005, Section = "Wall", Label = "Max module deformation" },
	{ Key = "WallSides", Type = "enum", Default = "Auto", Options = { "Auto", "Both" }, Section = "Wall", Label = "Wall sides",
		Tooltip = "Auto: face tournée vers le sol (ou la caméra). Both: les deux faces." },

	-- FLOOR OPTIONS
	{ Key = "FloorAlgorithm", Type = "enum", Default = "Hybrid", Options = { "Hybrid", "EdgeDecoration", "Scatter", "Cluster", "Grid", "Border", "HeroComposition" }, Section = "Floor", Label = "Floor algorithm" },
	{ Key = "KeepCenterClear", Type = "bool", Default = false, Section = "Floor", Label = "Keep center clear" },
	{ Key = "CenterClearStart", Type = "number", Default = 0.2, Min = 0, Max = 1, Step = 0.01, Section = "Floor", Label = "Clear zone start" },
	{ Key = "CenterClearEnd", Type = "number", Default = 0.8, Min = 0, Max = 1, Step = 0.01, Section = "Floor", Label = "Clear zone end" },
	{ Key = "CenterClearAxis", Type = "enum", Default = "Auto", Options = { "Auto", "Width", "Length", "Both" }, Section = "Floor", Label = "Clear zone axis" },
	{ Key = "EdgeMargin", Type = "number", Default = 0.25, Min = 0, Max = 50, Step = 0.05, Section = "Floor", Label = "Left/Right margin" },
	{ Key = "EdgeDepth", Type = "number", Default = 8, Min = 0, Max = 200, Step = 0.5, Section = "Floor", Label = "Edge depth" },
	{ Key = "PathWidth", Type = "number", Default = 0, Min = 0, Max = 200, Step = 0.5, Section = "Floor", Label = "Path width" },
	{ Key = "AllowWallContact", Type = "bool", Default = true, Section = "Floor", Label = "Allow wall contact" },

	-- CEILING
	{ Key = "CeilingDecoration", Type = "bool", Default = true, Section = "Ceiling", Label = "Ceiling decoration" },
	{ Key = "CeilingDensity", Type = "number", Default = 0.4, Min = 0, Max = 1, Step = 0.01, Section = "Ceiling", Label = "Ceiling density" },

	-- COLLISION
	{ Key = "CollisionCheck", Type = "bool", Default = true, Section = "Collision", Label = "Collision check" },
	{ Key = "MinimumSpacing", Type = "number", Default = 0.5, Min = 0, Max = 20, Step = 0.05, Section = "Collision", Label = "Minimum spacing" },
	{ Key = "PreciseCollision", Type = "bool", Default = true, Section = "Collision", Label = "Precise (per-part) collision" },
	{ Key = "CollideWithScene", Type = "bool", Default = true, Section = "Collision", Label = "Collide with scene geometry" },
	{ Key = "AvoidPreviousGenerations", Type = "bool", Default = true, Section = "Collision", Label = "Avoid previous generations" },

	-- RANDOM
	{ Key = "Seed", Type = "int", Default = 12345, Min = 0, Max = 2147483646, Section = "Random", Label = "Seed" },
	{ Key = "NewSeedOnRegenerate", Type = "bool", Default = true, Section = "Random", Label = "New seed on Regenerate" },

	-- PERFORMANCE / OUTPUT
	{ Key = "MaxAssets", Type = "int", Default = 600, Min = 1, Max = Config.Performance.HARD_MAX_ASSETS, Section = "Output", Label = "Max assets" },
	{ Key = "CandidatesPerPlacement", Type = "int", Default = Config.Composition.DEFAULT_CANDIDATES, Min = 4, Max = 64, Section = "Output", Label = "Candidates per placement" },
	{ Key = "AnchorClones", Type = "bool", Default = true, Section = "Output", Label = "Anchor generated parts" },
	{ Key = "StripScripts", Type = "bool", Default = false, Section = "Output", Label = "Strip scripts from clones" },

	-- DEBUG
	{ Key = "DebugEnabled", Type = "bool", Default = false, Section = "Debug", Label = "Debug visualization" },
	{ Key = "DebugBounds", Type = "bool", Default = true, Section = "Debug", Label = "Bounding boxes" },
	{ Key = "DebugNormals", Type = "bool", Default = true, Section = "Debug", Label = "Surface normals" },
	{ Key = "DebugZones", Type = "bool", Default = true, Section = "Debug", Label = "Forbidden / clear zones" },
	{ Key = "DebugCandidates", Type = "bool", Default = false, Section = "Debug", Label = "Candidate points" },
	{ Key = "DebugRejected", Type = "bool", Default = false, Section = "Debug", Label = "Rejected points" },
	{ Key = "DebugSnaps", Type = "bool", Default = true, Section = "Debug", Label = "Snap points" },
	{ Key = "DebugSegments", Type = "bool", Default = true, Section = "Debug", Label = "Wall segmentation" },

	-- Dernier preset appliqué (affichage).
	{ Key = "Preset", Type = "enum", Default = "Balanced", Options = Presets.Order, Section = "Hidden", Label = "Preset" },
}

Settings.ByKey = {}
for _, entry in ipairs(Settings.Schema) do
	Settings.ByKey[entry.Key] = entry
end

-- Valide et normalise une valeur ; renvoie (valeur, ok).
function Settings.validate(key, value)
	local entry = Settings.ByKey[key]
	if not entry then
		return nil, false
	end
	if entry.Type == "bool" then
		if type(value) ~= "boolean" then
			return entry.Default, false
		end
		return value, true
	elseif entry.Type == "number" or entry.Type == "int" then
		local n = tonumber(value)
		if not n or not Utilities.isFiniteNumber(n) then
			return entry.Default, false
		end
		if entry.Type == "int" then
			n = math.floor(n + 0.5)
		end
		if entry.Min then
			n = math.max(entry.Min, n)
		end
		if entry.Max then
			n = math.min(entry.Max, n)
		end
		return n, true
	elseif entry.Type == "enum" then
		if type(value) == "string" and table.find(entry.Options, value) then
			return value, true
		end
		return entry.Default, false
	end
	return entry.Default, false
end

function Settings.defaults()
	local values = {}
	for _, entry in ipairs(Settings.Schema) do
		values[entry.Key] = entry.Default
	end
	return values
end

function Settings.new(plugin)
	local self = setmetatable({}, Settings)
	self._plugin = plugin
	self.Values = Settings.defaults()
	self._listeners = {}
	self._saveScheduled = false
	return self
end

function Settings:get(key)
	return self.Values[key]
end

function Settings:onChanged(callback)
	table.insert(self._listeners, callback)
	return function()
		local i = table.find(self._listeners, callback)
		if i then
			table.remove(self._listeners, i)
		end
	end
end

function Settings:_notify(key, value)
	for _, cb in ipairs(self._listeners) do
		task.spawn(cb, key, value)
	end
end

function Settings:set(key, value, silent)
	local normalized, _ = Settings.validate(key, value)
	if normalized == nil then
		return
	end
	if self.Values[key] == normalized then
		return
	end
	self.Values[key] = normalized
	if not silent then
		self:_notify(key, normalized)
	end
	self:scheduleSave()
end

function Settings:applyPreset(name)
	local preset = Presets.Values[name]
	if not preset then
		return false
	end
	-- Un preset part toujours des valeurs par défaut de la composition pour être reproductible.
	for _, key in ipairs(Presets.ResetKeys) do
		self:set(key, Settings.ByKey[key].Default)
	end
	for key, value in pairs(preset) do
		self:set(key, value)
	end
	self:set("Preset", name)
	return true
end

function Settings:resetDefaults()
	for _, entry in ipairs(Settings.Schema) do
		if entry.Key ~= "Seed" then
			self:set(entry.Key, entry.Default)
		end
	end
end

-- Copie figée utilisée par une génération (les changements pendant la génération n'ont pas d'effet).
function Settings:snapshot()
	local snap = table.clone(self.Values)
	-- Cohérence des bornes couplées.
	if snap.MinScale > snap.MaxScale then
		snap.MinScale, snap.MaxScale = snap.MaxScale, snap.MinScale
	end
	if snap.CenterClearStart > snap.CenterClearEnd then
		snap.CenterClearStart, snap.CenterClearEnd = snap.CenterClearEnd, snap.CenterClearStart
	end
	return snap
end

function Settings:load()
	if not self._plugin then
		return
	end
	local ok, stored = pcall(function()
		return self._plugin:GetSetting(Config.SETTINGS_KEY)
	end)
	if ok and type(stored) == "table" then
		for key, value in pairs(stored) do
			if Settings.ByKey[key] then
				local normalized = Settings.validate(key, value)
				if normalized ~= nil then
					self.Values[key] = normalized
				end
			end
		end
	end
end

function Settings:save()
	if not self._plugin then
		return
	end
	local ok, err = pcall(function()
		self._plugin:SetSetting(Config.SETTINGS_KEY, self.Values)
	end)
	if not ok then
		warn("[" .. Config.PLUGIN_DISPLAY_NAME .. "] Unable to save settings: " .. tostring(err))
	end
end

function Settings:scheduleSave()
	if self._saveScheduled then
		return
	end
	self._saveScheduled = true
	task.delay(Config.UI.SETTINGS_SAVE_DELAY, function()
		self._saveScheduled = false
		self:save()
	end)
end

return Settings
]]></string>
